# .env.op.example — 1Password secret REFERENCES for this project.
# Copy to .env.op, edit the vault/item names, and COMMIT it (references only, no secret values).
#
# Every value is an op:// reference of the form  op://<vault>/<item>/<field>. `op run` (invoked from
# .envrc) resolves them at cd-time; the real values are never written to disk or committed. Store the
# items in a SHARED (non-Private) 1Password vault — a service account cannot read your Private vault.
#
# macOS: config-dir isolation does NOT switch the Claude account, so we inject a per-account
# subscription OAuth token (from `claude setup-token`, run once while logged into that account) that
# OUTRANKS the shared login Keychain. That is what makes per-project Claude switching real on a Mac.
CLAUDE_CODE_OAUTH_TOKEN="op://Firm/claude-work/credential"

# Any other per-project secrets follow the same pattern, e.g.:
# GITHUB_TOKEN="op://Firm/github-work/token"
# NPM_TOKEN="op://Firm/npm/token"

# --- Remote approval notifications (Phase 5; pick ONE adapter) ---
# firm-notify pushes "a gate is waiting" to your phone. Notify-only — you still approve in-session.
# export FIRM_NOTIFY_ADAPTER="telegram"   # slack | pushover | telegram | ntfy | none (default none)
# Telegram (free, no server): bot token from @BotFather + your numeric chat_id
# export FIRM_TELEGRAM_TOKEN_REF="op://Firm/telegram/bot-token"
# export FIRM_TELEGRAM_CHAT_REF="op://Firm/telegram/chat-id"
# Slack (free workspace; the whole webhook URL is the secret):
# export FIRM_SLACK_WEBHOOK_REF="op://Firm/slack-webhook/url"
# Pushover (~$5 one-time/platform):
# export FIRM_PUSHOVER_TOKEN_REF="op://Firm/pushover/app-token"
# export FIRM_PUSHOVER_USER_REF="op://Firm/pushover/user-key"
# ntfy.sh (no account; the topic name IS the password — keep it unguessable):
# export FIRM_NTFY_TOPIC_REF="op://Firm/ntfy/topic"
# export FIRM_NTFY_SERVER="https://ntfy.sh"
