          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/firm-ledger-hook\"" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/firm-merge-guard\" --hook", "timeout": 30 }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/firm-notify\"", "timeout": 15 }
        ]
      }
    ]
  }
}
