{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(firm-new-run:*)",
      "Bash(firm-ledger-log:*)",
      "Bash(firm-validate-verdict:*)",
      "Bash(firm-new-worktree:*)",
      "Bash(firm-integrate:*)",
      "Bash(firm-qa-checkout:*)",
      "Bash(firm-traceability-check:*)",
      "Bash(firm-policy:*)",
      "Bash(firm-hire:*)",
      "Bash(firm-run-evals:*)",
      "Bash(firm-propose-system-change:*)",
      "Bash(firm-gpt-qa:*)",
      "Bash(firm-doctor:*)",
      "Bash(firm-notify:*)",
      "Bash(firm-visual-check:*)",
      "Bash(firm-visual-baseline:*)",
      "Bash(firm-check-assertions:*)",
      "Bash(codex exec:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git worktree:*)",
      "Bash(git stash:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npx jest:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright test:*)",
      "Bash(node --test:*)",
      "Bash(node --test)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(ruff:*)",
      "Bash(ls:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm ci:*)",
      "Bash(yarn add:*)",
      "Bash(pnpm add:*)",
      "Bash(pip install:*)",
      "Bash(brew install:*)",
      "Bash(rm:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(git push:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(:* > /dev/sda)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.codex/auth.json)",
      "Read(~/.claude.json)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(cat ~/.ssh/**)",
      "Bash(cat ~/.aws/**)",
      "Bash(cat ~/.codex/auth.json)",
      "Bash(cat ~/.claude.json)",
      "Bash(head .env*)",
      "Bash(head ~/.ssh/**)",
      "Bash(head ~/.aws/**)",
      "Bash(tail .env*)",
      "Bash(tail ~/.ssh/**)",
      "Bash(tail ~/.aws/**)",
      "Bash(less .env*)",
      "Bash(less ~/.ssh/**)",
      "Bash(less ~/.aws/**)",
      "Bash(strings .env*)",
      "Bash(strings ~/.ssh/**)",
      "Bash(strings ~/.aws/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/bin/firm-ledger-hook\"" }
        ]
      }
    ]
  }
}
