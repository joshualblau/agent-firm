{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "//": "Permissive by default: anything not matched below runs without a prompt. Topic-branch push and PR create/edit are the reviewable delivery path. Direct remote-default writes and PR merges remain blocked or gated. Business-logic and product decisions are surfaced by the assistant as questions, not permission prompts.",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(*)",
      "Bash(git worktree:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr ready:*)"
    ],
    "ask": [
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(rm:*)",
      "Bash(dropdb:*)",
      "Bash(brew:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(npm publish:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(gcloud:*)",
      "Bash(aws:*)",
      "Bash(az:*)",
      "Bash(kubectl:*)",
      "Bash(gh api:*)",
      "Bash(gh auth:*)",
      "Bash(gh issue:*)",
      "Bash(gh repo:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh ruleset:*)",
      "Bash(gh project:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr reopen:*)",
      "Bash(gh pr review:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(* > /dev/sda)",
      "Bash(cat ~/.ssh/**)",
      "Bash(cat ~/.aws/**)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.codex/auth.json)",
      "Read(~/.claude.json)",
      "Bash(git push --all:*)",
      "Bash(git push --mirror:*)",
      "Bash(gh pr merge:*)",
      "Bash(cat ~/.codex/auth.json)",
      "Bash(cat ~/.claude.json)",
      "Bash(head .env*)",
      "Bash(head ~/.ssh/**)",
      "Bash(head ~/.aws/**)",
      "Bash(tail .env*)",
      "Bash(tail ~/.ssh/**)",
      "Bash(tail ~/.aws/**)",
      "Bash(less .env*)",
      "Bash(less ~/.ssh/**)",
      "Bash(less ~/.aws/**)",
      "Bash(strings .env*)",
      "Bash(strings ~/.ssh/**)",
      "Bash(strings ~/.aws/**)"
    ]
  }
}
