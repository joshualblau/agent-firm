{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "//": "Permissive by default: anything not matched below runs without a prompt. Precedence is deny > ask > allow, so the ask/deny lists are the ONLY gates. Ask ONLY for destructive actions, actions outside this project's scope (remote/cloud/system), and merge/push confirmations. Business-logic and product decisions are surfaced by the assistant as questions, not permission prompts.",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(*)"
    ],
    "ask": [
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(rm:*)",
      "Bash(dropdb:*)",
      "Bash(brew:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(npm publish:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(gcloud:*)",
      "Bash(aws:*)",
      "Bash(az:*)",
      "Bash(kubectl:*)",
      "Bash(gh:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(* > /dev/sda)",
      "Bash(cat ~/.ssh/**)",
      "Bash(cat ~/.aws/**)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.codex/auth.json)",
      "Read(~/.claude.json)",
      "Bash(git push:*)",
      "Bash(cat ~/.codex/auth.json)",
      "Bash(cat ~/.claude.json)",
      "Bash(head .env*)",
      "Bash(head ~/.ssh/**)",
      "Bash(head ~/.aws/**)",
      "Bash(tail .env*)",
      "Bash(tail ~/.ssh/**)",
      "Bash(tail ~/.aws/**)",
      "Bash(less .env*)",
      "Bash(less ~/.ssh/**)",
      "Bash(less ~/.aws/**)",
      "Bash(strings .env*)",
      "Bash(strings ~/.ssh/**)",
      "Bash(strings ~/.aws/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/bin/firm-ledger-hook\""
          },
          {
            "//": "Merge/push authority gate. Fail-closed, CLIENT-SIDE, bypassable by anyone with repo write access — not a security boundary and not branch protection (docs/ENFORCEMENT.md). Runs AFTER the ledger hook so a refused command is still recorded. Remove this one object to remove the control entirely; nothing in allow/ask/deny is touched by it. `timeout` is only a backstop — the script's own gh/git waits are bounded at 12s/8s.",
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/bin/firm-merge-guard\" --hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
