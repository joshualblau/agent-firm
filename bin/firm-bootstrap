#!/usr/bin/env bash
# firm-bootstrap [--with-permissions] [--with-python-deps]
# Install/update the same checkout for Claude Code and Codex. Both CLIs are mandatory and are
# preflighted before either installation is changed.
set -euo pipefail
__src="${BASH_SOURCE[0]}"
while [ -L "$__src" ]; do __d="$(cd -P "$(dirname "$__src")" && pwd)"; __src="$(readlink "$__src")"; case $__src in /*) ;; *) __src="$__d/$__src";; esac; done
SELF="$(cd -P "$(dirname "$__src")" && pwd)"; ROOT="$(cd "$SELF/.." && pwd)"
CODEX_MARKETPLACE_ROOT="$ROOT"

want_permissions=0; want_python_deps=0
for arg in "$@"; do
  case "$arg" in
    --with-permissions) want_permissions=1 ;;
    --with-python-deps) want_python_deps=1 ;;
    -h|--help) sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "firm-bootstrap: unknown arg '$arg'" >&2; exit 2 ;;
  esac
done

echo "agent-firm dual-provider bootstrap"
echo "  repo: $ROOT"
missing=""
command -v claude >/dev/null 2>&1 || missing="$missing claude"
command -v codex >/dev/null 2>&1 || missing="$missing codex"
if [[ -n "$missing" ]]; then
  echo "ERROR: required CLI(s) missing:$missing. Install both Claude Code and Codex before bootstrap; nothing was installed." >&2
  exit 1
fi
"$SELF/firm-version" --check >/dev/null

# Claude marketplace + plugin.
if claude plugin marketplace list 2>/dev/null | grep -qF "$ROOT"; then
  echo "  ✔ Claude marketplace already registered — refreshing"
  claude plugin marketplace update local >/dev/null
else
  claude plugin marketplace add "$ROOT"
fi
if claude plugin list 2>/dev/null | grep -q 'agent-firm@local'; then
  echo "  ✔ Claude plugin already installed — updating"
  claude plugin update agent-firm@local
else
  claude plugin install agent-firm@local
fi

# Codex repo-local marketplace + root-source plugin. Local marketplaces read the checkout directly;
# `plugin add` refreshes Codex's cached copy and is idempotent for an installed selector.
if codex plugin marketplace list 2>/dev/null | grep -qF "$CODEX_MARKETPLACE_ROOT"; then
  echo "  ✔ Codex marketplace already registered"
else
  codex plugin marketplace add "$CODEX_MARKETPLACE_ROOT"
fi
echo "  refreshing Codex plugin cache"
codex plugin add agent-firm@agent-firm-local

if [[ "${FIRM_SKIP_LINK:-0}" != "1" ]]; then "$SELF/firm-link"; else echo "  (skipping shell PATH linking — FIRM_SKIP_LINK=1)"; fi

PIP_CMD="python3 -m pip install --user jsonschema pyyaml"
missing_py=""
python3 -c 'import jsonschema' >/dev/null 2>&1 || missing_py="$missing_py jsonschema"
python3 -c 'import yaml' >/dev/null 2>&1 || missing_py="$missing_py pyyaml"
if [[ -n "$missing_py" ]]; then
  if [[ "$want_python_deps" == "1" ]]; then
    echo "  installing Python prerequisites:$missing_py"
    $PIP_CMD || echo "  WARNING: pip install failed — run it yourself: $PIP_CMD" >&2
  else
    echo "  ⚠ missing Python prerequisite(s):$missing_py"
    echo "    Install with: $PIP_CMD (or re-run with --with-python-deps)"
  fi
else
  echo "  ✔ Python prerequisites present (jsonschema, pyyaml)"
fi

if [[ "$want_permissions" == "1" ]]; then
  echo "  installing Claude permission policy into: $(pwd)/.claude/settings.json"
  "$SELF/firm-install"
fi

cat <<'EOF'

Done. Next steps:
  cd <your project> && firm-install     # Claude permission policy; Codex keeps native sandbox/approval config
  firm-doctor
  claude                               # /agent-firm:start <goal>
  codex                                # $agent-firm:start <goal>

Start a new Codex task and restart/reload Claude so both runtimes pick up refreshed plugin caches.
EOF
