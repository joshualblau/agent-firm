#!/usr/bin/env bash
# firm-bootstrap [--with-permissions] [--with-python-deps]
# One-command device setup: register this repo as a local marketplace and install the agent-firm
# plugin (user scope = all projects). Idempotent. Portable: it locates the firm repo from its own
# path, so it works wherever you cloned/copied the repo.
#   firm-bootstrap                     # register marketplace + install/update the plugin
#   firm-bootstrap --with-permissions  # also run firm-install in the CURRENT directory (project scope)
#   firm-bootstrap --with-python-deps  # also pip-install the required jsonschema + pyyaml
#
# Installing Python packages CHANGES YOUR MACHINE, so it never happens as a side effect of running
# this script. Without the flag, bootstrap only reports what's missing and prints the exact command.
set -uo pipefail
__src="${BASH_SOURCE[0]}"   # resolve symlinks so ~/.local/bin/firm-* finds the repo
while [ -L "$__src" ]; do __d="$(cd -P "$(dirname "$__src")" && pwd)"; __src="$(readlink "$__src")"; case $__src in /*) ;; *) __src="$__d/$__src";; esac; done
SELF="$(cd -P "$(dirname "$__src")" && pwd)"
ROOT="$(cd "$SELF/.." && pwd)"

# Flags are order-independent (this previously only inspected $1, so `--with-permissions` was
# silently ignored whenever it wasn't the first argument).
want_permissions=0
want_python_deps=0
for arg in "$@"; do
  case "$arg" in
    --with-permissions) want_permissions=1 ;;
    --with-python-deps) want_python_deps=1 ;;
    -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "firm-bootstrap: unknown arg '$arg'" >&2; exit 2 ;;
  esac
done

echo "agent-firm bootstrap"
echo "  repo: $ROOT"
command -v claude >/dev/null 2>&1 || { echo "ERROR: the 'claude' CLI is not on PATH. Install Claude Code first." >&2; exit 1; }

# 1. Local marketplace (idempotent — match by SOURCE PATH; the name 'local' is too generic to grep)
if claude plugin marketplace list 2>/dev/null | grep -qF "$ROOT"; then
  echo "  ✔ marketplace already registered (updating)"
  claude plugin marketplace update local >/dev/null 2>&1 || true
else
  claude plugin marketplace add "$ROOT"
fi

# 2. Plugin (install or update)
if claude plugin list 2>/dev/null | grep -q 'agent-firm@local'; then
  echo "  ✔ plugin already installed — updating to latest"
  claude plugin update agent-firm@local || true
else
  claude plugin install agent-firm@local
fi

# 3. Shell PATH: the plugin's bin/ joins PATH only INSIDE a claude session, so symlink the
#    firm-* tools into ~/.local/bin (or $FIRM_BIN_DIR) for use from your terminal.
if [[ "${FIRM_SKIP_LINK:-0}" != "1" ]]; then
  "$SELF/firm-link"
else
  echo "  (skipping shell PATH linking — FIRM_SKIP_LINK=1)"
fi

# 4. Python prerequisites. `jsonschema` is gate-critical: without it firm-validate-verdict cannot
#    schema-validate a QA verdict and exits 4 (DEGRADED), which does not satisfy the Final gate.
#    `pyyaml` is advisory — the yaml parsers fall back to regex without it.
PIP_CMD="python3 -m pip install --user jsonschema pyyaml"
missing_py=""
python3 -c 'import jsonschema' >/dev/null 2>&1 || missing_py="$missing_py jsonschema"
python3 -c 'import yaml'       >/dev/null 2>&1 || missing_py="$missing_py pyyaml"

if [[ -n "$missing_py" ]]; then
  if [[ "$want_python_deps" == "1" ]]; then
    echo "  installing Python prerequisites:$missing_py"
    $PIP_CMD || echo "  WARNING: pip install failed — run it yourself: $PIP_CMD" >&2
  else
    echo "  ⚠ missing Python prerequisite(s):$missing_py"
    echo "    jsonschema is REQUIRED (QA verdicts cannot be schema-validated without it)."
    echo "    Install with:  $PIP_CMD     (or re-run: firm-bootstrap --with-python-deps)"
  fi
else
  echo "  ✔ Python prerequisites present (jsonschema, pyyaml)"
fi

# 5. Optional: permissions into the current project
if [[ "$want_permissions" == "1" ]]; then
  echo "  installing firm permissions into: $(pwd)/.claude/settings.json"
  "$SELF/firm-install"
fi

cat <<'EOF'

Done. Next steps:
  cd <your project> && firm-install     # grant the firm's permission policy (once per project)
  # (optional) profile + secrets: cp ~/agent-firm/.envrc.example .envrc && cp ~/agent-firm/.env.op.example .env.op
  #            edit FIRM_PROFILE + op:// refs, then:  direnv allow
  firm-doctor                           # fail-closed check: no API-key leak, profiles isolated, op+direnv wired
  claude                                # then, inside the session:  /agent-firm:start <your goal>

Note: restart any already-running claude session so it loads/refreshes the plugin.
EOF
