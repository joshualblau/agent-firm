#!/usr/bin/env bash
# Private candidate-tool authority used only by firm-run-evals.
set -uo pipefail
__src="${BASH_SOURCE[0]}"
while [ -L "$__src" ]; do __dir="$(cd -P "$(dirname "$__src")" && pwd)"; __src="$(readlink "$__src")"; case $__src in /*) ;; *) __src="$__dir/$__src";; esac; done
__self="$(cd -P "$(dirname "$__src")" && pwd)"
. "$__self/firm-python"
exec "${FIRM_PYTHON_ARGV[@]}" - "$__src" "$@" <<'PY'
import argparse, errno, hashlib, hmac, json, os, re, secrets, shlex, shutil, signal, socket, stat, subprocess, sys, tempfile, time
from pathlib import Path

SELF = Path(sys.argv[1]).resolve()
ARGV = sys.argv[2:]
PATCH_BASE = "369c86b18027281fcfec1288efaa1255df315c35"
PATCH_COMMIT = "36acf5dd5ec1a3a22b797a30b053d4e592ce5c60"
PAYLOAD_COMMIT = "a57a8d0b4754ed92b74c023c340aab3154845abb"
PATCH_BYTES = 144413
PATCH_SHA256 = "7e79d4dc34a7fdcf540781fee5a35c006b6dc4aefabfbac1636c5b855c502829"
MAX_MESSAGE = 256 * 1024
HEX64 = set("0123456789abcdef")
GIT = str(Path(shutil.which("git") or "/usr/bin/git").resolve())
SANDBOX_EXEC = Path("/usr/bin/sandbox-exec")
PROFILE_SOURCE = b'''(version 1)\n(allow default)\n(deny file-read* file-write* (subpath (param "REAL_COMMON")))\n'''
GUARDIAN_PROTOCOL_VERSION = 2
GUARDIAN_SOCKET_NAME = "guardian.sock"
GUARDIAN_STABLE_IDENTITY = ("dev", "ino", "uid", "mode")
TEST_BARRIER_PHASES = {"manifest_read", "dispatch_commit", "use_exec", "cleanup_commit"}
SAFE_GIT_ENV = {
    "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null",
    "GIT_CONFIG_SYSTEM": "/dev/null", "GIT_CONFIG_COUNT": "0",
    "GIT_TERMINAL_PROMPT": "0", "GIT_PROTOCOL_FROM_USER": "0",
}

def fail(message):
    print("firm-eval-authority: INPUT_INVALID: " + message, file=sys.stderr)
    raise SystemExit(2)

def canonical(obj):
    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=True)

def digest_bytes(raw):
    return hashlib.sha256(raw).hexdigest()

def read_bytes(path, maximum=16 * 1024 * 1024):
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(str(path), flags)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_size > maximum:
            fail("unsafe file")
        chunks, total = [], 0
        while True:
            chunk = os.read(fd, 65536)
            if not chunk: break
            total += len(chunk)
            if total > maximum: fail("oversized file")
            chunks.append(chunk)
        after = os.fstat(fd)
        if identity(st) != identity(after): fail("file changed while read")
        return b"".join(chunks), st
    finally:
        os.close(fd)

def identity(st):
    return {"dev": st.st_dev, "ino": st.st_ino, "uid": st.st_uid,
            "mode": stat.S_IMODE(st.st_mode), "nlink": st.st_nlink,
            "bytes": st.st_size}

def no_symlink_components(path):
    path = Path(path)
    current = Path(path.anchor)
    for part in path.parts[1:]:
        current = current / part
        if stat.S_ISLNK(os.lstat(str(current)).st_mode): fail("symlinked path component")

def git(root, *args, binary=False):
    env = {"PATH":"/usr/bin:/bin:/usr/sbin:/sbin", "LC_ALL":"C"}
    env.update(SAFE_GIT_ENV)
    value = subprocess.check_output([GIT, "-C", str(root)] + list(args),
                                    stderr=subprocess.DEVNULL, env=env)
    return value if binary else value.decode("utf-8", "strict").strip()

def prove_patch(root, head):
    commits = git(root, "rev-list", "--first-parent", head).splitlines()
    for commit in commits:
        parents = git(root, "show", "-s", "--format=%P", commit).split()
        if parents == [PATCH_BASE]:
            raw = git(root, "diff", "--binary", "--full-index", PATCH_BASE, commit, binary=True)
            if len(raw) == PATCH_BYTES and digest_bytes(raw) == PATCH_SHA256:
                return commit
            fail("immutable patch identity mismatch")
    fail("immutable patch commit not found")

def put_file(path, raw, mode):
    fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os,"O_NOFOLLOW",0), mode)
    try:
        view = memoryview(raw)
        while view:
            count = os.write(fd, view); view = view[count:]
        os.fsync(fd)
    finally: os.close(fd)

def path_record(path, content=True):
    path = Path(path); no_symlink_components(path)
    st = os.lstat(str(path))
    if st.st_uid != os.getuid() or (stat.S_ISREG(st.st_mode) and st.st_nlink != 1):
        fail("unsafe owned path identity")
    item = identity(st)
    if stat.S_ISREG(st.st_mode) and content:
        raw, after = read_bytes(path, 512 * 1024 * 1024)
        if identity(after) != item: fail("identity changed while recorded")
        item["sha256"] = digest_bytes(raw)
    return item

def tree_inventory(root):
    root = Path(root); rows=[]
    for current, dirs, files in os.walk(str(root), topdown=True, followlinks=False):
        dirs.sort(); files.sort()
        for name in dirs + files:
            path=Path(current)/name; st=os.lstat(str(path)); rel=str(path.relative_to(root))
            if stat.S_ISLNK(st.st_mode): fail("symlink in protected tree")
            if st.st_uid != os.getuid(): fail("foreign path in protected tree")
            if stat.S_ISREG(st.st_mode):
                if st.st_nlink != 1: fail("hardlink in protected tree")
                raw,after=read_bytes(path,512*1024*1024)
                if identity(st)!=identity(after): fail("protected tree changed while read")
                rows.append({"path":rel,"kind":"file","mode":stat.S_IMODE(st.st_mode),
                             "bytes":len(raw),"sha256":digest_bytes(raw)})
            elif stat.S_ISDIR(st.st_mode):
                rows.append({"path":rel,"kind":"dir","mode":stat.S_IMODE(st.st_mode)})
            else: fail("special path in protected tree")
    raw=(canonical(rows)+"\n").encode("ascii")
    return {"entries":len(rows),"sha256":digest_bytes(raw),"bytes":len(raw)}

def owned_directory(path, mode=0o700):
    st=os.lstat(str(path))
    if (not stat.S_ISDIR(st.st_mode) or stat.S_ISLNK(st.st_mode) or st.st_uid!=os.getuid()
            or stat.S_IMODE(st.st_mode)!=mode):
        fail("unsafe owned directory")
    return st

def guardian_auth(token, record):
    return hmac.new(bytes.fromhex(token),canonical(record).encode("ascii"),hashlib.sha256).hexdigest()

def guardian_signed(token, unsigned):
    value=dict(unsigned); value["auth"]=guardian_auth(token,unsigned)
    return value

def guardian_root_binding(root_id):
    if not isinstance(root_id,dict) or any(not isinstance(root_id.get(key),int) for key in GUARDIAN_STABLE_IDENTITY):
        return ""
    stable={key:root_id[key] for key in GUARDIAN_STABLE_IDENTITY}
    return digest_bytes(canonical(stable).encode("ascii"))

def guardian_registration_digest(registrations):
    rows=[{"sequence":item["sequence"],"role":item["role"],"pid":item["pid"],
           "pgid":item["pgid"],"nonce":item["nonce"],"request_sha256":item["request_sha256"]}
          for item in sorted(registrations,key=lambda item:item["sequence"])]
    return digest_bytes(canonical(rows).encode("ascii"))

def guardian_write_all(fd, raw):
    view=memoryview(raw)
    while view:
        count=os.write(fd,view)
        if count<=0: raise RuntimeError("guardian short write")
        view=view[count:]

def guardian_recv_frame(connection, timeout):
    connection.settimeout(timeout); raw=b""
    while True:
        part=connection.recv(min(65536,MAX_MESSAGE+1-len(raw)))
        if not part: break
        raw+=part
        if len(raw)>MAX_MESSAGE: raise RuntimeError("guardian oversized frame")
    if not raw.endswith(b"\n") or raw.count(b"\n")!=1:
        raise RuntimeError("guardian partial or extra frame")
    try: value=json.loads(raw[:-1].decode("ascii"))
    except Exception: raise RuntimeError("guardian malformed frame")
    if not isinstance(value,dict): raise RuntimeError("guardian frame shape")
    return value

def guardian_send_frame(connection, token, unsigned):
    value=guardian_signed(token,unsigned)
    raw=(canonical(value)+"\n").encode("ascii")
    if len(raw)>MAX_MESSAGE: raise RuntimeError("guardian response too large")
    connection.sendall(raw); connection.shutdown(socket.SHUT_WR)

def guardian_verify_response(token, response):
    if not isinstance(response,dict): fail("guardian response shape")
    value=dict(response); auth=value.pop("auth",None)
    if not isinstance(auth,str) or not hmac.compare_digest(auth,guardian_auth(token,value)):
        fail("guardian response authentication")
    return value,auth

def guardian_client_request(control, token, unsigned, timeout=10):
    if not re.fullmatch(r"[0-9a-f]{64}",token): fail("guardian token")
    socket_path=Path(control)/GUARDIAN_SOCKET_NAME
    owned_directory(Path(control)); socket_st=os.lstat(str(socket_path))
    if (not stat.S_ISSOCK(socket_st.st_mode) or socket_st.st_uid!=os.getuid()
            or stat.S_IMODE(socket_st.st_mode)!=0o600):
        fail("guardian socket identity")
    request=guardian_signed(token,unsigned)
    raw=(canonical(request)+"\n").encode("ascii")
    if len(raw)>MAX_MESSAGE: fail("guardian request too large")
    connection=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
    try:
        connection.settimeout(timeout); connection.connect(str(socket_path))
        connection.sendall(raw); connection.shutdown(socket.SHUT_WR)
        response=guardian_recv_frame(connection,timeout)
    except (OSError,RuntimeError) as exc:
        fail("guardian request failed: %s"%exc)
    finally: connection.close()
    value,auth=guardian_verify_response(token,response)
    value["auth"]=auth
    return value

def write_failure_marker(parent_fd, marker_name, token, invocation, root, root_binding,
                         reason, request=None):
    value={"schema_version":1,"protocol_version":GUARDIAN_PROTOCOL_VERSION,"status":"BLOCK",
           "invocation":invocation,"candidate_commit":PAYLOAD_COMMIT,"root":str(root),
           "root_binding":root_binding,"reason":str(reason)[:1000],"guardian_pid":os.getpid(),
           "request_sha256":request.get("request_sha256") if request else None,
           "request_sequence":request.get("sequence") if request else None,
           "monotonic_ns":time.monotonic_ns()}
    raw=(canonical(guardian_signed(token,value))+"\n").encode("ascii")
    fd=os.open(marker_name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|getattr(os,"O_NOFOLLOW",0),0o600,
               dir_fd=parent_fd)
    try: guardian_write_all(fd,raw); os.fsync(fd)
    finally: os.close(fd)

def remove_owned_tree_fd(fd):
    for entry in list(os.scandir(fd)):
        st=os.stat(entry.name,dir_fd=fd,follow_symlinks=False)
        if st.st_uid!=os.getuid(): raise RuntimeError("foreign cleanup entry")
        if stat.S_ISDIR(st.st_mode):
            child=os.open(entry.name,os.O_RDONLY|getattr(os,"O_DIRECTORY",0)|getattr(os,"O_NOFOLLOW",0),dir_fd=fd)
            try: remove_owned_tree_fd(child)
            finally: os.close(child)
            os.rmdir(entry.name,dir_fd=fd)
        elif stat.S_ISREG(st.st_mode):
            if st.st_nlink!=1: raise RuntimeError("hardlinked cleanup entry")
            os.unlink(entry.name,dir_fd=fd)
        elif stat.S_ISLNK(st.st_mode):
            os.unlink(entry.name,dir_fd=fd)
        else: raise RuntimeError("special cleanup entry")

def raw_test_barrier(config, phase, observed):
    if not config or not config.get("enabled") or config.get("phase")!=phase: return
    root=Path(config["root"]); owned_directory(root)
    token=config["token"]
    if not re.fullmatch(r"[0-9a-f]{64}",token) or config.get("invocation") is None:
        fail("test barrier binding")
    prefix=str(root/(token+"."+phase))
    ready=Path(prefix+".ready")
    mutated=Path(prefix+".mutated")
    resume=Path(prefix+".resume")
    release=Path(prefix+".release")
    if release.exists(): return
    record={"schema_version":1,"phase":phase,"token":token,"invocation":config["invocation"],
            "authority_pid":os.getpid(),"enter_monotonic_ns":time.monotonic_ns(),"observed":observed}
    put_file(ready,(canonical(record)+"\n").encode("ascii"),0o600)
    deadline=time.monotonic()+10
    while time.monotonic()<deadline and not mutated.exists(): time.sleep(0.005)
    if not mutated.exists(): fail("test barrier mutation timeout")
    mutation_raw,_=read_bytes(mutated,MAX_MESSAGE)
    try: mutation=json.loads(mutation_raw.decode("ascii"))
    except Exception: fail("test barrier mutation JSON")
    required={"schema_version","phase","token","invocation","mutator_pid","mutate_monotonic_ns","changed"}
    if (not exact_keys(mutation,required) or mutation["schema_version"]!=1 or mutation["phase"]!=phase
            or mutation["token"]!=token or mutation["invocation"]!=config["invocation"]
            or not isinstance(mutation["mutator_pid"],int) or mutation["mutator_pid"]<=0
            or not isinstance(mutation["mutate_monotonic_ns"],int)
            or mutation["mutate_monotonic_ns"]<=record["enter_monotonic_ns"]
            or not isinstance(mutation["changed"],dict) or not mutation["changed"]):
        fail("test barrier mutation binding")
    try: os.kill(mutation["mutator_pid"],0)
    except ProcessLookupError: fail("test barrier mutator not concurrent")
    resume_ns=time.monotonic_ns()
    put_file(resume,(canonical({"schema_version":1,"phase":phase,"token":token,"invocation":config["invocation"],
                               "authority_pid":os.getpid(),"resume_monotonic_ns":resume_ns})+"\n").encode("ascii"),0o600)
    deadline=time.monotonic()+10
    while time.monotonic()<deadline and not release.exists(): time.sleep(0.005)
    if not release.exists(): fail("test barrier release timeout")
    release_raw,_=read_bytes(release,MAX_MESSAGE)
    try: release_doc=json.loads(release_raw.decode("ascii"))
    except Exception: fail("test barrier release JSON")
    if (not exact_keys(release_doc,{"schema_version","phase","token","invocation","mutator_pid","release_monotonic_ns"})
            or release_doc["schema_version"]!=1 or release_doc["phase"]!=phase or release_doc["token"]!=token
            or release_doc["invocation"]!=config["invocation"] or release_doc["mutator_pid"]!=mutation["mutator_pid"]
            or not isinstance(release_doc["release_monotonic_ns"],int) or release_doc["release_monotonic_ns"]<resume_ns):
        fail("test barrier release binding")

def test_barrier(doc,phase,observed):
    config=doc.get("test_barrier",{"enabled":False})
    supplied={"root":os.environ.get("FIRM_EVAL_TEST_BARRIER_ROOT"),
              "token":os.environ.get("FIRM_EVAL_TEST_BARRIER_TOKEN"),
              "invocation":os.environ.get("FIRM_EVAL_TEST_BARRIER_INVOCATION"),
              "phase":os.environ.get("FIRM_EVAL_TEST_BARRIER_PHASE")}
    if config.get("enabled"):
        expected={key:config[key] for key in supplied}
        if supplied!=expected: fail("test barrier environment binding")
        raw_test_barrier(config,phase,observed)
    elif any(value is not None for value in supplied.values()):
        fail("production invocation rejects test barrier")

def guardian_group_alive(pgid):
    try: os.killpg(pgid,0); return True
    except ProcessLookupError: return False
    except PermissionError: raise RuntimeError("cannot prove registered group absent")

def terminate_groups(registrations):
    observations=[]
    for item in registrations:
        pid=item["pid"]; pgid=item["pgid"]
        try:
            if os.getpgid(pid)!=pgid or os.getsid(pid)!=pid:
                raise RuntimeError("registered process identity drift")
        except ProcessLookupError:
            pass
    groups=sorted(set(item["pgid"] for item in registrations))
    for pgid in groups:
        try: os.killpg(pgid,signal.SIGTERM); outcome="sent"
        except ProcessLookupError: outcome="absent"
        except PermissionError: raise RuntimeError("cannot signal registered group")
        observations.append({"signal":"TERM","pgid":pgid,"outcome":outcome})
    deadline=time.monotonic()+2
    alive=[]
    while time.monotonic()<deadline:
        alive=[pgid for pgid in groups if guardian_group_alive(pgid)]
        if not alive: break
        time.sleep(0.02)
    for pgid in alive:
        try: os.killpg(pgid,signal.SIGKILL); outcome="sent"
        except ProcessLookupError: outcome="absent"
        except PermissionError: raise RuntimeError("cannot kill registered group")
        observations.append({"signal":"KILL","pgid":pgid,"outcome":outcome})
    deadline=time.monotonic()+2
    while time.monotonic()<deadline:
        alive=[pgid for pgid in groups if guardian_group_alive(pgid)]
        if not alive: break
        time.sleep(0.02)
    if alive: raise RuntimeError("registered group did not quiesce")
    for pgid in groups:
        observations.append({"signal":"PROBE","pgid":pgid,"outcome":"absent"})
    return observations

def guardian_same_identity(current, expected):
    return all(current[key]==expected[key] for key in GUARDIAN_STABLE_IDENTITY)

def guardian_delete_root(parent_fd, root, root_fd, root_id, control_fd, socket_path,
                         socket_id, listener, barrier):
    if listener is not None: listener.close()
    path_id=identity(os.stat(root.name,dir_fd=parent_fd,follow_symlinks=False))
    if (not guardian_same_identity(path_id,root_id)
            or not guardian_same_identity(identity(os.fstat(root_fd)),root_id)):
        raise RuntimeError("guardian root identity drift")
    socket_st=os.stat(GUARDIAN_SOCKET_NAME,dir_fd=control_fd,follow_symlinks=False)
    if (not stat.S_ISSOCK(socket_st.st_mode)
            or not guardian_same_identity(identity(socket_st),socket_id)):
        raise RuntimeError("guardian socket identity drift")
    os.unlink(GUARDIAN_SOCKET_NAME,dir_fd=control_fd)
    raw_test_barrier(barrier,"cleanup_commit",root_id)
    path_id=identity(os.stat(root.name,dir_fd=parent_fd,follow_symlinks=False))
    if not guardian_same_identity(path_id,root_id): raise RuntimeError("guardian cleanup race")
    remove_owned_tree_fd(root_fd)
    os.close(control_fd); control_fd=None
    os.close(root_fd); root_fd=None
    os.rmdir(root.name,dir_fd=parent_fd)
    try: os.stat(root.name,dir_fd=parent_fd,follow_symlinks=False)
    except FileNotFoundError: return {"removed":True,"absent":True,"method":"parent_fd_relative"},root_fd,control_fd
    raise RuntimeError("guardian cleanup residue")

def guardian_daemon(ready_fd, parent, launcher_pid, invocation, token, barrier):
    root=None; root_fd=None; parent_fd=None; control_fd=None; listener=None; cleanup_connection=None
    registrations=[]; sequence=0; accepted=None; state="BOOTSTRAP"; quiescence=None; root_binding=None
    marker_name="firm-eval-block-"+invocation+".json"
    try:
        parent_path=Path(parent); parent_fd=os.open(str(parent_path),os.O_RDONLY|getattr(os,"O_DIRECTORY",0)|getattr(os,"O_NOFOLLOW",0))
        try: os.stat(marker_name,dir_fd=parent_fd,follow_symlinks=False); raise RuntimeError("guardian failure marker collision")
        except FileNotFoundError: pass
        root=Path(tempfile.mkdtemp(prefix="firm-eval-"+invocation[:12]+".",dir=parent)).resolve()
        capsule=root/"capsule"; control=root/"control"; socket_path=control/GUARDIAN_SOCKET_NAME
        capsule.mkdir(mode=0o700); control.mkdir(mode=0o700)
        root_fd=os.open(str(root),os.O_RDONLY|getattr(os,"O_DIRECTORY",0)|getattr(os,"O_NOFOLLOW",0))
        control_fd=os.open("control",os.O_RDONLY|getattr(os,"O_DIRECTORY",0)|getattr(os,"O_NOFOLLOW",0),dir_fd=root_fd)
        root_id=identity(os.fstat(root_fd)); root_binding=guardian_root_binding(root_id)
        listener=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM); listener.bind(str(socket_path)); os.chmod(str(socket_path),0o600)
        listener.listen(8); listener.settimeout(0.05)
        socket_id=identity(os.lstat(str(socket_path)))
        if not stat.S_ISSOCK(os.lstat(str(socket_path)).st_mode): raise RuntimeError("guardian socket type")
        marker=str(parent_path/marker_name)
        unsigned={"schema_version":1,"protocol_version":GUARDIAN_PROTOCOL_VERSION,"status":"ready",
                  "invocation":invocation,"candidate_commit":PAYLOAD_COMMIT,"guardian_pid":os.getpid(),
                  "launcher_pid":launcher_pid,"root":str(root),"capsule":str(capsule),"control":str(control),
                  "socket":str(socket_path),"socket_identity":socket_id,"root_identity":root_id,
                  "root_binding":root_binding,"failure_marker":marker,
                  "token_sha256":digest_bytes(bytes.fromhex(token))}
        ready=guardian_signed(token,unsigned)
        guardian_write_all(ready_fd,(canonical(ready)+"\n").encode("ascii")); os.close(ready_fd); ready_fd=None
        state="ACCEPTING"; interrupted=[None]
        def request_cleanup(signum,*_): interrupted[0]="guardian signal %d"%signum
        for signum in (signal.SIGHUP,signal.SIGINT,signal.SIGTERM): signal.signal(signum,request_cleanup)
        while accepted is None:
            if interrupted[0]: raise RuntimeError(interrupted[0])
            try: os.kill(launcher_pid,0)
            except ProcessLookupError: raise RuntimeError("launcher liveness EOF")
            try: connection,_=listener.accept()
            except socket.timeout: continue
            try:
                try: request=guardian_recv_frame(connection,2)
                except Exception:
                    guardian_send_frame(connection,token,{"schema_version":1,"protocol_version":GUARDIAN_PROTOCOL_VERSION,
                        "status":"NACK","invocation":invocation,"candidate_commit":PAYLOAD_COMMIT,
                        "guardian_pid":os.getpid(),"state":state,"reason":"unauthenticated or malformed frame"})
                    continue
                unsigned_request=dict(request); auth=unsigned_request.pop("auth",None)
                authenticated=isinstance(auth,str) and hmac.compare_digest(auth,guardian_auth(token,unsigned_request))
                if not authenticated:
                    guardian_send_frame(connection,token,{"schema_version":1,"protocol_version":GUARDIAN_PROTOCOL_VERSION,
                        "status":"NACK","invocation":invocation,"candidate_commit":PAYLOAD_COMMIT,
                        "guardian_pid":os.getpid(),"state":state,"reason":"authentication failed"})
                    continue
                common={"schema_version","protocol_version","kind","invocation","candidate_commit","sequence",
                        "nonce","guardian_pid","root_binding"}
                if (request.get("schema_version")!=1 or request.get("protocol_version")!=GUARDIAN_PROTOCOL_VERSION
                        or request.get("invocation")!=invocation or request.get("candidate_commit")!=PAYLOAD_COMMIT
                        or request.get("guardian_pid")!=os.getpid() or request.get("root_binding")!=root_binding
                        or not re.fullmatch(r"[0-9a-f]{64}",str(request.get("nonce","")))):
                    raise RuntimeError("authenticated guardian binding fault")
                kind=request.get("kind")
                if kind=="status":
                    if not exact_keys(request,common|{"auth"}) or request["sequence"]!=sequence+1:
                        raise RuntimeError("guardian status sequence or shape")
                    guardian_send_frame(connection,token,{"schema_version":1,"protocol_version":GUARDIAN_PROTOCOL_VERSION,
                        "status":"STATE","invocation":invocation,"candidate_commit":PAYLOAD_COMMIT,
                        "guardian_pid":os.getpid(),"state":state,"next_sequence":sequence+1,
                        "request_nonce":request["nonce"],"root_binding":root_binding,
                        "registration_digest":guardian_registration_digest(registrations),
                        "registered_roles":sorted(item["role"] for item in registrations)})
                elif kind=="register":
                    keys=common|{"role","pid","pgid","auth"}
                    if not exact_keys(request,keys) or request["sequence"]!=sequence+1:
                        raise RuntimeError("guardian registration sequence or shape")
                    role=request.get("role"); pid=request.get("pid"); pgid=request.get("pgid")
                    if role not in ("broker","provider") or not isinstance(pid,int) or pid<=0 or pid!=pgid:
                        raise RuntimeError("guardian registration identity")
                    if role in {item["role"] for item in registrations} or request["nonce"] in {item["nonce"] for item in registrations}:
                        raise RuntimeError("guardian registration replay")
                    try:
                        if os.getpgid(pid)!=pgid or os.getsid(pid)!=pid: raise RuntimeError("guardian registration session")
                        os.kill(pid,0)
                    except ProcessLookupError: raise RuntimeError("guardian registration process absent")
                    request_sha=digest_bytes(canonical(unsigned_request).encode("ascii")); sequence+=1
                    registration={"sequence":sequence,"role":role,"pid":pid,"pgid":pgid,
                                  "nonce":request["nonce"],"request_sha256":request_sha}
                    registrations.append(registration)
                    guardian_send_frame(connection,token,{"schema_version":1,"protocol_version":GUARDIAN_PROTOCOL_VERSION,
                        "status":"REGISTERED","invocation":invocation,"candidate_commit":PAYLOAD_COMMIT,
                        "guardian_pid":os.getpid(),"sequence":sequence,"nonce":request["nonce"],
                        "role":role,"pid":pid,"pgid":pgid,"root_binding":root_binding,
                        "request_sha256":request_sha,"registration_digest":guardian_registration_digest(registrations)})
                elif kind=="cleanup":
                    keys=common|{"registration_digest","expected_roles","auth"}
                    roles=request.get("expected_roles")
                    if (not exact_keys(request,keys) or request["sequence"]!=sequence+1
                            or not isinstance(roles,list) or roles!=sorted(set(roles))
                            or any(role not in ("broker","provider") for role in roles)
                            or roles!=sorted(item["role"] for item in registrations)
                            or request.get("registration_digest")!=guardian_registration_digest(registrations)):
                        raise RuntimeError("guardian cleanup sequence, registration, or shape")
                    sequence+=1; state="CLEANUP_ACCEPTED"
                    accepted={"sequence":sequence,"nonce":request["nonce"],
                              "request_sha256":digest_bytes(canonical(unsigned_request).encode("ascii")),
                              "registration_digest":request["registration_digest"]}
                    cleanup_connection=connection; connection=None
                    listener.close(); listener=None
                else: raise RuntimeError("guardian request kind")
            except BaseException as exc:
                if connection is not None:
                    try: guardian_send_frame(connection,token,{"schema_version":1,"protocol_version":GUARDIAN_PROTOCOL_VERSION,
                        "status":"TERMINAL_BLOCK","invocation":invocation,"candidate_commit":PAYLOAD_COMMIT,
                        "guardian_pid":os.getpid(),"state":"TERMINAL_BLOCK","reason":str(exc)[:1000]})
                    except Exception: pass
                raise
            finally:
                if connection is not None: connection.close()
        state="QUIESCING"; quiescence=terminate_groups(registrations)
        quiescence_digest=digest_bytes(canonical(quiescence).encode("ascii"))
        state="DELETING"
        deletion,root_fd,control_fd=guardian_delete_root(parent_fd,root,root_fd,root_id,control_fd,
                                                         socket_path,socket_id,listener,barrier)
        listener=None; state="PROVING_ABSENT"
        terminal={"schema_version":1,"protocol_version":GUARDIAN_PROTOCOL_VERSION,"kind":"terminal",
                  "status":"TERMINAL_OK","invocation":invocation,"candidate_commit":PAYLOAD_COMMIT,
                  "guardian_pid":os.getpid(),"terminal_sequence":sequence+1,"request_sequence":accepted["sequence"],
                  "request_nonce":accepted["nonce"],"request_sha256":accepted["request_sha256"],
                  "root_identity":root_id,"root_binding":root_binding,
                  "registration_digest":accepted["registration_digest"],"quiescence_digest":quiescence_digest,
                  "deletion":deletion,"absent":True}
        state="TERMINAL_OK"; guardian_send_frame(cleanup_connection,token,terminal); cleanup_connection.close(); cleanup_connection=None
    except BaseException as exc:
        state="TERMINAL_BLOCK"
        failure_reason="%s: %s"%(type(exc).__name__,exc)
        if listener is not None:
            try: listener.close()
            except Exception: pass
            listener=None
        if cleanup_connection is not None:
            try: guardian_send_frame(cleanup_connection,token,{"schema_version":1,"protocol_version":GUARDIAN_PROTOCOL_VERSION,
                "status":"TERMINAL_BLOCK","invocation":invocation,"candidate_commit":PAYLOAD_COMMIT,
                "guardian_pid":os.getpid(),"state":state,"reason":str(exc)[:1000],
                "request_sequence":accepted.get("sequence") if accepted else None,
                "request_sha256":accepted.get("request_sha256") if accepted else None})
            except Exception: pass
        # A fault before cleanup acceptance can never become success, but the guardian still owns
        # lifecycle cleanup.  Quiesce every authenticated group and remove only the still-pinned
        # root.  If quiescence or identity proof fails, retain the root and make that failure loud.
        if accepted is None and root_fd is not None and control_fd is not None:
            try:
                quiescence=terminate_groups(registrations)
                _,root_fd,control_fd=guardian_delete_root(parent_fd,root,root_fd,root_id,control_fd,
                                                           socket_path,socket_id,None,barrier)
            except Exception as cleanup_exc:
                failure_reason+="; abnormal cleanup failed: %s: %s"%(type(cleanup_exc).__name__,cleanup_exc)
        try:
            if parent_fd is not None and root is not None:
                write_failure_marker(parent_fd,marker_name,token,invocation,root,root_binding or "0"*64,
                                     failure_reason,accepted)
        except Exception: pass
        for descriptor in (ready_fd,):
            if descriptor is not None:
                try: os.close(descriptor)
                except OSError: pass
        if cleanup_connection is not None:
            try: cleanup_connection.close()
            except Exception: pass
        os._exit(1)
    os._exit(0)

def guardian_start(ns):
    parent=Path(ns.parent).resolve(); pst=os.lstat(str(parent))
    if not stat.S_ISDIR(pst.st_mode) or stat.S_ISLNK(pst.st_mode): fail("guardian parent")
    if str(parent)!="/private/tmp": fail("guardian parent")
    if ns.launcher_pid<=0:
        fail("guardian launcher pid")
    try: os.kill(ns.launcher_pid,0)
    except ProcessLookupError: fail("guardian launcher not live")
    invocation=ns.invocation or secrets.token_hex(24); token=secrets.token_hex(32)
    barrier={"enabled":False}
    if ns.test_barrier_root or ns.test_barrier_token or ns.test_barrier_phase:
        if not (ns.test_barrier_root and ns.test_barrier_token and ns.test_barrier_phase in TEST_BARRIER_PHASES): fail("guardian test barrier")
        root=Path(ns.test_barrier_root).resolve(); owned_directory(root)
        if not re.fullmatch(r"[0-9a-f]{64}",ns.test_barrier_token): fail("guardian test barrier token")
        barrier={"enabled":True,"root":str(root),"token":ns.test_barrier_token,"phase":ns.test_barrier_phase,"invocation":invocation}
    left,right=socket.socketpair(); pid=os.fork()
    if pid==0:
        left.close(); os.setsid()
        # The bootstrap parent alone publishes readiness.  The independent child must not retain the
        # launcher's command-substitution pipe (or any future provider-visible inherited descriptor),
        # and closing descriptors performs no filesystem allocation before the guardian's mkdtemp.
        for descriptor in (0,1,2):
            try: os.close(descriptor)
            except OSError: pass
        guardian_daemon(right.detach(),str(parent),ns.launcher_pid,invocation,token,barrier)
    right.close(); data=b""; deadline=time.monotonic()+10
    while time.monotonic()<deadline and b"\n" not in data:
        left.settimeout(max(0.01,deadline-time.monotonic()))
        try: data+=left.recv(MAX_MESSAGE-len(data))
        except socket.timeout: break
    left.close()
    try: receipt=json.loads(data.decode("ascii")); auth=receipt.pop("auth")
    except Exception: fail("guardian readiness")
    if (not hmac.compare_digest(auth,guardian_auth(token,receipt)) or receipt.get("guardian_pid")!=pid
            or receipt.get("status")!="ready" or receipt.get("protocol_version")!=GUARDIAN_PROTOCOL_VERSION
            or receipt.get("candidate_commit")!=PAYLOAD_COMMIT): fail("guardian readiness binding")
    receipt["auth"]=auth; receipt["token"]=token; receipt["test_barrier"]=barrier
    print(canonical(receipt))

def guardian_request_base(control, invocation, sequence, guardian_pid, nonce=None):
    try: root_id=identity(os.lstat(str(Path(control).parent)))
    except OSError: fail("guardian root unavailable")
    return {"schema_version":1,"protocol_version":GUARDIAN_PROTOCOL_VERSION,"invocation":invocation,
            "candidate_commit":PAYLOAD_COMMIT,"sequence":sequence,"nonce":nonce or secrets.token_hex(32),
            "guardian_pid":guardian_pid,"root_binding":guardian_root_binding(root_id)}

def guardian_command(ns):
    base=guardian_request_base(ns.control,ns.invocation,ns.sequence,ns.guardian_pid,ns.nonce)
    if ns.action=="register":
        if ns.pid is None or ns.pgid is None or ns.role is None: fail("guardian registration")
        base.update({"kind":"register","role":ns.role,"pid":ns.pid,"pgid":ns.pgid})
        response=guardian_client_request(ns.control,ns.token,base)
        if response.get("status")!="REGISTERED": fail("guardian registration NACK")
        print(canonical(response)); return
    status_base=guardian_request_base(ns.control,ns.invocation,ns.sequence,ns.guardian_pid)
    status_base["kind"]="status"
    status=guardian_client_request(ns.control,ns.token,status_base)
    status_value,_=guardian_verify_response(ns.token,status)
    expected_status={"schema_version","protocol_version","status","invocation","candidate_commit","guardian_pid",
                     "state","next_sequence","request_nonce","root_binding","registration_digest","registered_roles"}
    roles=sorted(set(filter(None,(ns.expected_roles or "").split(","))))
    if (not exact_keys(status_value,expected_status) or status_value.get("status")!="STATE"
            or status_value.get("next_sequence")!=ns.sequence or status_value.get("request_nonce")!=status_base["nonce"]
            or status_value.get("schema_version")!=1 or status_value.get("protocol_version")!=GUARDIAN_PROTOCOL_VERSION
            or status_value.get("invocation")!=ns.invocation or status_value.get("candidate_commit")!=PAYLOAD_COMMIT
            or status_value.get("guardian_pid")!=ns.guardian_pid or status_value.get("root_binding")!=base["root_binding"]
            or not isinstance(status_value.get("registered_roles"),list)
            or status_value["registered_roles"]!=sorted(set(status_value["registered_roles"]))
            or any(role not in ("broker","provider") for role in status_value["registered_roles"])
            or not re.fullmatch(r"[0-9a-f]{64}",str(status_value.get("registration_digest","")))):
        fail("guardian status binding")
    base.update({"kind":"cleanup","registration_digest":status_value["registration_digest"],
                 "expected_roles":roles})
    terminal=guardian_client_request(ns.control,ns.token,base,10)
    terminal_value,_=guardian_verify_response(ns.token,terminal)
    required={"schema_version","protocol_version","kind","status","invocation","candidate_commit","guardian_pid",
              "terminal_sequence","request_sequence","request_nonce","request_sha256","root_identity","root_binding",
              "registration_digest","quiescence_digest","deletion","absent"}
    request_unsigned=dict(base); request_sha=digest_bytes(canonical(request_unsigned).encode("ascii"))
    if (not exact_keys(terminal_value,required) or terminal_value.get("kind")!="terminal"
            or terminal_value.get("schema_version")!=1 or terminal_value.get("protocol_version")!=GUARDIAN_PROTOCOL_VERSION
            or terminal_value.get("status")!="TERMINAL_OK" or terminal_value.get("invocation")!=ns.invocation
            or terminal_value.get("candidate_commit")!=PAYLOAD_COMMIT or terminal_value.get("guardian_pid")!=ns.guardian_pid
            or terminal_value.get("terminal_sequence")!=ns.sequence+1
            or terminal_value.get("request_sequence")!=ns.sequence or terminal_value.get("request_nonce")!=base["nonce"]
            or terminal_value.get("request_sha256")!=request_sha or terminal_value.get("root_binding")!=base["root_binding"]
            or guardian_root_binding(terminal_value.get("root_identity",{}))!=base["root_binding"]
            or terminal_value.get("registration_digest")!=status_value["registration_digest"]
            or not re.fullmatch(r"[0-9a-f]{64}",str(terminal_value.get("quiescence_digest","")))
            or terminal_value.get("absent") is not True
            or terminal_value.get("deletion")!={"removed":True,"absent":True,"method":"parent_fd_relative"}):
        fail("guardian terminal receipt binding")
    deadline=time.monotonic()+5
    while time.monotonic()<deadline:
        try: os.kill(ns.guardian_pid,0)
        except ProcessLookupError: break
        time.sleep(0.01)
    else: fail("guardian terminal exit timeout")
    marker=Path("/private/tmp")/("firm-eval-block-"+ns.invocation+".json")
    if marker.exists(): fail("guardian cleanup BLOCK marker: "+str(marker))
    print(canonical(terminal))

def guardian_exec(ns, rest):
    if not rest: fail("guardian exec argv")
    pid=os.getpid(); pgid=os.getpgrp()
    if (pid!=pgid or os.getsid(pid)!=pid) and ns.role=="broker":
        os.setsid(); pid=os.getpid(); pgid=os.getpgrp()
    if pid!=pgid or os.getsid(pid)!=pid: fail("guardian exec requires bounded child session leader")
    base=guardian_request_base(ns.control,ns.invocation,ns.sequence,ns.guardian_pid,ns.nonce)
    base.update({"kind":"register","role":ns.role,"pid":pid,"pgid":pgid})
    response=guardian_client_request(ns.control,ns.token,base)
    value,_=guardian_verify_response(ns.token,response)
    required={"schema_version","protocol_version","status","invocation","candidate_commit","guardian_pid","sequence",
              "nonce","role","pid","pgid","root_binding","request_sha256","registration_digest"}
    request_sha=digest_bytes(canonical(base).encode("ascii"))
    if (not exact_keys(value,required) or value.get("status")!="REGISTERED" or value.get("sequence")!=ns.sequence
            or value.get("schema_version")!=1 or value.get("protocol_version")!=GUARDIAN_PROTOCOL_VERSION
            or value.get("invocation")!=ns.invocation or value.get("candidate_commit")!=PAYLOAD_COMMIT
            or value.get("guardian_pid")!=ns.guardian_pid
            or value.get("nonce")!=base["nonce"] or value.get("role")!=ns.role or value.get("pid")!=pid
            or value.get("pgid")!=pgid or value.get("request_sha256")!=request_sha
            or value.get("root_binding")!=base["root_binding"]):
        fail("guardian registration ACK binding")
    os.execv(rest[0],rest)

def external_file_record(path, maximum=64*1024*1024):
    path=Path(path)
    if path.resolve()!=path or not path.is_absolute(): fail("external executable path")
    no_symlink_components(path)
    fd=os.open(str(path),os.O_RDONLY|getattr(os,"O_NOFOLLOW",0))
    try:
        before=os.fstat(fd)
        if not stat.S_ISREG(before.st_mode) or before.st_nlink!=1 or before.st_size>maximum:
            fail("external executable identity")
        raw=b""
        while len(raw)<=maximum:
            part=os.read(fd,65536)
            if not part: break
            raw+=part
        after=os.fstat(fd)
        if identity(before)!=identity(after) or len(raw)!=before.st_size: fail("external executable drift")
    finally: os.close(fd)
    return {**identity(before),"sha256":digest_bytes(raw),"path":str(path)}

def find_probe_file(real_common):
    for current,dirs,files in os.walk(str(real_common),topdown=True,followlinks=False):
        dirs.sort(); files.sort()
        for name in files:
            path=Path(current)/name; st=os.lstat(str(path))
            if (stat.S_ISREG(st.st_mode) and st.st_nlink==1 and st.st_uid==os.getuid()
                    and st.st_mode&stat.S_IRUSR and st.st_mode&stat.S_IWUSR):
                return path
    fail("no safe real-common probe file")

def run_seatbelt_probe(seatbelt, capsule):
    profile=Path(seatbelt["profile"]["path"]); real_common=Path(seatbelt["real_common"])
    alias=Path(seatbelt["alias"]); probe=Path(seatbelt["probe_file"]); sentinel=Path(seatbelt["capsule_sentinel"])
    rel=probe.relative_to(real_common); alias_probe=alias/rel
    script=r'''import errno,json,os,sys
real,alias,sentinel=sys.argv[1:]
def denied(path,flags):
    try:
        fd=os.open(path,flags)
    except OSError as exc:
        return exc.errno in (errno.EACCES,errno.EPERM)
    else:
        os.close(fd); return False
ok={"canonical_read":denied(real,os.O_RDONLY),
    "canonical_write":denied(real,os.O_WRONLY|getattr(os,"O_NOFOLLOW",0)),
    "alias_read":denied(alias,os.O_RDONLY),
    "alias_write":denied(alias,os.O_WRONLY|getattr(os,"O_NOFOLLOW",0))}
with open(sentinel,"rb") as handle: before=handle.read()
fd=os.open(sentinel,os.O_WRONLY|getattr(os,"O_NOFOLLOW",0)); os.write(fd,b"seatbelt-capsule-ok\n"); os.fsync(fd); os.close(fd)
with open(sentinel,"rb") as handle: after=handle.read()
ok["capsule_read_write"]=before==b"seatbelt-capsule-ok\n" and after==before
print(json.dumps(ok,sort_keys=True,separators=(",",":")))
raise SystemExit(0 if all(ok.values()) else 3)
'''
    done=subprocess.run([seatbelt["wrapper"]["path"],"-D","REAL_COMMON="+str(real_common),"-f",str(profile),
                         sys.executable,"-c",script,str(probe),str(alias_probe),str(sentinel)],
                        stdout=subprocess.PIPE,stderr=subprocess.PIPE,close_fds=True,timeout=10)
    if done.returncode!=0: fail("Seatbelt denial self-probe")
    try: result=json.loads(done.stdout.decode("ascii"))
    except Exception: fail("Seatbelt probe result")
    expected={"canonical_read":True,"canonical_write":True,"alias_read":True,"alias_write":True,"capsule_read_write":True}
    if result!=expected: fail("Seatbelt probe incomplete")
    return {"result":result,"stdout_sha256":digest_bytes(done.stdout),"profile_sha256":seatbelt["profile"]["sha256"],
            "wrapper_sha256":seatbelt["wrapper"]["sha256"],"monotonic_ns":time.monotonic_ns()}

def prepare_seatbelt(real_common, capsule_root, control, provider_executable):
    if sys.platform!="darwin" or not SANDBOX_EXEC.exists(): fail("Seatbelt unsupported")
    wrapper=external_file_record(SANDBOX_EXEC)
    provider=external_file_record(Path(provider_executable).resolve())
    profile=control/"provider.sb"; put_file(profile,PROFILE_SOURCE,0o400)
    alias=control/"real-common-alias"; os.symlink(str(real_common),str(alias))
    sentinel=control/"seatbelt-capsule-sentinel"; put_file(sentinel,b"seatbelt-capsule-ok\n",0o600)
    probe=find_probe_file(real_common)
    seatbelt={"profile":{"path":str(profile),**path_record(profile)},"wrapper":wrapper,"provider":provider,
              "real_common":str(real_common),"real_common_identity":path_record(real_common,False),
              "alias":str(alias),"probe_file":str(probe),"probe_file_identity":{"path":str(probe),**path_record(probe)},
              "capsule_sentinel":str(sentinel),"supervisor_argv_prefix":[str(SANDBOX_EXEC),"-D","REAL_COMMON="+str(real_common),"-f",str(profile)]}
    seatbelt["prepare_probe"]=run_seatbelt_probe(seatbelt,{})
    return seatbelt

def validate_seatbelt(doc, post=False):
    seatbelt=doc["seatbelt"]
    if external_file_record(Path(seatbelt["wrapper"]["path"]))!=seatbelt["wrapper"]: fail("Seatbelt wrapper drift")
    if external_file_record(Path(seatbelt["provider"]["path"]))!=seatbelt["provider"]: fail("provider executable drift")
    profile={"path":seatbelt["profile"]["path"],**path_record(Path(seatbelt["profile"]["path"]))}
    if profile!=seatbelt["profile"] or Path(seatbelt["profile"]["path"]).read_bytes()!=PROFILE_SOURCE: fail("Seatbelt profile drift")
    real=Path(seatbelt["real_common"])
    if path_record(real,False)!=seatbelt["real_common_identity"] or tree_inventory(real)!=doc["capsule"]["real_common_before"]:
        fail("real common identity drift")
    alias=Path(seatbelt["alias"])
    if not alias.is_symlink() or Path(os.readlink(str(alias)))!=real: fail("Seatbelt alias drift")
    if {"path":seatbelt["probe_file"],**path_record(Path(seatbelt["probe_file"]))}!=seatbelt["probe_file_identity"]: fail("Seatbelt probe target drift")
    receipt=run_seatbelt_probe(seatbelt,doc["capsule"])
    receipt["phase"]="post" if post else "prelaunch"
    return receipt

def seatbelt_probe(ns):
    doc,raw=load_manifest(ns.manifest)
    if digest_bytes(raw)!=ns.digest or doc["invocation"]!=ns.invocation: fail("Seatbelt invocation binding")
    receipt=validate_seatbelt(doc,ns.post)
    print(canonical(receipt))

def test_barrier_probe(ns):
    root=Path(ns.root).resolve(); owned_directory(root)
    target=Path(ns.target).resolve()
    if target.parent!=root or not re.fullmatch(r"[0-9a-f]{64}",ns.token) or not re.fullmatch(r"[0-9a-f]{48}",ns.invocation):
        fail("test barrier probe binding")
    if ns.phase not in TEST_BARRIER_PHASES or not re.fullmatch(r"[0-9a-f]{40}",ns.candidate): fail("test barrier probe scope")
    before_raw,before_st=read_bytes(target,MAX_MESSAGE)
    before={"candidate":ns.candidate,"identity":identity(before_st),"sha256":digest_bytes(before_raw)}
    config={"enabled":True,"root":str(root),"token":ns.token,"phase":ns.phase,"invocation":ns.invocation}
    raw_test_barrier(config,ns.phase,before)
    try: after_raw,after_st=read_bytes(target,MAX_MESSAGE)
    except BaseException: fail("concurrent "+ns.phase+" mutation detected")
    after={"identity":identity(after_st),"sha256":digest_bytes(after_raw)}
    if after["identity"]!=before["identity"] or after["sha256"]!=before["sha256"]:
        fail("concurrent "+ns.phase+" mutation detected")
    fail("test barrier mutation not detected")

def object_closure(root, commit):
    names=git(root,"rev-list","--objects","--no-object-names",commit).splitlines()
    if not names or len(names)!=len(set(names)) or any(not re.fullmatch(r"[0-9a-f]{40}",x) for x in names):
        fail("noncanonical object closure")
    proc=subprocess.Popen([GIT,"-C",str(root),"cat-file","--batch"],stdin=subprocess.PIPE,
                          stdout=subprocess.PIPE,stderr=subprocess.PIPE,
                          env={**SAFE_GIT_ENV,"PATH":"/usr/bin:/bin:/usr/sbin:/sbin","LC_ALL":"C"})
    out,err=proc.communicate(("\n".join(names)+"\n").encode("ascii"))
    if proc.returncode: fail("cannot read payload object closure")
    cursor=0; rows=[]
    for expected in names:
        end=out.find(b"\n",cursor)
        if end<0: fail("truncated object closure")
        header=out[cursor:end].decode("ascii").split(); cursor=end+1
        if len(header)!=3 or header[0]!=expected or header[1] not in ("blob","tree","commit","tag"):
            fail("object closure header")
        size=int(header[2]); body=out[cursor:cursor+size]; cursor+=size
        if len(body)!=size or out[cursor:cursor+1]!=b"\n": fail("object closure framing")
        cursor+=1; rows.append({"oid":expected,"type":header[1],"size":size,
                               "sha256":digest_bytes(body)})
    if cursor!=len(out): fail("extra object closure bytes")
    return rows

def copy_fixture(src, dst):
    src=Path(src); dst=Path(dst); no_symlink_components(src)
    for current,dirs,files in os.walk(str(src),topdown=True,followlinks=False):
        dirs.sort(); files.sort(); rel=Path(current).relative_to(src)
        for name in dirs:
            source=Path(current)/name; st=os.lstat(str(source))
            if not stat.S_ISDIR(st.st_mode) or stat.S_ISLNK(st.st_mode): fail("unsafe fixture directory")
            target=dst/rel/name
            if target.exists() or target.is_symlink(): fail("fixture collision")
            target.mkdir(mode=stat.S_IMODE(st.st_mode)&0o755)
        for name in files:
            source=Path(current)/name; st=os.lstat(str(source)); target=dst/rel/name
            if not stat.S_ISREG(st.st_mode) or stat.S_ISLNK(st.st_mode) or st.st_nlink!=1:
                fail("unsafe fixture file")
            if target.exists() or target.is_symlink(): fail("fixture collision")
            if hasattr(os,"listxattr") and os.listxattr(str(source)): fail("fixture xattr")
            raw,_=read_bytes(source,16*1024*1024); put_file(target,raw,stat.S_IMODE(st.st_mode)&0o755)

def isolated_git(cwd, args, data=None, extra=None):
    env={"PATH":"/usr/bin:/bin:/usr/sbin:/sbin","LC_ALL":"C"}; env.update(SAFE_GIT_ENV)
    if extra: env.update(extra)
    done=subprocess.run([GIT,"-C",str(cwd)]+list(args),input=data,stdout=subprocess.PIPE,
                        stderr=subprocess.PIPE,env=env)
    if done.returncode:
        detail=done.stderr.decode("utf-8","replace").strip().replace("\n"," ")[:500]
        fail("contained git command failed (%s): %s"%(" ".join(args[:4]),detail))
    return done.stdout

def build_capsule(root, scratch, fixture):
    if (scratch/".git").exists() or (scratch/"project").exists() or (scratch/"git-common").exists():
        fail("capsule must begin outside a repository")
    real_common=Path(git(root,"rev-parse","--path-format=absolute","--git-common-dir"))
    no_symlink_components(real_common); before=tree_inventory(real_common)
    chain=[git(root,"rev-parse",x) for x in (PATCH_BASE,PATCH_COMMIT,PAYLOAD_COMMIT)]
    if chain!=[PATCH_BASE,PATCH_COMMIT,PAYLOAD_COMMIT] or git(root,"show","-s","--format=%P",PATCH_COMMIT)!=PATCH_BASE or git(root,"show","-s","--format=%P",PAYLOAD_COMMIT)!=PATCH_COMMIT:
        fail("payload parent chain")
    payload_tree=git(root,"rev-parse",PAYLOAD_COMMIT+"^{tree}")
    closure=object_closure(root,PAYLOAD_COMMIT)
    project=scratch/"project"; common=scratch/"git-common"; hooks=scratch/"no-hooks"
    project.mkdir(mode=0o700); common.mkdir(mode=0o700); hooks.mkdir(mode=0o500)
    for rel in ("objects","objects/pack","objects/info","refs","refs/heads","refs/firm-eval","info","worktrees"):
        (common/rel).mkdir(mode=0o700)
    config=("[core]\n\trepositoryformatversion = 0\n\tfilemode = true\n\tbare = false\n"
            "\tlogallrefupdates = true\n\tworktree = %s\n\thooksPath = %s\n"
            "[gc]\n\tauto = 0\n[maintenance]\n\tauto = false\n"%(project,hooks)).encode("utf-8")
    put_file(common/"config",config,0o400)
    put_file(common/"HEAD",b"ref: refs/heads/main\n",0o600)
    pack=isolated_git(root,["pack-objects","--revs","--stdout"],(PAYLOAD_COMMIT+"\n").encode("ascii"))
    env={"GIT_OBJECT_DIRECTORY":str(common/"objects")}
    isolated_git(root,["--git-dir",str(common),"index-pack","--stdin","--fix-thin"],pack,env)
    pack_files=[]
    for path in sorted((common/"objects/pack").iterdir()):
        if path.suffix not in (".pack",".idx",".rev") or path.is_symlink():
            fail("unexpected initial pack: "+path.name)
        os.chmod(str(path),0o400); item={"path":str(path.relative_to(scratch))}; item.update(path_record(path)); pack_files.append(item)
    if len(pack_files) not in (2,3): fail("protected pack shape")
    put_file(common/"refs/heads/main",(PAYLOAD_COMMIT+"\n").encode("ascii"),0o600)
    put_file(common/"refs/firm-eval/candidate",(PAYLOAD_COMMIT+"\n").encode("ascii"),0o400)
    put_file(common/"refs/firm-eval/base",(PATCH_BASE+"\n").encode("ascii"),0o400)
    gitfile=("gitdir: %s\n"%common).encode("utf-8"); put_file(project/".git",gitfile,0o400)
    isolated_git(project,["reset","--hard",PAYLOAD_COMMIT])
    if git(project,"rev-parse","HEAD")!=PAYLOAD_COMMIT or git(project,"rev-parse","HEAD^{tree}")!=payload_tree:
        fail("payload checkout identity")
    # The launcher-owned authority is the one intentional harness overlay.  Candidate tools remain
    # byte-exact a57 payload files; the a57 writer requires its authority at TOOL_ROOT/bin, so the
    # manifest classifies and protects this path as harness identity rather than relabelling it.
    authority_raw,_=read_bytes(SELF)
    os.unlink(str(project/"bin/firm-eval-authority"))
    put_file(project/"bin/firm-eval-authority",authority_raw,0o500)
    copy_fixture(fixture,project)
    isolated_git(project,["add","-A"])
    fixed={"GIT_AUTHOR_NAME":"Firm Eval","GIT_AUTHOR_EMAIL":"eval@firm.invalid",
           "GIT_COMMITTER_NAME":"Firm Eval","GIT_COMMITTER_EMAIL":"eval@firm.invalid",
           "GIT_AUTHOR_DATE":"2000-01-01T00:00:00Z","GIT_COMMITTER_DATE":"2000-01-01T00:00:00Z"}
    isolated_git(project,["commit","-m","fixture"],extra=fixed)
    fixture_tip=git(project,"rev-parse","HEAD"); fixture_tree=git(project,"rev-parse","HEAD^{tree}")
    if git(project,"status","--porcelain","--untracked-files=all"): fail("dirty fixture tip")
    present=set(git(project,"cat-file","--batch-all-objects","--batch-check=%(objectname)").splitlines())
    if not set(row["oid"] for row in closure).issubset(present): fail("payload object omission")
    if tree_inventory(real_common)!=before: fail("real common changed during materialization")
    protected={"gitfile":{"path":"project/.git",**path_record(project/".git")},
               "config":{"path":"git-common/config",**path_record(common/"config")},
               "candidate_ref":{"path":"git-common/refs/firm-eval/candidate",**path_record(common/"refs/firm-eval/candidate")},
               "base_ref":{"path":"git-common/refs/firm-eval/base",**path_record(common/"refs/firm-eval/base")},
               "harness_authority":{"path":"project/bin/firm-eval-authority",**path_record(project/"bin/firm-eval-authority")},
               "packs":pack_files}
    return {"project":str(project),"common":str(common),"hooks":str(hooks),
            "root_identity":path_record(scratch,False),"project_identity":path_record(project,False),
            "common_identity":path_record(common,False),"objects_identity":path_record(common/"objects",False),
            "hooks_identity":path_record(hooks,False),
            "payload_tree":payload_tree,"closure":closure,"fixture_tip":fixture_tip,
            "fixture_tree":fixture_tree,"protected":protected,
            "real_root":str(root),"real_common":str(real_common),"real_common_before":before}

def validate_capsule(doc, final=False):
    cap=doc["capsule"]; root=Path(doc["scratch_root"]); project=Path(cap["project"]); common=Path(cap["common"])
    for path,key in ((root,"root_identity"),(project,"project_identity"),(common,"common_identity"),(common/"objects","objects_identity"),(Path(cap["hooks"]),"hooks_identity")):
        actual=path_record(path,False); expected=cap[key]
        if path.resolve()!=path or any(actual[name]!=expected[name] for name in ("dev","ino","uid","mode")):
            fail("capsule directory identity")
        if os.path.commonpath((str(root),str(path)))!=str(root): fail("capsule containment")
    if (root/".git").exists() or (root/".git").is_symlink(): fail("outer capsule became repository")
    for item in [cap["protected"]["gitfile"],cap["protected"]["config"],cap["protected"]["candidate_ref"],cap["protected"]["base_ref"],cap["protected"]["harness_authority"]]+cap["protected"]["packs"]:
        path=root/item["path"]
        if path_record(path)!={k:v for k,v in item.items() if k!="path"}: fail("protected capsule bytes changed")
    if (project/".git").read_bytes() != ("gitdir: %s\n"%common).encode(): fail("gitfile escape")
    resolved=[git(project,"rev-parse","--show-toplevel"),git(project,"rev-parse","--path-format=absolute","--git-dir"),git(project,"rev-parse","--path-format=absolute","--git-common-dir"),git(project,"rev-parse","--path-format=absolute","--git-path","objects")]
    if resolved != [str(project),str(common),str(common),str(common/"objects")]: fail("resolved git path escape")
    if git(project,"rev-parse","refs/firm-eval/candidate")!=PAYLOAD_COMMIT or git(project,"rev-parse","refs/firm-eval/base")!=PATCH_BASE:
        fail("anchor ref changed")
    for forbidden in (common/"objects/info/alternates",common/"info/grafts",common/"shallow",common/"packed-refs"):
        if forbidden.exists() or forbidden.is_symlink(): fail("forbidden git indirection")
    if any((common/"refs/replace").glob("*")) if (common/"refs/replace").exists() else False: fail("replace ref")
    if list(Path(cap["hooks"]).iterdir()): fail("hook appeared")
    config=(common/"config").read_text("utf-8")
    for token in ("remote \"","include","promisor","partialclonefilter","submodule","credential","filter \""):
        if token.lower() in config.lower(): fail("unsafe repository config")
    for current,dirs,files in os.walk(str(common),topdown=True,followlinks=False):
        for name in dirs+files:
            path=Path(current)/name; st=os.lstat(str(path))
            if stat.S_ISLNK(st.st_mode) or (stat.S_ISREG(st.st_mode) and st.st_nlink!=1): fail("git metadata link escape")
            if os.path.commonpath((str(root),str(path.resolve())))!=str(root): fail("git metadata path escape")
    for path in (common/"worktrees").glob("*"):
        if not path.is_dir() or path.is_symlink(): fail("worktree administration shape")
        gitdir=(path/"gitdir").read_text("utf-8").strip(); commondir=(path/"commondir").read_text("utf-8").strip()
        if Path(gitdir).resolve().name!=".git" or os.path.commonpath((str(root),str(Path(gitdir).resolve())))!=str(root): fail("linked worktree gitfile escape")
        if (path/commondir).resolve()!=common: fail("linked worktree common-dir escape")
    if tree_inventory(Path(cap["real_common"]))!=cap["real_common_before"]: fail("real repository changed")

def reject_git_environment():
    denied={"GIT_DIR","GIT_WORK_TREE","GIT_COMMON_DIR","GIT_OBJECT_DIRECTORY",
            "GIT_ALTERNATE_OBJECT_DIRECTORIES","GIT_REPLACE_REF_BASE","GIT_NAMESPACE",
            "GIT_INDEX_FILE","GIT_SHALLOW_FILE","GIT_CEILING_DIRECTORIES","GIT_DISCOVERY_ACROSS_FILESYSTEM",
            "GIT_CONFIG_PARAMETERS","GIT_TEMPLATE_DIR","GIT_EXEC_PATH","GIT_SSH","GIT_SSH_COMMAND",
            "GIT_ASKPASS","GIT_PROTOCOL"}
    for key,value in os.environ.items():
        if key in SAFE_GIT_ENV and SAFE_GIT_ENV[key]!=value:
            fail("unsafe Git environment")
        if key in denied or key.startswith("GIT_CONFIG_KEY_") or key.startswith("GIT_CONFIG_VALUE_"):
            fail("unsafe Git environment")

def exact_keys(value, keys):
    return isinstance(value, dict) and set(value) == set(keys)

def validate_tool(tool, root):
    keys = {"name","path","dev","ino","uid","mode","nlink","bytes","sha256"}
    if not exact_keys(tool, keys): fail("tool schema")
    path = Path(tool["path"])
    if path.parent != root / "bin" or path.name != tool["name"] or path.resolve() != path:
        fail("tool path escape")
    no_symlink_components(path)
    raw, st = read_bytes(path)
    if identity(st) != {key: tool[key] for key in ("dev","ino","uid","mode","nlink","bytes")}:
        fail("tool identity changed")
    if st.st_nlink != 1 or not (st.st_mode & stat.S_IXUSR) or digest_bytes(raw) != tool["sha256"]:
        fail("tool bytes or mode changed")
    return raw, st

def load_manifest(path):
    manifest_path=Path(path); fd=os.open(str(manifest_path),os.O_RDONLY|getattr(os,"O_NOFOLLOW",0))
    try:
        st=os.fstat(fd)
        if (not stat.S_ISREG(st.st_mode) or st.st_uid!=os.getuid() or st.st_nlink!=1
                or st.st_size>4*1024*1024 or stat.S_IMODE(st.st_mode)!=0o600): fail("manifest mode")
        raw=b""
        while True:
            part=os.read(fd,65536)
            if not part: break
            raw+=part
            if len(raw)>4*1024*1024: fail("oversized manifest")
        try: doc=json.loads(raw.decode("utf-8","strict"))
        except Exception: fail("manifest JSON")
        if not isinstance(doc,dict): fail("manifest JSON")
        test_barrier(doc,"manifest_read",identity(st))
        os.lseek(fd,0,os.SEEK_SET); second=b""
        while True:
            part=os.read(fd,65536)
            if not part: break
            second+=part
        after=os.fstat(fd); named=os.lstat(str(manifest_path))
        if raw!=second or identity(st)!=identity(after) or identity(after)!=identity(named):
            fail("manifest changed across read interval")
    finally: os.close(fd)
    keys = {"schema_version","purpose","invocation","eval","provider","harness_root",
            "harness_commit","harness_tree","candidate_root","candidate_commit","candidate_tree",
            "patch_base","patch_commit","patch_bytes","patch_sha256","scratch_root","scratch_dev",
            "scratch_ino","request_root","response_root","runner","tools","capsule","guardian",
            "seatbelt","test_barrier"}
    if not exact_keys(doc, keys) or doc["schema_version"] != 3 or doc["purpose"] != "disposable_git_candidate_eval":
        fail("manifest schema")
    root = Path(doc["candidate_root"])
    if root.resolve() != root: fail("candidate root")
    if doc["patch_base"] != PATCH_BASE or doc["patch_bytes"] != PATCH_BYTES or doc["patch_sha256"] != PATCH_SHA256:
        fail("patch binding")
    if doc["provider"] not in ("claude","codex") or doc["eval"] != "final-evidence-seal": fail("scope")
    request_root, response_root = Path(doc["request_root"]), Path(doc["response_root"])
    scratch = Path(doc["scratch_root"])
    if os.path.commonpath((str(scratch),str(request_root))) != str(scratch): fail("request root")
    if response_root.parent != Path(path).resolve().parent: fail("response root")
    for directory in (request_root,response_root):
        dst=os.lstat(str(directory))
        if not stat.S_ISDIR(dst.st_mode) or dst.st_uid!=os.getuid() or stat.S_IMODE(dst.st_mode)!=0o700: fail("transport root")
    if not isinstance(doc["tools"], list) or not doc["tools"]: fail("empty tools")
    names = [item.get("name") for item in doc["tools"] if isinstance(item, dict)]
    if len(names) != len(doc["tools"]) or len(names) != len(set(names)): fail("duplicate tools")
    for tool in doc["tools"]: validate_tool(tool, root)
    barrier=doc["test_barrier"]
    if barrier.get("enabled"):
        required={"enabled","root","token","phase","invocation"}
        if (not exact_keys(barrier,required) or barrier["enabled"] is not True or barrier["invocation"]!=doc["invocation"]
                or barrier["phase"] not in TEST_BARRIER_PHASES or not re.fullmatch(r"[0-9a-f]{64}",barrier["token"])): fail("test barrier manifest")
    elif barrier!={"enabled":False}: fail("test barrier manifest")
    guardian=doc["guardian"]
    if (not exact_keys(guardian,{"protocol_version","candidate_commit","pid","root","root_identity","root_binding",
                                "control","socket","socket_identity","token_sha256","failure_marker"})
            or guardian["protocol_version"]!=GUARDIAN_PROTOCOL_VERSION or guardian["candidate_commit"]!=PAYLOAD_COMMIT
            or guardian["pid"]<=0 or Path(guardian["root"]).resolve()!=Path(doc["scratch_root"]).parent
            or Path(guardian["control"]).resolve()!=Path(path).resolve().parent
            or Path(guardian["socket"])!=Path(guardian["control"])/GUARDIAN_SOCKET_NAME
            or guardian["root_binding"]!=guardian_root_binding(guardian["root_identity"])
            or not re.fullmatch(r"[0-9a-f]{64}",guardian["token_sha256"])): fail("guardian manifest")
    try: os.kill(guardian["pid"],0)
    except ProcessLookupError: fail("guardian dead")
    return doc, raw

def prepare(ns):
    root = Path(ns.root).resolve(); scratch = Path(ns.scratch).resolve()
    fixture = Path(ns.fixture).resolve()
    manifest = Path(ns.manifest); shims = Path(ns.shims)
    request_root = Path(ns.request_root).resolve(); response_root = Path(ns.response_root).resolve()
    guardian_root=Path(ns.guardian_root).resolve(); control=manifest.resolve().parent
    if scratch.parent!=guardian_root or control.parent!=guardian_root or scratch.name!="capsule" or control.name!="control":
        fail("guardian containment")
    root_st=owned_directory(guardian_root); owned_directory(scratch); owned_directory(control)
    if not re.fullmatch(r"[0-9a-f]{64}",ns.guardian_token) or ns.guardian_pid<=0: fail("guardian binding")
    try: os.kill(ns.guardian_pid,0)
    except ProcessLookupError: fail("guardian not live")
    invocation=ns.invocation
    if not re.fullmatch(r"[0-9a-f]{48}",invocation): fail("invocation binding")
    test_barrier_doc={"enabled":False}
    barrier_env=("FIRM_EVAL_TEST_BARRIER_ROOT","FIRM_EVAL_TEST_BARRIER_TOKEN",
                 "FIRM_EVAL_TEST_BARRIER_INVOCATION","FIRM_EVAL_TEST_BARRIER_PHASE")
    if any(os.environ.get(key) is not None for key in barrier_env) and not (ns.test_barrier_root and ns.test_barrier_token and ns.test_barrier_phase):
        fail("inherited test barrier environment")
    if ns.test_barrier_root or ns.test_barrier_token or ns.test_barrier_phase:
        if not (ns.test_barrier_root and ns.test_barrier_token and ns.test_barrier_phase in TEST_BARRIER_PHASES): fail("test barrier arguments")
        barrier_root=Path(ns.test_barrier_root).resolve(); owned_directory(barrier_root)
        if not re.fullmatch(r"[0-9a-f]{64}",ns.test_barrier_token): fail("test barrier token")
        test_barrier_doc={"enabled":True,"root":str(barrier_root),"token":ns.test_barrier_token,
                          "phase":ns.test_barrier_phase,"invocation":invocation}
    no_symlink_components(root); no_symlink_components(scratch)
    if git(root, "rev-parse", "--show-toplevel") != str(root): fail("repository root")
    if git(root, "status", "--porcelain", "--untracked-files=all"): fail("dirty harness")
    head = git(root, "rev-parse", "HEAD"); tree = git(root, "rev-parse", "HEAD^{tree}")
    patch_commit = prove_patch(root, PAYLOAD_COMMIT)
    scratch_st = os.lstat(str(scratch))
    if not stat.S_ISDIR(scratch_st.st_mode) or scratch_st.st_uid != os.getuid() or stat.S_IMODE(scratch_st.st_mode) & 0o022:
        fail("unsafe scratch")
    capsule = build_capsule(root,scratch,fixture)
    candidate_root=Path(capsule["project"])
    tools = []
    for path in sorted((candidate_root / "bin").glob("firm-*")):
        if path.name == "firm-eval-authority": continue
        if path.is_symlink() or not path.is_file() or not os.access(str(path), os.X_OK): continue
        raw, st = read_bytes(path)
        if st.st_nlink != 1: fail("hardlinked candidate tool")
        item = {"name":path.name,"path":str(path),"sha256":digest_bytes(raw)}
        item.update(identity(st)); tools.append(item)
    if not any(item["name"] == "firm-ledger-log" for item in tools): fail("writer missing")
    runner_raw,runner_st=read_bytes(SELF.parent/"firm-run-evals")
    runner={"name":"firm-run-evals","path":str(SELF.parent/"firm-run-evals"),"sha256":digest_bytes(runner_raw)}
    runner.update(identity(runner_st))
    guardian_socket=control/GUARDIAN_SOCKET_NAME; socket_st=os.lstat(str(guardian_socket))
    if not stat.S_ISSOCK(socket_st.st_mode): fail("guardian socket")
    guardian={"protocol_version":GUARDIAN_PROTOCOL_VERSION,"candidate_commit":PAYLOAD_COMMIT,
              "pid":ns.guardian_pid,"root":str(guardian_root),"root_identity":identity(root_st),
              "root_binding":guardian_root_binding(identity(root_st)),"control":str(control),
              "socket":str(guardian_socket),"socket_identity":identity(socket_st),
              "token_sha256":digest_bytes(bytes.fromhex(ns.guardian_token)),
              "failure_marker":ns.guardian_failure_marker}
    seatbelt=prepare_seatbelt(Path(capsule["real_common"]),scratch,control,ns.provider_executable)
    doc = {"schema_version":3,"purpose":"disposable_git_candidate_eval","invocation":invocation,
           "eval":ns.eval,"provider":ns.provider,"harness_root":str(root),"harness_commit":head,
           "harness_tree":tree,"candidate_root":str(candidate_root),
           "candidate_commit":PAYLOAD_COMMIT,"candidate_tree":capsule["payload_tree"],"patch_base":PATCH_BASE,
           "patch_commit":patch_commit,"patch_bytes":PATCH_BYTES,"patch_sha256":PATCH_SHA256,
           "scratch_root":str(scratch),"scratch_dev":scratch_st.st_dev,"scratch_ino":scratch_st.st_ino,
           "request_root":str(request_root),"response_root":str(response_root),
           "runner":runner,"tools":tools,"capsule":capsule,"guardian":guardian,"seatbelt":seatbelt,
           "test_barrier":test_barrier_doc}
    raw = (canonical(doc) + "\n").encode("ascii")
    if manifest.resolve().parent!=control: fail("manifest control root")
    fd = os.open(str(manifest), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os,"O_NOFOLLOW",0), 0o600)
    try: os.write(fd, raw); os.fsync(fd)
    finally: os.close(fd)
    request_root.mkdir(mode=0o700); response_root.mkdir(mode=0o700)
    shims.mkdir(mode=0o700)
    shim_body = b'''#!/bin/sh\nset -eu\nexec "$FIRM_EVAL_AUTHORITY_BIN" request-exec --request-root "$FIRM_EVAL_AUTHORITY_REQUEST_ROOT" --response-root "$FIRM_EVAL_AUTHORITY_RESPONSE_ROOT" --manifest "$FIRM_EVAL_AUTHORITY_MANIFEST" --digest "$FIRM_EVAL_AUTHORITY_DIGEST" --invocation "$FIRM_EVAL_INVOCATION" --tool "$(basename "$0")" -- "$@"\n'''
    for tool in tools:
        path = shims / tool["name"]
        fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os,"O_NOFOLLOW",0), 0o700)
        try: os.write(fd, shim_body); os.fsync(fd)
        finally: os.close(fd)
    shell_env = manifest.parent / "shell-env"
    shell_env.mkdir(mode=0o700)
    exports = {
        "PATH": str(shims) + ":/usr/bin:/bin:/usr/sbin:/sbin",
        "FIRM_EVAL_AUTHORITY_BIN": str(candidate_root / "bin" / "firm-eval-authority"),
        "FIRM_EVAL_AUTHORITY_REQUEST_ROOT": doc["request_root"],
        "FIRM_EVAL_AUTHORITY_RESPONSE_ROOT": doc["response_root"],
        "FIRM_EVAL_AUTHORITY_MANIFEST": str(manifest),
        "FIRM_EVAL_AUTHORITY_DIGEST": digest_bytes(raw),
        "FIRM_EVAL_INVOCATION": doc["invocation"],
    }
    exports.update(SAFE_GIT_ENV)
    shell_raw = "".join("export %s=%s\n" % (key, shlex.quote(value)) for key,value in exports.items()).encode("utf-8")
    for name in (".zshenv", ".zprofile", ".zshrc", ".zlogin", ".bash-env", ".sh-env"):
        path = shell_env / name
        fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os,"O_NOFOLLOW",0), 0o600)
        try: os.write(fd, shell_raw); os.fsync(fd)
        finally: os.close(fd)
    validate_capsule(doc)
    print(canonical({"schema_version":3,"manifest":str(manifest),"manifest_digest":digest_bytes(raw),
                     "invocation":doc["invocation"],"shim_dir":str(shims),"candidate_commit":PAYLOAD_COMMIT,
                     "candidate_tree":capsule["payload_tree"],"patch_commit":patch_commit,"tool_count":len(tools),
                     "shell_env":str(shell_env),"project_root":str(candidate_root),"capsule_root":str(scratch),
                     "authority_bin":str(candidate_root/"bin"/"firm-eval-authority"),
                     "seatbelt_profile":seatbelt["profile"]["path"],"real_common":seatbelt["real_common"],
                     "provider_executable":seatbelt["provider"]["path"],
                     "guardian_pid":ns.guardian_pid,"guardian_root":str(guardian_root)}))

def send_message(request_root, response_root, request):
    request_id=secrets.token_hex(24)
    envelope={"schema_version":1,"request_id":request_id,"request":request}
    request_path=Path(request_root)/(request_id+".request")
    response_path=Path(response_root)/(request_id+".response")
    payload=(canonical(envelope)+"\n").encode("ascii")
    fd=os.open(str(request_path),os.O_WRONLY|os.O_CREAT|os.O_EXCL|getattr(os,"O_NOFOLLOW",0),0o600)
    try: os.write(fd,payload); os.fsync(fd)
    finally: os.close(fd)
    deadline=time.monotonic()+10.0
    while time.monotonic()<deadline and not response_path.exists(): time.sleep(0.01)
    if not response_path.exists(): fail("broker response timeout")
    raw,st=read_bytes(response_path,MAX_MESSAGE)
    if stat.S_IMODE(st.st_mode)!=0o600: fail("broker response mode")
    try:
        envelope=json.loads(raw.decode("ascii"))
        if not exact_keys(envelope,{"schema_version","request_id","response"}) or envelope["schema_version"]!=1 or envelope["request_id"]!=request_id: raise ValueError()
        response=envelope["response"]
    except Exception: fail("broker response JSON")
    if not isinstance(response,dict) or response.get("ok") is not True: fail("broker refused request")
    return response

def append_receipt(path, record):
    raw=(canonical(record)+"\n").encode("ascii")
    fd=os.open(path, os.O_WRONLY|os.O_APPEND|getattr(os,"O_NOFOLLOW",0))
    try: os.write(fd,raw); os.fsync(fd)
    finally: os.close(fd)

def serve(ns):
    doc, raw = load_manifest(ns.manifest); digest=digest_bytes(raw)
    if digest != ns.digest or doc["invocation"] != ns.invocation: fail("broker binding")
    validate_capsule(doc)
    request_root=Path(ns.request_root).resolve(); response_root=Path(ns.response_root).resolve(); receipts=Path(ns.receipts)
    if str(request_root)!=doc["request_root"] or str(response_root)!=doc["response_root"]: fail("broker transport")
    fd=os.open(str(receipts), os.O_WRONLY|os.O_CREAT|os.O_EXCL|getattr(os,"O_NOFOLLOW",0),0o600); os.close(fd)
    pending={}; seen=set(); session_secret=secrets.token_bytes(32); stopping=[False]
    def stop(*_): stopping[0]=True
    signal.signal(signal.SIGTERM,stop); signal.signal(signal.SIGINT,stop)
    tools={item["name"]:item for item in doc["tools"]}; sequence=0
    while not stopping[0]:
        names=sorted(name for name in os.listdir(str(request_root)) if re.fullmatch(r"[0-9a-f]{48}\.request",name))
        if not names: time.sleep(0.01); continue
        for name in names:
            request_id=name[:-8]
            if request_id in seen: continue
            seen.add(request_id); response={"ok":False}
            try:
                data,_=read_bytes(request_root/name,MAX_MESSAGE)
                envelope=json.loads(data.decode("ascii"))
                if not exact_keys(envelope,{"schema_version","request_id","request"}) or envelope["schema_version"]!=1 or envelope["request_id"]!=request_id: raise ValueError()
                req=envelope["request"]
                if req.get("manifest_digest") != digest or req.get("invocation") != doc["invocation"]: raise ValueError()
                if req.get("op") == "exec" and exact_keys(req,{"op","manifest_digest","invocation","tool","argv","cwd"}):
                    tool=tools.get(req["tool"])
                    if tool is None or not isinstance(req["argv"],list) or not all(isinstance(x,str) and len(x)<=65536 for x in req["argv"]): raise ValueError()
                    validate_capsule(doc); validate_tool(tool,Path(doc["candidate_root"]))
                    test_barrier(doc,"dispatch_commit",{"tool":tool["name"],"identity":{key:tool[key] for key in ("dev","ino","bytes","sha256")}})
                    validate_capsule(doc); validate_tool(tool,Path(doc["candidate_root"])); sequence += 1
                    receipt={"schema_version":1,"sequence":sequence,"kind":"execution","tool":tool["name"],"path":tool["path"],"bytes":tool["bytes"],"sha256":tool["sha256"],"candidate_commit":doc["candidate_commit"],"candidate_tree":doc["candidate_tree"],"manifest_digest":digest,"invocation":doc["invocation"],"argv_sha256":digest_bytes(canonical(req["argv"]).encode("ascii")),"cwd":req["cwd"]}
                    append_receipt(str(receipts),receipt); response={"ok":True,"tool":tool,"receipt":receipt}
                    if tool["name"] == "firm-ledger-log" and "--run" in req["argv"]:
                        pos=req["argv"].index("--run")
                        if pos+1 >= len(req["argv"]): raise ValueError()
                        cwd=Path(req["cwd"])
                        if not cwd.is_absolute() or cwd.resolve()!=cwd: raise ValueError()
                        run=Path(req["argv"][pos+1]); run=(cwd/run).resolve() if not run.is_absolute() else run.resolve(); scratch=Path(doc["scratch_root"])
                        if os.path.commonpath((str(scratch),str(run))) != str(scratch) or run == scratch: raise ValueError()
                        rst=os.lstat(str(run))
                        if not stat.S_ISDIR(rst.st_mode) or rst.st_uid != os.getuid(): raise ValueError()
                        token={"schema_version":1,"purpose":"eval_p2_write","token":secrets.token_hex(32),"invocation":doc["invocation"],"manifest_digest":digest,"candidate_commit":doc["candidate_commit"],"candidate_tree":doc["candidate_tree"],"patch_sha256":doc["patch_sha256"],"eval":doc["eval"],"provider":doc["provider"],"writer_path":tool["path"],"writer_sha256":tool["sha256"],"scratch_root":str(scratch),"scratch_dev":doc["scratch_dev"],"scratch_ino":doc["scratch_ino"],"run_path":str(run),"run_dev":rst.st_dev,"run_ino":rst.st_ino,"macos":"26.5.1","kernel":"25.5.0","architecture":"arm64","python":"3.9.6","implementation":"cpython","filesystem":"apfs","issued_monotonic_ns":time.monotonic_ns(),"expires_monotonic_ns":time.monotonic_ns()+30_000_000_000}
                        token["auth"]=hmac.new(session_secret,canonical(token).encode("ascii"),hashlib.sha256).hexdigest(); pending[token["token"]]=token; response["p2_attestation"]=token
                elif req.get("op") == "validate_p2" and exact_keys(req,{"op","manifest_digest","invocation","token","writer_path","writer_sha256","run_path"}):
                    token=req["token"] if isinstance(req["token"],dict) else {}; expected=pending.pop(token.get("token",None),None)
                    unsigned=dict(token); auth=unsigned.pop("auth",None); valid_auth=isinstance(auth,str) and hmac.compare_digest(auth,hmac.new(session_secret,canonical(unsigned).encode("ascii"),hashlib.sha256).hexdigest())
                    if expected is None or token != expected or not valid_auth or time.monotonic_ns()>token["expires_monotonic_ns"]: raise ValueError()
                    if req["writer_path"]!=token["writer_path"] or req["writer_sha256"]!=token["writer_sha256"] or req["run_path"]!=token["run_path"]: raise ValueError()
                    sequence += 1; append_receipt(str(receipts),{"schema_version":1,"sequence":sequence,"kind":"p2_consumed","tool":"firm-ledger-log","path":token["writer_path"],"bytes":tools["firm-ledger-log"]["bytes"],"sha256":token["writer_sha256"],"candidate_commit":doc["candidate_commit"],"candidate_tree":doc["candidate_tree"],"manifest_digest":digest,"invocation":doc["invocation"],"run_path":token["run_path"],"token":token["token"]})
                    response={"ok":True,"modeled":{"system":"Darwin","macos":token["macos"],"kernel":token["kernel"],"architecture":token["architecture"],"python":token["python"],"implementation":token["implementation"],"filesystem":token["filesystem"]}}
            except Exception: response={"ok":False}
            response_envelope=(canonical({"schema_version":1,"request_id":request_id,"response":response})+"\n").encode("ascii")
            response_path=response_root/(request_id+".response")
            fd=os.open(str(response_path),os.O_WRONLY|os.O_CREAT|os.O_EXCL|getattr(os,"O_NOFOLLOW",0),0o600)
            try: os.write(fd,response_envelope); os.fsync(fd)
            finally: os.close(fd)

def request_exec(ns, rest):
    doc, raw=load_manifest(ns.manifest)
    if digest_bytes(raw)!=ns.digest or doc["invocation"]!=ns.invocation: fail("shim binding")
    reject_git_environment(); validate_capsule(doc)
    response=send_message(ns.request_root,ns.response_root,{"op":"exec","manifest_digest":ns.digest,"invocation":ns.invocation,"tool":ns.tool,"argv":rest,"cwd":os.path.realpath(os.getcwd())})
    tool=response.get("tool"); validate_tool(tool,Path(doc["candidate_root"]))
    test_barrier(doc,"use_exec",{"tool":tool["name"],"identity":{key:tool[key] for key in ("dev","ino","bytes","sha256")}})
    validate_capsule(doc); validate_tool(tool,Path(doc["candidate_root"]))
    env=os.environ.copy()
    if "p2_attestation" in response: env["FIRM_EVAL_P2_ATTESTATION"]=canonical(response["p2_attestation"])
    os.execve(tool["path"],[tool["path"]]+rest,env)

def validate_p2(ns):
    doc,raw=load_manifest(ns.manifest)
    if digest_bytes(raw)!=ns.digest or doc["invocation"]!=ns.invocation: fail("writer binding")
    reject_git_environment(); validate_capsule(doc)
    try: token=json.loads(ns.token)
    except Exception: fail("token JSON")
    response=send_message(ns.request_root,ns.response_root,{"op":"validate_p2","manifest_digest":ns.digest,"invocation":ns.invocation,"token":token,"writer_path":ns.writer_path,"writer_sha256":ns.writer_sha256,"run_path":ns.run_path})
    print(canonical(response))

def verify(ns):
    doc, raw=load_manifest(ns.manifest); expected=digest_bytes(raw)
    if expected!=ns.digest: fail("verify digest")
    validate_capsule(doc,final=True)
    receipt_raw,_=read_bytes(Path(ns.receipts),8*1024*1024)
    rows=[]
    for line in receipt_raw.splitlines():
        try: row=json.loads(line.decode("ascii"))
        except Exception: fail("receipt JSON")
        if row.get("manifest_digest")!=expected or row.get("invocation")!=doc["invocation"]: fail("receipt binding")
        rows.append(row)
    if not rows or not any(r.get("tool")=="firm-ledger-log" for r in rows) or not any(r.get("kind")=="p2_consumed" for r in rows): fail("missing required receipt")
    output={"schema_version":3,"candidate_commit":doc["candidate_commit"],"candidate_tree":doc["candidate_tree"],
            "patch_commit":doc["patch_commit"],"patch_bytes":doc["patch_bytes"],"patch_sha256":doc["patch_sha256"],
            "manifest_digest":expected,"invocation":doc["invocation"],"tool_count":len(doc["tools"]),
            "execution_receipts":sum(r.get("kind")=="execution" for r in rows),"p2_receipts":sum(r.get("kind")=="p2_consumed" for r in rows),
            "receipt_sha256":digest_bytes(receipt_raw),"receipt_bytes":len(receipt_raw)}
    print(canonical(output))

def cleanup(ns):
    doc,raw=load_manifest(ns.manifest)
    if digest_bytes(raw)!=ns.digest or doc["invocation"]!=ns.invocation: fail("cleanup digest")
    validate_capsule(doc,final=True); validate_seatbelt(doc,post=True)
    if (doc["guardian"]["control"]!=str(Path(ns.control).resolve())
            or doc["guardian"]["token_sha256"]!=digest_bytes(bytes.fromhex(ns.token))
            or doc["guardian"]["pid"]!=ns.guardian_pid): fail("cleanup guardian binding")
    ns.action="cleanup"; ns.nonce=None
    guardian_command(ns)

def main():
    p=argparse.ArgumentParser(add_help=False); sub=p.add_subparsers(dest="command",required=True)
    q=sub.add_parser("guardian-start"); q.add_argument("--parent",required=True); q.add_argument("--launcher-pid",type=int,required=True); q.add_argument("--invocation"); q.add_argument("--test-barrier-root"); q.add_argument("--test-barrier-token"); q.add_argument("--test-barrier-phase")
    q=sub.add_parser("guardian-command"); q.add_argument("--control",required=True); q.add_argument("--token",required=True); q.add_argument("--invocation",required=True); q.add_argument("--guardian-pid",type=int,required=True); q.add_argument("--sequence",type=int,required=True); q.add_argument("--action",choices=("register","cleanup"),required=True); q.add_argument("--role",choices=("broker","provider")); q.add_argument("--pid",type=int); q.add_argument("--pgid",type=int); q.add_argument("--nonce"); q.add_argument("--expected-roles",default="")
    q=sub.add_parser("guardian-exec"); q.add_argument("--control",required=True); q.add_argument("--token",required=True); q.add_argument("--invocation",required=True); q.add_argument("--guardian-pid",type=int,required=True); q.add_argument("--sequence",type=int,required=True); q.add_argument("--role",choices=("broker","provider"),required=True); q.add_argument("--nonce")
    q=sub.add_parser("prepare"); q.add_argument("--root",required=True); q.add_argument("--eval",required=True); q.add_argument("--provider",required=True); q.add_argument("--provider-executable",required=True); q.add_argument("--scratch",required=True); q.add_argument("--fixture",required=True); q.add_argument("--manifest",required=True); q.add_argument("--shims",required=True); q.add_argument("--request-root",required=True); q.add_argument("--response-root",required=True); q.add_argument("--guardian-root",required=True); q.add_argument("--guardian-pid",type=int,required=True); q.add_argument("--guardian-token",required=True); q.add_argument("--guardian-failure-marker",required=True); q.add_argument("--invocation",required=True); q.add_argument("--test-barrier-root"); q.add_argument("--test-barrier-token"); q.add_argument("--test-barrier-phase")
    q=sub.add_parser("serve"); q.add_argument("--manifest",required=True); q.add_argument("--digest",required=True); q.add_argument("--invocation",required=True); q.add_argument("--request-root",required=True); q.add_argument("--response-root",required=True); q.add_argument("--receipts",required=True)
    q=sub.add_parser("request-exec"); q.add_argument("--request-root",required=True); q.add_argument("--response-root",required=True); q.add_argument("--manifest",required=True); q.add_argument("--digest",required=True); q.add_argument("--invocation",required=True); q.add_argument("--tool",required=True)
    q=sub.add_parser("validate-p2"); q.add_argument("--request-root",required=True); q.add_argument("--response-root",required=True); q.add_argument("--manifest",required=True); q.add_argument("--digest",required=True); q.add_argument("--invocation",required=True); q.add_argument("--token",required=True); q.add_argument("--writer-path",required=True); q.add_argument("--writer-sha256",required=True); q.add_argument("--run-path",required=True)
    q=sub.add_parser("verify"); q.add_argument("--manifest",required=True); q.add_argument("--digest",required=True); q.add_argument("--receipts",required=True)
    q=sub.add_parser("seatbelt-probe"); q.add_argument("--manifest",required=True); q.add_argument("--digest",required=True); q.add_argument("--invocation",required=True); q.add_argument("--post",action="store_true")
    q=sub.add_parser("test-barrier-probe"); q.add_argument("--root",required=True); q.add_argument("--token",required=True); q.add_argument("--invocation",required=True); q.add_argument("--candidate",required=True); q.add_argument("--phase",required=True); q.add_argument("--target",required=True)
    q=sub.add_parser("cleanup"); q.add_argument("--manifest",required=True); q.add_argument("--digest",required=True); q.add_argument("--invocation",required=True); q.add_argument("--control",required=True); q.add_argument("--token",required=True); q.add_argument("--guardian-pid",type=int,required=True); q.add_argument("--sequence",type=int,required=True); q.add_argument("--expected-roles",default="")
    ns,rest=p.parse_known_args(ARGV)
    if ns.command=="guardian-start": guardian_start(ns)
    elif ns.command=="guardian-command": guardian_command(ns)
    elif ns.command=="guardian-exec":
        if not rest or rest[0]!="--": fail("missing argv boundary")
        guardian_exec(ns,rest[1:])
    elif ns.command=="prepare": prepare(ns)
    elif ns.command=="serve": serve(ns)
    elif ns.command=="request-exec":
        if not rest or rest[0]!="--": fail("missing argv boundary")
        request_exec(ns,rest[1:])
    elif ns.command=="validate-p2": validate_p2(ns)
    elif ns.command=="verify": verify(ns)
    elif ns.command=="seatbelt-probe": seatbelt_probe(ns)
    elif ns.command=="test-barrier-probe": test_barrier_probe(ns)
    else: cleanup(ns)
main()
