#!/usr/bin/env bash
# integrate [integration-branch]
# Creates/uses an integration branch and merges this run's implementer worktree branches into it.
# On conflict, aborts that merge and reports it for the Integrator agent to resolve by hand —
# never silently drops a change. Merging to the DEFAULT branch is a human gate (not done here).
set -uo pipefail
__src="${BASH_SOURCE[0]}"   # resolve symlinks so ~/.local/bin/firm-* finds the repo
while [ -L "$__src" ]; do __d="$(cd -P "$(dirname "$__src")" && pwd)"; __src="$(readlink "$__src")"; case $__src in /*) ;; *) __src="$__d/$__src";; esac; done
SELF="$(cd -P "$(dirname "$__src")" && pwd)"   # resolve sibling scripts by location

run_dir=""; [[ -f .agent-firm/CURRENT_RUN ]] && run_dir="$(cat .agent-firm/CURRENT_RUN)"
run_id="$(basename "${run_dir:-none}")"
intb="${1:-integration/${run_id}}"

# The target must be an integration/* branch — a POSITIVE allowlist, on purpose. Denylisting
# main/master/develop/release/* loses to the next protected name someone invents, and the only shape
# integration is ever allowed to have is integration/<run_id>. There is deliberately no override
# flag: an escape hatch is just the denylist again, wearing a different hat.
case "$intb" in
  integration/?*) : ;;
  *)
    echo "firm-integrate: refusing target '${intb}' — integration runs on integration/* branches only." >&2
    echo "  Merging anywhere else (the default branch above all) is a HUMAN GATE, never this script's job." >&2
    exit 2 ;;
esac

# Reach the integration branch, or STOP. This previously discarded git's exit code: a failed switch
# (dirty tree, or the branch already checked out in a linked worktree — routine here) left HEAD on
# whatever happened to be checked out, and the merges below landed THERE. With the Lead sitting on
# `main` that is an autonomous merge to the default branch — never-rule #1 — and the permission layer
# cannot see it, because Bash(firm-integrate:*) is allow-listed while Bash(git merge:*) is only `ask`.
if git show-ref --verify --quiet "refs/heads/${intb}"; then
  sw_err="$(git switch "$intb" 2>&1)"; sw_rc=$?
else
  sw_err="$(git switch -c "$intb" 2>&1)"; sw_rc=$?
fi
if [[ $sw_rc -ne 0 ]]; then
  echo "firm-integrate: cannot reach '${intb}' (git rc=${sw_rc}) — NOTHING merged." >&2
  echo "  ${sw_err}" >&2
  echo "  Resolve it (commit/stash local changes, or release the branch from its other worktree) and re-run." >&2
  exit 1
fi

# Belt and braces: prove we are standing on the target before a single merge runs.
head_now="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
if [[ "$head_now" != "$intb" ]]; then
  echo "firm-integrate: expected HEAD on '${intb}' but it is '${head_now}' — refusing to merge." >&2
  exit 1
fi

# bash 3.2 compatible (macOS): no `mapfile`.
# strip leading markers: '*' (current), '+' (checked out in a linked worktree), and spaces
branches="$(git branch --list "wt/${run_id}-*" | sed 's/^[*+ ]*//')"
if [[ -z "$branches" ]]; then echo "no worktree branches for ${run_id}; nothing to integrate"; exit 0; fi

conflicts=0; merged=0
while IFS= read -r b; do
  [[ -z "$b" ]] && continue
  printf 'merging %-50s ... ' "$b"
  if git merge --no-edit "$b" >/dev/null 2>&1; then
    echo "ok"; merged=$((merged+1))
  else
    echo "CONFLICT (left for Integrator to resolve)"; git merge --abort 2>/dev/null || true; conflicts=$((conflicts+1))
  fi
done <<< "$branches"

echo "integration branch: $intb"
echo "merged: $merged   conflicts: $conflicts"
[[ -x "$SELF/firm-ledger-log" ]] && "$SELF/firm-ledger-log" integrated branch="$intb" merged="$merged" conflicts="$conflicts" || true
echo "NEXT: reconcile lockfiles/migrations/ports/fixtures, run the COMBINED suite, write integration-summary.md."
[[ $conflicts -eq 0 ]]
