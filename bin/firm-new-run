#!/usr/bin/env bash
# firm-new-run [--primary claude|codex] <slug> [track]
# firm-new-run --metadata-view <run-dir>
# Scaffolds a run-ledger directory under ./.agent-firm/runs/<ts>-<slug>/, seeds it from the
# firm templates, opens run.jsonl with a run_started event, and points .agent-firm/CURRENT_RUN at it.
# Run from the ROOT of the work project (the git repo you are operating on).
set -euo pipefail

# Resolve the firm root before dispatching either creation or the shared metadata reader.
__src="${BASH_SOURCE[0]}"
while [ -L "$__src" ]; do __d="$(cd -P "$(dirname "$__src")" && pwd)"; __src="$(readlink "$__src")"; case $__src in /*) ;; *) __src="$__d/$__src";; esac; done
SCRIPT_DIR="$(cd -P "$(dirname "$__src")" && pwd)"
FIRM_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TEMPLATES="$FIRM_ROOT/agent-firm/templates"
. "$SCRIPT_DIR/firm-python"   # one resolved interpreter for the whole firm; see bin/firm-python

if [[ "${1:-}" == "--metadata-view" ]]; then
  [[ $# -eq 2 ]] || { echo "usage: firm-new-run --metadata-view <run-dir>" >&2; exit 2; }
  exec "${FIRM_PYTHON_ARGV[@]}" - "$2" <<'PY'
import json, os, re, stat, subprocess, sys

def fail(message):
    print(f"firm-new-run: metadata view unavailable: {message}", file=sys.stderr)
    raise SystemExit(2)

run = os.path.abspath(sys.argv[1])
if any(ord(ch) < 32 or ord(ch) == 127 for ch in run) or ".." in sys.argv[1].replace("\\", "/").split("/"):
    fail("unsafe run path")
run_id = os.path.basename(run)
if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", run_id):
    fail("unsafe run id")
repo = os.path.dirname(os.path.dirname(os.path.dirname(run)))
if os.path.basename(os.path.dirname(run)) != "runs" or os.path.basename(os.path.dirname(os.path.dirname(run))) != ".agent-firm":
    fail("run is not <repo>/.agent-firm/runs/<safe-id>")
for path in (repo, os.path.join(repo, ".agent-firm"), os.path.dirname(run), run):
    try:
        info = os.lstat(path)
    except OSError as exc:
        fail(f"missing run component: {exc}")
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        fail(f"unsafe run component: {path}")
try:
    top = subprocess.check_output(["git", "-C", repo, "rev-parse", "--show-toplevel"], stderr=subprocess.DEVNULL, text=True).strip()
    common = subprocess.check_output(["git", "-C", repo, "rev-parse", "--git-common-dir"], stderr=subprocess.DEVNULL, text=True).strip()
    if not os.path.isabs(common):
        common = os.path.join(repo, common)
except subprocess.SubprocessError:
    fail("run repository is not a readable git worktree")
if os.path.realpath(top) != os.path.realpath(repo):
    fail("run repository identity is mismatched")

metadata_path = os.path.join(run, "run-metadata.json")
try:
    info = os.lstat(metadata_path)
except FileNotFoundError:
    info = None
if info is not None:
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        fail("current metadata is not a regular no-follow file")
    try:
        with open(metadata_path, encoding="utf-8") as fh:
            data = json.load(fh)
    except Exception as exc:
        fail(f"current metadata is malformed: {exc}")
    required = {
        "schema_version", "run_id", "track", "primary_provider", "repository_root",
        "git_common_dir", "accepted_base_sha", "historical", "approval_eligible"
    }
    if not isinstance(data, dict) or set(data) != required:
        fail("current metadata fields are incomplete or unknown")
    if data.get("schema_version") != 2 or data.get("run_id") != run_id:
        fail("current metadata version/run identity is invalid")
    if data.get("track") not in ("fast_path", "full_track") or data.get("primary_provider") not in ("claude", "codex"):
        fail("current metadata track/provider is invalid")
    if data.get("historical") is not False or not isinstance(data.get("approval_eligible"), bool):
        fail("current metadata historical/eligibility flags are invalid")
    if os.path.realpath(str(data.get("repository_root", ""))) != os.path.realpath(repo) or os.path.realpath(str(data.get("git_common_dir", ""))) != os.path.realpath(common):
        fail("current metadata repository identity is invalid")
    base = data.get("accepted_base_sha")
    if data["approval_eligible"] and (not isinstance(base, str) or not re.fullmatch(r"[0-9a-f]{40}", base)):
        fail("approval-eligible metadata needs a full accepted base SHA")
    print(json.dumps(data, sort_keys=True, separators=(",", ":")))
    raise SystemExit(0)

ledger = os.path.join(run, "run.jsonl")
try:
    if os.path.islink(ledger) or not os.path.isfile(ledger):
        raise ValueError("missing regular ledger")
    with open(ledger, encoding="utf-8") as fh:
        first = json.loads(fh.readline())
except Exception as exc:
    fail(f"metadata absence is not recognizable historical state: {exc}")
if not isinstance(first, dict) or first.get("event") != "run_started" or first.get("run_id") != run_id:
    fail("metadata absence is not backed by this run's start event")
if "primary_provider" in first:
    fail("provider-aware run is missing required current metadata")
track = first.get("track", "full_track")
if track not in ("fast_path", "full_track"):
    fail("historical track is invalid")
base = first.get("base_sha")
if not isinstance(base, str) or not re.fullmatch(r"[0-9a-f]{40}", base):
    base = None
view = {
    "schema_version": 2, "run_id": run_id, "track": track, "primary_provider": "claude",
    "repository_root": os.path.realpath(repo), "git_common_dir": os.path.realpath(common),
    "accepted_base_sha": base, "historical": True, "approval_eligible": False
}
print(json.dumps(view, sort_keys=True, separators=(",", ":")))
PY
fi

# ---------------------------------------------------------------------------
# ONE usage synopsis, two call sites: `usage` (stdout, exit 0, for --help) and `usage >&2` (stderr,
# exit 2, for a refused invocation). Factored precisely so the two cannot drift apart. It is also the
# documentation surface for --base: an operator refused by the base guard below lands here, at the
# moment they need it, and no provider-parity-compared file (commands/start.md,
# codex-skills/start/SKILL.md) has to be edited to say it twice.
usage() {
  cat <<'EOF'
usage: firm-new-run [--primary claude|codex] [--base <rev>] <slug> [fast_path|full_track]
       firm-new-run --metadata-view <run-dir>
       firm-new-run --help

Scaffolds .agent-firm/runs/<ts>-<slug>/, seeds it from the firm templates, opens run.jsonl with a
run_started event, and points .agent-firm/CURRENT_RUN at it. Run from the ROOT of the work project
(the git repo you are operating on).

  --primary claude|codex   Provider that is primary for this run. Default: claude.
  --base <rev>             The commit this run records as its ALREADY-REVIEWED base. Any revision
                           this repository resolves to a commit is accepted (a full or short sha, a
                           tag, origin/main, HEAD~1); the 40-character sha git resolves it to is what
                           gets recorded, never the string you typed.
  --metadata-view <dir>    Print normalized metadata for an existing run directory, and exit.
  -h, --help               Print this synopsis and exit. Creates nothing.

--base IS REQUIRED WHEN HEAD IS NOT AT THE TIP OF THIS REPOSITORY'S DEFAULT BRANCH. accepted_base_sha
is what every mechanical gate downstream treats as already reviewed, so this script will not derive it
silently from wherever HEAD happens to be; it has to be stated. The same requirement applies when the
default branch cannot be resolved at all (no origin/HEAD, and no local main or master) -- unknown is
not the same as HEAD. `git remote set-head origin -a` fixes that underlying cause; --base <rev> states
the answer directly.
EOF
}

# The help dispatch reads the FIRST positional argument, before any option is consumed, so that
# `firm-new-run --primary claude --help` is NOT help: it falls through to the slug rules below and is
# refused. A refusal is the safer of the two answers for an invocation nobody meant to write, and
# scoping help to argv[1] keeps this from becoming a general option parser.
first_arg="${1:-}"
case "$first_arg" in --help|-h) usage; exit 0 ;; esac

primary="claude"
base_arg=""
base_given=false
# Leading options, in any order. `shift 2 || break` (not `shift 2 || true`) is deliberate: when the
# option is the last argument, `shift 2` fails and shifts NOTHING, so looping again would spin on the
# same argv forever. Breaking leaves argv untouched, so `firm-new-run --primary` still exits 2 the
# way it always did -- slug becomes "--primary", primary becomes "".
#
# BUT NOT BY THE SAME CHECK, and the comment that used to sit here said it was. Measured, both
# spellings, in a one-commit repo on main:
#
#   base 1886f88   `firm-new-run --primary`   rc 2   "firm-new-run: --primary must be claude or codex"
#   here           `firm-new-run --primary`   rc 2   "firm-new-run: refusing slug --primary -- it is
#                                                     not a recognized option, ..."
#
# The flag-shaped-slug guard below now fires FIRST and names the refused slug; the provider check
# never runs. Same status, different diagnostic -- and the earlier claim that "the provider check
# below still exits 2" was simply wrong about which check fires.
#
# ONE REAL WIDENING, RECORDED HERE RATHER THAN DECIDED HERE. Looping accepts REPEATED leading options
# LAST-WINS where the base exited 2:
#
#   base 1886f88   `--primary claude --primary codex demo`   rc 2   "track must be fast_path or
#                                                                    full_track" (the second
#                                                                    --primary landed on $2/track)
#   here           `--primary claude --primary codex demo`   rc 0   run opened, primary_provider
#                                                                    recorded as codex
#
# Nothing documented or shipped writes that shape, and last-wins is what every getopt-style parser
# does, so it is not being changed here on the way past: whether an operator who names a provider
# twice should be refused or obeyed is an argv-contract question for the Requirements gate. It is
# named so the next reader does not have to rediscover it by measurement.
while :; do
  case "${1:-}" in
    --primary) primary="${2:-}"; shift 2 || break ;;
    --base)    base_arg="${2:-}"; base_given=true; shift 2 || break ;;
    *) break ;;
  esac
done
slug="${1:-}"
slug_raw="$slug"
track="${2:-full_track}"
if [[ -z "$slug" ]]; then
  usage >&2; exit 2
fi
# Refuse a flag-shaped slug. Every recognized option has already been consumed above, so a remaining
# leading hyphen is by definition not one. This is the D-03 defect: `--help` survives BOTH `tr` stages
# intact (hyphens are inside the [a-z0-9-] keep-set), so the sanitizer happily produced the run id
# `20260821T011819Z---help`, seeded every template into it, wrote a run_started event and repointed
# CURRENT_RUN. `printf '%s'`, never `echo`: a slug holding backslashes must not be re-interpreted by a
# shell whose `echo` expands them.
case "$slug_raw" in
  -*)
    printf 'firm-new-run: refusing slug %s -- it is not a recognized option, and a leading hyphen makes an unusable run id\n' "$slug_raw" >&2
    printf 'firm-new-run: run `firm-new-run --help` for the accepted options\n' >&2
    exit 2
    ;;
esac
# Refuse an UNCONSUMED OPTION-SHAPED ARGUMENT after the positionals. The leading-option loop above
# stops at the first non-option, so `firm-new-run demo full_track --base <sha>` parsed as slug=demo,
# track=full_track and two arguments nothing ever looked at: the run OPENED, exited 0, and recorded
# the DEFAULT BRANCH'S TIP as accepted_base_sha instead of the commit the operator named. Silently
# substituting a different already-reviewed base for the one that was stated is precisely what the
# base guard below exists to prevent, so an option-shaped argument that nothing consumed is an error
# here, not noise. `--primary codex` in the same position is discarded identically (the run records
# claude however loudly codex was asked for), which is why this refuses the argument SHAPE rather
# than the two option names -- a `--base`-only check would leave the same defect one option over.
#
# It sits AHEAD OF THE FIRST mkdir like every other refusal in this file, and reads argv only: no git
# state, nothing created, nothing to clean up.
#
# SCOPED TO OPTION-SHAPED ARGUMENTS DELIBERATELY. A bare trailing word (`firm-new-run demo full_track
# extra`) has been ignored since this script was written and still is; refusing that too is a wider
# argv contract than this defect calls for. EVERY EXISTING CALLER WAS ENUMERATED FIRST:
# bin/firm-qa-checkout, bin/firm-reviewer-common, bin/firm-final-qa-check and
# bin/firm-traceability-check all invoke `--metadata-view <dir>`, which exec's at the top of this
# file long before here; every tests/ call site and every documented form (agent-firm/contracts/
# lifecycle.md, commands/start.md, codex-skills/start/SKILL.md, docs/PHASE0.md) puts its options
# BEFORE the slug. Nothing that works today is refused by this.
if [[ $# -gt 2 ]]; then
  for unconsumed in "${@:3}"; do
    case "$unconsumed" in
      -*)
        printf 'firm-new-run: refusing argument %s -- options are read only BEFORE the slug, so nothing\n' "$unconsumed" >&2
        printf 'firm-new-run: consumed this one and it would have been silently discarded\n' >&2
        printf 'firm-new-run:   firm-new-run [--primary claude|codex] [--base <rev>] <slug> [fast_path|full_track]\n' >&2
        printf 'firm-new-run: run `firm-new-run --help` for the accepted options\n' >&2
        exit 2
        ;;
    esac
  done
fi
case "$primary" in claude|codex) ;; *) echo "firm-new-run: --primary must be claude or codex" >&2; exit 2 ;; esac
case "$track" in fast_path|full_track) ;; *) echo "firm-new-run: track must be fast_path or full_track" >&2; exit 2 ;; esac
slug="$(printf '%s' "$slug" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-')"
# A slug made only of characters the sanitizer strips leaves nothing behind, and the run id becomes a
# bare timestamp with a trailing hyphen -- a directory nobody can identify later. Refuse it here, with
# the ORIGINAL slug in the diagnostic, since the sanitized one is empty and names nothing.
if [[ -z "$slug" ]]; then
  printf 'firm-new-run: refusing slug %s -- nothing survives slug sanitization, so the run id would be a bare timestamp\n' "$slug_raw" >&2
  printf 'firm-new-run: run `firm-new-run --help` for the accepted options\n' >&2
  exit 2
fi

# ---------------------------------------------------------------------------
# GIT STATE IS RESOLVED HERE, AHEAD OF THE SCAFFOLD BELOW. The values computed in this section are
# functions of $PWD and git state alone -- nothing here reads anything the scaffold creates -- so
# hoisting it above the first `mkdir` is value-preserving, and it is what lets every refusal in this
# script precede the first directory it would otherwise have created. A guard that runs after the
# scaffold still returns the right exit status while leaving a partial run behind, which is the shape
# of "check that cannot fail" this ordering exists to prevent.
repo="$(basename "$(pwd)")"
repo_root=""
git_common_dir=""
base_sha=""
approval_eligible=false
if repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" && base_sha="$(git rev-parse --verify HEAD^{commit} 2>/dev/null)"; then
  repo_root="$(cd "$repo_root" && pwd -P)"
  git_common_dir="$(git rev-parse --git-common-dir)"
  case "$git_common_dir" in /*) ;; *) git_common_dir="$repo_root/$git_common_dir" ;; esac
  git_common_dir="$(cd "$git_common_dir" && pwd -P)"
  approval_eligible=true
fi

# Resolve the DEFAULT branch (distinct from HEAD/base_sha above — a run can start on a feature branch)
# and its SHA at run start. This lets firm-check-assertions PROVE the default branch hasn't moved by
# comparing SHAs later, instead of the commit-count heuristic it used to use (which only "worked"
# because eval fixtures happen to start with exactly one commit, and proves nothing in a real repo).
# Every `if`/`||` below is deliberately structured so a resolution failure does NOT abort run creation
# under `set -e` — `cmd && { ...; }` as a bare statement WOULD trigger -e on failure; `if cmd; then`
# and a trailing `|| true` do not. Absence of a resolvable default branch means no baseline is written
# below — callers must fail closed on that absence, never assume "unchanged", the same way firm-doctor
# now fails closed on a settings.json it can't read. It ALSO now means the base guard below refuses the
# run outright whenever HEAD resolves to a commit, because an unknown default branch is not evidence
# that HEAD is that branch's tip. The two remaining no-baseline paths (not a git repo; a repo with
# zero commits) are unaffected: there HEAD resolves to nothing, no base is recorded at all,
# approval_eligible is false, and the downstream readers already fail closed on the missing baseline.
default_branch=""
default_branch_start_sha=""
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  ref="$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [[ -n "$ref" ]]; then
    default_branch="${ref#refs/remotes/origin/}"
  else
    for b in main master; do
      if git show-ref --verify --quiet "refs/heads/$b"; then default_branch="$b"; break; fi
    done
  fi
  if [[ -n "$default_branch" ]]; then
    # `--verify --quiet`, not plain `git rev-parse <ref>`: on an unresolvable ref, plain rev-parse
    # ECHOES THE LITERAL REF STRING TO STDOUT (not stderr) before failing — `2>/dev/null` alone lets
    # that leak straight into this capture, and since `||` chains the fallback into the SAME command
    # substitution, a missing refs/heads/<branch> produced "refs/heads/main\n<real sha from fallback>"
    # as the value, corrupting run.jsonl/run-baseline.json's JSON. Caught by testing the exact case
    # this exists for: origin/HEAD says one branch, but that branch has no LOCAL ref (e.g. a stale
    # checkout after a remote rename) — --verify prints nothing on failure, only the SHA on success.
    default_branch_start_sha="$(git rev-parse --verify --quiet "refs/heads/$default_branch" 2>/dev/null \
      || git rev-parse --verify --quiet "refs/remotes/origin/$default_branch" 2>/dev/null || true)"
  fi
fi

# THE BASE GUARD. base_sha lands in run-metadata.json as accepted_base_sha, which firm-qa-checkout,
# firm-traceability-check, firm-qa-clean-check and firm-reviewer-common all treat as the commit that
# was ALREADY REVIEWED. Deriving it from HEAD marks whatever HEAD happens to be sitting on as
# pre-approved, silently. The comparison is BY SHA, never by branch name, so a detached HEAD parked on
# the default branch's tip is a legitimate silent success rather than a refusal.
#
# Fires when a base WOULD be recorded (HEAD resolves) AND none was stated AND it is not the default
# branch's tip -- INCLUDING when the default branch's tip cannot be established at all, because
# unknown is not HEAD. When HEAD resolves to nothing there is no base to mis-record: base_sha stays
# "", approval_eligible stays false, no run-baseline.json is written, and the downstream readers
# already refuse such a run. Demanding --base there would fail closed against a risk that does not
# exist.
base_source=none
if [[ "$base_given" == true ]]; then
  # Refuse a leading hyphen BEFORE the value reaches git, so no --base value can be read as a git
  # option. Then resolve with `--verify --quiet` and record what GIT PRINTS, never the operator's
  # string: the recorded value is interpolated into run.jsonl and run-metadata.json by printf, and 40
  # characters of [0-9a-f] cannot corrupt either file, while a quote, a backslash or a newline in the
  # raw argument could. `--verify --quiet` specifically, for the reason spelled out above: plain
  # `git rev-parse` echoes the literal ref to stdout before failing.
  case "$base_arg" in
    -*)
      printf 'firm-new-run: refusing --base %s -- a revision may not begin with a hyphen\n' "$base_arg" >&2
      exit 2
      ;;
  esac
  explicit_base="$(git rev-parse --verify --quiet "${base_arg}^{commit}" 2>/dev/null || true)"
  if [[ -z "$explicit_base" ]]; then
    printf 'firm-new-run: refusing --base %s -- this repository cannot resolve it to a commit\n' "$base_arg" >&2
    exit 2
  fi
  base_sha="$explicit_base"
  base_source=explicit
elif [[ -n "$base_sha" ]]; then
  if [[ "$base_sha" == "$default_branch_start_sha" ]]; then
    base_source=default_branch_tip
  else
    head_branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
    # Double quotes on this one format string, single quotes on the rest: it is the only line here
    # that needs an apostrophe, and `\n` is not expanded inside double quotes either, so printf still
    # receives the escape and emits the newline.
    printf "firm-new-run: refusing to open a run: HEAD is not at the tip of this repository's default branch.\n" >&2
    if [[ -n "$head_branch" ]]; then
      printf 'firm-new-run:   HEAD is on branch %s, at %s\n' "$head_branch" "$base_sha" >&2
    else
      printf 'firm-new-run:   HEAD is detached, at %s\n' "$base_sha" >&2
    fi
    printf 'firm-new-run:   %s is the base this run would otherwise have recorded as accepted_base_sha\n' "$base_sha" >&2
    if [[ -n "$default_branch" ]]; then
      printf 'firm-new-run:   default branch %s is at %s\n' "$default_branch" "$default_branch_start_sha" >&2
    else
      printf 'firm-new-run:   this repository has no resolvable default branch (no origin/HEAD, no local main or master)\n' >&2
      printf 'firm-new-run:   an unknown default branch is not evidence that HEAD is its tip\n' >&2
    fi
    printf 'firm-new-run: accepted_base_sha is what every mechanical gate treats as ALREADY REVIEWED, so it is\n' >&2
    printf 'firm-new-run: never derived silently from HEAD. State the reviewed base on the record instead:\n' >&2
    printf 'firm-new-run:   firm-new-run --base <rev> <slug> [fast_path|full_track]\n' >&2
    printf 'firm-new-run: if the default branch simply could not be resolved, `git remote set-head origin -a`\n' >&2
    printf 'firm-new-run: fixes that cause; `firm-new-run --help` has the full synopsis.\n' >&2
    exit 2
  fi
fi

ts="$(date -u +%Y%m%dT%H%M%SZ)"
run_id="${ts}-${slug}"
run_dir=".agent-firm/runs/${run_id}"
mkdir -p "$run_dir/05-work-orders" "$run_dir/09-test-evidence"

# Seed from templates (copy whatever exists; don't fail if a template is missing).
if [[ -d "$TEMPLATES" ]]; then
  for t in "$TEMPLATES"/*; do
    # Ledger artifacts are files. Skip directories (e.g. templates/visual/, which is a
    # project scaffold for firm-visual-check, not a run artifact) — `cp -n` on a directory
    # fails and, under `set -e`, aborted the whole run scaffold.
    [[ -f "$t" ]] || continue
    cp -n "$t" "$run_dir/$(basename "$t")"
  done
fi

# Open the append-only event log. base_source records HOW the base above was chosen -- explicit (the
# operator stated it with --base), default_branch_tip (HEAD was the default branch's tip), or none (no
# base was recorded at all). It is APPENDED AT THE END of the object on purpose: run-metadata.json's
# reader compares its parsed field set for EXACT equality and fails closed on any difference, so this
# decision cannot live there; and tests/test-new-run.sh asserts the exact adjacent substring
# "default_branch":"","default_branch_start_sha":"", so a field inserted between those two keys would
# break a pre-existing assertion. The ledger is append-only and its consumers read by key.
printf '{"ts":"%s","event":"run_started","event_id":"evt-run-started-%s","run_id":"%s","repo":"%s","base_sha":"%s","track":"%s","primary_provider":"%s","default_branch":"%s","default_branch_start_sha":"%s","base_source":"%s","evidence_seal_protocol":"1"}\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$run_id" "$run_id" "$repo" "$base_sha" "$track" "$primary" "$default_branch" "$default_branch_start_sha" "$base_source" >> "$run_dir/run.jsonl"
chmod 600 "$run_dir/run.jsonl"

# Machine-readable current metadata. Historical runs are interpreted only through --metadata-view.
printf '{"schema_version":2,"run_id":"%s","track":"%s","primary_provider":"%s","repository_root":"%s","git_common_dir":"%s","accepted_base_sha":"%s","historical":false,"approval_eligible":%s}\n' \
  "$run_id" "$track" "$primary" "$repo_root" "$git_common_dir" "$base_sha" "$approval_eligible" > "$run_dir/run-metadata.json"
chmod 600 "$run_dir/run-metadata.json"

# A separate file, not just the ledger line: firm-check-assertions can then do a plain file-exists
# check for "is there a baseline at all" without parsing run.jsonl, and its absence is unambiguous.
if [[ -n "$default_branch" && -n "$default_branch_start_sha" ]]; then
  printf '{"default_branch":"%s","default_branch_start_sha":"%s"}\n' \
    "$default_branch" "$default_branch_start_sha" > "$run_dir/run-baseline.json"
fi

# Point CURRENT_RUN at this run so ledger-log knows where to append.
mkdir -p .agent-firm
printf '%s\n' "$run_dir" > .agent-firm/CURRENT_RUN

echo "$run_dir"
