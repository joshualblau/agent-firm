    [str(self_dir / "firm-model-resolve"), "--provider", resolver_provider, "--role", "reviewer", "--format", "json"],
    stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
)
if resolved_done.returncode != 0:
    stop(f"canonical reviewer model resolution failed: {resolved_done.stderr.strip()}", 2)
