if (normalized_metadata.get("run_id") != run.name
        or os.path.realpath(str(normalized_metadata.get("repository_root", ""))) != os.path.realpath(repo)
        or os.path.realpath(str(normalized_metadata.get("git_common_dir", ""))) != os.path.realpath(str(candidate.get("git_common_dir", "")))
        or normalized_metadata.get("accepted_base_sha") != candidate.get("base_sha")):
    stop("normalized run metadata does not match candidate repository/base identity", 2)

resolver_provider = "codex" if provider == "gpt" else "claude"
