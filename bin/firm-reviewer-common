#!/usr/bin/env bash
# Shared controlled-root reviewer engine. Provider wrappers pass only gpt|claude and user arguments.
set -euo pipefail
__src="${BASH_SOURCE[0]}"
while [ -L "$__src" ]; do __d="$(cd -P "$(dirname "$__src")" && pwd)"; __src="$(readlink "$__src")"; case $__src in /*) ;; *) __src="$__d/$__src";; esac; done
SELF="$(cd -P "$(dirname "$__src")" && pwd)"
ROOT="$(cd "$SELF/.." && pwd)"
exec python3 - "$ROOT" "$SELF" "$@" <<'PY'
import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile

root = Path(sys.argv[1])
self_dir = Path(sys.argv[2])
argv = sys.argv[3:]

parser = argparse.ArgumentParser(prog="firm-reviewer-common")
parser.add_argument("provider", choices=("gpt", "claude"))
parser.add_argument("run_dir", nargs="?")
parser.add_argument("--run", dest="run_option")
parser.add_argument("--discovery-timeout")
parser.add_argument("--readiness-timeout")
parser.add_argument("--judge-timeout")
parser.add_argument("--grace")
parser.add_argument("--max-output")
parser.add_argument("--retain-raw-seconds")
parser.add_argument("--print-capability-contract", action="store_true",
                    help="print the provider capability contract as JSON and exit; reads nothing, "
                         "writes nothing, runs no provider")
args = parser.parse_intermixed_args(argv)
provider = args.provider
label = "firm-gpt-qa" if provider == "gpt" else "firm-claude-qa"

# ---------------------------------------------------------------------------
# The provider capability contract: one declaration per provider of the help surfaces discovery
# probes and the controls it requires ON EACH ONE. Discovery must interrogate the surface a control
# is actually PASSED on. Two distinct ways of getting that wrong have now been found here:
#
#   * 2026-08-21, false NEGATIVE: `codex --help` was probed while `codex exec ...` was invoked, so
#     five controls that exist only under `codex exec --help` were reported missing and a fully
#     capable provider was published as `unsupported_capability` (exit 3), silently suppressing the
#     cross-provider second voice on every run.
#   * 2026-08-21, false POSITIVE, found in review of the fix: probing the UNION of both surfaces and
#     accepting a control found on *some* surface certifies `--ask-for-approval` as ready because it
#     is in `codex --help` — while the invocation passed it to `codex exec`, which rejects it
#     (`codex exec -a never ...` exits 2, "unexpected argument '-a' found"). Same wrong question,
#     inverted answer. That invocation had never been executable at any Codex version; the discovery
#     defect was masking a second, independent defect underneath it.
#
# So a control is declared against exactly one surface and must be found THERE. Satisfaction on a
# surface the wrapper does not pass it on is a miss, not a pass. `subcommand` is the argv prefix that
# selects the surface (`[]` = top level); the probe is `executable + subcommand + ["--help"]`.
#
# `controls` are the EXACT tokens the invocation passes — `-a`, not `--ask-for-approval`. There is
# deliberately no alias/synonym map. The previous revision had one, and review defeated the drift
# check through it: adding real new controls `-x` and `--search` to the invocation plus
# `{"-x": "--model", "--search": "--model"}` to the alias map normalised both onto `--model`, which
# de-duplicated to a single entry and passed cleanly. Any normalisation step is a place where two
# unchecked controls can be laundered into one checked one, and an alias claim is a claim about the
# provider CLI that no offline check can refute. Every short form the wrapper passes is present
# verbatim in the help text of its own surface (measured against codex-cli 0.149.0 and Claude Code
# 2.1.238), so nothing is lost by searching for the token itself.
#
# This declaration is HAND-MAINTAINED and must agree, in both directions, with the equally
# hand-maintained judge_plan() below: same surfaces in the same order, same control tokens on each.
# tests/test-reviewer-capability-contract.sh asserts that, so an edit to one and not the other fails
# a test rather than a production run.
CAPABILITY_CONTRACT = {
    "gpt": {
        "surfaces": [
            # `-a` is top-level ONLY on codex-cli; `codex exec` rejects it outright.
            {"subcommand": [], "controls": ["-a"]},
            {"subcommand": ["exec"],
             "controls": ["--skip-git-repo-check", "--ignore-user-config", "--ignore-rules",
                          "--ephemeral", "-s", "-m", "-c", "--output-schema", "-o"]},
        ],
    },
    "claude": {
        # claude is invoked at top level (`claude -p ...`) and carries every control it passes in
        # `claude --help`. It declares one surface: probing a subcommand here would loosen a check
        # that is already correct, trading this defect class for its mirror image.
        "surfaces": [
            {"subcommand": [],
             "controls": ["-p", "--safe-mode", "--system-prompt", "--strict-mcp-config", "--model",
                          "--effort", "--output-format", "--json-schema", "--permission-mode",
                          "--tools", "--disallowedTools", "--no-session-persistence"]},
        ],
    },
}

# READINESS_CONTRACT — the authentication probe, per provider: the command actually run and the
# EXACT responses that command is known to give. Same declarative discipline as CAPABILITY_CONTRACT
# above, for the same reason: the previous revision asked both CLIs a question neither answers.
#
# Measured on 2026-08-21 against codex-cli 0.149.0 and Claude Code 2.1.238 (macOS 26.5.1, arm64):
#
#   codex login status --json   rc=2  "error: unexpected argument '--json' found"   NO SUCH FORM
#   codex login status          rc=0  "Logged in using ChatGPT"      (human text, written to stderr)
#   codex login status          rc=1  "Not logged in"                (empty CODEX_HOME)
#   claude auth status --json   rc=0  {"loggedIn":true,"authMethod":"claude.ai",...}
#   claude auth status --json   rc=1  {"loggedIn":false,"authMethod":"none","apiProvider":"firstParty"}
#
# So: codex answers only in human text and there is no JSON contract to invent (proposal item 3); it
# is parsed narrowly and literally, line-anchored, case-sensitive, one exact phrase per answer.
# claude answers in JSON but under `loggedIn`, matching neither key the old code read — which is why
# a fully authenticated CLI was published as "not a trusted structured available result" and BLOCKed.
#
# `exit_codes` is part of each answer, not decoration. The body and the exit status must AGREE: a
# "Logged in using ..." line delivered with a nonzero status, or a `loggedIn: true` payload from a
# command that failed, is not a fourth outcome to interpret — it is an unrecognised response, and
# unrecognised is BLOCK. Exactly one declared answer may match; zero matches, two matches, or a match
# whose exit status is undeclared all return None, and None is BLOCK. Nothing here can ever produce
# "available" from a response the CLI did not clearly give.
#
# There is deliberately NO model-readiness probe. See the readiness phase below for the argument.
READINESS_CONTRACT = {
    "gpt": {
        "command": ["login", "status"],
        "shape": "text",
        "keys": [],
        "answers": [
            {"answer": "ready", "exit_codes": [0], "line": r"Logged in using .+"},
            {"answer": "unavailable", "reason": "authentication", "exit_codes": [1],
             "line": r"Not logged in"},
        ],
    },
    "claude": {
        "command": ["auth", "status", "--json"],
        "shape": "json",
        "keys": ["loggedIn"],
        "answers": [
            {"answer": "ready", "exit_codes": [0], "key": "loggedIn", "value": True},
            {"answer": "unavailable", "reason": "authentication", "exit_codes": [1],
             "key": "loggedIn", "value": False},
        ],
    },
}

# CREDENTIAL_CONTRACT — the third hand-maintained declaration, and the only one that WIDENS what the
# judge can see. One entry per provider naming EXACTLY which ambient environment variables the judge
# inherits, which the seal must remove, and which real credential surfaces are materialised into the
# sealed control root. Everything not named here stays sealed.
#
# Why this exists: config_root is a freshly created empty directory and nothing seeded a credential
# into it, so the judge CLI was unauthenticated on every run in the firm's history. Change #2 made
# that classify honestly, so both directions returned a trusted exit 3 `authentication` — an accurate
# report of a judge that structurally could not run.
#
# MECHANISM, measured 2026-08-23 against codex-cli 0.149.0 and Claude Code 2.1.238 (macOS 26.5.1,
# arm64). The two providers fail for unrelated reasons and the answer is asymmetric on purpose:
#
#   codex — the credential is a file, `~/.codex/auth.json`, mode 600. Nothing else in ~/.codex is
#   needed: a sealed CODEX_HOME containing ONLY a copy of auth.json answers `Logged in using ChatGPT`
#   (rc 0) with HOME still sealed. So the whole-directory passthrough the proposal measured is not
#   necessary and is not used; history.jsonl, config.toml, the logs/goals/memories sqlite databases
#   and global state all stay out of reach. A COPY, not a symlink, deliberately: a symlink would let
#   the CLI write a refreshed token back into the operator's real ~/.codex, and the passthrough is
#   specified read-only against real credential surfaces.
#
#   claude — the credential is in the macOS keychain, and the proposal's central puzzle was that
#   setting CLAUDE_CONFIG_DIR *at all* reported logged out even when set to the exact path Claude
#   Code would have used anyway. That is not a keychain-versus-file switch. It is keychain SERVICE
#   NAMESPACING, and it is legible in the vendor's own code — the service name is built as
#
#       `Claude Code-credentials` + ("" if CLAUDE_CONFIG_DIR is unset
#                                    else "-" + sha256(config_dir)[:8])
#
#   so any value of CLAUDE_CONFIG_DIR asks the keychain for a DIFFERENT, non-existent item. The
#   account is `process.env.USER || os.userInfo().username`, and in the packaged binary the fallback
#   does not survive an emptied environment: with USER unset the account becomes `claude-code-user`
#   and the lookup misses. The lookup itself shells out to /usr/bin/security, which resolves the
#   login keychain through $HOME, so a sealed HOME breaks it a third way.
#
#   Three independent gates, therefore, and all three had to be relieved:
#     1. USER must be inherited          (else the keychain ACCOUNT is wrong)
#     2. CLAUDE_CONFIG_DIR must be UNSET (else the keychain SERVICE is namespaced away)
#     3. $HOME/Library/Keychains/login.keychain-db must resolve to the real login keychain
#                                        (else /usr/bin/security cannot open it at all)
#   With exactly those three, and nothing else, `claude auth status --json` answers
#   {"loggedIn": true, "authMethod": "claude.ai"} from a sealed HOME. Unsetting CLAUDE_CONFIG_DIR is
#   what makes this SAFE as well as necessary: Claude Code then reads $HOME/.claude, which is inside
#   the seal, so the operator's settings, hooks, plugins, MCP servers, skills and session history
#   remain unreachable. The one thing genuinely exposed is the login keychain file itself, named
#   below in `exposes` and repeated in the attempt record.
#
# FAIL CLOSED. A declared source that is missing, symlinked, foreign-owned or the wrong file type is
# refused and simply not materialised. The judge then runs in the sealed environment it has always
# had, the readiness probe answers "not logged in" in the provider's own words, and the wrapper
# returns the same trusted exit 3 `authentication` as before. There is no path here that turns a
# failed passthrough into an unauthenticated judge whose refusal could be read as a verdict.
CREDENTIAL_CONTRACT = {
    "gpt": {
        "inherit_environment": [],
        "unset_environment": [],
        "materialize": [
            {"id": "codex_auth", "kind": "copy", "source": "~/.codex/auth.json",
             "destination": "codex/auth.json", "mode": 0o400,
             "exposes": "codex_oauth_credential",
             "caveats": [
                 "A copy at mode 0400, so the operator's ~/.codex/auth.json cannot be written "
                 "through this passthrough. A token the CLI refreshes during the judge run is "
                 "written to the copy and discarded with the control root.",
             ]},
        ],
    },
    "claude": {
        # USER only. It is not a credential, it is the keychain account selector; without it the
        # lookup asks for an account that does not exist.
        "inherit_environment": ["USER"],
        # Not "set to something harmless" — REMOVED. Any value namespaces the keychain service.
        "unset_environment": ["CLAUDE_CONFIG_DIR"],
        "materialize": [
            {"id": "login_keychain", "kind": "symlink",
             "source": "~/Library/Keychains/login.keychain-db",
             "destination": "Library/Keychains/login.keychain-db", "mode": None,
             "exposes": "macos_login_keychain",
             # Both of these were true from the first commit and were stated only in conversation.
             # A caveat that lives in a handback is a caveat the next reader does not get, so they
             # are published here, reach --print-capability-contract, and are written into every
             # attempt record beside the exposure they qualify.
             "caveats": [
                 "This is a live symlink to the operator's real login keychain, so Claude Code's "
                 "OAuth refresh can WRITE BACK through it. It is the one surface in this "
                 "passthrough that is not read-only. A copy is not an alternative: the credential "
                 "is obtainable only by extracting plaintext tokens from the keychain.",
                 "The canary is silent on keychain CONTENTS by construction. It checks whether a "
                 "path inside the sealed home resolves onto an operator surface; it does not and "
                 "cannot enumerate what this keychain holds, so any other secret in the operator's "
                 "login keychain that the claude binary's ACLs permit is within reach of that "
                 "process and is not covered by any check here.",
             ]},
        ],
    },
}

# READ_BOUNDARY — what actually stops the judge reading a file, per provider. This used to be a list
# called ISOLATED_SURFACES naming nine operator surfaces as unreachable, and in the gpt direction
# THAT CLAIM WAS FALSE. Review proved it in one turn: rebuilding this exact phase environment and
# running this exact gpt argv, the judge returned the verbatim contents of ~/.codex/history.jsonl and
# ~/.claude/settings.json — two of the nine.
#
# The mechanism, and the reason neither guard below could ever have caught it:
#
#   `-s read-only` is a WRITE denial. It denies writes everywhere and permits reads everywhere.
#   The seal (HOME / XDG_CONFIG_HOME / CODEX_HOME / CLAUDE_CONFIG_DIR) redirects where the CLI looks
#   for its CONFIGURATION. Neither of those bounds where the MODEL may read. An absolute-path read
#   never touches the sealed home at all, so credential_seal_audit() — which walks the sealed home
#   for symlinks escaping the control root — and the live canary — which asks whether
#   sealed_home/<rel> resolves onto real_home/<rel> — are both looking at the wrong object. They were
#   not broken; they were answering a question about the shape of the sealed home and being read as
#   an answer about filesystem isolation.
#
# `-s read-only` predates this change, so the exposure is not new. The FALSE ASSERTION was new, and
# it was published through --print-capability-contract into every attempt record. The operator's
# ruling: restate the declaration honestly, do not scope the sandbox and do not change the tool
# posture. So this declares the boundary that exists rather than the one that would be nicer:
#
#   gpt     — bounded by THE OPERATOR'S UID. Everything the operator can read, the judge can read:
#             ~/.ssh, ~/.aws, ~/.claude.json, the whole source tree. What the seal provides here is
#             configuration redirection and write denial, and nothing else. The judge is bounded by
#             its role contract and by write denial, not by the filesystem.
#   claude  — bounded by THE PERMISSION SYSTEM, and this half was verified as declared: with
#             `--permission-mode dontAsk --tools Read,Grep,Glob` plus the explicit denials, a Read of
#             an absolute path outside the working directory was REFUSED and recorded in
#             `permission_denials`. That is what holds the line in this direction — the permission
#             system, not the seal.
READ_BOUNDARY = {
    "gpt": {
        "bounded_by": "operator_uid",
        "enforced_by": ["-s read-only (write denial only; reads are permitted everywhere)"],
        "model_may_read": "any path readable by the operator's uid, including every surface listed "
                          "in seal_redirects_configuration_for",
        "verified": "2026-08-23 review read ~/.codex/history.jsonl and ~/.claude/settings.json "
                    "verbatim from inside this environment",
    },
    "claude": {
        "bounded_by": "permission_system",
        "enforced_by": ["--permission-mode dontAsk", "--tools Read,Grep,Glob",
                        "--disallowedTools Edit,Write,Bash,WebFetch,WebSearch",
                        "--strict-mcp-config <empty>"],
        "model_may_read": "paths the permission system allows; refusals are recorded by the CLI in "
                          "permission_denials",
        "verified": "2026-08-23 review saw a Read of an absolute path outside the working directory "
                    "DENIED and recorded in permission_denials",
    },
}

# Surfaces the seal redirects the CLI's CONFIGURATION LOOKUP away from. This is a true and much
# smaller claim than the one it replaces: it says the provider CLI will not LOAD the operator's
# hooks, plugins, MCP servers, skills, settings or session history into the judge's session. It says
# NOTHING about whether the model can read those files, which in the gpt direction it plainly can.
SEAL_REDIRECTS_CONFIGURATION_FOR = [
    "agent_settings", "hooks", "plugins", "mcp_servers", "skills", "session_history",
    "operator_projects", "codex_history", "codex_global_state",
]

ENVIRONMENT_VALUE = re.compile(r"[A-Za-z0-9._-]{1,64}")

def credential_environment_names(provider_name):
    """Names only — never values. Used by the introspection path, which must stay credential-free."""
    declared = CREDENTIAL_CONTRACT[provider_name]
    return list(declared["inherit_environment"]), list(declared["unset_environment"])

def credential_declaration(provider_name):
    """The declaration as published: paths and kinds, no values, no secrets."""
    declared = CREDENTIAL_CONTRACT[provider_name]
    inherited, unset = credential_environment_names(provider_name)
    return {
        "inherit_environment": inherited,
        "unset_environment": unset,
        "materialize": [
            {"id": item["id"], "kind": item["kind"], "source": item["source"],
             "destination": item["destination"], "exposes": item["exposes"],
             # Published WITH the exposure, never separately: the qualification and the thing it
             # qualifies have to arrive together or the reader gets the reassuring half.
             "caveats": list(item.get("caveats", []))}
            for item in declared["materialize"]
        ],
        # The read boundary travels with the credential declaration because they are read together
        # and were previously contradicted by each other: a reader who saw a tightly scoped
        # credential passthrough alongside nine "isolated" surfaces reasonably concluded the judge
        # was confined, and in the gpt direction it is not.
        "read_boundary": dict(READ_BOUNDARY[provider_name]),
        "seal_redirects_configuration_for": list(SEAL_REDIRECTS_CONFIGURATION_FOR),
    }

# TRANSPORT SCHEMA. The canonical verdict schema is the CONTRACT the returned verdict is validated
# against; it is not, and cannot be, the wire format handed to a provider's structured-output option.
# Nothing had ever run past readiness against a live provider, so this was unexercised, and all three
# of the following are real 2026-08-23 measurements against codex-cli 0.149.0 / Claude Code 2.1.238:
#
#   codex exec --output-schema <canonical>
#     -> HTTP 400 invalid_json_schema: "In context=('properties','affected_criteria'),
#        'uniqueItems' is not permitted."
#   claude --json-schema <canonical>
#     -> "--json-schema is not a valid JSON Schema: no schema with key or ref
#        'https://json-schema.org/draft/2020-12/schema'"   (the $schema meta-schema is not resolvable
#        offline by the CLI's validator)
#   claude --json-schema <canonical minus $schema>
#     -> API Error 400: "tools.3.custom.input_schema: input_schema does not support oneOf, allOf, or
#        anyOf at the top level"   (the canonical schema's top-level allOf/if/then/else)
#
# So the projection below removes the meta-schema identity and the assertion keywords neither
# provider's structured-output dialect accepts, and keeps the structure. It WEAKENS NOTHING at the
# gate: the verdict that comes back is still validated against the full canonical schema by
# jsonschema.validate(), and the wrapper's own BLOCK/APPROVE blocker-object checks still run on top
# of that. The projection loosens what we ASK for, never what we ACCEPT.
#
# Key names inside `properties`/`$defs` are property names, not keywords, so those maps are recursed
# into by value only — otherwise a verdict field that happened to be called `pattern` or `default`
# would be silently deleted from the schema the judge is asked to fill in.
# Drop only what a provider was measured to reject — plus, unavoidably, whatever lives INSIDE a
# dropped combinator. Be precise about which is which, because the earlier wording here ("length,
# size and range constraints are KEPT on purpose") was wrong in a way that hid a real hole:
#
#   KEPT, and deliberately so, because they sit on properties: `pattern`, `minLength`, `minimum`.
#   These are what stop the judge returning `"environment": ""` or a blocker id of `BLOCKER-6` —
#   projecting `pattern` away made a live claude judge emit exactly that, and the canonical gate then
#   rejected a perfectly good verdict for a rule the judge had never been shown.
#
#   LOST AS COLLATERAL, because they appear ONLY inside the top-level allOf: `const`, `minItems`,
#   `maxItems`. That allOf is a single rule —
#       verdict == BLOCK  -> blockers minItems 1, blocker_objects minItems 1
#       otherwise         -> blockers maxItems 0, blocker_objects maxItems 0
#   — and it exists nowhere else in the schema. Dropping the combinator therefore removes the ONLY
#   statement relating `verdict` to `blockers`, while the required/additionalProperties rewrite below
#   simultaneously forces the judge to supply both arrays. That combination is a trap aimed squarely
#   at the APPROVE branch, which has still never run live: an approve-with-nits verdict is valid on
#   the wire and is then killed by the canonical gate as `reviewer_invalid`. Both live verdicts so
#   far were BLOCK WITH blockers, which is the one shape that happens to satisfy the missing rule.
#
# The combinator genuinely cannot go on the wire (claude: "input_schema does not support oneOf,
# allOf, or anyOf at the top level"), so the rule is carried where the projection DOES preserve it:
# verbatim in the `description` of `verdict`, `blockers` and `blocker_objects` in the canonical
# schema, and again in the judge prompt. transport_schema() copies descriptions untouched, so the
# judge is told the rule in the same document that demands the fields.
# tests/test-reviewer-credential-contract.sh asserts the projected schema still carries it.
TRANSPORT_SCHEMA_DROP = (
    "$schema", "$id",                                  # claude: meta-schema is not resolvable offline
    "allOf", "anyOf", "oneOf", "not", "if", "then", "else",  # claude: no combinator at the top level
    "uniqueItems",                                     # codex: "'uniqueItems' is not permitted"
    "format", "default", "examples",                   # annotation-only; not worth a 400 to carry
)
TRANSPORT_SCHEMA_MAPS = ("properties", "$defs", "definitions", "patternProperties")

def transport_schema(node):
    if isinstance(node, list):
        return [transport_schema(item) for item in node]
    if not isinstance(node, dict):
        return node
    projected = {}
    for key, value in node.items():
        if key in TRANSPORT_SCHEMA_DROP:
            continue
        if key in TRANSPORT_SCHEMA_MAPS and isinstance(value, dict):
            projected[key] = {name: transport_schema(sub) for name, sub in value.items()}
        else:
            projected[key] = transport_schema(value)
    # Strict structured outputs, measured: `codex exec --output-schema` returns HTTP 400
    # "'required' is required to be supplied and to be an array including every key in properties.
    # Missing 'blocker_objects'." Every object must therefore list every property as required and
    # close itself to additional ones. This makes the REQUEST demand fields the canonical schema
    # treats as conditional — `blocker_objects: []` on an APPROVE, for instance — which the canonical
    # schema and the wrapper's own APPROVE/BLOCK checks both accept, so it costs nothing at the gate.
    if isinstance(projected.get("properties"), dict):
        projected["required"] = sorted(projected["properties"])
        projected["additionalProperties"] = False
    return projected

def readiness_invocation(provider_name, executable):
    """The single construction of the readiness argv, derived from READINESS_CONTRACT. The wrapper
    runs this and nothing else in the readiness phase, so a command the declaration does not name
    cannot be sent to a provider."""
    return [executable] + list(READINESS_CONTRACT[provider_name]["command"])

def readiness_answer(provider_name, exit_code, raw):
    """Classify one readiness response into exactly one of three outcomes:

        ("ready", None)                -> the CLI said it is authenticated
        ("unavailable", <reason>)      -> the CLI said, in a declared form, that it is not
        (None, None)                   -> anything else: unparsable, unknown shape, ambiguous, or a
                                          declared body carrying an undeclared exit status

    The caller must treat None as BLOCK. It is never "probably fine" and never trusted-unavailable:
    "the probe did not give a recognised answer" and "the provider answered that it is unavailable"
    are different facts, and collapsing them is the defect class this wrapper keeps being bitten by.
    """
    declared = READINESS_CONTRACT[provider_name]
    text = raw.decode("utf-8", "replace")
    matched = []
    if declared["shape"] == "json":
        try:
            data = json.loads(text)
        except Exception:
            return None, None
        if not isinstance(data, dict):
            return None, None
        for answer in declared["answers"]:
            # Identity-strict: `1` must not satisfy `True`, and "true" must not either.
            value = data.get(answer["key"], None)
            if isinstance(value, bool) and value is answer["value"]:
                matched.append(answer)
    else:
        # Narrow, literal line matching. Whole stripped line, anchored at both ends, case-sensitive.
        # Other lines may exist (update notices and the like) but cannot themselves be the answer,
        # and a line that merely CONTAINS the phrase ("not logged in token=secret") is not a match.
        lines = [line.strip() for line in text.splitlines() if line.strip()]
        for answer in declared["answers"]:
            if any(re.fullmatch(answer["line"], line) for line in lines):
                matched.append(answer)
    if len(matched) != 1:
        return None, None
    answer = matched[0]
    if exit_code not in answer["exit_codes"]:
        return None, None
    return answer["answer"], answer.get("reason")

def judge_plan(provider_name, model, prompt, contract_text, empty_mcp, schema_path, schema_text,
               candidate_verdict):
    """The single structured description of the judge invocation: an ordered list of segments, each
    a subcommand step plus the options passed AT THAT POINT, and the trailing operands. argv and the
    surface/control split are both derived from this, so the invocation cannot disagree with itself
    about which surface a control is passed on — the exact thing that made `-a never` sit after
    `exec`, where Codex refuses it, for as long as the wrapper has existed."""
    if provider_name == "gpt":
        return ([
            {"subcommand": [], "options": [("-a", "never")]},
            {"subcommand": ["exec"], "options": [
                ("--skip-git-repo-check", None), ("--ignore-user-config", None),
                ("--ignore-rules", None), ("--ephemeral", None), ("-s", "read-only"),
                ("-m", model), ("-c", 'model_reasoning_effort="xhigh"'),
                ("--output-schema", str(schema_path)), ("-o", str(candidate_verdict)),
            ]},
        ], [prompt])
    return ([
        {"subcommand": [], "options": [
            ("-p", prompt), ("--safe-mode", None), ("--system-prompt", contract_text),
            ("--strict-mcp-config", str(empty_mcp)), ("--model", model), ("--effort", "xhigh"),
            ("--output-format", "json"), ("--json-schema", schema_text),
            ("--permission-mode", "dontAsk"), ("--tools", "Read,Grep,Glob"),
            ("--disallowedTools", "Edit,Write,Bash,WebFetch,WebSearch"),
            ("--no-session-persistence", None),
        ]},
    ], [])

def judge_invocation(provider_name, executable, model, prompt, contract_text, empty_mcp,
                     schema_path, schema_text, candidate_verdict):
    """Flatten judge_plan into argv. The single construction of the judge command line."""
    segments, operands = judge_plan(provider_name, model, prompt, contract_text, empty_mcp,
                                    schema_path, schema_text, candidate_verdict)
    argv = [executable]
    for segment in segments:
        argv.extend(segment["subcommand"])
        for flag, value in segment["options"]:
            argv.append(flag)
            if value is not None:
                argv.append(value)
    argv.extend(operands)
    return argv

def invocation_argv(provider_name):
    """The judge command line with every operand replaced by a dash-free placeholder. Carries no
    path, prompt, schema or credential."""
    return judge_invocation(provider_name, "EXECUTABLE", "MODEL", "PROMPT", "CONTRACT",
                            "EMPTY_MCP", "SCHEMA_PATH", "SCHEMA_TEXT", "CANDIDATE_VERDICT")

def invocation_surfaces(provider_name):
    """The surfaces the wrapper actually passes controls on, and which controls, derived from
    judge_plan itself rather than from a second hand-kept list. Cumulative subcommand path, so a
    nested subcommand would be described exactly."""
    segments, _ = judge_plan(provider_name, "MODEL", "PROMPT", "CONTRACT", "EMPTY_MCP",
                             "SCHEMA_PATH", "SCHEMA_TEXT", "CANDIDATE_VERDICT")
    surfaces = []
    path = []
    for segment in segments:
        path = path + list(segment["subcommand"])
        surfaces.append({"subcommand": list(path),
                         "controls": [flag for flag, _ in segment["options"]]})
    return surfaces

def surface_label(executable_name, subcommand):
    return " ".join([executable_name] + list(subcommand) + ["--help"])

def flag_present(flag, help_text):
    """Word-boundary match, not substring containment. `-s` occurs inside `--sandbox`, `--strict-...`
    and a hundred prose words; plain containment would report a short option as supported by any help
    text at all. It also stops a required `--model` being satisfied by an unrelated `--models`."""
    return re.search(r"(?<![\w-])" + re.escape(flag) + r"(?![\w-])", help_text) is not None

if args.print_capability_contract:
    # Introspection only, and ONLY introspection: any other argument makes this ambiguous with a real
    # engagement call, whose stdout is consumed by the caller. Refuse rather than short-circuit a run
    # someone meant to happen.
    conflicting = [name for name, value in (
        ("run directory", args.run_dir), ("--run", args.run_option),
        ("--discovery-timeout", args.discovery_timeout), ("--readiness-timeout", args.readiness_timeout),
        ("--judge-timeout", args.judge_timeout), ("--grace", args.grace),
        ("--max-output", args.max_output), ("--retain-raw-seconds", args.retain_raw_seconds),
    ) if value is not None]
    if conflicting:
        print(f"{label}: --print-capability-contract takes no other argument; got "
              + ", ".join(conflicting), file=sys.stderr)
        raise SystemExit(2)
    print(json.dumps({
        "schema_version": 2,
        "providers": {
            name: {
                "declared_surfaces": entry["surfaces"],
                "invocation_surfaces": invocation_surfaces(name),
                "invocation_argv": invocation_argv(name)[1:],
            }
            for name, entry in CAPABILITY_CONTRACT.items()
        },
        # The readiness declaration travels with the capability one, through the same guarded
        # introspection path, so a drift check can read both without a second entry point to secure.
        # `probe_argv` is built by readiness_invocation(), the same function the runtime calls, so a
        # command the declaration does not name cannot be run against a provider unnoticed.
        "readiness": {
            name: {
                "command": list(entry["command"]),
                "shape": entry["shape"],
                "keys": list(entry["keys"]),
                "answers": entry["answers"],
                "probe_argv": readiness_invocation(name, "EXECUTABLE")[1:],
            }
            for name, entry in READINESS_CONTRACT.items()
        },
        # The credential passthrough declaration, through the same guarded introspection path. NAMES
        # AND PATHS ONLY: no environment VALUE and no credential byte is ever produced here, so this
        # stays safe to print, diff and test offline.
        "credentials": {
            name: credential_declaration(name) for name in CREDENTIAL_CONTRACT
        },
    }, indent=2, sort_keys=True))
    raise SystemExit(0)

def stop(message, code=1):
    print(f"{label}: {message}", file=sys.stderr)
    raise SystemExit(code)

def positive(name, value, default, maximum):
    raw = str(default if value is None else value)
    if not re.fullmatch(r"[0-9]+", raw):
        stop(f"{name} must be a positive integer no greater than {maximum}", 2)
    number = int(raw)
    if number < 1 or number > maximum:
        stop(f"{name} must be between 1 and {maximum}", 2)
    return number

def bounded_nonnegative(name, value, default, maximum):
    raw = str(default if value is None else value)
    if not re.fullmatch(r"[0-9]+", raw):
        stop(f"{name} must be a nonnegative integer no greater than {maximum}", 2)
    number = int(raw)
    if number > maximum:
        stop(f"{name} must be between 0 and {maximum}", 2)
    return number

prefix = "FIRM_GPT_QA" if provider == "gpt" else "FIRM_CLAUDE_QA"
discovery_timeout = positive("discovery timeout", args.discovery_timeout or os.environ.get(prefix+"_DISCOVERY_TIMEOUT"), 15, 120)
readiness_timeout = positive("readiness timeout", args.readiness_timeout or os.environ.get(prefix+"_READINESS_TIMEOUT") or os.environ.get(prefix+"_PREFLIGHT_TIMEOUT"), 30, 180)
# DEFAULT 300 s, AND THE FIRST REAL CANDIDATE THE FIRM EVER JUDGED EXCEEDED IT.
#
# Measured 2026-08-23, run 20260823T030032Z-judge-credential-boundary, candidate 5a23596, gpt:
#   attempt gpt-c1-a0001   timed out at 300 s (default)   -> reviewer_timeout, BLOCK
#   attempt gpt-c1-a0002   timed out at 300 s (default)   -> reviewer_timeout, BLOCK
#   attempt gpt-c1-a0003   completed in 352 s, with --judge-timeout raised to 900
#
# So the default is not a margin around normal cost; it sits BELOW it for a real change of this
# firm, and two attempts were spent discovering that. A judge that cannot finish reads as a judge
# that failed: `reviewer_timeout` is a correctly classified BLOCK, and nothing in that outcome says
# "it needed more seconds". The number is left at 300 deliberately — raising a spend bound is a
# separate decision with its own approval, exactly as the eval ceiling was — but it is recorded here
# so the next person meets the measurement rather than the mystery. The ceiling of 900 is unchanged
# and is what the successful attempt ran under.
judge_timeout = positive("judge timeout", args.judge_timeout or os.environ.get(prefix+"_TIMEOUT"), 300, 900)
grace = positive("kill grace", args.grace or os.environ.get("FIRM_QA_KILL_GRACE"), 2, 30)
max_output = positive("output cap", args.max_output or os.environ.get("FIRM_QA_MAX_OUTPUT"), 65536, 1048576)
retain_raw_seconds = bounded_nonnegative(
    "raw retention", args.retain_raw_seconds if args.retain_raw_seconds is not None else os.environ.get("FIRM_QA_RETAIN_RAW_SECONDS"),
    0, 3600
)
if retain_raw_seconds != 0:
    stop("persistent raw retention is disabled; use allowlisted diagnostics only", 2)

def atomic_write(path, payload, mode=0o600):
    path = Path(path)
    parent = path.parent
    info = os.lstat(parent)
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
        raise OSError(f"unsafe output parent: {parent}")
    try:
        existing = os.lstat(path)
        if stat.S_ISLNK(existing.st_mode) or not stat.S_ISREG(existing.st_mode):
            raise OSError(f"refusing non-regular output: {path}")
    except FileNotFoundError:
        pass
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    tmp = parent / f".{path.name}.{os.getpid()}.{os.urandom(8).hex()}.tmp"
    fd = os.open(tmp, flags, mode)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb", closefd=True) as fh:
            fd = -1
            fh.write(payload)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
        os.chmod(path, mode, follow_symlinks=False)
    finally:
        if fd != -1:
            os.close(fd)
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass

def json_bytes(value):
    return (json.dumps(value, indent=2, sort_keys=True) + "\n").encode("utf-8")

def safe_dir(path, mode=0o700, create=False):
    path = Path(path)
    if create:
        try:
            os.mkdir(path, mode)
        except FileExistsError:
            pass
    info = os.lstat(path)
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        stop(f"unsafe directory component: {path}", 2)
    os.chmod(path, mode, follow_symlinks=False)
    return path

def resolve_run(raw):
    if raw is None:
        current = Path.cwd() / ".agent-firm" / "CURRENT_RUN"
        try:
            if current.is_symlink():
                stop("CURRENT_RUN must not be a symlink", 2)
            raw = current.read_text(encoding="utf-8").strip()
        except OSError:
            stop("no run dir (pass one or set CURRENT_RUN)", 2)
    if not raw or any(ord(ch) < 32 or ord(ch) == 127 for ch in raw):
        stop("run path is empty or contains a control character", 2)
    if any(part == ".." for part in Path(raw).parts):
        stop("run path contains traversal", 2)
    path = Path(raw)
    if not path.is_absolute():
        path = Path.cwd() / path
    path = Path(os.path.abspath(path))
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", path.name) or path.name in (".", ".."):
        stop("run id is unsafe", 2)
    if path.parent.name != "runs" or path.parent.parent.name != ".agent-firm":
        stop("run must be <repo>/.agent-firm/runs/<safe-id>", 2)
    repo = path.parent.parent.parent
    for component in (repo, repo / ".agent-firm", path.parent, path):
        try:
            info = os.lstat(component)
        except OSError:
            stop(f"run component does not exist: {component}", 2)
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
            stop(f"run component is symlinked, non-directory, or foreign-owned: {component}", 2)
    try:
        top = subprocess.check_output(["git", "-C", str(repo), "rev-parse", "--show-toplevel"], stderr=subprocess.DEVNULL, text=True).strip()
    except subprocess.SubprocessError:
        stop("run is not owned through a git repository root", 2)
    if os.path.realpath(top) != os.path.realpath(repo):
        stop("run repository identity is mismatched", 2)
    for relative in ("09-test-evidence", "08-qa-verdict.gpt.json", "08-qa-verdict.claude.json", "run.jsonl"):
        target = path / relative
        try:
            info = os.lstat(target)
        except FileNotFoundError:
            continue
        if stat.S_ISLNK(info.st_mode):
            stop(f"run output component is symlinked: {target}", 2)
        if relative == "09-test-evidence" and not stat.S_ISDIR(info.st_mode):
            stop("09-test-evidence is not a directory", 2)
        if relative != "09-test-evidence" and not stat.S_ISREG(info.st_mode):
            stop(f"run output is not a regular file: {target}", 2)
    return repo, path

run_arg = args.run_option or args.run_dir
repo, run = resolve_run(run_arg)
evidence = safe_dir(run / "09-test-evidence", 0o700, create=True)
if os.path.realpath(evidence) != os.path.join(os.path.realpath(run), "09-test-evidence"):
    stop("09-test-evidence parent is redirected", 2)
candidate_path = evidence / "qa-candidate.json"
try:
    if candidate_path.is_symlink():
        raise ValueError("candidate metadata is symlinked")
    candidate_raw = candidate_path.read_bytes()
    candidate = json.loads(candidate_raw)
except Exception as exc:
    stop(f"candidate metadata is missing or invalid; run firm-qa-checkout first: {exc}", 2)
sha = candidate.get("candidate_sha")
generation = candidate.get("generation")
checkout = candidate.get("checkout_path")
expected_checkout = repo / ".agent-firm" / "qa-checkout" / run.name
expected_checkout_literal = Path(str(candidate.get("repository_root", ""))) / ".agent-firm" / "qa-checkout" / run.name
if not isinstance(sha, str) or not re.fullmatch(r"[0-9a-f]{40}", sha):
    stop("candidate metadata needs a full 40-character SHA", 2)
if not isinstance(generation, int) or isinstance(generation, bool) or generation < 1:
    stop("candidate metadata generation is invalid", 2)
if candidate.get("run_id") != run.name or os.path.realpath(str(candidate.get("repository_root", ""))) != os.path.realpath(repo):
    stop("candidate metadata run/repository identity is mismatched", 2)
if candidate.get("schema_version") != 2 or not re.fullmatch(r"refs/heads/integration/[A-Za-z0-9._/-]+", str(candidate.get("source_ref", ""))):
    stop("candidate metadata version/source_ref is invalid", 2)
try:
    for component in (repo / ".agent-firm" / "qa-checkout", expected_checkout):
        info = os.lstat(component)
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
            raise ValueError(component)
    if (os.path.abspath(str(checkout)) != os.path.abspath(expected_checkout_literal)
            or os.path.realpath(str(checkout)) != os.path.realpath(expected_checkout)):
        raise ValueError("candidate checkout is not the exact canonical QA path")
except Exception as exc:
    stop(f"candidate checkout parent is unsafe or redirected: {exc}", 2)

def verify_candidate():
    try:
        current_raw = candidate_path.read_bytes()
        if current_raw != candidate_raw:
            return False, "candidate generation changed during reviewer attempt"
        if os.path.islink(checkout):
            return False, "candidate checkout became a symlink"
        head = subprocess.check_output(["git", "-C", checkout, "rev-parse", "HEAD"], stderr=subprocess.DEVNULL, text=True).strip()
        dirty = subprocess.check_output(["git", "-C", checkout, "status", "--porcelain=v1", "--untracked-files=all"], stderr=subprocess.DEVNULL, text=True)
        top = subprocess.check_output(["git", "-C", checkout, "rev-parse", "--show-toplevel"], stderr=subprocess.DEVNULL, text=True).strip()
        common = subprocess.check_output(["git", "-C", checkout, "rev-parse", "--git-common-dir"], stderr=subprocess.DEVNULL, text=True).strip()
        if not os.path.isabs(common):
            common = os.path.join(checkout, common)
        source = subprocess.check_output(["git", "-C", str(repo), "rev-parse", "--verify", candidate["source_ref"] + "^{commit}"], stderr=subprocess.DEVNULL, text=True).strip()
        ancestry = subprocess.run(["git", "-C", str(repo), "merge-base", "--is-ancestor", candidate["base_sha"], sha], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode
    except Exception as exc:
        return False, f"candidate checkout verification failed: {exc}"
    if head != sha or dirty:
        return False, "candidate checkout is moved, amended, mismatched, or dirty"
    if os.path.realpath(top) != os.path.realpath(checkout):
        return False, "candidate checkout path identity changed"
    if os.path.realpath(common) != os.path.realpath(str(candidate.get("git_common_dir", ""))):
        return False, "candidate repository identity changed"
    if source != sha or candidate.get("source_ref_sha") != sha or ancestry != 0:
        return False, "candidate source ref or accepted-base ancestry changed"
    return True, ""

valid, reason = verify_candidate()
if not valid:
    stop(reason, 1)

try:
    metadata_done = subprocess.run(
        [str(self_dir / "firm-new-run"), "--metadata-view", str(run)],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
