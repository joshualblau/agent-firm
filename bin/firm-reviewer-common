    resolved_model = json.loads(resolved_done.stdout)
    model = str(resolved_model["model"])
    model_display = str(resolved_model["display"])
    model_effort = str(resolved_model["effort"])
    model_tier = str(resolved_model["tier"])
except Exception as exc:
    stop(f"canonical reviewer model resolution was malformed: {exc}", 2)
if model_tier != "heavyweight" or model_effort != "xhigh":
    stop("canonical reviewer role must resolve to heavyweight/xhigh", 2)
override_name = "FIRM_GPT_QA_MODEL" if provider == "gpt" else "FIRM_CLAUDE_QA_MODEL"
override = os.environ.get(override_name)
if override is not None and override != model:
    stop(f"{override_name} must equal canonical reviewer model {model!r}", 2)

# Raw provider output exists only in a private, package-excluded transient control tree. Each attempt
# has an independent cleanup guardian; persistent raw retention is deliberately unsupported.
private_root = safe_dir(repo / ".agent-firm" / "private-reviewer-control", 0o700, create=True)
private_run = safe_dir(private_root / run.name, 0o700, create=True)
for old in list(private_run.iterdir()):
    try:
        info = os.lstat(old)
    except OSError as exc:
        stop(f"cannot inspect private reviewer-control entry {old}: {exc}", 2)
    if stat.S_ISLNK(info.st_mode) or info.st_uid != os.getuid() or not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
        stop(f"unsafe private reviewer-control entry: {old}", 2)

lock = evidence / f".reviewer-{provider}.lock"
lock_owner = {"schema_version":1, "pid":os.getpid(), "provider":provider, "run_id":run.name,
              "candidate_sha":sha, "generation":generation,
              "started_at":datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")}
try:
    os.mkdir(lock, 0o700)
except FileExistsError:
    try:
        info = os.lstat(lock)
        owner_path = lock / "owner.json"
        owner_info = os.lstat(owner_path)
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
            raise ValueError("lock is not an owned regular directory")
        if stat.S_ISLNK(owner_info.st_mode) or not stat.S_ISREG(owner_info.st_mode):
            raise ValueError("lock owner record is unsafe")
        owner = json.loads(owner_path.read_text(encoding="utf-8"))
        pid = int(owner["pid"])
        if owner.get("provider") != provider or owner.get("run_id") != run.name or owner.get("candidate_sha") != sha or owner.get("generation") != generation:
            raise ValueError("stale lock identity does not match this candidate")
        try:
            os.kill(pid, 0)
            alive = True
        except ProcessLookupError:
            alive = False
        except PermissionError:
            alive = True
        if alive:
            stop(f"another {provider} reviewer attempt holds the run lock", 1)
        stale = evidence / f".reviewer-{provider}.stale.{os.getpid()}.{os.urandom(4).hex()}"
        os.rename(lock, stale)
        shutil.rmtree(stale)
        os.mkdir(lock, 0o700)
    except SystemExit:
        raise
    except Exception as exc:
        stop(f"reviewer lock is unsafe or not provably stale: {exc}", 1)
atomic_write(lock / "owner.json", json_bytes(lock_owner), 0o600)

attempt = None
attempt_path = None
diagnostic_path = None
control = None
guardian = None
cleanup_failure = False

def make_event_id(kind):
    return f"evt-{kind}-{provider}-g{generation}-{os.getpid()}-{os.urandom(6).hex()}"

def ledger(event, event_id=None, **fields):
    event_id = event_id or make_event_id(event)
    command = [str(self_dir / "firm-ledger-log"), "--run", str(run), "--strict", "--event-id", event_id, event]
    command.extend(f"{key}={value}" for key, value in fields.items())
    done = subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    if done.returncode != 0:
        stop(f"target-ledger write failed: {done.stderr.strip()}", 1)
    return event_id

def update_attempt(status, exit_code, **fields):
    attempt["status"] = status
    attempt["exit_code"] = exit_code
    attempt["finished_at"] = datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    attempt.update(fields)
    atomic_write(attempt_path, json_bytes(attempt), 0o600)

def finalize_attempt(status, exit_code, event, ledger_fields=None, **fields):
    outcome_event_id = make_event_id(event)
    update_attempt(status, exit_code, outcome_event_id=outcome_event_id, **fields)
    payload = attempt_path.read_bytes()
    event_fields = {
        "provider":provider, "generation":generation, "sha":sha, "attempt":attempt_rel,
        "attempt_id":attempt_id, "exit_code":exit_code,
        "sha256":hashlib.sha256(payload).hexdigest(), "bytes":len(payload)
    }
    event_fields.update(ledger_fields or {})
    ledger(event, event_id=outcome_event_id, **event_fields)
    return outcome_event_id

try:
    attempts_dir = safe_dir(evidence / "reviewer-attempts", 0o700, create=True)
    state_path = evidence / f"reviewer-state.{provider}.json"
