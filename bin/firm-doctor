#!/usr/bin/env bash
# firm-doctor [--probe]
# Fail-closed profile / secrets / subscription doctor for the agent-firm.
#
# It answers one question with evidence: "is this project safely wired to my SUBSCRIPTION
# accounts, with no metered-API leak, isolated per-profile config, and working op+direnv secret
# plumbing?" The HEADLINE check is fail-closed: if a metered-API key is exported in a subscription
# project it ABORTS (exit 1), because such a key silently outranks your subscription and bills per token.
#
# Checks (see docs/PHASE4.md part 2):
#   1. BILLING GUARD (fail-closed): no ANTHROPIC_/OPENAI_/CODEX_API_KEY leaking into a subscription project
#   2. op (1Password CLI) present, >= 2.18.0, authenticated non-interactively (service-account)
#   3. direnv present, shell hook installed, current .envrc allowed
#   4. git hygiene: .env.op holds op:// REFERENCES only; secrets/auth are gitignored, none tracked
#   5. op:// references in .env.op actually resolve  (with --probe, or when op is authed)
#   6. Claude profile: CLAUDE_CONFIG_DIR isolated + CLAUDE_CODE_OAUTH_TOKEN present (macOS account switch)
#   7. Codex profile: CODEX_HOME isolated + has its own auth.json (switches the ChatGPT account)
#   8. both provider CLIs present and subscription login/model configuration ready
#   9. retired permission rules (fail-closed): the retirement policy is present AND readable, and no
#      settings.json still grants a rule it withdrew. "Could not check" counts as a FAIL, not a WARN.
#  10. P2 ledger-write configuration (fail-closed): the process row this host actually presents —
#      system, macOS/Darwin pair, architecture, Python version and implementation — against what
#      bin/firm-ledger-log admits. Without it this doctor could report 8 PASS / 5 FAIL on a machine
#      where EVERY ledger write was dead and never name the blocker, which is exactly what it did
#      when macOS moved to a row the writer had not proven yet.
#
# Every python probe here runs the interpreter bin/firm-python resolves — the same one the ledger
# writer runs — not whatever `python3` is first on PATH. A doctor that probes a different interpreter
# than the gate is answering a different question, and the two can (and did) disagree: PATH `python3`
# was conda 3.8.13 while the gate needs CPython 3.9.6, and an x86_64 Homebrew bash ahead of /bin/bash
# made a universal python report x86_64, so its own arm64 wheels would not load.
#
# Exit 0 when no FAIL (WARN is advisory). Exit 1 on ANY fail-closed FAIL. bash-3.2 safe (macOS).
#   --probe   also run live account/model probes — needs network and a small subscription turn.
set -uo pipefail
__src="${BASH_SOURCE[0]}"   # resolve symlinks so ~/.local/bin/firm-* finds the repo
while [ -L "$__src" ]; do __d="$(cd -P "$(dirname "$__src")" && pwd)"; __src="$(readlink "$__src")"; case $__src in /*) ;; *) __src="$__d/$__src";; esac; done
SELF="$(cd -P "$(dirname "$__src")" && pwd)"
. "$SELF/firm-python"

PROBE=0
case "${1:-}" in
  --probe) PROBE=1 ;;
  -h|--help) sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  '') : ;;
  *) echo "firm-doctor: unknown arg '$1' (use --probe or --help)" >&2; exit 2 ;;
esac

# ---- output helpers ------------------------------------------------------
FAILS=0; WARNS=0; PASSES=0
r=""; g=""; y=""; rd=""; dim=""
if [ -t 1 ]; then r=$'\033[0m'; g=$'\033[32m'; y=$'\033[33m'; rd=$'\033[31m'; dim=$'\033[2m'; fi
pass(){ PASSES=$((PASSES+1)); printf '  %sPASS%s %s\n' "$g" "$r" "$1"; }
warn(){ WARNS=$((WARNS+1));  printf '  %sWARN%s %s\n' "$y" "$r" "$1"; }
fail(){ FAILS=$((FAILS+1));  printf '  %sFAIL%s %s\n' "$rd" "$r" "$1"; }
info(){ printf '  %s·%s %s%s\n' "$dim" "$r" "$dim" "$1$r"; }
section(){ printf '\n%s%s%s\n' "$dim" "$1" "$r"; }

# perl-alarm wall-clock cap (macOS has no `timeout`); falls back to no cap if perl is absent.
run_capped(){ secs="$1"; shift; if command -v perl >/dev/null 2>&1; then perl -e 'alarm shift @ARGV; exec @ARGV' "$secs" "$@"; else "$@"; fi; }
# numeric "A >= B" for dotted versions (2.18.0 style), awk-based (portable, no sort -V).
ver_ge(){ awk -v a="$1" -v b="$2" 'BEGIN{na=split(a,A,"."); nb=split(b,B,"."); n=(na>nb)?na:nb; for(i=1;i<=n;i++){x=A[i]+0;y=B[i]+0; if(x>y){print "y";exit} if(x<y){print "n";exit}} print "y"}' | grep -q y; }

printf '%sagent-firm doctor%s  (%s)\n' "$dim" "$r" "$(pwd)"

# ==========================================================================
# 0. Subscription-context detection (drives fail-closed severity below)
# ==========================================================================
SUB=0
[ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && SUB=1
[ -n "${FIRM_PROFILE:-}" ] && SUB=1
[ -n "${CODEX_HOME:-}" ] && [ "${CODEX_HOME:-}" != "$HOME/.codex" ] && SUB=1
[ -f .env.op ] && SUB=1

# ==========================================================================
# 1. BILLING GUARD — the fail-closed headline
# ==========================================================================
section "1. Billing guard (metered-API leak)"
leaked=""
for v in ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN OPENAI_API_KEY CODEX_API_KEY; do
  [ -n "${!v:-}" ] && leaked="$leaked $v"
done
if [ -n "$leaked" ]; then
  if [ "$SUB" = 1 ]; then
    fail "metered-API key(s) exported in a SUBSCRIPTION project:$leaked"
    info  "these OUTRANK your subscription auth and silently bill per token. The .envrc unsets them; run 'unset$leaked' in this shell."
  else
    warn "API key(s) set:$leaked — metered/API mode (no subscription context detected). Fine only if that's intended."
  fi
else
  pass "no metered-API key leak (ANTHROPIC_/OPENAI_/CODEX_API_KEY all unset)"
fi
if [ -n "${OP_CONNECT_HOST:-}${OP_CONNECT_TOKEN:-}" ]; then
  warn "OP_CONNECT_HOST/OP_CONNECT_TOKEN set — these override OP_SERVICE_ACCOUNT_TOKEN; unset them for portable service-account auth."
fi

# ==========================================================================
# 2. 1Password CLI (op)
# ==========================================================================
section "2. 1Password CLI (op)"
if command -v op >/dev/null 2>&1; then
  opv="$(op --version 2>/dev/null | head -n1 | tr -d '[:space:]')"
  if [ -n "$opv" ] && ver_ge "$opv" "2.18.0"; then
    pass "op $opv (>= 2.18.0, supports service-account tokens)"
  else
    warn "op ${opv:-unknown} is older than 2.18.0 — service-account tokens need 2.18.0+; upgrade with 'brew upgrade 1password-cli'."
  fi
  if [ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
    if run_capped 15 op whoami >/dev/null 2>&1; then
      pass "op authenticated non-interactively (service account)"
    else
      if [ -f .env.op ]; then fail "OP_SERVICE_ACCOUNT_TOKEN set but 'op whoami' failed — this project's .env.op secrets won't resolve."
      else warn "OP_SERVICE_ACCOUNT_TOKEN set but 'op whoami' failed (bad/expired token or no network)."; fi
    fi
  else
    if [ -f .env.op ]; then warn "OP_SERVICE_ACCOUNT_TOKEN not set — .env.op op:// references can't resolve headlessly. Export it (from a shared vault; hand-carried on new machines)."
    else info "OP_SERVICE_ACCOUNT_TOKEN not set (no .env.op in this project, so not required here)."; fi
  fi
else
  if [ "$SUB" = 1 ]; then warn "op not found but this looks like a subscription project — install the 1Password CLI to resolve op:// secrets ('brew install 1password-cli')."
  else info "op not found (no secrets plumbing needed here)."; fi
fi

# ==========================================================================
# 3. direnv
# ==========================================================================
section "3. direnv"
if command -v direnv >/dev/null 2>&1; then
  pass "direnv present"
  hookfound=0
  for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile"; do
    [ -f "$rc" ] && grep -q 'direnv hook' "$rc" 2>/dev/null && hookfound=1
  done
  if [ "$hookfound" = 1 ]; then pass "direnv shell hook installed"; else warn "direnv shell hook not found in ~/.zshrc — add: eval \"\$(direnv hook zsh)\""; fi
  if [ -f .envrc ]; then
    st="$(direnv status 2>/dev/null)"
    case "$st" in
      *"Found RC allowed true"*|*"Found RC allowed 0"*) pass ".envrc is allowed (loaded on cd)" ;;
      *) warn ".envrc present but not allowed — run 'direnv allow' in this directory (approval is per-machine by design)." ;;
    esac
  else
    if [ -f .envrc.example ]; then info "no .envrc yet — 'cp .envrc.example .envrc', set FIRM_PROFILE, then 'direnv allow'."; else info "no .envrc in this directory."; fi
  fi
else
  if [ "$SUB" = 1 ]; then warn "direnv not found — install it so .envrc auto-loads on cd ('brew install direnv')."
  else info "direnv not found (not required outside a firm profile)."; fi
fi

# ==========================================================================
# 4. git hygiene — refs-only .env.op, secrets gitignored, none tracked
# ==========================================================================
section "4. git hygiene"
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  # 4a. .env.op must carry ONLY op:// references (no plaintext values)
  if [ -f .env.op ]; then
    bad=""
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in ''|\#*) continue ;; esac
      l="${line#export }"
      case "$l" in *=*) : ;; *) continue ;; esac
      val="${l#*=}"; val="${val%\"}"; val="${val#\"}"; val="${val%\'}"; val="${val#\'}"
      case "$val" in
        op://*) : ;;
        '$('*|'`'*) : ;;                       # a command substitution that resolves at load-time is acceptable
        *) bad="$bad ${l%%=*}" ;;              # a literal value = plaintext secret
      esac
    done < .env.op
    if [ -n "$bad" ]; then fail ".env.op contains non-op:// value(s) for:$bad — .env.op must hold op:// REFERENCES only, never secret values."
    else pass ".env.op holds op:// references only (no plaintext secrets)"; fi
  else
    info "no .env.op in this project (nothing to scan)."
  fi
  # 4b. secret/auth paths must be gitignored
  notign=""
  for p in .envrc .env .env.op.local .direnv/x .claude-work/x .codex-work/x sub/auth.json; do
    git check-ignore -q "$p" 2>/dev/null || notign="$notign $p"
  done
  if [ -n "$notign" ]; then fail "these secret/auth paths are NOT gitignored:$notign — add them to .gitignore before committing."
  else pass "secret/auth paths (.envrc, .env*, .direnv, .claude-*/, .codex-*/, **/auth.json) are gitignored"; fi
  # 4c. no obviously-secret file is tracked
  tracked="$(git ls-files 2>/dev/null | grep -E '(^|/)(auth\.json|\.env|\.envrc)$' | grep -vE '(\.example|\.op)$' || true)"
  if [ -n "$tracked" ]; then fail "secret file(s) are tracked in git: $(echo $tracked | tr '\n' ' ')— remove with 'git rm --cached'."
  else pass "no secret/auth file is tracked in git"; fi
  # 4d. .env.op itself SHOULD be committed (references only) when present
  if [ -f .env.op ] && git check-ignore -q .env.op 2>/dev/null; then
    warn ".env.op is gitignored — it holds only op:// references and is meant to be COMMITTED; add '!.env.op' to .gitignore."
  fi
else
  info "not inside a git work tree — skipping tracked-file / gitignore checks."
fi

# ==========================================================================
# 5. op:// references resolve (live; on --probe or when op is authed)
# ==========================================================================
if [ -f .env.op ] && command -v op >/dev/null 2>&1 && [ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
  section "5. op:// reference resolution"
  if run_capped 25 op run --no-masking --env-file=.env.op -- true >/dev/null 2>&1; then
    pass "every op:// reference in .env.op resolves"
  else
    fail "one or more op:// references in .env.op do NOT resolve — wrong vault/item/field, a Private-vault ref a service account can't read, or a renamed item. Run 'op run --env-file=.env.op -- true' to see which."
  fi
fi

# ==========================================================================
# 6. Claude profile isolation + account switch
# ==========================================================================
section "6. Claude profile"
DEF_CLAUDE="$HOME/.claude"
if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
  if [ -d "$CLAUDE_CONFIG_DIR" ]; then pass "CLAUDE_CONFIG_DIR isolates settings/agents/history/MCP: $CLAUDE_CONFIG_DIR"
  else warn "CLAUDE_CONFIG_DIR set to $CLAUDE_CONFIG_DIR but that directory doesn't exist yet — log in once: CLAUDE_CONFIG_DIR=$CLAUDE_CONFIG_DIR claude  (then /login)."; fi
  if [ -n "${FIRM_PROFILE:-}" ] && [ "$CLAUDE_CONFIG_DIR" = "$DEF_CLAUDE" ]; then
    warn "FIRM_PROFILE=$FIRM_PROFILE but CLAUDE_CONFIG_DIR is the default ~/.claude — profile isolation isn't applied."
  fi
else
  if [ "$SUB" = 1 ]; then warn "CLAUDE_CONFIG_DIR unset in a subscription project — set it via .envrc (CLAUDE_CONFIG_DIR=\$HOME/.claude-\$FIRM_PROFILE)."
  else info "CLAUDE_CONFIG_DIR unset (using the default ~/.claude)."; fi
fi
# macOS auth storage, re-measured on Claude Code 2.1.234 (the old text here predates it and was
# wrong in both directions). The credential is in the login Keychain, and `claude` fetches it by
# spawning `security find-generic-password -a "$USER" -s <service>`. TWO things scope that lookup:
#   * HOME — the default keychain search list is resolved from the invoking user's home directory,
#     so the identical lookup that succeeds under your HOME fails with rc 44 under any other one.
#   * CLAUDE_CONFIG_DIR — <service> is "Claude Code-credentials" only while CLAUDE_CONFIG_DIR is
#     UNSET. Set it, and the service becomes "Claude Code-credentials-<sha256(dir) first 8 hex>",
#     a per-directory namespace. So on this version CLAUDE_CONFIG_DIR DOES switch the account: each
#     config dir has its own keychain entry and its own /login. The entry is shared only across
#     config-dir-unset invocations.
info "macOS: the Claude credential is in the login Keychain, keyed by \$USER and namespaced per CLAUDE_CONFIG_DIR (unset ⇒ 'Claude Code-credentials'; set ⇒ '…-<sha256(dir)|8>'). It is NOT reachable from an isolated HOME."
if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
  pass "CLAUDE_CODE_OAUTH_TOKEN present — the one credential that needs no config dir and no Keychain, so it pins THIS account and is what firm-claude-qa's controlled root can use"
else
  if [ "$SUB" = 1 ]; then warn "CLAUDE_CODE_OAUTH_TOKEN not set — firm-claude-qa's controlled root isolates HOME, which severs the Keychain, so the Claude judge will report a trusted 'unavailable' (exit 3). Run 'claude setup-token' for this account, store it in op, and reference it from .env.op."
  else info "CLAUDE_CODE_OAUTH_TOKEN not set — firm-claude-qa's Claude judge will report a trusted 'unavailable' (exit 3) until it is."; fi
fi
if [ "$PROBE" = 1 ] && command -v claude >/dev/null 2>&1; then
  info "probe: run 'claude' then /status to confirm auth is subscription-OAuth-token (not an API key)."
fi

# ==========================================================================
# 7. Codex profile isolation (switches the ChatGPT account)
# ==========================================================================
section "7. Codex profile"
DEF_CODEX="$HOME/.codex"
if [ -n "${CODEX_HOME:-}" ]; then
  if [ "$CODEX_HOME" = "$DEF_CODEX" ]; then info "CODEX_HOME is the default ~/.codex (single ChatGPT account)."
  else pass "CODEX_HOME isolates the ChatGPT account: $CODEX_HOME"; fi
  if [ -d "$CODEX_HOME" ]; then
    if [ -f "$CODEX_HOME/auth.json" ]; then pass "$CODEX_HOME/auth.json present (a distinct logged-in ChatGPT account)"
    else warn "$CODEX_HOME has no auth.json — log in once: CODEX_HOME=$CODEX_HOME codex login."; fi
  else
    warn "CODEX_HOME=$CODEX_HOME doesn't exist yet — create it by logging in: CODEX_HOME=$CODEX_HOME codex login."
  fi
  if [ "$PROBE" = 1 ] && command -v codex >/dev/null 2>&1; then
    if run_capped 20 env CODEX_HOME="$CODEX_HOME" codex login status >/dev/null 2>&1; then pass "codex login status OK under $CODEX_HOME"
    else warn "codex login status failed under $CODEX_HOME — not logged in on that profile (or no network)."; fi
  fi
else
  if [ "$SUB" = 1 ]; then warn "CODEX_HOME unset in a subscription project — set it via .envrc (CODEX_HOME=\$HOME/.codex-\$FIRM_PROFILE) to select the ChatGPT account."
  else info "CODEX_HOME unset (using the default ~/.codex)."; fi
fi
info "Codex config profiles (--profile) do NOT switch accounts — only CODEX_HOME does."

# ==========================================================================
# 8. Tooling sanity (GPT judge + bootstrap) — informational
# ==========================================================================
section "8. Tooling"
# Shell PATH: a plugin's bin/ is on PATH only INSIDE a claude session, so firm-install & friends
# must be linked out (firm-link) to be usable from a terminal.
if command -v firm-install >/dev/null 2>&1; then
  _fi="$(command -v firm-install)"
  _resolved="$_fi"
  while [ -L "$_resolved" ]; do
    _d="$(cd -P "$(dirname "$_resolved")" && pwd)"; _resolved="$(readlink "$_resolved")"
    case $_resolved in /*) ;; *) _resolved="$_d/$_resolved";; esac
  done
  if [ "$_resolved" = "$SELF/firm-install" ]; then
    pass "firm-* on PATH at $_fi → this repo"
  else
    warn "firm-install on PATH resolves to $_resolved, not $SELF/firm-install — run 'firm-link' to repoint it at this repo."
  fi
else
  warn "firm-* not on your shell PATH — run '$SELF/firm-link' (a plugin's bin/ is only on PATH inside a claude session)."
fi
# Python prerequisites. jsonschema is GATE-CRITICAL: without it firm-validate-verdict exits 4
# (DEGRADED) and a QA verdict cannot clear the Final gate.
# pyyaml is gate-critical in 0.8.0 because firm-final-qa-check parses structured two-voice state.
#
# These probe the RESOLVED interpreter, not `python3` from PATH. "Installed" is a property of one
# interpreter: a package installed for PATH's python is not installed for the firm's, and reporting
# the wrong one produces both false greens and false reds (an arm64 jsonschema that only fails to
# load because a translated shell forced the probe into Rosetta was reported here as MISSING).
info "python interpreter under test: $FIRM_PYTHON_DISPLAY"

# _import_proved <module> — rc 0 only if the resolved interpreter DEMONSTRABLY imported <module>.
#
# `firm_python -c import X` was an exit status and nothing else, and an exit status is a number any
# program can return without importing anything (SEC-01). A `#!/bin/sh` + `exit 0` shim named python3
# produced PASS for both GATE-CRITICAL dependencies here with no Python executed at all. The
# resolver refuses that shim now, but $FIRM_PYTHON on a host with no compliant interpreter can still
# make the degraded argv something that is not an interpreter, and this check has no business
# depending on a fix one layer down. So the probe carries proof: the marker is built FROM the module
# name inside the interpreter, so a constant `echo` cannot answer for an arbitrary module either.
# The program is a named constant rather than an inline multi-line string, so the `[ ... ]` test
# below stays one readable line.
_IMPORT_PROBE='import importlib, sys; importlib.import_module(sys.argv[1]); sys.stdout.write("FIRM_DOCTOR_IMPORTED:" + sys.argv[1])'
_import_proved() {
  [ "$(firm_python -c "$_IMPORT_PROBE" "$1" 2>/dev/null)" = "FIRM_DOCTOR_IMPORTED:$1" ]
}
if _import_proved jsonschema; then
  pass "python jsonschema present — QA verdicts can be schema-validated"
else
  fail "python jsonschema MISSING for $FIRM_PYTHON_DISPLAY — firm-validate-verdict exits 4 (DEGRADED) and no QA verdict can pass the Final gate"
  info "fix: bin/firm-python -m pip install --user jsonschema pyyaml   (or: firm-bootstrap --with-python-deps)"
fi
if _import_proved yaml; then
  pass "python pyyaml present — traceability, eval assertions, and final QA can parse exactly"
else
  fail "python pyyaml missing for $FIRM_PYTHON_DISPLAY — firm-final-qa-check cannot evaluate two-voice state; install with 'bin/firm-python -m pip install --user pyyaml'."
fi

# Retired permission rules. firm-install only unions rules, so a project installed before a rule was
# withdrawn keeps it forever. This is a FAIL, not a warning: the retired rules read around the
# Read-tool deny rules, and a warning would leave that open in every project that already has one.
#
# The checker below must not report a clean PASS on a settings.json it couldn't actually verify. The
# first version of this check did exactly that: `except Exception: sys.exit(0)` treated invalid JSON,
# or `permissions` shaped as a list instead of an object, as "no retired rules found" — a false PASS on
# the one file this check exists to inspect. Every parse failure now prints nothing but an error to
# stderr and exits 2.
#
# Every non-verifying outcome below is a FAIL, not a WARN, because WARN does not reach the exit code
# (see the summary block at the bottom: only FAILS gates it). Downgrading the printed line from a false
# PASS to a WARN — as the first repair of this check did — still lets `firm-doctor && <run the firm>`
# proceed on a settings file nobody could read. For a fail-closed check "I could not verify this" and
# "this is broken" have to cost the same, or the check is advice rather than a gate. The three
# non-verifying outcomes are: the retirement policy is missing, the retirement policy is unreadable,
# and a settings.json cannot be parsed. Each is UNVERIFIED, never clean.
RETIRED_JSON="$SELF/../agent-firm/policy/retired-permissions.json"
_pol_ok=0
_pol_err=""
if [ ! -f "$RETIRED_JSON" ]; then
  # No `else`-less skip here. A deleted, renamed or (in plugin mode) simply not-where-we-looked policy
  # file used to make this whole FAIL-class check evaporate with no output at all, so the one way to
  # silence it was to remove the file it reads.
  fail "retired-permission policy NOT FOUND at $RETIRED_JSON — the retired-rule check could not run (SKIPPED, not passed)"
  info "restore agent-firm/policy/retired-permissions.json (or reinstall the plugin), then re-run firm-doctor."
else
  # Validate the POLICY once, before looking at any settings file. Doing it here rather than inside
  # the per-scope loop keeps the message honest ("the policy is unusable", not "your settings.json
  # could not be checked") and costs one FAIL for one defect instead of one per settings file.
  _pol_err="$(firm_python - "$RETIRED_JSON" <<'PY' 2>&1 >/dev/null
import json, sys
try:
    entries = json.load(open(sys.argv[1])).get("retired", [])
    if not isinstance(entries, list):
        raise ValueError("`retired` is not a JSON array")
    for i, e in enumerate(entries):
        rule = e.get("rule") if isinstance(e, dict) else None
        if not isinstance(rule, str) or not rule:
            raise ValueError(f"entry #{i} has no usable `rule`")
        declared = e.get("scope")
        if declared is None:
            raise ValueError(f"entry `{rule}` declares no `scope`")
        buckets = [declared] if isinstance(declared, str) else declared
        if not isinstance(buckets, list) or not buckets or not all(isinstance(b, str) for b in buckets):
            raise ValueError(f"entry `{rule}` has a malformed `scope`")
        if "deny" in buckets:
            raise ValueError(f"entry `{rule}` scopes a DENY rule for deletion — deny is a protection, "
                             f"and firm-install refuses such a policy outright (exit 4)")
        unknown = [b for b in buckets if b not in ("allow", "ask")]
        if unknown:
            raise ValueError(f"entry `{rule}` names unknown permission list(s) {unknown}")
except Exception as e:
    print(f"{type(e).__name__}: {e}", file=sys.stderr)
    sys.exit(2)
PY
)"
  if [ $? -eq 0 ]; then
    _pol_ok=1
  else
    fail "retired-permission policy at $RETIRED_JSON is unusable — the retired-rule check could not run (SKIPPED, not passed)"
    info "retired-permission policy problem: $_pol_err"
    info "fix agent-firm/policy/retired-permissions.json, then re-run firm-doctor."
  fi
fi

if [ "$_pol_ok" -eq 1 ]; then
  for _scope in project user; do
    if [ "$_scope" = project ]; then _sfile=".claude/settings.json"; _sflag=""; else _sfile="$HOME/.claude/settings.json"; _sflag=" --user"; fi
    [ -f "$_sfile" ] || continue
    # `scope` is honoured the same way firm-install honours it: a rule is only reported as a live
    # grant in the list(s) its retirement entry names. Reporting a hit in `deny` as "still grants a
    # retired rule" would be both wrong (deny withholds, it does not grant) and unactionable — the fix
    # it prints, `firm-install --migrate`, refuses to delete deny rules. A deny hit is INFO instead.
    #
    # This re-validates the policy the guard above already validated. That duplication is deliberate:
    # this is the script that decides what gets reported as a live grant, and in a fail-closed check it
    # should not be able to produce a PASS from a policy it never checked, however it came to be run.
    _out="$(firm_python - "$RETIRED_JSON" "$_sfile" <<'PY' 2>&1
import json, os, sys
try:
    entries = json.load(open(sys.argv[1])).get("retired", [])
    if not isinstance(entries, list):
        raise ValueError("`retired` is not a JSON array")
    scoped = {"allow": set(), "ask": set()}
    every = set()
    for i, e in enumerate(entries):
        rule = e.get("rule") if isinstance(e, dict) else None
        if not isinstance(rule, str) or not rule:
            raise ValueError(f"retired entry #{i} has no usable `rule`")
        declared = e.get("scope")
        if declared is None:
            raise ValueError(f"retired entry `{rule}` declares no `scope`")
        buckets = [declared] if isinstance(declared, str) else declared
        if not isinstance(buckets, list) or not buckets or not all(isinstance(b, str) for b in buckets):
            raise ValueError(f"retired entry `{rule}` has a malformed `scope`")
        if "deny" in buckets:
            raise ValueError(f"retired entry `{rule}` scopes a DENY rule for deletion — deny is a protection")
        unknown = [b for b in buckets if b not in ("allow", "ask")]
        if unknown:
            raise ValueError(f"retired entry `{rule}` names unknown permission list(s) {unknown}")
        every.add(rule)
        for b in buckets:
            scoped[b].add(rule)
    perms = json.load(open(sys.argv[2])).get("permissions", {})
    if not isinstance(perms, dict):
        raise ValueError("`permissions` is not a JSON object")
    for k in ("allow", "ask", "deny"):
        if not isinstance(perms.get(k, []), list):
            raise ValueError(f"`permissions.{k}` is not a JSON array")
    hits = sorted({r for k in ("allow", "ask") for r in perms.get(k, []) if r in scoped[k]})
    deny_hits = sorted({r for r in perms.get("deny", []) if r in every})
    # PROOF OF EXECUTION, first line. rc 0 with no hits used to be read as "no retired rules", and a
    # program that never ran produces exactly that: rc 0, empty stdout (SEC-01). The marker carries
    # the settings file this run actually opened, so it cannot be answered by a constant echo either.
    print("FIRM_DOCTOR_RETIRED_OK " + os.path.realpath(sys.argv[2]))
    print(" ".join(hits))
    print(" ".join(deny_hits))
except Exception as e:
    print(f"{type(e).__name__}: {e}", file=sys.stderr)
    sys.exit(2)
PY
)"
    _py_rc=$?
    _proof="$(printf '%s\n' "$_out" | sed -n '1p')"
    _hits="$(printf '%s\n' "$_out" | sed -n '2p')"
    _deny_hits="$(printf '%s\n' "$_out" | sed -n '3p')"
    _want_proof="FIRM_DOCTOR_RETIRED_OK $(cd -P "$(dirname "$_sfile")" 2>/dev/null && pwd -P)/$(basename "$_sfile")"
    if [ "$_py_rc" -ne 0 ]; then
      fail "$_scope settings.json could not be checked for retired permission rules ($_out) — fix the file's JSON, then re-run firm-doctor."
      info "firm-doctor fails closed: a settings file it cannot parse is UNVERIFIED, not clean."
    elif [ "$_proof" != "$_want_proof" ]; then
      # The checker exited 0 without proving it ran. "Could not check" is a FAIL here, not a WARN,
      # and it is emphatically not a PASS: the comment above says this check must not be able to
      # produce a PASS from a policy it never checked, however it came to be run.
      fail "$_scope settings were NOT checked for retired permission rules — the checker exited 0 without proving it ran (SKIPPED, not passed)"
      info "the resolved interpreter ($FIRM_PYTHON_DISPLAY) did not execute the check. Verify it with: bin/firm-python --status"
    elif [ -n "$_hits" ]; then
      fail "$_scope settings still grant RETIRED permission rule(s): $_hits"
      info "these read around the Read-tool deny rules. Fix: firm-install$_sflag --migrate"
    else
      pass "$_scope settings carry no retired permission rules"
    fi
    if [ -n "$_deny_hits" ]; then
      info "$_scope settings also list retired rule(s) under \`deny\` ($_deny_hits) — left alone; deny withholds, it does not grant."
    fi
  done
fi

section "9. Provider CLIs and reviewer readiness"
if [ -x "$SELF/firm-version" ]; then
  if "$SELF/firm-version" --check >/dev/null 2>&1; then pass "Claude and Codex plugin manifest base versions match"
  else fail "plugin manifest versions drifted — run 'firm-version --check' for details"; fi
fi

resolve_reviewer_tuple() {
  _provider="$1"; _override_set="$2"; _override="$3"
  _resolver_args=(--provider "$_provider" --role reviewer --format json)
  if [ "$_override_set" = x ]; then _resolver_args+=(--expect-model "$_override"); fi
  _resolved="$($SELF/firm-model-resolve "${_resolver_args[@]}" 2>&1)"; _resolved_rc=$?
  [ "$_resolved_rc" -eq 0 ] || { printf '%s\n' "$_resolved" >&2; return "$_resolved_rc"; }
  printf '%s' "$_resolved" | firm_python -c '
import json,sys
provider=sys.argv[1]; d=json.load(sys.stdin)
assert set(d)=={"provider","selected_by","selector","tier","model","display","effort","policy_sha256"}
assert d["provider"]==provider and d["selected_by"]=="role" and d["selector"]=="reviewer"
assert d["tier"]=="heavyweight" and d["effort"]=="xhigh"
for field in ("model","display","effort"):
 value=d[field]; assert isinstance(value,str) and value and not any(ord(ch)<32 for ch in value)
print("\t".join((d["model"],d["display"],d["effort"])))
' "$_provider"
}

MODEL_ENVELOPE_READY=1
_claude_tuple="$(resolve_reviewer_tuple claude "${FIRM_CLAUDE_QA_MODEL+x}" "${FIRM_CLAUDE_QA_MODEL:-}")"; _claude_tuple_rc=$?
if [ "$_claude_tuple_rc" -ne 0 ]; then
  fail "canonical Claude reviewer envelope or FIRM_CLAUDE_QA_MODEL compatibility alias is invalid; no provider command ran"
  MODEL_ENVELOPE_READY=0
else
  IFS=$'\t' read -r CLAUDE_REVIEW_MODEL CLAUDE_REVIEW_DISPLAY CLAUDE_REVIEW_EFFORT <<< "$_claude_tuple"
fi
_codex_tuple="$(resolve_reviewer_tuple codex "${FIRM_GPT_QA_MODEL+x}" "${FIRM_GPT_QA_MODEL:-}")"; _codex_tuple_rc=$?
if [ "$_codex_tuple_rc" -ne 0 ]; then
  fail "canonical Codex reviewer envelope or FIRM_GPT_QA_MODEL compatibility alias is invalid; no provider command ran"
  MODEL_ENVELOPE_READY=0
else
  IFS=$'\t' read -r CODEX_REVIEW_MODEL CODEX_REVIEW_DISPLAY CODEX_REVIEW_EFFORT <<< "$_codex_tuple"
fi

if [ "$MODEL_ENVELOPE_READY" = 1 ] && command -v claude >/dev/null 2>&1; then
  pass "claude present — Claude-primary orchestration and firm-claude-qa are available"
  if run_capped 10 claude auth status >/dev/null 2>&1; then
    pass "Claude subscription authentication is ready"
    if [ "$PROBE" = 1 ]; then
      if run_capped 45 claude -p "Reply with exactly: ok" --model "$CLAUDE_REVIEW_MODEL" \
        --effort "$CLAUDE_REVIEW_EFFORT" --output-format text --permission-mode dontAsk --tools "" \
        --no-session-persistence >/dev/null 2>&1; then
        pass "Claude reviewer $CLAUDE_REVIEW_DISPLAY ($CLAUDE_REVIEW_MODEL, effort $CLAUDE_REVIEW_EFFORT) completed a bounded no-tools probe"
      else
        warn "Claude reviewer $CLAUDE_REVIEW_DISPLAY ($CLAUDE_REVIEW_MODEL, effort $CLAUDE_REVIEW_EFFORT) failed its bounded probe — check model compatibility, quota, and login."
      fi
    else
      info "canonical Claude reviewer: display=$CLAUDE_REVIEW_DISPLAY model=$CLAUDE_REVIEW_MODEL effort=$CLAUDE_REVIEW_EFFORT (run firm-doctor --probe to verify it live)"
    fi
  else warn "Claude authentication is not ready — run 'claude auth' or the provider's login flow before using Claude staff/reviewer."; fi
elif [ "$MODEL_ENVELOPE_READY" != 1 ]; then
  info "Claude provider checks skipped because canonical reviewer-envelope validation failed first."
else
  fail "claude not found — dual-provider Agent Firm installation is incomplete"
fi
if [ "$MODEL_ENVELOPE_READY" = 1 ] && command -v codex >/dev/null 2>&1; then
  pass "codex present — Codex-primary orchestration and firm-gpt-qa are available"
  if run_capped 10 codex login status >/dev/null 2>&1; then
    pass "Codex ChatGPT subscription authentication is ready"
    if [ "$PROBE" = 1 ]; then
      # -a/--ask-for-approval is INTERACTIVE-ONLY on codex-cli 0.147.0 and is not a clap global, so
      # `codex exec ... -a never` is `error: unexpected argument '-a' found` (rc 2) and the probe
      # never reaches the model. That made --probe report the canonical GPT reviewer failing on a
      # host where it works perfectly, which is the loudest possible false negative from the
      # quietest possible cause. The same never-ask policy is stated the way exec does accept it,
      # as the typed -c override firm-reviewer-common already sends to the real judge.
      if run_capped 45 codex exec --skip-git-repo-check --ephemeral -s read-only \
        -m "$CODEX_REVIEW_MODEL" -c "model_reasoning_effort=\"$CODEX_REVIEW_EFFORT\"" \
        -c "approval_policy=\"never\"" \
        "Reply with exactly: ok" >/dev/null 2>&1; then
        pass "GPT reviewer $CODEX_REVIEW_DISPLAY ($CODEX_REVIEW_MODEL, effort $CODEX_REVIEW_EFFORT) completed a bounded read-only probe"
      else
        warn "GPT reviewer $CODEX_REVIEW_DISPLAY ($CODEX_REVIEW_MODEL, effort $CODEX_REVIEW_EFFORT) failed its bounded probe — check model compatibility, quota, and login."
      fi
    else
      info "canonical Codex reviewer: display=$CODEX_REVIEW_DISPLAY model=$CODEX_REVIEW_MODEL effort=$CODEX_REVIEW_EFFORT (run firm-doctor --probe to verify it live)"
    fi
  else warn "Codex authentication is not ready — run 'codex login' before using GPT staff/reviewer."; fi
elif [ "$MODEL_ENVELOPE_READY" != 1 ]; then
  info "Codex provider checks skipped because canonical reviewer-envelope validation failed first."
else
  fail "codex not found — dual-provider Agent Firm installation is incomplete"
fi
if [ "$MODEL_ENVELOPE_READY" = 1 ]; then
  info "canonical reviewer models: GPT=$CODEX_REVIEW_DISPLAY ($CODEX_REVIEW_MODEL, $CODEX_REVIEW_EFFORT) · Claude=$CLAUDE_REVIEW_DISPLAY ($CLAUDE_REVIEW_MODEL, $CLAUDE_REVIEW_EFFORT)"
fi

section "9.5. Plugin hook ownership and legacy duplicates"
FIRM_SOURCE_ROOT="$(cd "$SELF/.." && pwd)"
_hook_manifest_out="$(firm_python - "$FIRM_SOURCE_ROOT" <<'PY' 2>/dev/null
import json, os, sys
root = sys.argv[1]
claude_plugin = json.load(open(os.path.join(root, ".claude-plugin", "plugin.json")))
codex_plugin = json.load(open(os.path.join(root, ".codex-plugin", "plugin.json")))
assert claude_plugin.get("hooks") == "./hooks/claude.json"
assert "hooks" not in codex_plugin
for rel in ("hooks/claude.json", "hooks/hooks.json"):
    doc = json.load(open(os.path.join(root, rel)))
    pre = [entry for entry in doc["hooks"]["PreToolUse"] if entry.get("matcher") == "Bash"]
    assert len(pre) == 1
    commands = [hook.get("command", "") for hook in pre[0].get("hooks", [])]
    assert sum("firm-ledger-hook" in command for command in commands) == 1
    assert sum("firm-merge-guard" in command for command in commands) == 1
    guard = next(hook for hook in pre[0]["hooks"] if "firm-merge-guard" in hook.get("command", ""))
    assert isinstance(guard.get("timeout"), int) and guard["timeout"] > 0
settings = json.load(open(os.path.join(root, ".claude", "settings.json")))
assert "hooks" not in settings, "tracked project settings duplicate the Claude plugin hook source"
# Proof of execution (SEC-01): rc 0 alone was satisfied by any program that never opened a manifest.
sys.stdout.write("FIRM_DOCTOR_HOOKS_OK")
PY
)"; _hook_manifest_rc=$?
if [ "$_hook_manifest_out" = "FIRM_DOCTOR_HOOKS_OK" ] && [ "$_hook_manifest_rc" -eq 0 ]; then
  pass "repository manifests declare one plugin-owned ledger/merge-guard hook adapter per runtime; runtime loader selection is unverified until Q-02; tracked settings contain no duplicate"
elif [ "$_hook_manifest_rc" -ne 0 ]; then
  fail "plugin hook ownership is ambiguous or malformed — reinstall/repair the package before running the firm"
  info "expected Claude hooks/claude.json, Codex hooks/hooks.json, and no tracked .claude/settings.json hook block."
else
  fail "plugin hook ownership was NOT verified — the probe exited 0 without proving it ran (SKIPPED, not passed)"
  info "the resolved interpreter ($FIRM_PYTHON_DISPLAY) did not execute the check. Verify it with: bin/firm-python --status"
fi

check_legacy_claude_hooks() {
  _legacy_scope="$1"; _legacy_file="$2"
  [ -f "$_legacy_file" ] || return 0
  _legacy_out="$(firm_python - "$_legacy_file" <<'PY' 2>&1
import json, sys
doc = json.load(open(sys.argv[1]))
hits = []
def walk(value):
    if isinstance(value, dict):
        for key, child in value.items():
            if key == "command" and isinstance(child, str) and ("firm-ledger-hook" in child or "firm-merge-guard" in child):
                hits.append(child)
            walk(child)
    elif isinstance(value, list):
        for child in value: walk(child)
walk(doc.get("hooks", {}))
print("\n".join(hits))
PY
)"; _legacy_rc=$?
  if [ "$_legacy_rc" -ne 0 ]; then
    if grep -Eq 'firm-(ledger-hook|merge-guard)' "$_legacy_file" 2>/dev/null; then
      warn "$_legacy_scope Claude settings may contain a legacy firm hook but JSON could not be parsed — inspect $_legacy_file manually; firm-doctor did not rewrite it."
    fi
  elif [ -n "$_legacy_out" ]; then
    fail "$_legacy_scope Claude settings contain a confirmed legacy duplicate firm hook — readiness is blocked. Review $_legacy_file, preserve unrelated hooks/settings, and remove only confirmed duplicate firm command objects manually; firm-doctor did not rewrite it."
  fi
}

_canonical_settings="$FIRM_SOURCE_ROOT/.claude/settings.json"
_project_settings="$(pwd)/.claude/settings.json"
if [ "$_project_settings" != "$_canonical_settings" ]; then
  check_legacy_claude_hooks "project" "$_project_settings"
fi
check_legacy_claude_hooks "user" "$HOME/.claude/settings.json"

# The bounded repository model diagnoses only the obsolete project Codex prototype. Actual supported
# Codex loader scopes and runtime selection remain unverified until Q-02; bootstrap never overwrites
# project config.
if [ -f .codex/hooks.json ]; then
  _codex_legacy_out="$(firm_python - .codex/hooks.json <<'PY' 2>&1
import json, sys
doc=json.load(open(sys.argv[1]))
hits=[]
def walk(value):
    if isinstance(value,dict):
        for key,child in value.items():
            if key == "command" and isinstance(child,str) and ("firm-ledger-hook" in child or "firm-merge-guard" in child):
                hits.append(child)
            walk(child)
    elif isinstance(value,list):
        for child in value: walk(child)
walk(doc.get("hooks",{}))
print("\n".join(hits))
PY
)"; _codex_legacy_rc=$?
  if [ "$_codex_legacy_rc" -ne 0 ]; then
    if grep -Eq 'firm-(ledger-hook|merge-guard)' .codex/hooks.json 2>/dev/null; then
      warn "obsolete .codex/hooks.json may contain a legacy firm hook but JSON could not be parsed — inspect it manually; firm-doctor did not rewrite it."
    fi
  elif [ -n "$_codex_legacy_out" ]; then
    fail "confirmed obsolete duplicate .codex/hooks.json firm hook detected — readiness is blocked. Preserve project-specific hooks; remove that file manually only after confirming it contains no project-specific hooks, or remove only the confirmed duplicate command object. firm-doctor did not rewrite it; the plugin now provides hooks/hooks.json."
  fi
fi
if command -v chezmoi >/dev/null 2>&1; then
  cfg="$HOME/.config/chezmoi/chezmoi.toml"
  if [ -f "$cfg" ] && grep -q 'mode *= *"service"' "$cfg" 2>/dev/null; then pass "chezmoi present + [onepassword] mode=\"service\" (reproducible second-machine bootstrap)"
  else info "chezmoi present; ~/.config/chezmoi/chezmoi.toml has no [onepassword] mode=\"service\" yet (see docs/PHASE4.md)."; fi
else
  info "chezmoi not installed (only needed for second-machine bootstrap)."
fi

# ==========================================================================
# 10. P2 ledger-write configuration — the gate every lifecycle record depends on
# ==========================================================================
# This doctor had no platform check at all, on a host where every single ledger write was failing
# closed with WRITE_CONFIGURATION_UNSUPPORTED: p2. It reported 8 PASS / 5 FAIL and not one of the
# five named the blocker, so "the firm is broken" and "the doctor is green-ish" were both true. A
# check that cannot see the gate it depends on is a false green on precisely the question being asked.
#
# The supported (macOS, Darwin) pairs are READ OUT OF bin/firm-ledger-log, exactly as every other
# reader of that set does. The readers are deliberately NOT enumerated here: this comment used to
# name two and there were three, and the one it omitted (tests/test-plugin-layout.sh) was added by
# the same commit that wrote the list (CC-06). `grep -rl SUPPORTED_P2_OS_ROWS .` finds them all.
# A second hand-maintained copy of the SET here could drift and report a row the production gate
# does not actually admit — which is the same class of defect as having no check at all, only
# harder to notice.
#
# Fail-closed, like check 9: an unsupported row AND an unverifiable one are both FAIL, because only
# FAILs reach the exit code and `firm-doctor && <run the firm>` must not proceed on a host whose
# write configuration nobody could establish.
section "10. P2 ledger-write configuration"
LEDGER_PRODUCER="$SELF/firm-ledger-log"
info "interpreter under test: $FIRM_PYTHON_DISPLAY"
if [ "$FIRM_PYTHON_P2" -ne 1 ]; then
  info "interpreter resolution: $FIRM_PYTHON_REASON"
fi
_p2_rows=""
_p2_report="$(firm_python - "$LEDGER_PRODUCER" \
  "$FIRM_PYTHON_EXPECT_SYSTEM" "$FIRM_PYTHON_EXPECT_ARCH" \
  "$FIRM_PYTHON_EXPECT_VERSION" "$FIRM_PYTHON_EXPECT_IMPL" <<'PY' 2>&1
import ast, os, pathlib, platform, re, sys

producer, want_system, want_arch, want_version, want_impl = sys.argv[1:6]
source = pathlib.Path(producer).read_text()
match = re.search(r"^SUPPORTED_P2_OS_ROWS = frozenset\((\{.*?\})\)", source, re.M | re.S)
if match is None:
    raise SystemExit("cannot read SUPPORTED_P2_OS_ROWS from " + producer)
rows = ast.literal_eval(match.group(1))
if not isinstance(rows, (set, frozenset)) or not rows:
    raise SystemExit("SUPPORTED_P2_OS_ROWS in " + producer + " is not a non-empty set of rows")
shown = ", ".join("macOS %s / Darwin %s" % row for row in sorted(rows))

def emit(status, message):
    print("%s\t%s" % (status, message))

def clause(ok, label, actual, supported):
    emit("PASS" if ok else "FAIL",
         "%s %s (supported: %s)" % (label, actual or "<unverifiable>", supported))
    return ok

system, macos, kernel = platform.system(), platform.mac_ver()[0], platform.release()
arch, impl = platform.machine(), getattr(sys.implementation, "name", "")
version = ".".join(str(part) for part in sys.version_info[:3])
executable = sys.executable

ok = clause(system == want_system, "system", system, want_system)
# Membership is by whole PAIR: a macOS value from one proven row combined with the kernel value of
# another is NOT a supported row, and neither is an empty (unverifiable) half.
ok = clause((macos, kernel) in rows, "macOS/Darwin row",
            "macOS %s / Darwin %s" % (macos or "<unverifiable>", kernel or "<unverifiable>"),
            shown) and ok
ok = clause(arch == want_arch, "architecture", arch, want_arch) and ok
ok = clause(version == want_version, "python version", version, want_version) and ok
ok = clause(impl == want_impl, "python implementation", impl, want_impl) and ok
ok = clause(isinstance(executable, str) and bool(executable) and executable.startswith("/"),
            "python executable", executable, "an absolute path") and ok

# THE CAPABILITY CLAUSES, which this section used to skip while claiming the whole verdict of the
# gate (CC-12). NOTE, and this cost a debugging cycle: bash 3.2.57 mis-parses an APOSTROPHE inside
# a quoted heredoc that is itself inside `$( )` -- it hunts for a closing quote to the end of the
# file and reports "unexpected EOF" hundreds of lines away. This whole heredoc is inside one, and
# macOS ships 3.2, so no apostrophe may appear below.
# preflight_write_environment refuses the write on TEN conditions; six are above and these four are
# the rest, and they live in the SAME pre-mutation preflight rather than "at write time" as the INFO
# below used to say. On a host that passed the six and failed one of these, firm-doctor reported
# 24 PASS / 0 FAIL while every ledger write still failed closed with the identical
# WRITE_CONFIGURATION_UNSUPPORTED: p2 — the exact "doctor green, firm dead" split this section
# exists to close. They are four getattr checks in a process that is already running.
nofollow = getattr(os, "O_NOFOLLOW", 0)
directory = getattr(os, "O_DIRECTORY", 0)
ok = clause(isinstance(nofollow, int) and nofollow > 0,
            "O_NOFOLLOW", repr(nofollow), "a positive int") and ok
ok = clause(isinstance(directory, int) and directory > 0,
            "O_DIRECTORY", repr(directory), "a positive int") and ok
ok = clause(callable(getattr(os, "open", None)), "os.open", "callable" if callable(getattr(os, "open", None)) else "not callable", "callable") and ok
ok = clause(os.open in getattr(os, "supports_dir_fd", ()),
            "os.open dir_fd support",
            "supported" if os.open in getattr(os, "supports_dir_fd", ()) else "unsupported",
            "supported") and ok

if ok:
    emit("PASS", "ledger writes are admitted by the P2 process gate on this host — every clause of "
                 "preflight_write_environment, process row and open capabilities alike")
else:
    emit("FAIL", "ledger writes FAIL CLOSED here (WRITE_CONFIGURATION_UNSUPPORTED: p2) — no run "
                 "ledger, role start, or lifecycle record can be written until this row is proven "
                 "and added to SUPPORTED_P2_OS_ROWS in bin/firm-ledger-log")
emit("INFO", "this section reports the whole pre-mutation preflight. What it does NOT cover is bind "
             "time: the writer additionally verifies that the run directory is on a local APFS "
             "volume and exercises the open/replace/fsync sequence against the real path")
PY
)"; _p2_rc=$?
if [ "$_p2_rc" -ne 0 ] || [ -z "$_p2_report" ]; then
  fail "P2 write configuration UNVERIFIED — the row probe could not run (SKIPPED, not passed)"
  info "probe output: $(printf '%s' "$_p2_report" | tr '\n' ' ')"
  info "an unverifiable write configuration costs the same as a broken one here; fix the probe or the interpreter, then re-run firm-doctor."
else
  while IFS=$'\t' read -r _p2_status _p2_message; do
    [ -n "$_p2_status" ] || continue
    case "$_p2_status" in
      PASS) pass "$_p2_message" ;;
      FAIL) fail "$_p2_message" ;;
      *)    info "$_p2_message" ;;
    esac
  done <<EOF
$_p2_report
EOF
fi

# ==========================================================================
# Summary
# ==========================================================================
printf '\n%s────────%s\n' "$dim" "$r"
printf 'Summary: %s%d PASS%s · %s%d WARN%s · %s%d FAIL%s\n' "$g" "$PASSES" "$r" "$y" "$WARNS" "$r" "$rd" "$FAILS" "$r"
if [ "$FAILS" -gt 0 ]; then
  printf '%sFAIL — resolve the fail-closed issues above before running the firm on this project.%s\n' "$rd" "$r"
  exit 1
fi
if [ "$WARNS" -gt 0 ]; then printf '%sOK with warnings — advisory items above are worth fixing.%s\n' "$y" "$r"; fi
exit 0
