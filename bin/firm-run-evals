#!/usr/bin/env bash
# firm-run-evals [--structural|--list] [--provider claude|codex] [eval-name]
# Golden evals: DRIVE the firm headlessly against each fixture under a BOUNDED permission posture, then
# check assertions.yaml. `--structural` is the OFFLINE mode (no model run) — see below.
#
# `--structural` is CI's offline parser/shape mode. It invokes only
# `firm-check-assertions --parse-only`, validates a non-empty known vocabulary and value domains, and
# exits before assertion dispatch. It therefore cannot satisfy an assertion and is never behavioral
# evidence. `--list` is the only successful zero-execution listing operation; an unknown explicit
# selector is a usage error (2), with valid names and a copyable correction.
#
# NEVER uses --dangerously-skip-permissions / bypassPermissions: the eval must exercise the firm's own
# guardrails, and the `final_gate_pending` assertion relies on the firm stopping deliberately (not
# barreling through the final gate). The bounded posture = --permission-mode default + a scoped
# --allowedTools + --disallowedTools, so anything not allow-listed cannot proceed in headless mode.
#
# Behavioral mode requires both installed adapters and the selected provider login. Its process group
# is bounded by firm-bounded-exec; Codex turns are counted from the JSONL stream and Claude receives a
# native --max-turns. Post-run counting is defense-in-depth, not the terminating control.
#
# `Bash(sh test/run-tests.sh)` is the EXACT command, not `Bash(sh:*)` — the qa-blocks-broken-build eval
# fixture's suite is a shell script (no node in this environment), and this is the narrowest rule that
# lets the qa-tester agent execute it. Arbitrary command execution is already reachable in this posture
# via the existing node/npm/pytest entries plus Write, so this adds no new class of exposure -- but a
# bare `sh:*` would, and is deliberately not granted. UNVERIFIED at authoring time whether Claude Code's
# permission engine actually matches this rule as intended against the live agent's tool call -- only a
# real model-driven run of that eval proves it, and this file's own `--structural` mode cannot.
set -uo pipefail
__src="${BASH_SOURCE[0]}"   # resolve symlinks so ~/.local/bin/firm-* finds the repo
while [ -L "$__src" ]; do __d="$(cd -P "$(dirname "$__src")" && pwd)"; __src="$(readlink "$__src")"; case $__src in /*) ;; *) __src="$__d/$__src";; esac; done
SELF="$(cd -P "$(dirname "$__src")" && pwd)"
ROOT="$(cd "$SELF/.." && pwd)"
. "$SELF/firm-python"   # one resolved interpreter for the whole firm; see bin/firm-python
EVALS="$ROOT/agent-firm/evals"
MANUAL="$ROOT/agent-firm/contracts/lifecycle.md"  # shared provider-neutral lifecycle contract
SETTINGS="$ROOT/.claude/settings.json"   # the firm's canonical allow/ask/deny posture
CHECKER="$SELF/firm-check-assertions"
BOUNDED="$SELF/firm-bounded-exec"

mode=run; provider=claude; want=""; operation_seen=0
while [ $# -gt 0 ]; do
  case "$1" in
    --structural)
      [ "$operation_seen" -eq 0 ] || { echo "firm-run-evals: choose only one of --structural or --list" >&2; exit 2; }
      mode=structural; operation_seen=1; shift ;;
    --list)
      [ "$operation_seen" -eq 0 ] || { echo "firm-run-evals: choose only one of --structural or --list" >&2; exit 2; }
      mode=list; operation_seen=1; shift ;;
    --provider)
      [ $# -ge 2 ] || { echo "firm-run-evals: --provider requires claude or codex" >&2; exit 2; }
      provider="$2"; shift 2
      case "$provider" in claude|codex) ;; *) echo "firm-run-evals: --provider must be claude or codex" >&2; exit 2 ;; esac ;;
    -*) echo "firm-run-evals: unknown option '$1'" >&2; exit 2 ;;
    *) [ -z "$want" ] || { echo "firm-run-evals: only one eval name may be selected" >&2; exit 2; }; want="$1"; shift ;;
  esac
done

valid_names() {
  local d
  for d in "$EVALS"/*/; do [ -d "$d" ] && basename "$d"; done
}

selector_known=0
if [ -n "$want" ]; then
  for selector_name in $(valid_names); do [ "$selector_name" = "$want" ] && selector_known=1; done
fi
if [ -n "$want" ] && [ "$selector_known" -ne 1 ]; then
  echo "firm-run-evals: unknown eval selector '$want'" >&2
  echo "valid eval names:" >&2
  valid_names | sed 's/^/  /' >&2
  echo "corrective action: choose one exact name above, or run 'firm-run-evals --list'" >&2
  exit 2
fi

if [ "$mode" = list ]; then
  [ -z "$want" ] || { echo "firm-run-evals: --list does not accept an eval selector" >&2; exit 2; }
  echo "available evals (listing only; no behavioral or structural claim):"
  valid_names | sed 's/^/  /'
  exit 0
fi

# Behavioral mode has one provider invocation per selected eval and no retry path. Wall-clock and
# case limits prevent an expanding eval tree or stalled provider from consuming unbounded subscription
# turns; the result envelope is also checked against the declared top-level turn cap.
if [ "$mode" = run ]; then
  eval_timeout="${FIRM_EVAL_TIMEOUT_SECONDS:-900}"
  eval_max_turns="${FIRM_EVAL_MAX_TURNS:-60}"
  eval_max_cases="${FIRM_EVAL_MAX_CASES:-8}"
  for bound in "$eval_timeout" "$eval_max_turns" "$eval_max_cases"; do
    case "$bound" in ''|*[!0-9]*|0) echo "firm-run-evals: behavioral bounds must be positive integers" >&2; exit 2 ;; esac
  done
  [ "$eval_timeout" -le 900 ] || { echo "firm-run-evals: timeout exceeds maximum 900 seconds; provider phase BLOCKED" >&2; exit 2; }
  [ "$eval_max_turns" -le 1000 ] || { echo "firm-run-evals: turn cap exceeds maximum 1000; provider phase BLOCKED" >&2; exit 2; }
  [ "$eval_max_cases" -le 8 ] || { echo "firm-run-evals: case cap exceeds maximum 8; provider phase BLOCKED" >&2; exit 2; }
fi

structural_check() { # $1 = eval dir -> 0 ok, 1 bad
  local d="$1" ok=1
  [ -f "$d/task.md" ]         || { echo "  MISSING task.md"; ok=0; }
  [ -f "$d/assertions.yaml" ] || { echo "  MISSING assertions.yaml"; ok=0; }
  [ -d "$d/fixture" ]         || { echo "  MISSING fixture/"; ok=0; }
  [ "$ok" -eq 1 ]
}

SA_COUNT=0      # assertions firm-check-assertions actually PARSED (authoritative)
SA_DETAIL=""    # multi-line explanation when structural_assertions fails
sa_detail() { if [ -z "$SA_DETAIL" ]; then SA_DETAIL="$1"; else SA_DETAIL="$SA_DETAIL
$1"; fi; }

# structural_assertions <eval-dir> -> 0 = known vocabulary and value shapes parse, 1 = not parseable.
# The checker exits before defining or dispatching any assertion operation in --parse-only mode.
structural_assertions() {
  local d="$1" af="$1/assertions.yaml" out rc parsed
  SA_COUNT=0; SA_DETAIL=""

  if [ ! -x "$CHECKER" ]; then
    sa_detail "firm-check-assertions is missing or not executable at: $CHECKER"
    sa_detail "structural CANNOT verify assertions without it, and will not guess — this is a FAILURE,"
    sa_detail "not a reason to fall back to counting dash-lines."
    return 1
  fi
  out="$("$CHECKER" --parse-only "$af" 2>&1)"; rc=$?
  if [ "$rc" -eq 2 ]; then
    sa_detail "assertions are NOT PARSEABLE — firm-check-assertions --parse-only exited 2:"
    sa_detail "$(printf '%s\n' "$out" | sed -n '1,10p' | sed 's/^/  | /')"
    return 1
  fi
  if [ "$rc" -ne 0 ]; then
    sa_detail "firm-check-assertions --parse-only exited $rc — expected 0 or 2:"
    sa_detail "$(printf '%s\n' "$out" | sed -n '1,10p' | sed 's/^/  | /')"
    return 1
  fi

  parsed="$(printf '%s\n' "$out" | sed -n 's/^assertions: \([0-9][0-9]*\) parsed from .*$/\1/p')"
  case "$out" in *"PARSE-ONLY: PASS -- "*" no assertion or payload executed"*) ;; *)
    sa_detail "firm-check-assertions exited 0 without its parse-only completion marker:"
    sa_detail "$(printf '%s\n' "$out" | sed -n '1,10p' | sed 's/^/  | /')"
    return 1 ;;
  esac
  [ -n "$parsed" ] || { sa_detail "parse-only completion omitted the authoritative parsed count"; return 1; }

  SA_COUNT="$parsed"
  return 0
}

# A hook-free copy of the firm settings: the real settings.json registers a PreToolUse hook pointing at
# the project's bin/firm-ledger-hook, which doesn't exist in an eval scratch repo (it would fail every
# Bash call). Strip "hooks" so the eval loads only the allow/ask/deny posture.
make_eval_settings() { # $1 = dest file
  firm_python - "$SETTINGS" "$1" <<'PY'
import json, sys
src, dst = sys.argv[1], sys.argv[2]
d = json.load(open(src)); d.pop("hooks", None)
json.dump(d, open(dst, "w"), indent=2)
PY
}

run_one() { # $1 = eval dir ; $2 = name -> checker rc (0 pass)
  local d="$1" name="$2" provider_rc turns prompt checker_rc
  [ -x "$CHECKER" ] || { echo "FAIL $name: missing executable firm-check-assertions at $CHECKER; provider phase not started" >&2; return 1; }
  command -v "$provider" >/dev/null 2>&1 || { echo "SKIP $name: '$provider' not found"; return 4; }
  [ -x "$BOUNDED" ] || { echo "FAIL $name: missing executable firm-bounded-exec" >&2; return 1; }

  local scratch; scratch="$(mktemp -d "${TMPDIR:-/tmp}/firm-eval-${name}.XXXXXX")"
  cp -R "$d/fixture/." "$scratch/" 2>/dev/null || true
  # THE FIXTURE'S DEFAULT BRANCH IS STATED, NOT INHERITED. A bare `git init` takes the branch name
  # from the HOST's init.defaultBranch, so on a machine set to anything but main or master this
  # fixture came up on a branch bin/firm-new-run cannot recognize as any default branch -- and since
  # that script started refusing to derive an already-reviewed base from a HEAD it cannot place,
  # every behavioural eval was refused (rc 2) at its own first instruction, `firm-new-run`, before
  # the eval had done anything. Reproduced at init.defaultBranch=trunk: base rc 0, candidate rc 2.
  # Nothing caught it, because both hosted CI jobs run `--structural`, which builds no fixture at
  # all, and .github/workflows/ci.yml pins init.defaultBranch=main on every runner besides.
  #
  # `git symbolic-ref HEAD` and not `git init -b main`: -b needs git >= 2.28, this needs no floor at
  # all, and it is the spelling tests/lib.sh:mk_repo already uses for exactly this reason. It runs
  # between init and the first commit, when HEAD is still unborn, so it only names the branch the
  # commit below will create.
  ( cd "$scratch" && git init -q && git symbolic-ref HEAD refs/heads/main && git add -A \
      && git -c user.email=eval@firm -c user.name=eval commit -qm fixture ) || { echo "SKIP $name: git init failed"; return 4; }
  local out="$scratch/.eval-out"; mkdir -p "$out"
  make_eval_settings "$out/settings.json"

  echo "==> $name: driving the $provider-primary firm headlessly (bounded posture) in $scratch"
  echo "    bounds: wall=${eval_timeout}s top-level-turns=$eval_max_turns cases=$eval_max_cases attempts=1 retries=0"
  # AskUserQuestion / merge / push are deliberately NOT allow-listed, so the firm cannot autonomously
  # pass the final human gate in -p mode — that's how final_gate_pending is provable.
  if [ "$provider" = claude ]; then
    "$BOUNDED" --phase eval --provider claude --timeout "$eval_timeout" \
      --grace "${FIRM_EVAL_KILL_GRACE:-2}" --max-output "${FIRM_EVAL_MAX_OUTPUT:-1048576}" \
      --generation 1 --output "$out/result.json" --result "$out/supervision.json" --cwd "$scratch" -- \
      claude -p "$(cat "$d/task.md")" \
        --append-system-prompt "$(cat "$MANUAL")

Execution envelope: this eval permits one provider attempt, no retries, and at most $eval_max_turns top-level turns." \
        --settings "$out/settings.json" \
        --permission-mode default \
        --allowedTools "Read,Edit,Write,Grep,Glob,Bash(firm-new-run:*),Bash(firm-ledger-log:*),Bash(firm-validate-verdict:*),Bash(firm-traceability-check:*),Bash(firm-final-qa-check:*),Bash(firm-qa-checkout:*),Bash(firm-qa-clean-check:*),Bash(firm-integrate:*),Bash(firm-integration-summary:*),Bash(firm-new-worktree:*),Bash(firm-gpt-qa:*),Bash(firm-claude-qa:*),Bash(firm-bench-record:*),Bash(git add:*),Bash(git commit:*),Bash(git worktree:*),Bash(git status:*),Bash(git diff:*),Bash(git log:*),Bash(git rev-parse:*),Bash(git checkout:*),Bash(git switch:*),Bash(git branch:*),Bash(node --test),Bash(node --test:*),Bash(npm test:*),Bash(npm run test:*),Bash(pytest:*),Bash(sh test/run-tests.sh)" \
        --disallowedTools "Bash(git push:*),Bash(git merge:*)" \
        --max-turns "$eval_max_turns" \
        --max-budget-usd "${FIRM_EVAL_BUDGET_USD:-5.00}" \
        --output-format json
    provider_rc=$?
  else
    prompt="\$agent-firm:start $(cat "$d/task.md")

Execution envelope: this eval permits one provider attempt, no retries, and at most $eval_max_turns top-level turns."
    # -a never is a parse error on codex exec (0.147.0): --ask-for-approval is interactive-only and
    # is not a clap global, so this argv used to die at rc 2 without running the eval at all. The
    # never-ask policy is stated as the typed -c override exec does accept.
    "$BOUNDED" --phase eval --provider codex --timeout "$eval_timeout" \
      --grace "${FIRM_EVAL_KILL_GRACE:-2}" --max-output "${FIRM_EVAL_MAX_OUTPUT:-1048576}" \
      --max-turns "$eval_max_turns" --generation 1 --output "$out/result.json" \
      --result "$out/supervision.json" --cwd "$scratch" -- \
      env FIRM_PRIMARY_PROVIDER=codex codex exec --ephemeral \
        -m "${FIRM_CODEX_LEAD_MODEL:-gpt-5.6-sol}" -c 'model_reasoning_effort="xhigh"' \
        -s workspace-write -c 'approval_policy="never"' --json "$prompt"
    provider_rc=$?
  fi

  if [ "$provider_rc" -ne 0 ]; then
    echo "  ($provider was stopped or exited non-zero; rc=$provider_rc — see $out/supervision.json and result.json; no retry attempted)" >&2
    return 1
  fi

  if [ "$provider" = claude ]; then
    turns="$(firm_python - "$out/result.json" <<'PY'
import json, sys
try:
    value = json.load(open(sys.argv[1], encoding="utf-8")).get("num_turns")
    if not isinstance(value, int) or value < 0:
        raise ValueError("num_turns is absent or invalid")
    print(value)
except Exception as e:
    print(f"cannot account Claude turns: {type(e).__name__}: {e}", file=sys.stderr)
    sys.exit(2)
PY
)" || return 1
  else
    turns="$(firm_python - "$out/result.json" <<'PY'
import json, sys
count = 0
try:
    for raw in open(sys.argv[1], encoding="utf-8"):
        event = json.loads(raw)
        if event.get("type") in ("turn.started", "turn_start"):
            count += 1
    if count < 1:
        raise ValueError("no turn-start event was recorded")
    print(count)
except Exception as e:
    print(f"cannot account Codex turns: {type(e).__name__}: {e}", file=sys.stderr)
    sys.exit(2)
PY
)" || return 1
  fi
  if [ "$turns" -gt "$eval_max_turns" ]; then
    echo "  ($provider reported $turns top-level turns, exceeding cap $eval_max_turns — BLOCK; no retry attempted)" >&2
    return 1
  fi
  echo "    accounted top-level turns: $turns/$eval_max_turns"

  # Show the run envelope summary for observability.
  [ "$provider" = claude ] && firm_python - "$out/result.json" <<'PY' 2>/dev/null || true
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: sys.exit(0)
print("    envelope:", {k:d.get(k) for k in ("subtype","is_error","num_turns","stop_reason","total_cost_usd")})
print("    permission_denials:", len(d.get("permission_denials") or []))
PY

  FIRM_EVAL_PROVIDER="$provider" "$CHECKER" "$d/assertions.yaml" "$scratch" "$out/result.json"
  checker_rc=$?
  echo "    (scratch: $scratch — inspect .eval-out/ and .agent-firm/ on failure)"
  case "$checker_rc" in
    0) return 0 ;;
    1) echo "  (assertion checker completed: one or more assertions failed; no retry attempted)" >&2 ;;
    2) echo "  (assertion checker rejected malformed or unevaluable assertions; no retry attempted)" >&2 ;;
    *) echo "  (assertion checker crashed or returned unsupported rc=$checker_rc; no retry attempted)" >&2 ;;
  esac
  return 1
}

if [ "$mode" = "structural" ]; then
  echo "structural mode: OFFLINE shape + assertion PARSE-ONLY check (no assertion payload, model, network, or spend)."
  echo "  Proves: each eval has known non-empty assertion vocabulary and valid value shapes."
  echo "  Does NOT prove: that the firm SATISFIES them — that needs a real 'firm-run-evals --provider <provider> <name>'."
fi

rc=0; n=0
for d in "$EVALS"/*/; do
  [ -d "$d" ] || continue
  name="$(basename "$d")"; [ "$name" = "README.md" ] && continue
  [ -n "$want" ] && [ "$want" != "$name" ] && continue
  if [ "$mode" = run ] && [ "$n" -ge "$eval_max_cases" ]; then
    echo "behavioral eval case cap reached ($eval_max_cases); refusing additional subscription work" >&2
    rc=1
    break
  fi
  n=$((n+1))
  if ! structural_check "$d"; then echo "BAD  $name (structure)"; rc=1; continue; fi
  if [ "$mode" = "structural" ]; then
    if structural_assertions "$d"; then
      echo "ok   $name ($SA_COUNT assertions) — vocabulary + value shapes parsed [structural only; payloads not executed]"
    else
      echo "BAD  $name (assertions)"
      printf '%s\n' "$SA_DETAIL" | sed 's/^/       /'
      rc=1
    fi
    continue
  fi
  if run_one "$d" "$name"; then echo "PASS $name"; else echo "FAIL $name"; rc=1; fi
done
[ "$n" -eq 0 ] && { echo "firm-run-evals: no eval directories found in $EVALS" >&2; exit 1; }
echo "---"
sfx=""
[ "$mode" = "structural" ] && sfx=" (structural: parse/shape only — NOT a behavioural pass)"
if [ "$rc" -eq 0 ]; then echo "all evals passed$sfx"; else echo "some evals FAILED$sfx"; fi
exit "$rc"
