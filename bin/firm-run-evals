#!/usr/bin/env bash
# firm-run-evals [--structural|--list] [--provider claude|codex] [eval-name]
# Golden evals: DRIVE the firm headlessly against each fixture under a BOUNDED permission posture, then
# check assertions.yaml. `--structural` is the OFFLINE mode (no model run) — see below.
#
# `--structural` is CI's offline parser/shape mode. It invokes only
# `firm-check-assertions --parse-only`, validates a non-empty known vocabulary and value domains, and
# exits before assertion dispatch. It therefore cannot satisfy an assertion and is never behavioral
# evidence. `--list` is the only successful zero-execution listing operation; an unknown explicit
# selector is a usage error (2), with valid names and a copyable correction.
#
# NEVER uses --dangerously-skip-permissions / bypassPermissions: the eval must exercise the firm's own
# guardrails, and the `final_gate_pending` assertion relies on the firm stopping deliberately (not
# barreling through the final gate). The bounded posture = --permission-mode default + a scoped
# --allowedTools + --disallowedTools, so anything not allow-listed cannot proceed in headless mode.
#
# Behavioral mode requires both installed adapters and the selected provider login. Its process group
# is bounded by firm-bounded-exec; Codex turns are counted from the JSONL stream and Claude receives a
# native --max-turns. Post-run counting is defense-in-depth, not the terminating control.
#
# `Bash(sh test/run-tests.sh)` is the EXACT command, not `Bash(sh:*)` — the qa-blocks-broken-build eval
# fixture's suite is a shell script (no node in this environment), and this is the narrowest rule that
# lets the qa-tester agent execute it. Arbitrary command execution is already reachable in this posture
# via the existing node/npm/pytest entries plus Write, so this adds no new class of exposure -- but a
# bare `sh:*` would, and is deliberately not granted. UNVERIFIED at authoring time whether Claude Code's
# permission engine actually matches this rule as intended against the live agent's tool call -- only a
# real model-driven run of that eval proves it, and this file's own `--structural` mode cannot.
set -uo pipefail
__src="${BASH_SOURCE[0]}"   # resolve symlinks so ~/.local/bin/firm-* finds the repo
while [ -L "$__src" ]; do __d="$(cd -P "$(dirname "$__src")" && pwd)"; __src="$(readlink "$__src")"; case $__src in /*) ;; *) __src="$__d/$__src";; esac; done
SELF="$(cd -P "$(dirname "$__src")" && pwd)"
ROOT="$(cd "$SELF/.." && pwd)"
. "$SELF/firm-python"   # one resolved interpreter for the whole firm; see bin/firm-python
EVALS="$ROOT/agent-firm/evals"
MANUAL="$ROOT/agent-firm/contracts/lifecycle.md"  # shared provider-neutral lifecycle contract
SETTINGS="$ROOT/.claude/settings.json"   # the firm's canonical allow/ask/deny posture
CHECKER="$SELF/firm-check-assertions"
BOUNDED="$SELF/firm-bounded-exec"
EVAL_AUTHORITY="$SELF/firm-eval-authority"

mode=run; provider=claude; want=""; operation_seen=0
while [ $# -gt 0 ]; do
  case "$1" in
    --structural)
      [ "$operation_seen" -eq 0 ] || { echo "firm-run-evals: choose only one of --structural or --list" >&2; exit 2; }
      mode=structural; operation_seen=1; shift ;;
    --list)
      [ "$operation_seen" -eq 0 ] || { echo "firm-run-evals: choose only one of --structural or --list" >&2; exit 2; }
      mode=list; operation_seen=1; shift ;;
    --provider)
      [ $# -ge 2 ] || { echo "firm-run-evals: --provider requires claude or codex" >&2; exit 2; }
      provider="$2"; shift 2
      case "$provider" in claude|codex) ;; *) echo "firm-run-evals: --provider must be claude or codex" >&2; exit 2 ;; esac ;;
    -*) echo "firm-run-evals: unknown option '$1'" >&2; exit 2 ;;
    *) [ -z "$want" ] || { echo "firm-run-evals: only one eval name may be selected" >&2; exit 2; }; want="$1"; shift ;;
  esac
done

valid_names() {
  local d
  for d in "$EVALS"/*/; do [ -d "$d" ] && basename "$d"; done
}

selector_known=0
if [ -n "$want" ]; then
  for selector_name in $(valid_names); do [ "$selector_name" = "$want" ] && selector_known=1; done
fi
if [ -n "$want" ] && [ "$selector_known" -ne 1 ]; then
  echo "firm-run-evals: unknown eval selector '$want'" >&2
  echo "valid eval names:" >&2
  valid_names | sed 's/^/  /' >&2
  echo "corrective action: choose one exact name above, or run 'firm-run-evals --list'" >&2
  exit 2
fi

if [ "$mode" = list ]; then
  [ -z "$want" ] || { echo "firm-run-evals: --list does not accept an eval selector" >&2; exit 2; }
  echo "available evals (listing only; no behavioral or structural claim):"
  valid_names | sed 's/^/  /'
  exit 0
fi

# Behavioral mode has one provider invocation per selected eval and no retry path. Wall-clock and
# case limits prevent an expanding eval tree or stalled provider from consuming unbounded subscription
# turns; the result envelope is also checked against the declared top-level turn cap.
#
# THE WALL-CLOCK CEILING IS PER PROVIDER ORIENTATION, and each number below carries its basis.
#
# One number used to serve both, and it was 900 s. That number fitted one orientation and acted as a
# guillotine on the other. Measured 2026-08-23, `firm-run-evals --provider codex greet-fast-path`
# on codex-cli 0.149.0 (the first Codex-primary behavioural eval that has ever executed at all — see
# the `-a never` defect fixed in this same change):
#
#   at the 900 s bound: SIGTERM, status=timeout, 389,023 bytes, 88 completed items. The run had
#   already logged `final_qa_passed` and satisfied 7 of the eval's 8 assertions — APPROVE verdict,
#   strict traceability PASS, node --test green — and was inside the PACKAGING stage when it was
#   killed. The single failing assertion, `final_gate_pending`, failed only because the kill landed
#   before that event was written.
#
# So 900 s was not a safety margin for this orientation; it was positioned a few steps before the
# finish line, and it converted "nearly done" into "FAIL" with no signal that time was the cause.
#
# 1800 IS A HEADROOM CHOICE, NOT A FITTED VALUE. That distinction is worth stating, because the
# number sits among measurements and could easily be read as one. What is MEASURED is the spread —
# three runs of the same eval on the same host:
#
#   run A   >900 s   killed at the old ceiling, inside packaging, 7 of 8 assertions already satisfied
#   run B    653 s   provider phase completed (status ok, exit 0)
#   run C    451 s   whole eval completed end to end and its assertions were evaluated
#
# Those measurements establish two things and no more: that this workload needs somewhat more than
# 900 s, and that it has no stable duration — it varied by better than 2x, because it is a model
# driving a lifecycle rather than a deterministic job. They do NOT derive 1800.
#
# 1800 is chosen against that spread rather than against the median. A ceiling near typical cost is a
# ceiling that fails runs for being unlucky rather than for being wrong, and a bound that fires on
# luck is one everybody learns to ignore. Fitting it snugly would also guarantee re-raising it the
# first time the host is busier, and every such re-raise is a decision taken under pressure to turn a
# red eval green. The looseness is deliberate — but it is a judgement, not evidence.
#
# Claude-primary stays at 900 s and is marked UNMEASURED on purpose. I have not timed a Claude
# orientation, and inventing a second number to look symmetrical would be exactly the guessing this
# comment exists to end. It keeps the value it has always had; the split now makes the absence of a
# measurement visible instead of hiding it inside a shared constant.
#
# These ceilings are LITERALS and are deliberately not readable from the environment. A runaway
# control that the runaway can raise is not a control. FIRM_EVAL_TIMEOUT_SECONDS may only ask for
# LESS than the ceiling for its orientation.
if [ "$mode" = run ]; then
  case "$provider" in
    codex)  eval_timeout_ceiling=1800 ;;   # measured; see the comment above
    *)      eval_timeout_ceiling=900  ;;   # UNMEASURED: inherited value, Claude-primary
  esac
  eval_timeout="${FIRM_EVAL_TIMEOUT_SECONDS:-$eval_timeout_ceiling}"
  eval_max_turns="${FIRM_EVAL_MAX_TURNS:-60}"
  eval_max_cases="${FIRM_EVAL_MAX_CASES:-8}"
  for bound in "$eval_timeout" "$eval_max_turns" "$eval_max_cases"; do
    case "$bound" in ''|*[!0-9]*|0) echo "firm-run-evals: behavioral bounds must be positive integers" >&2; exit 2 ;; esac
  done
  [ "$eval_timeout" -le "$eval_timeout_ceiling" ] || { echo "firm-run-evals: timeout exceeds the maximum $eval_timeout_ceiling seconds for a $provider-primary eval; provider phase BLOCKED" >&2; exit 2; }
  [ "$eval_max_turns" -le 1000 ] || { echo "firm-run-evals: turn cap exceeds maximum 1000; provider phase BLOCKED" >&2; exit 2; }
  [ "$eval_max_cases" -le 8 ] || { echo "firm-run-evals: case cap exceeds maximum 8; provider phase BLOCKED" >&2; exit 2; }
fi

structural_check() { # $1 = eval dir -> 0 ok, 1 bad
  local d="$1" ok=1
  [ -f "$d/task.md" ]         || { echo "  MISSING task.md"; ok=0; }
  [ -f "$d/assertions.yaml" ] || { echo "  MISSING assertions.yaml"; ok=0; }
  [ -d "$d/fixture" ]         || { echo "  MISSING fixture/"; ok=0; }
  [ "$ok" -eq 1 ]
}

SA_COUNT=0      # assertions firm-check-assertions actually PARSED (authoritative)
SA_DETAIL=""    # multi-line explanation when structural_assertions fails
sa_detail() { if [ -z "$SA_DETAIL" ]; then SA_DETAIL="$1"; else SA_DETAIL="$SA_DETAIL
$1"; fi; }

# structural_assertions <eval-dir> -> 0 = known vocabulary and value shapes parse, 1 = not parseable.
# The checker exits before defining or dispatching any assertion operation in --parse-only mode.
structural_assertions() {
  local d="$1" af="$1/assertions.yaml" out rc parsed
  SA_COUNT=0; SA_DETAIL=""

  if [ ! -x "$CHECKER" ]; then
    sa_detail "firm-check-assertions is missing or not executable at: $CHECKER"
    sa_detail "structural CANNOT verify assertions without it, and will not guess — this is a FAILURE,"
    sa_detail "not a reason to fall back to counting dash-lines."
    return 1
  fi
  out="$("$CHECKER" --parse-only "$af" 2>&1)"; rc=$?
  if [ "$rc" -eq 2 ]; then
    sa_detail "assertions are NOT PARSEABLE — firm-check-assertions --parse-only exited 2:"
    sa_detail "$(printf '%s\n' "$out" | sed -n '1,10p' | sed 's/^/  | /')"
    return 1
  fi
  if [ "$rc" -ne 0 ]; then
    sa_detail "firm-check-assertions --parse-only exited $rc — expected 0 or 2:"
    sa_detail "$(printf '%s\n' "$out" | sed -n '1,10p' | sed 's/^/  | /')"
    return 1
  fi

  parsed="$(printf '%s\n' "$out" | sed -n 's/^assertions: \([0-9][0-9]*\) parsed from .*$/\1/p')"
  case "$out" in *"PARSE-ONLY: PASS -- "*" no assertion or payload executed"*) ;; *)
    sa_detail "firm-check-assertions exited 0 without its parse-only completion marker:"
    sa_detail "$(printf '%s\n' "$out" | sed -n '1,10p' | sed 's/^/  | /')"
    return 1 ;;
  esac
  [ -n "$parsed" ] || { sa_detail "parse-only completion omitted the authoritative parsed count"; return 1; }

  SA_COUNT="$parsed"
  return 0
}

# A hook-free copy of the firm settings: the real settings.json registers a PreToolUse hook pointing at
# the project's bin/firm-ledger-hook, which doesn't exist in an eval scratch repo (it would fail every
# Bash call). Strip "hooks" so the eval loads only the allow/ask/deny posture.
make_eval_settings() { # $1 = dest file
  firm_python - "$SETTINGS" "$1" <<'PY'
import json, sys
src, dst = sys.argv[1], sys.argv[2]
d = json.load(open(src)); d.pop("hooks", None)
json.dump(d, open(dst, "w"), indent=2)
PY
}

run_one() { # $1 = eval dir ; $2 = name -> checker rc (0 pass)
  local d="$1" name="$2" provider_rc turns prompt checker_rc provider_executable
  local codex_command claude_command
  codex_command=codex; claude_command=claude
  local control="" broker_pid="" authority_manifest="" authority_digest="" authority_invocation="" candidate_path="" candidate_project="" candidate_authority=""
  local shell_env="${ZDOTDIR:-${HOME:-/tmp}}" shell_bash_env="${BASH_ENV:-}" shell_sh_env="${ENV:-}"
  [ -x "$CHECKER" ] || { echo "FAIL $name: missing executable firm-check-assertions at $CHECKER; provider phase not started" >&2; return 1; }
  command -v "$provider" >/dev/null 2>&1 || { echo "SKIP $name: '$provider' not found"; return 4; }
  [ -x "$BOUNDED" ] || { echo "FAIL $name: missing executable firm-bounded-exec" >&2; return 1; }

  local scratch; scratch="$(mktemp -d "${TMPDIR:-/tmp}/firm-eval-${name}.XXXXXX")"
  chmod 700 "$scratch" || return 1
  # THE FIXTURE'S DEFAULT BRANCH IS STATED, NOT INHERITED. A bare `git init` takes the branch name
  # from the HOST's init.defaultBranch, so on a machine set to anything but main or master this
  # fixture came up on a branch bin/firm-new-run cannot recognize as any default branch -- and since
  # that script started refusing to derive an already-reviewed base from a HEAD it cannot place,
  # every behavioural eval was refused (rc 2) at its own first instruction, `firm-new-run`, before
  # the eval had done anything. Reproduced at init.defaultBranch=trunk: base rc 0, candidate rc 2.
  # Nothing caught it, because both hosted CI jobs run `--structural`, which builds no fixture at
  # all, and .github/workflows/ci.yml pins init.defaultBranch=main on every runner besides.
  #
  # `git symbolic-ref HEAD` and not `git init -b main`: -b needs git >= 2.28, this needs no floor at
  # all, and it is the spelling tests/lib.sh:mk_repo already uses for exactly this reason. It runs
  # between init and the first commit, when HEAD is still unborn, so it only names the branch the
  # commit below will create.
  #
  # THE OTHER AMBIENT GIT INPUTS TO THIS FIXTURE ARE PINNED THE SAME WAY -- with `git -c`, never a
  # config write, so nothing outside $scratch is touched. Measured against this exact recipe:
  # commit.gpgsign=true with no usable signing program aborts the commit at rc 128; a
  # core.excludesFile that matches the fixture's own files leaves `git add -A` nothing to stage and
  # the commit exits 1; a core.hooksPath holding a failing pre-commit exits 1. Each makes run_one
  # return 4 and the eval a FAIL. That is the LOUD direction, unlike init.defaultBranch above, which
  # let the fixture build and then had the eval's own first instruction refused inside it while the
  # run still reported rc 0 -- which is why those were the lower priority and not "no priority".
  # tests/lib.sh:mk_repo already pins commit.gpgsign false for exactly this reason; the other two are
  # pinned here for the first time, and user.email/user.name were already pinned this way.
  #
  # STILL INHERITED, named so the next reader does not have to measure it again: init.templateDir (a
  # global template seeds files into the .git this creates -- harmless here, and it is what the
  # hostile-host case in tests/test-run-evals-structural.sh uses to PROVE this environment reaches
  # this `git init` rather than only a probe beside it), and core.attributesFile.
  if [ "$name" != final-evidence-seal ]; then
    cp -R "$d/fixture/." "$scratch/" 2>/dev/null || true
    ( cd "$scratch" && git init -q && git symbolic-ref HEAD refs/heads/main \
        && git -c core.excludesFile=/dev/null add -A \
        && git -c commit.gpgsign=false -c core.excludesFile=/dev/null -c core.hooksPath=/dev/null \
               -c user.email=eval@firm -c user.name=eval commit -qm fixture ) \
      || { echo "SKIP $name: git init failed"; return 4; }
  fi
  local out="$scratch/.eval-out"; mkdir -p "$out"
  make_eval_settings "$out/settings.json"

  # The evidence-seal golden is candidate-specific. Build its command capsule outside provider write
  # scope, prove the immutable patch and final candidate first, and invoke the selected provider by
  # its pre-resolved absolute path so PATH contains no ambient firm installation or checkout.
  if [ "$name" = final-evidence-seal ]; then
    [ -x "$EVAL_AUTHORITY" ] || { echo "FAIL $name: missing candidate authority" >&2; return 1; }
    provider_executable="$(command -v "$provider" 2>/dev/null || true)"
    [ -n "$provider_executable" ] || { echo "SKIP $name: '$provider' not found"; return 4; }
    case "$provider_executable" in /*) ;; *) provider_executable="$(cd -P "$(dirname "$provider_executable")" && pwd)/$(basename "$provider_executable")" ;; esac
    [ "$provider" = codex ] && codex_command="$provider_executable" || claude_command="$provider_executable"
    control="$(mktemp -d "/tmp/firm-eval-authority.XXXXXX")" || return 1
    chmod 700 "$control" || return 1
    authority_manifest="$control/manifest.json"
    authority_prepare="$($EVAL_AUTHORITY prepare --root "$ROOT" --eval "$name" --provider "$provider" \
      --scratch "$scratch" --fixture "$d/fixture" --manifest "$authority_manifest" --shims "$control/shims" \
      --request-root "$out/authority-requests" --response-root "$control/responses")" || { rm -rf "$control"; return 1; }
    authority_digest="$(printf '%s\n' "$authority_prepare" | firm_python -c 'import json,sys; print(json.load(sys.stdin)["manifest_digest"])')" || { rm -rf "$control"; return 1; }
    authority_invocation="$(printf '%s\n' "$authority_prepare" | firm_python -c 'import json,sys; print(json.load(sys.stdin)["invocation"])')" || { rm -rf "$control"; return 1; }
    shell_env="$(printf '%s\n' "$authority_prepare" | firm_python -c 'import json,sys; print(json.load(sys.stdin)["shell_env"])')" || { rm -rf "$control"; return 1; }
    candidate_project="$(printf '%s\n' "$authority_prepare" | firm_python -c 'import json,sys; print(json.load(sys.stdin)["project_root"])')" || { rm -rf "$control"; return 1; }
    candidate_authority="$(printf '%s\n' "$authority_prepare" | firm_python -c 'import json,sys; print(json.load(sys.stdin)["authority_bin"])')" || { rm -rf "$control"; return 1; }
    shell_bash_env="$shell_env/.bash-env"; shell_sh_env="$shell_env/.sh-env"
    candidate_path="$control/shims:/usr/bin:/bin:/usr/sbin:/sbin"
    "$EVAL_AUTHORITY" serve --manifest "$authority_manifest" --digest "$authority_digest" \
      --invocation "$authority_invocation" --request-root "$out/authority-requests" \
      --response-root "$control/responses" --receipts "$control/receipts.jsonl" &
    broker_pid=$!
    authority_ready=0; authority_wait=0
    while [ "$authority_wait" -lt 100 ]; do
      [ -f "$control/receipts.jsonl" ] && { authority_ready=1; break; }
      kill -0 "$broker_pid" 2>/dev/null || break
      sleep 0.02; authority_wait=$((authority_wait+1))
    done
    [ "$authority_ready" -eq 1 ] || { kill "$broker_pid" 2>/dev/null || true; wait "$broker_pid" 2>/dev/null || true; rm -rf "$control"; echo "FAIL $name: candidate authority did not start" >&2; return 1; }
    trap 'kill "$broker_pid" 2>/dev/null || true; wait "$broker_pid" 2>/dev/null || true; [ -z "$authority_manifest" ] || "$EVAL_AUTHORITY" cleanup --manifest "$authority_manifest" --digest "$authority_digest" >/dev/null 2>&1 || true; [ -z "$control" ] || rm -rf "$control"' EXIT HUP INT TERM
  else
    provider_executable="$(command -v "$provider" 2>/dev/null || true)"
  fi

  echo "==> $name: driving the $provider-primary firm headlessly (bounded posture) in $scratch"
  echo "    bounds: wall=${eval_timeout}s top-level-turns=$eval_max_turns cases=$eval_max_cases attempts=1 retries=0"
  # AskUserQuestion / merge / push are deliberately NOT allow-listed, so the firm cannot autonomously
  # pass the final human gate in -p mode — that's how final_gate_pending is provable.
  if [ "$provider" = claude ]; then
    "$BOUNDED" --phase eval --provider claude --timeout "$eval_timeout" \
      --grace "${FIRM_EVAL_KILL_GRACE:-2}" --max-output "${FIRM_EVAL_MAX_OUTPUT:-1048576}" \
      --generation 1 --output "$out/result.json" --result "$out/supervision.json" --cwd "$scratch" -- \
      /usr/bin/env PATH="${candidate_path:-$PATH}" \
        GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
        GIT_CONFIG_COUNT=0 GIT_TERMINAL_PROMPT=0 GIT_PROTOCOL_FROM_USER=0 \
        ZDOTDIR="$shell_env" BASH_ENV="$shell_bash_env" ENV="$shell_sh_env" \
        FIRM_EVAL_AUTHORITY_BIN="$candidate_authority" FIRM_EVAL_AUTHORITY_REQUEST_ROOT="$out/authority-requests" \
        FIRM_EVAL_AUTHORITY_RESPONSE_ROOT="$control/responses" \
        FIRM_EVAL_AUTHORITY_MANIFEST="$authority_manifest" FIRM_EVAL_AUTHORITY_DIGEST="$authority_digest" \
        FIRM_EVAL_INVOCATION="$authority_invocation" "$claude_command" -p "The provider starts in a non-repository disposable capsule. The sole project root is $candidate_project; run every repository and Agent Firm command from it. Do not inspect or use any repository outside that root.

$(cat "$d/task.md")" \
        --append-system-prompt "$(cat "$MANUAL")

Execution envelope: this eval permits one provider attempt, no retries, and at most $eval_max_turns top-level turns." \
        --settings "$out/settings.json" \
        --permission-mode default \
        --allowedTools "Read,Edit,Write,Grep,Glob,Bash(firm-new-run:*),Bash(firm-ledger-log:*),Bash(firm-validate-verdict:*),Bash(firm-traceability-check:*),Bash(firm-final-qa-check:*),Bash(firm-qa-checkout:*),Bash(firm-qa-clean-check:*),Bash(firm-integrate:*),Bash(firm-integration-summary:*),Bash(firm-new-worktree:*),Bash(firm-gpt-qa:*),Bash(firm-claude-qa:*),Bash(firm-bench-record:*),Bash(git add:*),Bash(git commit:*),Bash(git worktree:*),Bash(git status:*),Bash(git diff:*),Bash(git log:*),Bash(git rev-parse:*),Bash(git checkout:*),Bash(git switch:*),Bash(git branch:*),Bash(node --test),Bash(node --test:*),Bash(npm test:*),Bash(npm run test:*),Bash(pytest:*),Bash(sh test/run-tests.sh)" \
        --disallowedTools "Bash(git push:*),Bash(git merge:*)" \
        --max-turns "$eval_max_turns" \
        --max-budget-usd "${FIRM_EVAL_BUDGET_USD:-5.00}" \
        --output-format json
    provider_rc=$?
  else
    prompt="\$agent-firm:start The provider starts in a non-repository disposable capsule. The sole project root is project; run every repository and Agent Firm command from \"$candidate_project\". Do not inspect or use any repository outside that root.

$(cat "$d/task.md")

Execution envelope: this eval permits one provider attempt, no retries, and at most $eval_max_turns top-level turns."
    # The never-ask policy is stated as a typed -c override, which is the ONLY form `codex exec`
    # honours. Measured against the installed codex-cli 0.147.0:
    #
    #   codex exec -a never --help    rc 2  "error: unexpected argument '-a' found"
    #   codex exec --ask-for-approval never --help
    #                                 rc 2  "error: unexpected argument '--ask-for-approval' found"
    #   codex -a never exec --help    rc 0  -- PARSES, BUT THE VALUE IS DISCARDED
    #
    # The third form is the trap. `codex --help` says "If no subcommand is specified, options will
    # be forwarded to the interactive CLI", and the root options really are dropped once a
    # subcommand appears -- they are not even validated. The control experiment is `-s`, whose
    # values clap does check:
    #
    #   codex --sandbox bogus --help      rc 2  "invalid value 'bogus' for '--sandbox'"
    #   codex -s bogus exec --help        rc 0  -- accepted, because it is thrown away
    #
    # So moving `-a never` in front of `exec` only buys rc 0; it does not set an approval policy.
    # `codex exec --help` lists no --ask-for-approval at all; `-c approval_policy="never"` is how
    # exec takes it, and it is the same form firm-reviewer-common sends to the real judge.
    "$BOUNDED" --phase eval --provider codex --timeout "$eval_timeout" \
      --grace "${FIRM_EVAL_KILL_GRACE:-2}" --max-output "${FIRM_EVAL_MAX_OUTPUT:-1048576}" \
      --max-turns "$eval_max_turns" --generation 1 --output "$out/result.json" \
      --result "$out/supervision.json" --cwd "$scratch" -- \
      /usr/bin/env PATH="${candidate_path:-$PATH}" FIRM_PRIMARY_PROVIDER=codex \
        GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
        GIT_CONFIG_COUNT=0 GIT_TERMINAL_PROMPT=0 GIT_PROTOCOL_FROM_USER=0 \
        ZDOTDIR="$shell_env" BASH_ENV="$shell_bash_env" ENV="$shell_sh_env" \
        FIRM_EVAL_AUTHORITY_BIN="$candidate_authority" FIRM_EVAL_AUTHORITY_REQUEST_ROOT="$out/authority-requests" \
        FIRM_EVAL_AUTHORITY_RESPONSE_ROOT="$control/responses" \
        FIRM_EVAL_AUTHORITY_MANIFEST="$authority_manifest" FIRM_EVAL_AUTHORITY_DIGEST="$authority_digest" \
        FIRM_EVAL_INVOCATION="$authority_invocation" "$codex_command" exec --ephemeral \
        --skip-git-repo-check \
        -m "${FIRM_CODEX_LEAD_MODEL:-gpt-5.6-sol}" -c 'model_reasoning_effort="xhigh"' \
        -s workspace-write -c 'approval_policy="never"' --json "$prompt"
    provider_rc=$?
  fi

  if [ -n "$broker_pid" ]; then
    kill "$broker_pid" 2>/dev/null || true
    wait "$broker_pid" 2>/dev/null || true
    cp "$control/receipts.jsonl" "$out/candidate-execution-receipts.jsonl" 2>/dev/null || provider_rc=1
    chmod 600 "$out/candidate-execution-receipts.jsonl" 2>/dev/null || provider_rc=1
    "$EVAL_AUTHORITY" verify --manifest "$authority_manifest" --digest "$authority_digest" \
      --receipts "$control/receipts.jsonl" > "$out/candidate-execution-summary.json" || provider_rc=1
    chmod 600 "$out/candidate-execution-summary.json" 2>/dev/null || provider_rc=1
    broker_pid=""
  fi

  if [ "$provider_rc" -ne 0 ]; then
    # The supervisor distinguishes "the provider ran and failed" from "the provider never started
    # because this harness handed the supervisor something it refuses". Those are different facts
    # and this message used to report both as the first: a `{"status":"invalid","error":"timeout
    # must be between 1 and 900"}` rejection was announced as "codex was stopped or exited
    # non-zero; rc=2", which reads as a provider problem and sends the reader to the wrong file.
    # Surface what the supervisor actually recorded.
    sup_status="$(firm_python - "$out/supervision.json" <<'PY' 2>/dev/null || true
import json, sys
try:
    doc = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    raise SystemExit(0)
if doc.get("status") == "invalid":
    print(f"the supervisor REFUSED this harness's control input and no provider ran: "
          f"{doc.get('error', 'no reason recorded')}")
elif doc.get("status") == "timeout":
    print(f"the provider hit the wall bound after {doc.get('duration_ms', '?')} ms and was "
          f"terminated; this is a BOUND, not a provider failure")
PY
)"
    if [ -n "$sup_status" ]; then
      echo "  ($sup_status; rc=$provider_rc — see $out/supervision.json; no retry attempted)" >&2
    else
      echo "  ($provider was stopped or exited non-zero; rc=$provider_rc — see $out/supervision.json and result.json; no retry attempted)" >&2
    fi
    [ -z "$authority_manifest" ] || "$EVAL_AUTHORITY" cleanup --manifest "$authority_manifest" --digest "$authority_digest" >/dev/null || true
    [ -z "$control" ] || rm -rf "$control"; control=""; authority_manifest=""
    trap - EXIT HUP INT TERM
    return 1
  fi

  if [ "$provider" = claude ]; then
    turns="$(firm_python - "$out/result.json" <<'PY'
import json, sys
try:
    value = json.load(open(sys.argv[1], encoding="utf-8")).get("num_turns")
    if not isinstance(value, int) or value < 0:
        raise ValueError("num_turns is absent or invalid")
    print(value)
except Exception as e:
    print(f"cannot account Claude turns: {type(e).__name__}: {e}", file=sys.stderr)
    sys.exit(2)
PY
)" || return 1
  else
    turns="$(firm_python - "$out/result.json" <<'PY'
# `codex exec --json` writes a JSONL EVENT STREAM, but not every line of its stdout is an event:
# it emits human preamble first. Measured 2026-08-23, the very first line of a real run is
#
#     Reading additional input from stdin...
#     {"type":"thread.started","thread_id":"01a02cd4-..."}
#
# and this accounter called json.loads() on every line, so it died on line 1 with
# "JSONDecodeError: Expecting value: line 1 column 1 (char 0)" and failed an eval whose provider
# phase had just completed normally in 654 s. Nothing had ever got this far on the Codex
# orientation — the `-a never` defect stopped every previous run in 9 ms — so the first line the
# CLI has always printed had never been read by this code.
#
# Non-JSON lines are therefore skipped, but the check keeps its teeth in both directions: a stream
# with NO parseable records at all is still a failure (that is a broken or empty stream, not a
# preamble), and a stream that parses but records no turn is still a failure (that is the run that
# crashed or did nothing, which is what this accounting exists to catch). Only provider prose is
# tolerated, and only when real events follow it.
#
# NOTE FOR EDITORS: this heredoc sits inside a $(...) substitution, where bash 3.2 scans for the
# closing paren without fully honouring heredoc quoting, so a lone apostrophe here ends a quote that
# was never opened and the whole script fails to parse at a line number hundreds of lines away.
# MEASURED, because the earlier wording over-stated it: bash 3.2.57 breaks only on an apostrophe that
# sits OUTSIDE a double-quoted span -- the scanner does track double quotes, which is why the
# f-strings below survive with nine apostrophes between them -- and bash 5.3.15 parses either form
# clean. macOS ships 3.2, so treat the body as apostrophe-free anyway; that is the cheap rule, and it
# is the one tests/test-bin-syntax.sh pins (against a bash 3.2 specifically, after the CI fix).
import json, sys
count = 0
parsed = 0
try:
    for raw in open(sys.argv[1], encoding="utf-8"):
        raw = raw.strip()
        if not raw.startswith("{"):
            continue
        try:
            event = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if not isinstance(event, dict):
            continue
        parsed += 1
        if event.get("type") in ("turn.started", "turn_start"):
            count += 1
    if parsed < 1:
        raise ValueError("the result stream contained no parseable JSON event at all")
    if count < 1:
        raise ValueError("no turn-start event was recorded")
    print(count)
except Exception as e:
    print(f"cannot account Codex turns: {type(e).__name__}: {e}", file=sys.stderr)
    sys.exit(2)
PY
)" || return 1
  fi
  if [ "$turns" -gt "$eval_max_turns" ]; then
    echo "  ($provider reported $turns top-level turns, exceeding cap $eval_max_turns — BLOCK; no retry attempted)" >&2
    return 1
  fi
  echo "    accounted top-level turns: $turns/$eval_max_turns"

  # Show the run envelope summary for observability.
  [ "$provider" = claude ] && firm_python - "$out/result.json" <<'PY' 2>/dev/null || true
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: sys.exit(0)
print("    envelope:", {k:d.get(k) for k in ("subtype","is_error","num_turns","stop_reason","total_cost_usd")})
print("    permission_denials:", len(d.get("permission_denials") or []))
PY

  FIRM_EVAL_PROVIDER="$provider" "$CHECKER" "$d/assertions.yaml" "${candidate_project:-$scratch}" "$out/result.json"
  checker_rc=$?
  if [ -n "$authority_manifest" ]; then
    "$EVAL_AUTHORITY" cleanup --manifest "$authority_manifest" --digest "$authority_digest" >/dev/null || checker_rc=1
    rm -rf "$control"; control=""; authority_manifest=""
    trap - EXIT HUP INT TERM
  fi
  echo "    (disposable capsule cleaned after assertion evaluation)"
  case "$checker_rc" in
    0) return 0 ;;
    1) echo "  (assertion checker completed: one or more assertions failed; no retry attempted)" >&2 ;;
    2) echo "  (assertion checker rejected malformed or unevaluable assertions; no retry attempted)" >&2 ;;
    *) echo "  (assertion checker crashed or returned unsupported rc=$checker_rc; no retry attempted)" >&2 ;;
  esac
  return 1
}

if [ "$mode" = "structural" ]; then
  echo "structural mode: OFFLINE shape + assertion PARSE-ONLY check (no assertion payload, model, network, or spend)."
  echo "  Proves: each eval has known non-empty assertion vocabulary and valid value shapes."
  echo "  Does NOT prove: that the firm SATISFIES them — that needs a real 'firm-run-evals --provider <provider> <name>'."
fi

rc=0; n=0
for d in "$EVALS"/*/; do
  [ -d "$d" ] || continue
  name="$(basename "$d")"; [ "$name" = "README.md" ] && continue
  [ -n "$want" ] && [ "$want" != "$name" ] && continue
  if [ "$mode" = run ] && [ "$n" -ge "$eval_max_cases" ]; then
    echo "behavioral eval case cap reached ($eval_max_cases); refusing additional subscription work" >&2
    rc=1
    break
  fi
  n=$((n+1))
  if ! structural_check "$d"; then echo "BAD  $name (structure)"; rc=1; continue; fi
  if [ "$mode" = "structural" ]; then
    if structural_assertions "$d"; then
      echo "ok   $name ($SA_COUNT assertions) — vocabulary + value shapes parsed [structural only; payloads not executed]"
    else
      echo "BAD  $name (assertions)"
      printf '%s\n' "$SA_DETAIL" | sed 's/^/       /'
      rc=1
    fi
    continue
  fi
  if run_one "$d" "$name"; then echo "PASS $name"; else echo "FAIL $name"; rc=1; fi
done
[ "$n" -eq 0 ] && { echo "firm-run-evals: no eval directories found in $EVALS" >&2; exit 1; }
echo "---"
sfx=""
[ "$mode" = "structural" ] && sfx=" (structural: parse/shape only — NOT a behavioural pass)"
if [ "$rc" -eq 0 ]; then echo "all evals passed$sfx"; else echo "some evals FAILED$sfx"; fi
exit "$rc"
