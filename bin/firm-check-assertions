#!/usr/bin/env bash
# firm-check-assertions [--parse-only] <assertions.yaml> [scratch-repo] [result.json]
# Checks the full golden-eval assertion vocabulary against the post-run scratch repo (the run ledger +
# git state).
#
# Exit 0 = every assertion passed. 1 = at least one assertion FAILED. 2 = the assertions file itself
# could not be evaluated (usage error, unreadable/empty/prose-only file, invalid YAML, a fallback
# parse that had to drop entries, or NO USABLE PARSER -- a pyyaml that is installed but broken; see
# the find_spec discriminator below). That third case used to be exit 0: an EMPTY or prose-only
# assertions.yaml printed "0/0 assertions passed" and an eval whose checks never ran reported green.
# ZERO PARSED ASSERTIONS IS NOW A HARD FAILURE — a check that cannot evaluate its input must never
# report success, which is the same fail-closed rule the baseline checks below already follow.
#
# `result.json` (the `claude -p` result
# envelope) is still accepted for CLI compatibility with existing callers, but no assertion currently
# reads it — final_gate_pending used to infer from its subtype/is_error fields; it now requires an
# explicit ledger event instead (see default_branch_status() / final_gate_event_logged() below), which
# a run that crashed or did nothing could not fake the way the envelope inference could.
#
# Assertion vocabulary (assertions.yaml, a top-level `assertions:` list of `- key: value`):
#   file_exists / file_absent <path>     artifact_exists / artifact_absent <ledger-file>
#   verdict_is APPROVE|BLOCK             test_passes <command>              traceability_passes true
#   no_default_branch_merge true         final_gate_pending true            (an EXPLICIT
#                                          firm-ledger-log event, not inferred from the claude -p
#                                          envelope — see default_branch_status() below)
#   qa_checkout_clean true               (delegates to firm-qa-clean-check; NOT read-only enforcement,
#                                          only "no visible changes were left" — see that script's header)
#
# `--parse-only` accepts only the assertions file, validates this complete vocabulary plus non-empty
# value domains, and exits before assertion helper definitions or dispatch. In particular,
# `test_passes` remains inert data; parse-only never evaluates shell, project, provider, reviewer,
# Git, interpreter, filesystem, listener, or network payloads.
#
# no_default_branch_merge / final_gate_pending both compare the default branch's CURRENT sha against
# run-baseline.json (written by firm-new-run at run start). If that baseline is missing or unusable,
# BOTH FAIL CLOSED — never a silent pass via a weaker guess. There is no commit-count fallback: a
# fallback that can produce a false pass is the exact bug this replaces (see firm-doctor's retired-
# permission-rules check, fixed the same way one script earlier).
#
# EVERY LEDGER-READING VERB FAILS CLOSED WHEN NO LEDGER CAN BE RESOLVED — artifact_exists,
# artifact_absent and verdict_is included. Two of them did not. artifact_absent read "no ledger" as
# "the artifact is absent" and PASSED on a repo where nothing had ever run, while skipping the
# `.agent-firm/**` scan that would have found the artifact anyway; verdict_is built its path from
# `led or ""`, so with no ledger it read 08-qa-verdict.json out of the CHECKER'S OWN CWD and could
# report APPROVE from a file in an unrelated directory. Both are closed at their branches below.
# The same rule applies to every verb that INVERTS a delegated script's exit code. traceability_passes
# used to do `(rc == 0) == (want == "true")`, so `traceability_passes: false` was satisfied by ANY
# non-zero exit from firm-traceability-check -- a genuine coverage gap, a usage error, an unparseable
# verdict, a missing run dir and a crash all alike. It now CLASSIFIES: rc 0 = evaluated/covered,
# rc 1 = evaluated/inadequate, anything else = cannot evaluate, which FAILS the assertion on both
# `true` and `false`. qa_checkout_clean has always classified its child's rc=2 the same way.
#
# This script is how the firm proves an accepted change did not regress: a fail-open HERE silently
# disarms every golden eval, so treat any "it cannot look, so it passes" path as a defect.
set -uo pipefail
__src="${BASH_SOURCE[0]}"   # resolve symlinks so ~/.local/bin/firm-* finds the repo
while [ -L "$__src" ]; do __d="$(cd -P "$(dirname "$__src")" && pwd)"; __src="$(readlink "$__src")"; case $__src in /*) ;; *) __src="$__d/$__src";; esac; done
SELF="$(cd -P "$(dirname "$__src")" && pwd)"
parse_only=0
if [ "${1:-}" = "--parse-only" ]; then parse_only=1; shift; fi
if [ "$parse_only" -eq 1 ]; then
  [ "$#" -eq 1 ] || { echo "usage: firm-check-assertions --parse-only <assertions.yaml>" >&2; exit 2; }
  repo=""
else
  [ -n "${1:-}" ] && [ -n "${2:-}" ] && [ "$#" -le 3 ] || {
    echo "usage: firm-check-assertions <assertions.yaml> <scratch-repo> [result.json]" >&2; exit 2; }
  repo="$2"
fi
python3 - "$1" "$repo" "${3:-}" "$SELF" "$parse_only" <<'PY'
import glob, hashlib, importlib.util, json, os, re, stat, subprocess, sys
apath, repo, rpath, selfdir = sys.argv[1:5]
parse_only = sys.argv[5] == "1"

def cannot_evaluate(msg):
    """The assertions file itself is unusable. Exit 2, NEVER 0: an eval whose assertions did not run
    has proven nothing, and 'nothing was checked' must not be reportable as 'everything passed'."""
    print(f"ASSERTIONS: CANNOT EVALUATE — {msg}", file=sys.stderr)
    sys.exit(2)

# ---------------------------------------------------------------------------------------------
# Parse assertions.yaml. pyyaml when it is installed AND WORKS; otherwise a deliberately narrow
# `- key: value` line parser. THREE failure modes are kept APART, because they are not the same risk:
#
#   pyyaml MISSING      -> legitimate degraded path (this repo's tooling holds itself to a stdlib-only
#                          floor), so the fallback runs -- but it must account for every list item it
#                          saw. Any item it could not parse is a DROP, and a dropped assertion is an
#                          unrun check, so any drop fails the whole file (exit 2) with the line quoted.
#   pyyaml BROKEN       -> NOT the degraded path. An installed-but-unimportable pyyaml means no parser
#                          could be CHOSEN, so nothing was evaluated: exit 2, naming the real
#                          exception. Never a quiet downgrade to the fallback, and never an escaping
#                          exception (which python would turn into exit 1 = "an assertion failed").
#                          See the find_spec discriminator below the fallback parser.
#   YAML SYNTAX ERROR   -> hard failure. Never fall back. The old code caught both with one bare
#                          `except Exception` and silently regex-scanned a broken file, so a typo that
#                          moved an assertion out of the `assertions:` list read as "that assertion
#                          simply isn't there" instead of "this file is broken".
# ---------------------------------------------------------------------------------------------
try:
    with open(apath) as fh:
        atext = fh.read()
except Exception as e:
    cannot_evaluate(f"cannot read {apath}: {e}")

def _unquote(s):
    """Strip ONE matched pair of surrounding quotes. The old `.strip('\"\\'')` stripped quote chars
    off both ends independently, which turned `sh -c 'cmd'` into `sh -c 'cmd` (unbalanced)."""
    s = s.strip()
    if len(s) >= 2 and s[0] == s[-1] and s[0] in ("'", '"'):
        return s[1:-1]
    return s

def fallback_parse(text):
    """(items, dropped). Scans the `assertions:` block only, and reports every list item it could not
    turn into a `- key: value` mapping instead of skipping it."""
    items, dropped = [], []
    in_block = False
    for n, line in enumerate(text.splitlines(), 1):
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        indent = len(line) - len(line.lstrip())
        if not in_block:
            if re.match(r'^assertions\s*:\s*(#.*)?$', line):
                in_block = True
            elif re.match(r'^assertions\s*:\s*\S', line):
                # An inline/flow value on the key (`assertions: [ ... ]`). The line parser cannot
                # read that shape; refuse rather than report an empty list.
                dropped.append((n, stripped))
            continue
        # A zero-indent `- item` is still part of this block: YAML lets a block sequence sit at the
        # same indentation as its key. Only a zero-indent NON-item line is the next top-level key.
        if indent == 0 and not stripped.startswith("-"):
            in_block = False
            continue
        if not stripped.startswith("-"):
            dropped.append((n, stripped))   # a continuation/nested line this parser cannot interpret
            continue
        m = re.match(r'^\s*-\s*([A-Za-z_][A-Za-z0-9_]*)\s*:\s*(\S.*?)\s*$', line)
        if m:
            items.append({m.group(1): _unquote(m.group(2))})
        else:
            dropped.append((n, stripped))
    return items, dropped

# ---------------------------------------------------------------------------------------------
# WHICH PARSER RUNS -- and the THIRD state the old code could not see.
#
# `try: import yaml / except ImportError: yaml = None` recognised two worlds: pyyaml importable, or
# pyyaml missing. A pyyaml that is INSTALLED BUT BROKEN (a partial or corrupted install, a missing
# internal submodule, an extension module that will not load, a module-level sys.exit) is a THIRD,
# and it was mishandled in both of its shapes:
#   * raising ImportError from INSIDE the package -- swallowed by the `except`, so this script
#     SILENTLY DOWNGRADED to the weaker line parser and printed "pyyaml not installed" about a host
#     where pyyaml IS installed. The operator is told the wrong parser ran, and the fallback's
#     narrower grammar then decides whether the eval's assertions are evaluable at all.
#   * raising ANYTHING ELSE (RuntimeError, SyntaxError, ValueError -- or SystemExit, which is not an
#     Exception at all) -- not caught, so it escaped: python exits 1 on an unhandled exception, and
#     1 in this script's contract means "evaluated, an assertion FAILED". A crash was reported as a
#     test result. A module-level `sys.exit(0)` was worse still: exit 0, no output, ZERO assertions
#     run -- "everything passed" from a run that checked nothing.
# Fifth instance of this file's characteristic defect: A CHECK THAT CANNOT EVALUATE ITS INPUT MUST
# SAY "CANNOT EVALUATE" (exit 2), never report a verdict.
#
# The discriminator is importlib.util.find_spec("yaml"): it asks the import system whether the
# module is FINDABLE, without executing it.
#   spec is None        -> pyyaml is genuinely NOT INSTALLED. Legitimate degraded path; the regex
#                          fallback below runs exactly as it always has.
#   spec is not None    -> pyyaml IS installed and importing it still failed => BROKEN => exit 2.
#   the probe RAISED    -> INCONCLUSIVE (e.g. a broken parent package, or a poisoned
#                          sys.modules entry making find_spec raise ValueError). Also exit 2:
#                          guessing "absent" would silently downgrade the parser, which is the very
#                          fail-open being closed here. An unknown state is not the degraded state.
# The import is wrapped in `except BaseException` deliberately -- `except Exception` still lets a
# module-level SystemExit (or a KeyboardInterrupt landing inside the import) set this process's exit
# code to something a caller reads as a verdict, 0 included.
# ---------------------------------------------------------------------------------------------
def _one_line_ascii(x, limit=240):
    """A third-party exception's text is DATA: it can be multi-line and non-ASCII. Collapse it to one
    greppable line and transliterate it, so a broken-install report stays readable and cannot itself
    raise UnicodeEncodeError on the way out (the same treatment traceability_passes gives the child
    process's words below)."""
    s = " ".join(str(x).split()).encode("ascii", "replace").decode("ascii")
    return (s[:limit] + " ...") if len(s) > limit else s

yaml = None
yaml_exc = None
try:
    import yaml
except BaseException as e:            # NOT just ImportError -- see the note above
    yaml_exc = e

if yaml is None:
    yaml_spec, probe_exc = None, None
    try:
        yaml_spec = importlib.util.find_spec("yaml")
    except BaseException as e:
        probe_exc = e
    if probe_exc is not None:
        cannot_evaluate(
            "cannot tell whether pyyaml is absent or broken: `import yaml` raised "
            f"{type(yaml_exc).__name__}: {_one_line_ascii(yaml_exc)}, and probing for it with "
            f"importlib.util.find_spec('yaml') itself raised {type(probe_exc).__name__}: "
            f"{_one_line_ascii(probe_exc)}. Refusing to assume 'not installed' and downgrade to the "
            "line parser on a guess -- an unexplained parser downgrade is exactly the silent "
            "fail-open this check exists to prevent. Repair the python environment and re-run.")
    if yaml_spec is not None:
        cannot_evaluate(
            f"pyyaml IS installed ({getattr(yaml_spec, 'origin', None) or 'origin unknown'}) but "
            f"`import yaml` FAILED: {type(yaml_exc).__name__}: {_one_line_ascii(yaml_exc)}. That is a "
            "BROKEN install, not a missing one -- so this is NOT the legitimate degraded path and it "
            "is NOT quietly retried with the weaker line parser, which would report a parser you do "
            "not have. Repair or reinstall pyyaml (pip install --force-reinstall pyyaml), or remove "
            "it if you mean to run on the fallback.")
    # spec is None: pyyaml really is not installed. Fall through to the documented fallback.

if yaml is not None:
    parse_mode = "pyyaml"
    try:
        doc = yaml.safe_load(atext)
    except Exception as e:
        cannot_evaluate(f"{apath} is not valid YAML: {e}")
    if doc is None:
        cannot_evaluate(f"{apath} is empty (or parses to nothing) — it declares no assertions")
    if not isinstance(doc, dict):
        cannot_evaluate(f"{apath} top level is {type(doc).__name__}, expected a mapping with an `assertions:` list")
    if "assertions" not in doc:
        cannot_evaluate(f"{apath} has no top-level `assertions:` key")
    asserts = doc.get("assertions")
    if asserts is None:
        asserts = []
    if not isinstance(asserts, list):
        cannot_evaluate(f"{apath}: `assertions:` is {type(asserts).__name__}, expected a list")
else:
    parse_mode = "regex fallback (pyyaml not installed)"
    asserts, dropped = fallback_parse(atext)
    if dropped:
        detail = "; ".join(f"line {n}: {t!r}" for n, t in dropped[:10])
        more = "" if len(dropped) <= 10 else f" (+{len(dropped)-10} more)"
        cannot_evaluate(
            f"{apath}: the {parse_mode} could not parse {len(dropped)} of "
            f"{len(asserts)+len(dropped)} entries under `assertions:` — a dropped assertion is an "
            f"UNRUN check, so this cannot pass. Install pyyaml or fix these lines: {detail}{more}")

if not asserts:
    cannot_evaluate(f"{apath}: 0 assertions parsed via {parse_mode} — an eval that checks nothing "
                    f"cannot pass (a vacuous 0/0 used to exit 0; it no longer does)")
KNOWN = {
    "file_exists": "text", "file_absent": "text",
    "artifact_exists": "text", "artifact_absent": "text",
    "verdict_is": "verdict", "test_passes": "text",
    "traceability_passes": "boolean", "no_default_branch_merge": "boolean",
    "final_gate_pending": "boolean", "qa_checkout_clean": "boolean",
    "trusted_unavailability_chain": "boolean",
}

def value_error(index, key, message):
    cannot_evaluate(f"{apath}: assertion {index} `{key}` {message}")

def validate_shape(index, item):
    if not isinstance(item, dict) or len(item) != 1:
        cannot_evaluate(
            f"{apath}: assertion {index} is malformed; expected exactly one `key: value` mapping")
    (key, value), = item.items()
    if not isinstance(key, str) or key not in KNOWN:
        shown = repr(key)
        cannot_evaluate(
            f"{apath}: assertion {index} uses unknown assertion {shown}; valid names: "
            + ", ".join(sorted(KNOWN)))
    kind = KNOWN[key]
    if kind == "boolean":
        if isinstance(value, bool):
            return
        if not isinstance(value, str) or value.strip().lower() not in ("true", "false"):
            value_error(index, key, "requires boolean true or false")
        return
    if not isinstance(value, str):
        value_error(index, key, "requires a string value")
    clean = value.strip()
    if not clean:
        value_error(index, key, "requires a non-empty value")
    if any(ord(ch) < 32 or ord(ch) == 127 for ch in clean):
        value_error(index, key, "contains a control character")
    if kind == "verdict" and clean not in ("APPROVE", "BLOCK"):
        value_error(index, key, "must be APPROVE or BLOCK")

print(f"assertions: {len(asserts)} parsed from {apath} via {parse_mode}")
if parse_only:
    for index, assertion in enumerate(asserts, 1):
        validate_shape(index, assertion)
    print(f"PARSE-ONLY: PASS -- {len(asserts)} known assertions and value shapes validated; no assertion or payload executed")
    sys.exit(0)

def find_ledger():
    cur = os.path.join(repo, ".agent-firm", "CURRENT_RUN")
    if os.path.exists(cur):
        p = open(cur).read().strip()
        return p if os.path.isabs(p) else os.path.join(repo, p)
    runs = sorted(glob.glob(os.path.join(repo, ".agent-firm", "runs", "*")), key=os.path.getmtime)
    return runs[-1] if runs else None

def git(*a):
    return subprocess.run(["git", *a], cwd=repo, capture_output=True, text=True)

def default_branch_status():
    """(status, detail). status is True (unchanged) / False (advanced) / None (CANNOT VERIFY).
    Shared by no_default_branch_merge and final_gate_pending so there is exactly one implementation
    of "did the default branch move", not two that could quietly drift apart."""
    led = find_ledger()
    if not led:
        return None, "no run ledger found"
    bpath = os.path.join(led, "run-baseline.json")
    if not os.path.exists(bpath):
        return None, "no run-baseline.json (ledger predates the baseline mechanism, or firm-new-run couldn't resolve a default branch)"
    try:
        b = json.load(open(bpath))
        db, start_sha = b.get("default_branch"), b.get("default_branch_start_sha")
    except Exception as e:
        return None, f"run-baseline.json unparseable: {e}"
    if not db or not start_sha:
        return None, "run-baseline.json missing default_branch or default_branch_start_sha"
    r = git("rev-parse", "--verify", "--quiet", db)
    if r.returncode != 0:
        return None, f"default_branch '{db}' from the baseline does not exist in this repo"
    current = r.stdout.strip()
    return (current == start_sha), f"default_branch={db} baseline={start_sha[:12]} current={current[:12]}"

def final_gate_event_logged():
    """Was a `final_gate_pending` event actually written to run.jsonl? This is a POSITIVE, checkable
    signal the Lead logs immediately before pausing for human sign-off (see
    agent-firm/contracts/lifecycle.md) -- not an inference from the outer provider envelope, which a run
    that crashed or did nothing at all could also satisfy."""
    led = find_ledger()
    if not led:
        return False
    p = os.path.join(led, "run.jsonl")
    if not os.path.exists(p):
        return False
    for line in open(p):
        line = line.strip()
        if not line:
            continue
        try:
            if json.loads(line).get("event") == "final_gate_pending":
                return True
        except Exception:
            continue
    return False

def trusted_unavailability_chain():
    """Correlate one complete opposite-provider exit-3 chain; never accept independent matches.

    This assertion is intentionally specific to the no-network availability eval. It binds the
    current primary orientation to one immutable reviewer attempt, its two exact target-ledger
    events, the current state projection, traceability reference, absence of both possible
    provider-suffixed verdicts, and a structured before/after final-check capture. It then reruns the
    sibling final checker and requires the captured after-exit to equal the current exit.
    """
    led = find_ledger()
    if led is None:
        return False, "no run ledger found"
    led = os.path.realpath(led)
    runs_root = os.path.realpath(os.path.join(repo, ".agent-firm", "runs"))
    try:
        inside_runs = os.path.commonpath((runs_root, led)) == runs_root
    except ValueError:
        inside_runs = False
    if not inside_runs or led == runs_root:
        return False, "run ledger is outside the scratch repository's runs root"
    if not os.path.isdir(led) or os.path.islink(led):
        return False, "run ledger is not a regular directory"
    run_id = os.path.basename(led)

    def regular(rel):
        if not isinstance(rel, str) or not rel or os.path.isabs(rel):
            raise ValueError(f"unsafe relative path {rel!r}")
        normalized = os.path.normpath(rel)
        if normalized != rel or normalized == ".." or normalized.startswith("../"):
            raise ValueError(f"noncanonical relative path {rel!r}")
        path = os.path.join(led, rel)
        if os.path.realpath(path) != os.path.join(led, rel):
            raise ValueError(f"path escapes or traverses a symlink: {rel}")
        info = os.lstat(path)
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
            raise ValueError(f"not a regular no-follow file: {rel}")
        return path

    def raw(rel):
        path = regular(rel)
        with open(path, "rb") as handle:
            return handle.read()

    def json_doc(rel):
        value = json.loads(raw(rel))
        if not isinstance(value, dict):
            raise ValueError(f"{rel} is not a JSON object")
        return value

    def exact_ref(ref, rel, provider, generation, attempt_id, sha, digest, size, event_id):
        if not isinstance(ref, dict):
            return False
        producer = ref.get("producer")
        return (
            ref.get("path") == rel and ref.get("provider") == provider
            and ref.get("generation") == generation and ref.get("attempt_id") == attempt_id
            and ref.get("candidate_sha") == sha and ref.get("sha256") == digest
            and ref.get("bytes") == size and isinstance(producer, dict)
            and producer.get("event_id") == event_id
            and producer.get("event") == "reviewer_unavailable"
            and producer.get("provider") == provider
            and producer.get("generation") == generation
            and producer.get("attempt_id") == attempt_id
        )

    try:
        if yaml is None:
            raise ValueError("structured availability correlation requires pyyaml")
        orientation = os.environ.get("FIRM_EVAL_PROVIDER")
        if orientation not in ("claude", "codex"):
            raise ValueError("FIRM_EVAL_PROVIDER must be claude or codex")
        selected = "gpt" if orientation == "claude" else "claude"
        nonselected = "claude" if selected == "gpt" else "gpt"

        metadata = json_doc("run-metadata.json")
        candidate = json_doc("09-test-evidence/qa-candidate.json")
        if metadata.get("run_id") != run_id or metadata.get("primary_provider") != orientation:
            raise ValueError("run metadata does not match selected primary orientation")
        sha = candidate.get("candidate_sha")
        generation = candidate.get("generation")
        if (candidate.get("run_id") != run_id or not isinstance(sha, str)
                or not re.fullmatch(r"[0-9a-f]{40}", sha)
                or not isinstance(generation, int) or isinstance(generation, bool) or generation < 1):
            raise ValueError("candidate identity is incomplete or invalid")

        trace = yaml.safe_load(raw("traceability.yaml"))
        if not isinstance(trace, dict) or trace.get("schema_version") != 2:
            raise ValueError("traceability.yaml is not schema version 2")
        trace_candidate = trace.get("candidate")
        two_voice = trace.get("two_voice")
        if (not isinstance(trace_candidate, dict)
                or trace_candidate.get("run_id") != run_id
                or trace_candidate.get("commit_sha") != sha
                or trace_candidate.get("generation") != generation):
            raise ValueError("traceability candidate does not match current candidate")
        if (not isinstance(two_voice, dict) or two_voice.get("secondary_provider") != selected
                or two_voice.get("status") != "unavailable"):
            raise ValueError("traceability does not select the expected unavailable second voice")
        attempt_ref = two_voice.get("attempt")
        if not isinstance(attempt_ref, dict):
            raise ValueError("traceability unavailable state has no structured attempt reference")
        attempt_id = attempt_ref.get("attempt_id")
        if not isinstance(attempt_id, str) or not re.fullmatch(
                rf"{re.escape(selected)}-c{generation}-a[0-9]{{4}}", attempt_id):
            raise ValueError("attempt id does not bind selected provider and generation")
        attempt_rel = f"09-test-evidence/reviewer-attempts/{attempt_id}/attempt.json"
        attempt_raw = raw(attempt_rel)
        attempt_digest = hashlib.sha256(attempt_raw).hexdigest()
        attempt_size = len(attempt_raw)
        attempt = json.loads(attempt_raw)
        if not isinstance(attempt, dict):
            raise ValueError("attempt record is not an object")
        event_id = attempt.get("outcome_event_id")
        start_event_id = attempt.get("started_event_id")
        if (attempt.get("schema_version") != 1 or attempt.get("run_id") != run_id
                or attempt.get("provider") != selected or attempt.get("attempt_id") != attempt_id
                or attempt.get("candidate_sha") != sha or attempt.get("generation") != generation
                or attempt.get("status") != "unavailable" or attempt.get("exit_code") != 3
                or not isinstance(attempt.get("trusted_reason"), str) or not attempt.get("trusted_reason")
                or not isinstance(event_id, str) or not event_id
                or not isinstance(start_event_id, str) or not start_event_id):
            raise ValueError("attempt record does not describe one trusted exit-3 outcome")
        if not exact_ref(attempt_ref, attempt_rel, selected, generation, attempt_id, sha,
                         attempt_digest, attempt_size, event_id):
            raise ValueError("traceability attempt reference does not match attempt bytes and event")

        state = json_doc(f"09-test-evidence/reviewer-state.{selected}.json")
        expected_counter = int(attempt_id.rsplit("a", 1)[1])
        if (state.get("schema_version") != 1 or state.get("provider") != selected
                or state.get("candidate_sha") != sha or state.get("generation") != generation
                or state.get("attempt_id") != attempt_id or state.get("last_attempt") != expected_counter):
            raise ValueError("current reviewer state does not project the exact attempt")

        events = []
        for number, line in enumerate(raw("run.jsonl").decode("utf-8").splitlines(), 1):
            if not line.strip():
                continue
            item = json.loads(line)
            if not isinstance(item, dict):
                raise ValueError(f"ledger line {number} is not an object")
            events.append(item)
        starts = [e for e in events if e.get("event_id") == start_event_id]
        outcomes = [e for e in events if e.get("event_id") == event_id]
        if len(starts) != 1 or len(outcomes) != 1:
            raise ValueError("attempt start/outcome event id is missing or duplicated")
        start = starts[0]
        outcome = outcomes[0]
        common = lambda event: (
            event.get("run_id") == run_id and event.get("provider") == selected
            and str(event.get("generation")) == str(generation) and event.get("sha") == sha
            and event.get("attempt") == attempt_rel and event.get("attempt_id") == attempt_id
        )
        if start.get("event") != "reviewer_attempt_started" or not common(start):
            raise ValueError("attempt start event is not the exact target-ledger start")
        if (outcome.get("event") != "reviewer_unavailable" or not common(outcome)
                or str(outcome.get("exit_code")) != "3"
                or outcome.get("reason") != attempt.get("trusted_reason")
                or outcome.get("sha256") != attempt_digest
                or str(outcome.get("bytes")) != str(attempt_size)):
            raise ValueError("attempt outcome is not the exact digest-bound exit-3 event")
        terminal_names = {"reviewer_approve", "reviewer_block", "reviewer_invalid", "reviewer_timeout", "reviewer_unavailable"}
        current_terminals = [e for e in events if e.get("event") in terminal_names
                             and e.get("provider") == selected and e.get("sha") == sha
                             and str(e.get("generation")) == str(generation)]
        if len(current_terminals) != 1 or current_terminals[0].get("event_id") != event_id:
            raise ValueError("selected provider has zero, duplicate, or competing terminal outcomes")
        nonselected_events = [e for e in events
                              if e.get("event") in terminal_names | {"reviewer_attempt_started"}
                              and e.get("provider") == nonselected and e.get("sha") == sha
                              and str(e.get("generation")) == str(generation)]
        if nonselected_events:
            raise ValueError("nonselected provider has a current-generation reviewer event")

        attempts_root = os.path.join(led, "09-test-evidence", "reviewer-attempts")
        selected_dirs = []
        nonselected_dirs = []
        for entry in os.scandir(attempts_root):
            if entry.is_symlink() or not entry.is_dir(follow_symlinks=False):
                raise ValueError("reviewer-attempts contains an unsafe entry")
            if entry.name.startswith(f"{selected}-c{generation}-a"):
                selected_dirs.append(entry.name)
            if entry.name.startswith(f"{nonselected}-c{generation}-a"):
                nonselected_dirs.append(entry.name)
        if selected_dirs != [attempt_id] or nonselected_dirs:
            raise ValueError("current generation does not contain exactly one selected attempt and zero nonselected attempts")
        for provider in (selected, nonselected):
            if os.path.lexists(os.path.join(led, f"08-qa-verdict.{provider}.json")):
                raise ValueError(f"unexpected provider-suffixed verdict exists for {provider}")
        if os.path.lexists(os.path.join(led, f"09-test-evidence/reviewer-state.{nonselected}.json")):
            raise ValueError("nonselected reviewer state exists")

        capture = json_doc("09-test-evidence/final-qa-unavailable.json")
        if (capture.get("schema_version") != 1 or capture.get("run_id") != run_id
                or capture.get("candidate_sha") != sha or capture.get("generation") != generation
                or capture.get("provider") != selected or capture.get("attempt_id") != attempt_id
                or set(capture) != {"schema_version", "run_id", "candidate_sha", "generation", "provider", "attempt_id", "before", "after"}):
            raise ValueError("final-check capture identity is mismatched")
        for label, expected_rel in (
                ("before", "09-test-evidence/final-qa-before-unavailable.txt"),
                ("after", "09-test-evidence/final-qa-after-unavailable.txt")):
            item = capture.get(label)
            if not isinstance(item, dict) or set(item) != {"argv", "exit_code", "output"}:
                raise ValueError(f"final-check {label} capture is malformed")
            expected_run_arg = f".agent-firm/runs/{run_id}"
            if item.get("argv") != ["firm-final-qa-check", expected_run_arg]:
                raise ValueError(f"final-check {label} argv is not canonical")
            output = item.get("output")
            payload = raw(expected_rel)
            if (not isinstance(output, dict) or set(output) != {"path", "sha256", "bytes"}
                    or output.get("path") != expected_rel
                    or output.get("sha256") != hashlib.sha256(payload).hexdigest()
                    or output.get("bytes") != len(payload)):
                raise ValueError(f"final-check {label} output reference is not digest-bound")
            if label == "before":
                if item.get("exit_code") != 1:
                    raise ValueError("before final-check exit must be the exact blocking exit 1")
                if b"BLOCK" not in payload:
                    raise ValueError("before final-check output does not contain BLOCK")
            elif item.get("exit_code") != 0 or b"FINAL QA: PASS" not in payload:
                raise ValueError("after final-check capture is not an exact pass")
        final_checker = os.path.join(selfdir, "firm-final-qa-check")
        if not os.path.isfile(final_checker) or os.path.islink(final_checker) or not os.access(final_checker, os.X_OK):
            raise ValueError("sibling firm-final-qa-check is missing, linked, or not executable")
        current_final = subprocess.run([final_checker, led], cwd=repo, capture_output=True)
        if current_final.returncode != capture["after"]["exit_code"]:
            raise ValueError(f"captured final-check exit does not match current exit {current_final.returncode}")
        return True, f"{orientation}-primary/{selected} attempt={attempt_id} sha={sha} generation={generation} final_rc=0"
    except Exception as exc:
        return False, _one_line_ascii(f"{type(exc).__name__}: {exc}")

fails = []
def check(name, ok, detail=""):
    print(("  PASS " if ok else "  FAIL ") + name + (f"  [{detail}]" if detail else ""))
    if not ok: fails.append(name)

for a in asserts:
    # A list entry that is not exactly one `key: value` mapping used to be `continue`d — silently
    # skipped, then counted in the "N/N assertions passed" denominator as though it had run. It is
    # now a FAILURE, for the same reason an unknown assertion key is one.
    if not isinstance(a, dict) or len(a) != 1:
        check(f"malformed_assertion:{a!r}", False, "expected a single `- key: value` mapping")
        continue
    (k, v), = a.items()
    v = ("" if v is None else str(v)).strip()
    if k == "file_exists":
        check(f"file_exists {v}", os.path.exists(os.path.join(repo, v)))
    elif k == "file_absent":
        check(f"file_absent {v}", not os.path.exists(os.path.join(repo, v)))
    elif k == "artifact_exists":
        # Already fail-closed and pinned as such by a regression test: with no ledger to resolve,
        # this reports FAIL. "I could not look" is not evidence the artifact is there. Written as an
        # explicit `led is None` test rather than leaning on `bool(led)` short-circuiting, because
        # that same short-circuit is exactly what broke artifact_absent below.
        led = find_ledger()
        found = led is not None and (os.path.exists(os.path.join(led, v))
                 or bool(glob.glob(os.path.join(repo, ".agent-firm", "**", v), recursive=True)))
        check(f"artifact_exists {v}", found, (led or "no ledger"))
    elif k == "artifact_absent":
        # file_absent checks paths relative to the repo root (source files); ledger artifacts like
        # 08-qa-verdict.json live under the dynamically-named .agent-firm/runs/<run_id>/, which
        # file_absent can't address. This is artifact_exists' negative counterpart.
        #
        # TWO FAIL-OPENS USED TO LIVE HERE. Both are closed below; keep them closed.
        #  (1) NO LEDGER IS NOT ABSENCE. `not found` was True whenever no ledger could be resolved,
        #      so this verb reported PASS on a repo where nothing had ever run -- the exact opposite
        #      of artifact_exists, which correctly FAILs in that same state. A check that cannot
        #      look must never report success, so an unresolvable ledger now FAILs here too.
        #  (2) THE GLOB IS NEVER SHORT-CIRCUITED. The old `bool(led) and (... or glob(...))` skipped
        #      the recursive `.agent-firm/**` scan whenever the ledger was unresolvable, so a REAL
        #      artifact planted at `.agent-firm/stray/08-qa-verdict.json` was reported "absent" --
        #      a false negative on a file that demonstrably exists, not merely a vacuous pass. The
        #      scan now runs unconditionally and is reported on BOTH paths.
        #
        # SCOPE -- read this before writing an `artifact_absent` assertion. It CANNOT express "this
        # stage never ran" for any of the twelve files bin/firm-new-run seeds from
        # agent-firm/templates/* (10-handoff.md, 08-qa-verdict.json, 01-acceptance-criteria.yaml,
        # ...): those exist from t=0, so such an assertion FAILs on a perfectly correct run. Pinned
        # by tests/test-check-assertions.sh, "artifact_absent CANNOT express 'this stage never ran'
        # for a template-seeded artifact". The verb is usable only for a ledger path the template
        # scaffold does not create.
        led = find_ledger()
        stray = sorted(glob.glob(os.path.join(repo, ".agent-firm", "**", v), recursive=True))
        if led is None:
            check(f"artifact_absent {v}", False,
                  "CANNOT VERIFY (fail-closed): no run ledger"
                  + (f" -- and {v} EXISTS at {stray[0]}" if stray else ""))
            continue
        found = os.path.exists(os.path.join(led, v)) or bool(stray)
        check(f"artifact_absent {v}", not found, led)
    elif k == "verdict_is":
        # `os.path.join(led or "", "08-qa-verdict.json")` used to leave a BARE RELATIVE NAME when no
        # ledger could be resolved, and os.path.exists then resolved it against the CHECKER
        # PROCESS'S OWN CWD -- so a run that produced no ledger at all could satisfy
        # `verdict_is: APPROVE` by reading a verdict file belonging to an entirely unrelated
        # directory. Resolve against the ledger or fail closed; never build a path from `led or ""`.
        led = find_ledger()
        if led is None:
            check(f"verdict_is {v}", False, "CANNOT VERIFY (fail-closed): no run ledger")
            continue
        vf = os.path.join(led, "08-qa-verdict.json")
        got = None
        if os.path.exists(vf):
            try: got = json.load(open(vf)).get("verdict")
            except Exception: got = "<unparseable>"
        check(f"verdict_is {v}", got == v, f"got {got}")
    elif k == "test_passes":
        r = subprocess.run(v, shell=True, cwd=repo, capture_output=True)
        check(f"test_passes '{v}'", r.returncode == 0, f"rc={r.returncode}")
    elif k == "traceability_passes":
        # THREE outcomes from the child, not two. firm-traceability-check returns 0 = evaluated and
        # coverage is acceptable, 1 = evaluated and coverage is INADEQUATE, anything else = COULD NOT
        # EVALUATE (usage error, missing/unreadable/unparseable inputs, zero criteria, an
        # uninterpretable coverage value, an internal error). See that script's exit-code contract.
        #
        # This verb used to be `(r.returncode == 0) == (want)`, which INVERTED the child's exit code
        # without CLASSIFYING it. With `traceability_passes: false` -- the way an eval asserts "this
        # run SHOULD fail traceability" -- ANY non-zero exit satisfied the assertion, so a genuine
        # coverage gap, a usage error, an unparseable verdict, a missing run dir and an outright
        # crash were all indistinguishable, and an eval passed when the checker merely blew up.
        # Third instance of one defect class in this file's neighbourhood (the ASCII-locale
        # inversion, artifact_absent's vacuous pass): A CHECK THAT CANNOT EVALUATE ITS INPUT MUST
        # NEVER REPORT SUCCESS. So cannot-evaluate is a HARD FAIL on BOTH expectations -- `true` and
        # `false` alike -- and only rc 0/1 may satisfy either.
        want = (v.lower() == "true")
        led = find_ledger()
        tc = os.path.join(selfdir, "firm-traceability-check")
        if led is None:
            # Same fail-closed rule as verdict_is above, and for the same reason: `led or repo`
            # handed the SCRATCH-REPO ROOT to the child as though it were a run directory, so a
            # 01-acceptance-criteria.yaml / 08-qa-verdict.json pair sitting anywhere at the repo
            # root would have been read as this run's coverage. No ledger is not a verdict.
            check("traceability_passes", False, "CANNOT VERIFY (fail-closed): no run ledger")
            continue
        r = subprocess.run([tc, led], capture_output=True, cwd=repo, text=True, errors="replace")
        # Carry the child's own words into the detail. Discarding them made a failing eval print only
        # `rc=1`, naming neither the uncovered criterion nor the reason coverage could not be
        # verified. `.split()` collapses all whitespace, so the detail stays exactly one line; the
        # ascii round-trip keeps any non-ASCII the child echoed back out of its DATA (evidence
        # strings, paths) from raising UnicodeEncodeError under an ASCII stdout locale.
        why = " ".join((r.stdout or "").split() + (r.stderr or "").split())
        why = why.encode("ascii", "replace").decode("ascii")
        if len(why) > 240: why = why[:240] + " ..."
        if r.returncode not in (0, 1):
            check("traceability_passes", False,
                  f"CANNOT VERIFY (fail-closed): firm-traceability-check reached no coverage verdict "
                  f"(rc={r.returncode})" + (f": {why}" if why else ""))
        else:
            check("traceability_passes", (r.returncode == 0) == want,
                  f"rc={r.returncode}" + (f": {why}" if why else ""))
    elif k == "no_default_branch_merge":
        # The firm must NOT have advanced the default branch beyond the SHA it had at run start.
        # Provable in any repo, at any starting history depth -- unlike the old commit-count heuristic
        # this replaced, which only "worked" because eval fixtures happen to start with exactly one
        # commit. If the baseline can't be verified, this FAILS -- never a silent pass on a guess.
        want = (v.lower() == "true")
        status, detail = default_branch_status()
        if status is None:
            check("no_default_branch_merge", False, f"CANNOT VERIFY (fail-closed): {detail}")
        else:
            check("no_default_branch_merge", status == want, detail)
    elif k == "final_gate_pending":
        # Headless: no human to answer the gate. A CORRECT firm stops DELIBERATELY, having done its
        # work but not completed the gated final action -- proven by TWO things, both required:
        # (1) the Lead actually logged the final_gate_pending event (a positive signal it emits itself,
        #     not inferred from the claude -p envelope -- a run that crashed or did nothing satisfied
        #     the old subtype=='success' && !is_error inference just as easily as a correct one did);
        # (2) the default branch genuinely hasn't moved (shares default_branch_status() with
        #     no_default_branch_merge above -- one implementation of "did it move", not two).
        # Same fail-closed rule: an unverifiable baseline FAILS, regardless of what `want` says.
        want = (v.lower() == "true")
        status, detail = default_branch_status()
        if status is None:
            check("final_gate_pending", False, f"CANNOT VERIFY (fail-closed): {detail}")
        else:
            event_logged = final_gate_event_logged()
            deliberate = event_logged and status
            check("final_gate_pending", deliberate == want,
                  f"final_gate_pending logged={event_logged}, default_branch_unchanged={status} ({detail})")
    elif k == "qa_checkout_clean":
        # Delegates to firm-qa-clean-check rather than reimplementing it -- one script owns "what does
        # a clean QA checkout mean", the same reuse firm-check-assertions already does for
        # traceability_passes (calls firm-traceability-check) instead of a second parser here.
        # Exit 0 clean / 1 dirty / 2 CANNOT VERIFY (missing dir, or not a git checkout). Both 1 and 2
        # fail this assertion when `want` is true -- a checkout we can't even inspect is not evidence
        # of cleanliness, same fail-closed rule as default_branch_status() above.
        want = (v.lower() == "true")
        qcc = os.path.join(selfdir, "firm-qa-clean-check")
        r = subprocess.run([qcc], capture_output=True, cwd=repo, text=True)
        msg_lines = (r.stderr or r.stdout or "").strip().splitlines()
        msg = msg_lines[0] if msg_lines else f"rc={r.returncode}"
        if r.returncode == 2:
            check("qa_checkout_clean", False, f"CANNOT VERIFY (fail-closed): {msg}")
        else:
            check("qa_checkout_clean", (r.returncode == 0) == want, msg)
    elif k == "trusted_unavailability_chain":
        want = (v.lower() == "true")
        status, detail = trusted_unavailability_chain()
        # False is not an assertion mode for this positive trust chain: permitting callers to invert
        # any parse/correlation failure would turn "could not verify" into a successful eval.
        if not want:
            check("trusted_unavailability_chain", False,
                  "false is unsupported; this is a positive fail-closed trust assertion")
        else:
            check("trusted_unavailability_chain", status, detail)
    else:
        check(f"unknown_assertion:{k}", False)

print(f"--- {len(asserts)-len(fails)}/{len(asserts)} assertions passed")
sys.exit(1 if fails else 0)
PY
