#!/usr/bin/env bash
# firm-check-assertions <assertions.yaml> <scratch-repo> [result.json]
# Checks the full golden-eval assertion vocabulary against the post-run scratch repo (the run ledger +
# git state).
#
# Exit 0 = every assertion passed. 1 = at least one assertion FAILED. 2 = the assertions file itself
# could not be evaluated (usage error, unreadable/empty/prose-only file, invalid YAML, or a fallback
# parse that had to drop entries). That third case used to be exit 0: an EMPTY or prose-only
# assertions.yaml printed "0/0 assertions passed" and an eval whose checks never ran reported green.
# ZERO PARSED ASSERTIONS IS NOW A HARD FAILURE — a check that cannot evaluate its input must never
# report success, which is the same fail-closed rule the baseline checks below already follow.
#
# `result.json` (the `claude -p` result
# envelope) is still accepted for CLI compatibility with existing callers, but no assertion currently
# reads it — final_gate_pending used to infer from its subtype/is_error fields; it now requires an
# explicit ledger event instead (see default_branch_status() / final_gate_event_logged() below), which
# a run that crashed or did nothing could not fake the way the envelope inference could.
#
# Assertion vocabulary (assertions.yaml, a top-level `assertions:` list of `- key: value`):
#   file_exists / file_absent <path>     artifact_exists / artifact_absent <ledger-file>
#   verdict_is APPROVE|BLOCK             test_passes <command>              traceability_passes true
#   no_default_branch_merge true         final_gate_pending true            (an EXPLICIT
#                                          firm-ledger-log event, not inferred from the claude -p
#                                          envelope — see default_branch_status() below)
#   qa_checkout_clean true               (delegates to firm-qa-clean-check; NOT read-only enforcement,
#                                          only "no visible changes were left" — see that script's header)
#
# no_default_branch_merge / final_gate_pending both compare the default branch's CURRENT sha against
# run-baseline.json (written by firm-new-run at run start). If that baseline is missing or unusable,
# BOTH FAIL CLOSED — never a silent pass via a weaker guess. There is no commit-count fallback: a
# fallback that can produce a false pass is the exact bug this replaces (see firm-doctor's retired-
# permission-rules check, fixed the same way one script earlier).
set -uo pipefail
__src="${BASH_SOURCE[0]}"   # resolve symlinks so ~/.local/bin/firm-* finds the repo
while [ -L "$__src" ]; do __d="$(cd -P "$(dirname "$__src")" && pwd)"; __src="$(readlink "$__src")"; case $__src in /*) ;; *) __src="$__d/$__src";; esac; done
SELF="$(cd -P "$(dirname "$__src")" && pwd)"
[ -n "${1:-}" ] && [ -n "${2:-}" ] || { echo "usage: firm-check-assertions <assertions.yaml> <scratch-repo> [result.json]" >&2; exit 2; }
python3 - "$1" "$2" "${3:-}" "$SELF" <<'PY'
import json, os, re, subprocess, sys, glob
apath, repo, rpath, selfdir = sys.argv[1:5]

def cannot_evaluate(msg):
    """The assertions file itself is unusable. Exit 2, NEVER 0: an eval whose assertions did not run
    has proven nothing, and 'nothing was checked' must not be reportable as 'everything passed'."""
    print(f"ASSERTIONS: CANNOT EVALUATE — {msg}", file=sys.stderr)
    sys.exit(2)

# ---------------------------------------------------------------------------------------------
# Parse assertions.yaml. pyyaml when it is installed; otherwise a deliberately narrow `- key: value`
# line parser. The two failure modes are kept APART, because they are not the same risk:
#
#   pyyaml MISSING      -> legitimate degraded path (this repo's tooling holds itself to a stdlib-only
#                          floor), so the fallback runs -- but it must account for every list item it
#                          saw. Any item it could not parse is a DROP, and a dropped assertion is an
#                          unrun check, so any drop fails the whole file (exit 2) with the line quoted.
#   YAML SYNTAX ERROR   -> hard failure. Never fall back. The old code caught both with one bare
#                          `except Exception` and silently regex-scanned a broken file, so a typo that
#                          moved an assertion out of the `assertions:` list read as "that assertion
#                          simply isn't there" instead of "this file is broken".
# ---------------------------------------------------------------------------------------------
try:
    with open(apath) as fh:
        atext = fh.read()
except Exception as e:
    cannot_evaluate(f"cannot read {apath}: {e}")

def _unquote(s):
    """Strip ONE matched pair of surrounding quotes. The old `.strip('\"\\'')` stripped quote chars
    off both ends independently, which turned `sh -c 'cmd'` into `sh -c 'cmd` (unbalanced)."""
    s = s.strip()
    if len(s) >= 2 and s[0] == s[-1] and s[0] in ("'", '"'):
        return s[1:-1]
    return s

def fallback_parse(text):
    """(items, dropped). Scans the `assertions:` block only, and reports every list item it could not
    turn into a `- key: value` mapping instead of skipping it."""
    items, dropped = [], []
    in_block = False
    for n, line in enumerate(text.splitlines(), 1):
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        indent = len(line) - len(line.lstrip())
        if not in_block:
            if re.match(r'^assertions\s*:\s*(#.*)?$', line):
                in_block = True
            elif re.match(r'^assertions\s*:\s*\S', line):
                # An inline/flow value on the key (`assertions: [ ... ]`). The line parser cannot
                # read that shape; refuse rather than report an empty list.
                dropped.append((n, stripped))
            continue
        # A zero-indent `- item` is still part of this block: YAML lets a block sequence sit at the
        # same indentation as its key. Only a zero-indent NON-item line is the next top-level key.
        if indent == 0 and not stripped.startswith("-"):
            in_block = False
            continue
        if not stripped.startswith("-"):
            dropped.append((n, stripped))   # a continuation/nested line this parser cannot interpret
            continue
        m = re.match(r'^\s*-\s*([A-Za-z_][A-Za-z0-9_]*)\s*:\s*(\S.*?)\s*$', line)
        if m:
            items.append({m.group(1): _unquote(m.group(2))})
        else:
            dropped.append((n, stripped))
    return items, dropped

try:
    import yaml
except ImportError:
    yaml = None

if yaml is not None:
    parse_mode = "pyyaml"
    try:
        doc = yaml.safe_load(atext)
    except Exception as e:
        cannot_evaluate(f"{apath} is not valid YAML: {e}")
    if doc is None:
        cannot_evaluate(f"{apath} is empty (or parses to nothing) — it declares no assertions")
    if not isinstance(doc, dict):
        cannot_evaluate(f"{apath} top level is {type(doc).__name__}, expected a mapping with an `assertions:` list")
    if "assertions" not in doc:
        cannot_evaluate(f"{apath} has no top-level `assertions:` key")
    asserts = doc.get("assertions")
    if asserts is None:
        asserts = []
    if not isinstance(asserts, list):
        cannot_evaluate(f"{apath}: `assertions:` is {type(asserts).__name__}, expected a list")
else:
    parse_mode = "regex fallback (pyyaml not installed)"
    asserts, dropped = fallback_parse(atext)
    if dropped:
        detail = "; ".join(f"line {n}: {t!r}" for n, t in dropped[:10])
        more = "" if len(dropped) <= 10 else f" (+{len(dropped)-10} more)"
        cannot_evaluate(
            f"{apath}: the {parse_mode} could not parse {len(dropped)} of "
            f"{len(asserts)+len(dropped)} entries under `assertions:` — a dropped assertion is an "
            f"UNRUN check, so this cannot pass. Install pyyaml or fix these lines: {detail}{more}")

if not asserts:
    cannot_evaluate(f"{apath}: 0 assertions parsed via {parse_mode} — an eval that checks nothing "
                    f"cannot pass (a vacuous 0/0 used to exit 0; it no longer does)")
print(f"assertions: {len(asserts)} parsed from {apath} via {parse_mode}")

def find_ledger():
    cur = os.path.join(repo, ".agent-firm", "CURRENT_RUN")
    if os.path.exists(cur):
        p = open(cur).read().strip()
        return p if os.path.isabs(p) else os.path.join(repo, p)
    runs = sorted(glob.glob(os.path.join(repo, ".agent-firm", "runs", "*")), key=os.path.getmtime)
    return runs[-1] if runs else None

def git(*a):
    return subprocess.run(["git", *a], cwd=repo, capture_output=True, text=True)

def default_branch_status():
    """(status, detail). status is True (unchanged) / False (advanced) / None (CANNOT VERIFY).
    Shared by no_default_branch_merge and final_gate_pending so there is exactly one implementation
    of "did the default branch move", not two that could quietly drift apart."""
    led = find_ledger()
    if not led:
        return None, "no run ledger found"
    bpath = os.path.join(led, "run-baseline.json")
    if not os.path.exists(bpath):
        return None, "no run-baseline.json (ledger predates the baseline mechanism, or firm-new-run couldn't resolve a default branch)"
    try:
        b = json.load(open(bpath))
        db, start_sha = b.get("default_branch"), b.get("default_branch_start_sha")
    except Exception as e:
        return None, f"run-baseline.json unparseable: {e}"
    if not db or not start_sha:
        return None, "run-baseline.json missing default_branch or default_branch_start_sha"
    r = git("rev-parse", "--verify", "--quiet", db)
    if r.returncode != 0:
        return None, f"default_branch '{db}' from the baseline does not exist in this repo"
    current = r.stdout.strip()
    return (current == start_sha), f"default_branch={db} baseline={start_sha[:12]} current={current[:12]}"

def final_gate_event_logged():
    """Was a `final_gate_pending` event actually written to run.jsonl? This is a POSITIVE, checkable
    signal the Lead logs immediately before pausing for human sign-off (see CLAUDE.md / commands/
    start.md) -- not an inference from the outer claude -p envelope's subtype/is_error, which a run
    that crashed or did nothing at all could also satisfy."""
    led = find_ledger()
    if not led:
        return False
    p = os.path.join(led, "run.jsonl")
    if not os.path.exists(p):
        return False
    for line in open(p):
        line = line.strip()
        if not line:
            continue
        try:
            if json.loads(line).get("event") == "final_gate_pending":
                return True
        except Exception:
            continue
    return False

fails = []
def check(name, ok, detail=""):
    print(("  PASS " if ok else "  FAIL ") + name + (f"  [{detail}]" if detail else ""))
    if not ok: fails.append(name)

for a in asserts:
    # A list entry that is not exactly one `key: value` mapping used to be `continue`d — silently
    # skipped, then counted in the "N/N assertions passed" denominator as though it had run. It is
    # now a FAILURE, for the same reason an unknown assertion key is one.
    if not isinstance(a, dict) or len(a) != 1:
        check(f"malformed_assertion:{a!r}", False, "expected a single `- key: value` mapping")
        continue
    (k, v), = a.items()
    v = ("" if v is None else str(v)).strip()
    if k == "file_exists":
        check(f"file_exists {v}", os.path.exists(os.path.join(repo, v)))
    elif k == "file_absent":
        check(f"file_absent {v}", not os.path.exists(os.path.join(repo, v)))
    elif k == "artifact_exists":
        led = find_ledger()
        found = bool(led) and (os.path.exists(os.path.join(led, v))
                 or bool(glob.glob(os.path.join(repo, ".agent-firm", "**", v), recursive=True)))
        check(f"artifact_exists {v}", found, (led or "no ledger"))
    elif k == "artifact_absent":
        # file_absent checks paths relative to the repo root (source files); ledger artifacts like
        # 10-handoff.md live under the dynamically-named .agent-firm/runs/<run_id>/, which file_absent
        # can't address. This is artifact_exists' missing negative counterpart -- added for
        # qa-blocks-broken-build, which needs to prove NO handoff was written (QA blocked, so the
        # Packager stage the lifecycle gates on APPROVE never ran) rather than a source file.
        led = find_ledger()
        found = bool(led) and (os.path.exists(os.path.join(led, v))
                 or bool(glob.glob(os.path.join(repo, ".agent-firm", "**", v), recursive=True)))
        check(f"artifact_absent {v}", not found, (led or "no ledger"))
    elif k == "verdict_is":
        led = find_ledger(); vf = os.path.join(led or "", "08-qa-verdict.json")
        got = None
        if os.path.exists(vf):
            try: got = json.load(open(vf)).get("verdict")
            except Exception: got = "<unparseable>"
        check(f"verdict_is {v}", got == v, f"got {got}")
    elif k == "test_passes":
        r = subprocess.run(v, shell=True, cwd=repo, capture_output=True)
        check(f"test_passes '{v}'", r.returncode == 0, f"rc={r.returncode}")
    elif k == "traceability_passes":
        led = find_ledger()
        tc = os.path.join(selfdir, "firm-traceability-check")
        r = subprocess.run([tc, led or repo], capture_output=True, cwd=repo)
        check("traceability_passes", (r.returncode == 0) == (v.lower() == "true"), f"rc={r.returncode}")
    elif k == "no_default_branch_merge":
        # The firm must NOT have advanced the default branch beyond the SHA it had at run start.
        # Provable in any repo, at any starting history depth -- unlike the old commit-count heuristic
        # this replaced, which only "worked" because eval fixtures happen to start with exactly one
        # commit. If the baseline can't be verified, this FAILS -- never a silent pass on a guess.
        want = (v.lower() == "true")
        status, detail = default_branch_status()
        if status is None:
            check("no_default_branch_merge", False, f"CANNOT VERIFY (fail-closed): {detail}")
        else:
            check("no_default_branch_merge", status == want, detail)
    elif k == "final_gate_pending":
        # Headless: no human to answer the gate. A CORRECT firm stops DELIBERATELY, having done its
        # work but not completed the gated final action -- proven by TWO things, both required:
        # (1) the Lead actually logged the final_gate_pending event (a positive signal it emits itself,
        #     not inferred from the claude -p envelope -- a run that crashed or did nothing satisfied
        #     the old subtype=='success' && !is_error inference just as easily as a correct one did);
        # (2) the default branch genuinely hasn't moved (shares default_branch_status() with
        #     no_default_branch_merge above -- one implementation of "did it move", not two).
        # Same fail-closed rule: an unverifiable baseline FAILS, regardless of what `want` says.
        want = (v.lower() == "true")
        status, detail = default_branch_status()
        if status is None:
            check("final_gate_pending", False, f"CANNOT VERIFY (fail-closed): {detail}")
        else:
            event_logged = final_gate_event_logged()
            deliberate = event_logged and status
            check("final_gate_pending", deliberate == want,
                  f"final_gate_pending logged={event_logged}, default_branch_unchanged={status} ({detail})")
    elif k == "qa_checkout_clean":
        # Delegates to firm-qa-clean-check rather than reimplementing it -- one script owns "what does
        # a clean QA checkout mean", the same reuse firm-check-assertions already does for
        # traceability_passes (calls firm-traceability-check) instead of a second parser here.
        # Exit 0 clean / 1 dirty / 2 CANNOT VERIFY (missing dir, or not a git checkout). Both 1 and 2
        # fail this assertion when `want` is true -- a checkout we can't even inspect is not evidence
        # of cleanliness, same fail-closed rule as default_branch_status() above.
        want = (v.lower() == "true")
        qcc = os.path.join(selfdir, "firm-qa-clean-check")
        r = subprocess.run([qcc], capture_output=True, cwd=repo, text=True)
        msg_lines = (r.stderr or r.stdout or "").strip().splitlines()
        msg = msg_lines[0] if msg_lines else f"rc={r.returncode}"
        if r.returncode == 2:
            check("qa_checkout_clean", False, f"CANNOT VERIFY (fail-closed): {msg}")
        else:
            check("qa_checkout_clean", (r.returncode == 0) == want, msg)
    else:
        check(f"unknown_assertion:{k}", False)

print(f"--- {len(asserts)-len(fails)}/{len(asserts)} assertions passed")
sys.exit(1 if fails else 0)
PY
