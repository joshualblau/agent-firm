#!/usr/bin/env bash
# PreToolUse(Bash) hook — appends the Bash command to the active run's run.jsonl.
# Best-effort and NON-BLOCKING: always exits 0 so it can never stall or fail a tool call.
# Reads the Claude Code hook payload (JSON) on stdin.
set -uo pipefail

input="$(cat 2>/dev/null || true)"

run_dir=""
[[ -f .agent-firm/CURRENT_RUN ]] && run_dir="$(cat .agent-firm/CURRENT_RUN 2>/dev/null || true)"
[[ -n "$run_dir" && -d "$run_dir" ]] || exit 0

ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
if command -v jq >/dev/null 2>&1; then
  cmd="$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null || true)"
  [[ -n "$cmd" ]] && jq -cn --arg ts "$ts" --arg cmd "$cmd" \
    '{ts:$ts, event:"bash", cmd:$cmd}' >> "$run_dir/run.jsonl" 2>/dev/null || true
fi
exit 0
