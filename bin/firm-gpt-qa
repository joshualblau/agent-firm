#!/usr/bin/env bash
# firm-gpt-qa [run_dir]
# The firm's INDEPENDENT, cross-provider QA judge: runs GPT via the Codex CLI on your ChatGPT
# subscription (NO API key) and emits a schema-valid verdict at <run_dir>/08-qa-verdict.gpt.json.
# It hunts for implementation blind spots a same-provider judge might share.
#
# Prereqs (see docs/PHASE3.md): `codex` installed + `codex login` on your ChatGPT plan. If codex is
# absent OR present-but-incompatible with the configured model, this exits 3 (UNAVAILABLE) and the
# qa-tester degrades to Claude-only QA (logged), never silently passing.
#
# Exit codes:
#   0 = judge ran and produced a schema-valid verdict
#   1 = judge RAN and BLOCKED / failed / timed out (a real judgement — surface it)
#   2 = usage error (no run dir)
#   3 = judge UNAVAILABLE (codex absent, or codex present but incompatible with the model) -> the
#       qa-tester degrades to Claude-only QA and the Lead MUST surface this as a Final-gate warning.
#       Never a silent pass.
#
# The model is env-configurable via FIRM_GPT_QA_MODEL (default below). A preflight detects a
# version/model incompatibility (e.g. codex too old for the configured model -> HTTP 400 "requires a
# newer Codex") and treats it as UNAVAILABLE (exit 3) with an actionable fix message, rather than
# letting it look like a generic judge failure (exit 1).
set -uo pipefail
__src="${BASH_SOURCE[0]}"   # resolve symlinks so ~/.local/bin/firm-* finds the repo
while [ -L "$__src" ]; do __d="$(cd -P "$(dirname "$__src")" && pwd)"; __src="$(readlink "$__src")"; case $__src in /*) ;; *) __src="$__d/$__src";; esac; done
SELF="$(cd -P "$(dirname "$__src")" && pwd)"
ROOT="$(cd "$SELF/.." && pwd)"
SCHEMA="$ROOT/agent-firm/schemas/qa-verdict.schema.json"

if ! command -v codex >/dev/null 2>&1; then
  echo "firm-gpt-qa: 'codex' not found. Install the Codex CLI and run 'codex login' on your ChatGPT plan (docs/PHASE3.md). Skipping the GPT judge (UNAVAILABLE, exit 3)." >&2
  exit 3
fi

# The judge model, env-configurable. Default is the model the firm ships with; override to whatever
# your installed codex supports (this is the human's environment action, NOT a network call we make).
FIRM_GPT_QA_MODEL="${FIRM_GPT_QA_MODEL:-gpt-5.6-sol}"

# Preflight: codex is PRESENT but may be incompatible with the configured model (the real failure mode:
# an older codex + model gpt-5.6-sol -> HTTP 400 "requires a newer version of Codex"). Detect that here
# and treat it as UNAVAILABLE (exit 3), NOT a bare judge failure (exit 1). We do a cheap, offline-ish
# probe: if codex advertises supported models we check membership; otherwise we run a tiny exec and
# scan for a version/compat error signature. Any incompat signature => exit 3 with an actionable fix.
incompat_msg() {
  cat >&2 <<EOF
firm-gpt-qa: the installed Codex CLI ($(codex --version 2>/dev/null | head -n1 || echo 'unknown version')) is INCOMPATIBLE with the configured judge model '${FIRM_GPT_QA_MODEL}'.
  Detail: ${1:-model/version mismatch}
  Fix (human environment action, pick one):
    - upgrade the Codex CLI to a version that supports '${FIRM_GPT_QA_MODEL}', OR
    - set a compatible model:  export FIRM_GPT_QA_MODEL=<a-model-your-codex-supports>
Skipping the GPT judge (UNAVAILABLE, exit 3) — the qa-tester degrades to Claude-only QA and the Lead MUST surface this at the Final gate. Never a silent pass.
EOF
}

preflight_log="$(mktemp "${TMPDIR:-/tmp}/firm-gpt-qa-preflight.XXXXXX")"
# Allow tests / callers to force the UNAVAILABLE path deterministically without a network round-trip.
if [[ -n "${FIRM_GPT_QA_FORCE_INCOMPAT:-}" ]]; then
  incompat_msg "forced via FIRM_GPT_QA_FORCE_INCOMPAT (simulated version/model mismatch)"
  rm -f "$preflight_log"
  exit 3
fi
# Try a fast list of supported models if the CLI offers one; membership check is authoritative.
if codex --help 2>/dev/null | grep -qiE '\bmodels?\b.*list|list-models'; then
  if codex models list >"$preflight_log" 2>&1 || codex models >"$preflight_log" 2>&1; then
    if [[ -s "$preflight_log" ]] && ! grep -qiF "$FIRM_GPT_QA_MODEL" "$preflight_log"; then
      incompat_msg "model '${FIRM_GPT_QA_MODEL}' not in codex's supported-model list"
      rm -f "$preflight_log"; exit 3
    fi
  fi
fi
# Cheap exec probe: a trivial prompt with the configured model. A version/compat error (HTTP 400
# "requires a newer version of Codex", "unsupported model", "unknown model", "upgrade") => UNAVAILABLE.
if ! perl -e 'alarm shift @ARGV; exec @ARGV' "${FIRM_GPT_QA_PREFLIGHT_TIMEOUT:-30}" \
      codex exec --skip-git-repo-check -m "$FIRM_GPT_QA_MODEL" "reply with: ok" </dev/null >"$preflight_log" 2>&1; then
  if grep -qiE 'requires a newer version of codex|unsupported model|unknown model|not supported|please upgrade|HTTP 400' "$preflight_log"; then
    incompat_msg "$(grep -iE 'requires a newer version of codex|unsupported model|unknown model|not supported|please upgrade|HTTP 400' "$preflight_log" | head -n1)"
    rm -f "$preflight_log"; exit 3
  fi
  # A non-compat failure here (e.g. transient/login) is not fatal to preflight; the real judge run
  # below is authoritative and will exit 1 if it genuinely fails.
fi
rm -f "$preflight_log"

run_dir="${1:-}"
[[ -z "$run_dir" && -f .agent-firm/CURRENT_RUN ]] && run_dir="$(cat .agent-firm/CURRENT_RUN)"
if [[ -z "$run_dir" || ! -d "$run_dir" ]]; then echo "firm-gpt-qa: no run dir (pass one or set CURRENT_RUN)" >&2; exit 2; fi
mkdir -p "$run_dir/09-test-evidence"

out="$run_dir/08-qa-verdict.gpt.json"
log="$run_dir/09-test-evidence/gpt-qa.log"

read -r -d '' PROMPT <<EOF
You are an INDEPENDENT QA judge from a DIFFERENT model provider than the implementer. Hunt for
implementation blind spots and certify with evidence, not opinion.
- Run the project's test command(s); read the diff and the evidence under ${run_dir}/09-test-evidence/.
- Check every acceptance criterion in ${run_dir}/01-acceptance-criteria.yaml has proving evidence.
- State what was NOT tested. You are READ-ONLY against source: never edit code or tests.
- Emit BLOCK on any uncertainty; APPROVE only with passing evidence for every required test type.
Return ONLY the verdict conforming to the provided JSON schema.
EOF

echo "firm-gpt-qa: running the Codex judge on your ChatGPT subscription..." >&2
# NOTE: close stdin (</dev/null) — otherwise `codex exec` blocks reading "additional input from stdin".
# Hard wall-clock cap via a perl alarm (macOS has no `timeout`); alarm survives exec and terminates codex.
timeout_secs="${FIRM_GPT_QA_TIMEOUT:-300}"
if perl -e 'alarm shift @ARGV; exec @ARGV' "$timeout_secs" \
     codex exec --skip-git-repo-check -m "$FIRM_GPT_QA_MODEL" --output-schema "$SCHEMA" -o "$out" "$PROMPT" </dev/null >>"$log" 2>&1; then
  # Validate the structured verdict Codex produced. This rc was previously discarded — the script's
  # last command was the `echo` below, so an invalid or unvalidatable second-voice verdict still
  # exited 0 and read as a clean judge run. Fail closed instead.
  "$SELF/firm-validate-verdict" "$out"; v_rc=$?
  if [[ $v_rc -ne 0 ]]; then
    echo "firm-gpt-qa: the judge's verdict did not validate (firm-validate-verdict rc=$v_rc) — treating as a BLOCK." >&2
    [[ $v_rc -eq 4 ]] && echo "  rc=4 means DEGRADED: install jsonschema (firm-bootstrap --with-python-deps) and re-run." >&2
    [[ -x "$SELF/firm-ledger-log" ]] && "$SELF/firm-ledger-log" gpt_qa_invalid file="$out" rc="$v_rc" || true
    exit 1
  fi
  [[ -x "$SELF/firm-ledger-log" ]] && "$SELF/firm-ledger-log" gpt_qa file="$out" || true
  echo "$out"
else
  rc=$?
  echo "firm-gpt-qa: codex exec failed or timed out after ${timeout_secs}s (rc=$rc) — see $log" >&2
  exit 1
fi
