#!/usr/bin/env bash
# firm-gpt-qa [run_dir]
# Independent GPT second voice for Claude-primary runs. Uses ChatGPT subscription auth via Codex.
# Writes <run>/08-qa-verdict.gpt.json.
# Exit: 0 valid APPROVE, 1 valid BLOCK/run failure/timeout, 2 usage, 3 unavailable CLI/auth/model.
set -uo pipefail
__src="${BASH_SOURCE[0]}"
while [ -L "$__src" ]; do __d="$(cd -P "$(dirname "$__src")" && pwd)"; __src="$(readlink "$__src")"; case $__src in /*) ;; *) __src="$__d/$__src";; esac; done
SELF="$(cd -P "$(dirname "$__src")" && pwd)"
ROOT="$(cd "$SELF/.." && pwd)"
SCHEMA="$ROOT/agent-firm/schemas/qa-verdict.schema.json"
FIRM_QA_SELF="$SELF"; . "$SELF/firm-reviewer-common"

firm_qa_resolve_run "${1:-}" || { echo "firm-gpt-qa: no run dir (pass one or set CURRENT_RUN)" >&2; exit 2; }
run_dir="$FIRM_QA_RUN_DIR"
mkdir -p "$run_dir/09-test-evidence"
out="$run_dir/08-qa-verdict.gpt.json"
rm -f "$out"
log="$(mktemp "$run_dir/09-test-evidence/gpt-qa.log.XXXXXX")" || exit 1
if ! command -v codex >/dev/null 2>&1; then
  echo "firm-gpt-qa: codex CLI unavailable; install it and run 'codex login' (exit 3)." > "$log"
  cat "$log" >&2
  exit 3
fi

FIRM_GPT_QA_MODEL="${FIRM_GPT_QA_MODEL:-gpt-5.6-sol}"
preflight_log="$(mktemp "${TMPDIR:-/tmp}/firm-gpt-qa-preflight.XXXXXX")" || exit 1
cleanup() { case "$preflight_log" in /*/firm-gpt-qa-preflight.*) rm -f "$preflight_log" ;; esac; }
trap cleanup EXIT

if [[ -n "${FIRM_GPT_QA_FORCE_INCOMPAT:-}" ]]; then
  echo "unsupported model forced via FIRM_GPT_QA_FORCE_INCOMPAT" > "$preflight_log"
  cp "$preflight_log" "$log"
  echo "firm-gpt-qa: configured model '$FIRM_GPT_QA_MODEL' is unavailable (exit 3)." >&2
  exit 3
fi

if codex --help 2>/dev/null | grep -qiE '\bmodels?\b.*list|list-models'; then
  if codex models list > "$preflight_log" 2>&1 || codex models > "$preflight_log" 2>&1; then
    if [[ -s "$preflight_log" ]] && ! grep -qiF "$FIRM_GPT_QA_MODEL" "$preflight_log"; then
      cp "$preflight_log" "$log"
      echo "firm-gpt-qa: model '$FIRM_GPT_QA_MODEL' is not supported by this Codex CLI (exit 3)." >&2
      exit 3
    fi
  fi
fi

FIRM_QA_JUDGE=1 perl -e 'alarm shift @ARGV; exec @ARGV' "${FIRM_GPT_QA_PREFLIGHT_TIMEOUT:-30}" \
  codex exec --skip-git-repo-check --ephemeral -s read-only -a never -m "$FIRM_GPT_QA_MODEL" \
  "reply with: ok" </dev/null > "$preflight_log" 2>&1
preflight_rc=$?
if [[ $preflight_rc -ne 0 ]]; then
  cp "$preflight_log" "$log"
  firm_qa_failure_kind "$preflight_log"; kind=$?
  if [[ $kind -eq 3 ]]; then
    echo "firm-gpt-qa: Codex authentication or model readiness is unavailable (exit 3): $(sed -n '1p' "$preflight_log")" >&2
    exit 3
  fi
  echo "firm-gpt-qa: Codex readiness preflight failed (rc=$preflight_rc) — BLOCK: $(sed -n '1p' "$preflight_log")" >&2
  exit 1
fi

candidate="$(mktemp "$run_dir/.qa-verdict.gpt.candidate.XXXXXX")" || exit 1
cleanup_candidate() {
  case "$candidate" in "$run_dir"/.qa-verdict.gpt.candidate.*) rm -f "$candidate" ;; esac
}
trap 'cleanup_candidate; cleanup' EXIT
read -r -d '' PROMPT <<EOF
You are the independent cross-provider QA judge. FIRM_QA_JUDGE=1 makes the repository judge contract
authoritative. Run project tests read-only, inspect the diff and ${run_dir}/09-test-evidence/, and
check every criterion in ${run_dir}/01-acceptance-criteria.yaml. State what was not tested. Never edit
source/tests or update snapshots. Emit BLOCK on uncertainty. Return only the provided verdict schema.
EOF

echo "firm-gpt-qa: running GPT judge ($FIRM_GPT_QA_MODEL)..." >&2
timeout_secs="${FIRM_GPT_QA_TIMEOUT:-300}"
FIRM_QA_JUDGE=1 perl -e 'alarm shift @ARGV; exec @ARGV' "$timeout_secs" \
  codex exec --skip-git-repo-check --ephemeral -s read-only -a never -m "$FIRM_GPT_QA_MODEL" \
  --output-schema "$SCHEMA" -o "$candidate" "$PROMPT" </dev/null > "$log" 2>&1
rc=$?
if [[ $rc -eq 0 ]]; then
  firm_qa_finish "$candidate" "$out" gpt_qa firm-gpt-qa; exit $?
fi
firm_qa_failure_kind "$log"; kind=$?
if [[ $kind -eq 3 ]]; then
  echo "firm-gpt-qa: Codex authentication or model readiness became unavailable (exit 3); see $log" >&2
  exit 3
fi
echo "firm-gpt-qa: judge failed or timed out after ${timeout_secs}s (rc=$rc) — see $log" >&2
exit 1
