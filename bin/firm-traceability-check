#!/usr/bin/env bash
# traceability-check [run_dir]
# Cross-references acceptance criteria (01-acceptance-criteria.yaml) against the QA verdict's
# acceptance_criteria_coverage (08-qa-verdict.json). Defaults to the active run
# (.agent-firm/CURRENT_RUN).
#
# The schema allows covered: yes | no | partial (agent-firm/schemas/qa-verdict.schema.json). This
# script used to look at `no` ONLY, so a verdict where every criterion was `partial` printed
# "PASS -- every criterion is covered or justified" and exited 0: a gate claiming full coverage over
# work that was, by QA's own admission, only partly verified. Rules now, all three coverage values
# handled explicitly:
#
#   covered: yes                  fully covered.
#   covered: partial + evidence   ALLOWED (exit 0) but reported as a GAP, and the headline says
#                                 INCOMPLETE, never PASS. Deliberately NOT harsher than a justified
#                                 `no`: if a justified partial blocked while a justified waiver
#                                 passed, the cheapest way out would be to downgrade `partial` to
#                                 `no`, which is less coverage, not more.
#   covered: partial + no evidence   FAIL (exit 1) -- same bar as `no` with no justification.
#   covered: no + evidence        ALLOWED (exit 0), reported as a waived GAP (unchanged verdict,
#                                 newly visible in the output).
#   covered: no + no evidence     FAIL (exit 1) -- unchanged.
#   covered: missing / not in the enum / a malformed coverage entry   CANNOT EVALUATE -- a coverage
#                                 value this script cannot interpret is not evidence of coverage,
#                                 and it is not evidence of a coverage GAP either. It is evidence of
#                                 nothing at all, which is a third outcome; see the contract below.
#
# THE CHECK RUNS IN BOTH DIRECTIONS -- criteria -> coverage AND coverage -> criteria.
#
# It used to run in one: for each CRITERION, is there a coverage entry? A coverage entry naming an id
# that NO criterion declares was simply never looked at, so a verdict could claim coverage for
# AC-999-DOES-NOT-EXIST and the gate passed. It even PRINTED the discrepancy -- `acceptance criteria: 2
# verdict coverage entries: 4` -- and then acted on neither number: a fact nobody acted on is not a
# check. Consequence: a verdict written against a DIFFERENT criteria set satisfied this gate as long as
# it happened to also cover the real ids, so the gate could not tell "this verdict describes this run"
# from "this verdict describes some other run". Tenth instance of this repo's characteristic defect (a
# check that cannot evaluate its input reports success) and the third in this file.
#
# So: any coverage entry whose id is declared by no criterion is CANNOT EVALUATE (exit 2), at the same
# precedence as an uninterpretable `covered` value, and the reasoning is the same reasoning. Why 2 and
# not 1 -- the substantive call, argued out rather than picked:
#
#   * Exit 1 would say "the gate looked, and this run's coverage is inadequate". But a phantom id is not
#     a fact about coverage at all; it is a fact about PROVENANCE -- evidence that at least part of this
#     verdict was not written against this criteria file. Correspondence between the two documents is a
#     PRECONDITION for comparing them, and every other exit-2 case in this file is exactly that: an
#     input state that did not permit the comparison (missing file, unparseable, no ids, no usable
#     parser, an uninterpretable coverage value).
#   * Once provenance is broken, the entries whose ids DO match cannot be trusted either. An id is only a
#     label; the same label names a different criterion in a different revision of the criteria file. So
#     `AC-001: covered yes` may be a truthful statement about some OTHER AC-001. The gate therefore has
#     no coverage verdict for ANY criterion, which is the definition of exit 2 -- and it is the same
#     argument that already makes one uninterpretable value poison the whole run ("the uninterpretable
#     part could have changed it").
#   * Exit 2 also fails CLOSED for every caller polarity. bin/firm-check-assertions treats anything
#     other than 0/1 as cannot-evaluate and fails the assertion whichever way it was inverting the gate,
#     so a mismatched-verdict ledger can satisfy neither `traceability_passes: true` nor `false`. Exit 1
#     would let `traceability_passes: false` be PROVEN by a ledger whose coverage was never evaluated --
#     re-creating, one door along, the laundering the 1-vs-2 split exists to stop.
#
# DEGREE DOES NOT CHANGE THE ANSWER, deliberately. A single phantom id and zero id overlap get the same
# exit 2. Grading by degree was considered and rejected twice over: partial overlap is where the
# "evaluated" claim is LEAST safe (it is precisely the case where the gate relied on id-matching that
# the phantom ids just falsified), so a rule that called partial overlap "evaluated" would be backwards;
# and any threshold creates a boundary where one id flips the classification, which is an argument a
# gate should not have. One sentence, no threshold, fails closed everywhere. Note this DOES move the
# degenerate zero-overlap case (non-empty coverage, no id in common) from 1 to 2, on purpose: "no entry
# names any of my criteria" is far better explained by "this is not my verdict" than by "I am uncovered".
# An EMPTY coverage list is untouched and stays exit 1 -- it holds no phantom ids, and a verdict that
# names nothing is a verdict this gate CAN evaluate: coverage is zero.
#
# EXIT-CODE CONTRACT -- THREE outcomes, never two.
#
# Callers INVERT this gate: `traceability_passes: false` in a golden eval asserts "this run SHOULD
# fail traceability". So "the checker reached a coverage verdict and the answer is no" and "the
# checker could not reach a verdict at all" must not share an exit code. They used to -- every
# CANNOT VERIFY path below exited 1, exactly like a genuine coverage gap -- so
# bin/firm-check-assertions' `(rc == 0) == (want == "true")` was satisfied by a usage error, an
# unparseable verdict, a missing run dir, or an outright crash. An eval asserting "traceability
# correctly fails here" passed when the checker merely blew up. Same defect class as the two closed
# before it (the ASCII-locale inversion above, artifact_absent's vacuous pass): A CHECK THAT CANNOT
# EVALUATE ITS INPUT MUST NEVER REPORT SUCCESS -- and must never be mistakable for a real verdict.
#
#   0  EVALUATED, coverage acceptable. Headline PASS when every criterion is `yes`, INCOMPLETE when
#      justified gaps remain.
#   1  EVALUATED, coverage INADEQUATE. A real, criterion-level coverage failure: a criterion missing
#      from the verdict, or `no`/`partial` with no justification. THE ONLY CODE THAT MEANS "the gate
#      looked, and the answer is no".
#   2  CANNOT EVALUATE. Nothing whatsoever was decided about coverage: usage errors, missing inputs,
#      an unreadable/unparseable criteria file or verdict, zero criteria, a coverage entry or
#      `covered` value this script cannot interpret, A COVERAGE ENTRY NAMING AN ID NO CRITERION
#      DECLARES (the verdict does not describe this run -- see the both-directions note above),
#      NO USABLE PARSER (a pyyaml that is installed but
#      whose import fails -- see the find_spec discriminator in the Python block; genuine absence is
#      NOT this case, it is the legitimate regex fallback), and any unexpected internal error (an
#      unhandled exception exits 1 by default, which would land squarely on the "coverage is
#      inadequate" code -- see the excepthook in the Python block).
#
# 2 ABSORBS the previous "missing inputs" meaning rather than adding a fourth code: a missing input
# IS a cannot-evaluate, and a single such code matches bin/firm-qa-clean-check (0 clean / 1 dirty /
# 2 CANNOT VERIFY), which firm-check-assertions already classifies correctly. Callers must read
# ANYTHING other than 0 or 1 -- including a code this script never deliberately returns -- as
# cannot-evaluate, and must fail their assertion on it whichever way they were inverting the gate.
#
# This file is deliberately ASCII end to end -- see the locale-hardening note in the Python block
# below, and the assertion in tests/test-traceability-check.sh that keeps it that way.
set -euo pipefail

run_dir="${1:-}"
if [[ -z "$run_dir" && -f .agent-firm/CURRENT_RUN ]]; then run_dir="$(cat .agent-firm/CURRENT_RUN)"; fi
if [[ -z "$run_dir" || ! -d "$run_dir" ]]; then echo "no run dir (pass one or set CURRENT_RUN)" >&2; exit 2; fi

python3 - "$run_dir" <<'PY'
import json, re, sys, os, traceback, importlib.util

# --- exit-code contract (spelled out in the shell header above) -------------
EXIT_OK              = 0   # evaluated; coverage acceptable
EXIT_COVERAGE_FAIL   = 1   # evaluated; coverage INADEQUATE -- the only "the gate says no" code
EXIT_CANNOT_EVALUATE = 2   # nothing decided about coverage; not a verdict in either direction

# --- locale hardening -------------------------------------------------------
# This script is a GATE. Its exit code must depend on the run's coverage and on NOTHING else -- least
# of all on the ambient locale of whatever shell happened to invoke it. Two ways the locale used to
# decide the verdict instead, both of which made it exit 1 unconditionally:
#
#   1. STDOUT. Under an ASCII stdout encoding (LC_ALL=C with no PYTHONUTF8) printing a non-ASCII
#      character raises UnicodeEncodeError. The coverage-summary line printed one BEFORE any verdict
#      line, so the script died at the same point on every run: `traceability_passes: true` could
#      NEVER pass, and `traceability_passes: false` passed VACUOUSLY. The gate silently inverted.
#   2. INPUT FILES. open() defaults to the locale's encoding, so a criteria file or verdict holding a
#      single UTF-8 character (an em dash in a criterion statement is routine) raised
#      UnicodeDecodeError under that same locale -- before one criterion had even been read.
#
# Both are closed, belt and braces. Every literal this file prints is plain ASCII (the whole file is,
# and the test suite asserts it), the input files are decoded explicitly as UTF-8 rather than as
# whatever the locale guesses, AND the output streams are reconfigured so DATA-derived text --
# evidence strings, file paths, parser error messages, none of which this script controls -- cannot
# raise either. Unencodable characters are escaped INTO the output instead of killing the run: a
# mangled character in a message is cosmetic, a gate exiting non-zero for a reason unrelated to
# coverage is a fail-open.
for _stream in (sys.stdout, sys.stderr):
    try:
        _stream.reconfigure(errors="backslashreplace")
    except Exception:
        pass   # second layer below covers any stream that cannot be reconfigured


def emit(msg):
    """print() that can never abort the gate on an encoding error.

    Every line this script writes goes through here. reconfigure() above should make the fallback
    unreachable on any Python where .reconfigure exists (3.7+); it stays because "the gate crashed
    while printing" must not be a reachable state on ANY interpreter or stream.
    """
    try:
        print(msg)
    except UnicodeEncodeError:
        enc = getattr(sys.stdout, "encoding", None) or "ascii"
        print(msg.encode(enc, "backslashreplace").decode(enc, "replace"))


def _one_line_ascii(x, limit=240):
    """A third-party exception's text is DATA: it can be multi-line and non-ASCII.

    Collapse it to one greppable line and transliterate it, so a broken-install report stays readable
    and cannot itself raise UnicodeEncodeError on the way out. emit() would already survive that, but
    the two layers cover different things: emit() keeps the process alive, this keeps the REPORT on one
    line and in the ASCII this file is otherwise held to. Same helper, same wording, as
    bin/firm-check-assertions -- the two gate scripts answer "is pyyaml usable?" with one voice.
    """
    s = " ".join(str(x).split()).encode("ascii", "replace").decode("ascii")
    return (s[:limit] + " ...") if len(s) > limit else s


def _crash_is_cannot_evaluate(exc_type, exc, tb):
    """An UNEXPECTED exception is CANNOT EVALUATE (exit 2), never "coverage is inadequate" (exit 1).

    Python exits 1 on an unhandled exception -- precisely the code this gate reserves for a real,
    criterion-level coverage failure. Without this hook a crash is INDISTINGUISHABLE from "the run
    has an uncovered criterion", so a caller inverting the gate (`traceability_passes: false`)
    counts the crash as the failure it was hoping for. Reachable for real: a corrupt .pyc, an
    interpreter-level failure, an OSError from a path this script did not think to guard -- none of
    which it can enumerate in advance, which is the whole point of catching them by class rather than
    by case.

    A BROKEN PYYAML NO LONGER ARRIVES HERE. It used to be this hook's headline example, and a generic
    "internal error" was all the operator got. The parser-selection block below now classifies that
    state explicitly -- naming the exception AND saying pyyaml is installed rather than missing -- so
    this hook is back to being the net for the genuinely unforeseen. Both land on exit 2 either way;
    what changed is that the diagnosis is no longer lost.

    The traceback is still printed (diagnosis matters), and the exit goes through os._exit so no
    later handler or interpreter-shutdown path can put the code back to 1. os._exit skips stdio
    flushing, hence the explicit flushes.
    """
    try:
        traceback.print_exception(exc_type, exc, tb)
    except Exception:
        pass
    try:
        emit(f"TRACEABILITY: CANNOT VERIFY -- internal error: {exc_type.__name__}: {exc}")
    except Exception:
        pass
    for _s in (sys.stdout, sys.stderr):
        try:
            _s.flush()
        except Exception:
            pass
    os._exit(EXIT_CANNOT_EVALUATE)


sys.excepthook = _crash_is_cannot_evaluate


class LedgerReadError(Exception):
    """A ledger file could not be read as text at all -- reported, never guessed around."""


def read_text(path):
    """Read a ledger file as UTF-8, never as the locale's encoding.

    STRICT, and that is the point. Substituting U+FFFD for undecodable bytes would let a file this
    script cannot actually read yield a SHORT or subtly-wrong id list, which is the same silent
    shrinking of the enforced set that the pyyaml syntax-error branch below already refuses to do.
    So an undecodable file is CANNOT VERIFY -- fail closed, and identically so under every locale.

    The BOM is stripped rather than decoded (utf-8-sig behaviour, spelled out so the strict decode
    below is over the document alone): json.loads rejects a leading U+FEFF outright, and YAML would
    carry it into the first key.
    """
    try:
        with open(path, "rb") as fh:
            raw = fh.read()
    except OSError as e:
        # The path EXISTS (os.path.exists said so) but cannot be read as a file: a directory where a
        # file belongs, a permission problem, an I/O error. Unhandled, this escaped read_text and
        # Python exited 1 -- the coverage-failure code -- for something that is plainly a
        # cannot-evaluate. The excepthook above would now catch it anyway; naming it here gets a
        # one-line reason instead of a traceback.
        raise LedgerReadError(f"{path} cannot be read: {e}")
    if raw[:3] == b"\xef\xbb\xbf":
        raw = raw[3:]
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError as e:
        raise LedgerReadError(f"{path} is not valid UTF-8: {e}")


run = sys.argv[1]
ac_path = os.path.join(run, "01-acceptance-criteria.yaml")
v_path  = os.path.join(run, "08-qa-verdict.json")
# A missing input is a CANNOT EVALUATE, and always was exit 2 -- which is now the one code for that
# whole class rather than a separate "missing inputs" meaning.
if not os.path.exists(ac_path):
    emit(f"TRACEABILITY: CANNOT VERIFY -- MISSING {ac_path}"); sys.exit(EXIT_CANNOT_EVALUATE)
if not os.path.exists(v_path):
    emit(f"TRACEABILITY: CANNOT VERIFY -- MISSING {v_path}");  sys.exit(EXIT_CANNOT_EVALUATE)


def top_level_criteria_key(text):
    """True if `criteria:` is a key of the document's TOP-LEVEL mapping.

    Mirrors, as closely as text alone can, the two SHAPE checks the pyyaml branch performs below: the
    document must be a MAPPING (not a list, not a scalar) and `criteria:` must live in that mapping.

    The base indentation is measured from the first structural line rather than hard-coded to column
    0, because a uniformly indented block mapping is a document pyyaml ACCEPTS -- refusing it here
    would be a divergence in the other direction. Anything genuinely ambiguous (a fully flow-style
    top-level `{criteria: ...}`, a `criteria:` nested under some other key) is refused, which is the
    fail-closed direction: a document this cannot confirm is a criteria mapping does not get to
    supply the id list this gate enforces.
    """
    base = None
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or stripped.startswith("%"):
            continue
        if stripped in ("---", "..."):
            continue
        base = line[:len(line) - len(line.lstrip())]
        break
    if base is None:
        return False
    return re.search(r"(?m)^" + re.escape(base) + r"criteria[ \t]*:", text) is not None


# Acceptance-criteria ids: pyyaml when it is installed AND WORKS, else a regex that handles BOTH
# block style (`- id: AC-001`) and flow style (`- {id: AC-001, ...}`).
#
# "pyyaml is missing" and "this YAML is broken" are NOT the same condition and are no longer caught
# by one bare `except`. A missing library is a legitimate degraded path; a SYNTAX ERROR is not
# something to regex around, because a half-readable criteria file yields a SHORT id list, and every
# criterion that fell out of that list is then never checked for coverage at all -- silently shrinking
# the very set this gate exists to enforce. Nor is "pyyaml is INSTALLED BUT BROKEN" either of those
# two: see the discriminator below.
ac_ids = []
try:
    text = read_text(ac_path)
except LedgerReadError as e:
    emit(f"TRACEABILITY: CANNOT VERIFY -- {e}")
    sys.exit(EXIT_CANNOT_EVALUATE)

# ---------------------------------------------------------------------------------------------
# WHICH PARSER RUNS -- and the THIRD state the old code could not see.
#
# `try: import yaml / except ImportError: yaml = None` recognised two worlds: pyyaml importable, or
# pyyaml missing. A pyyaml that is INSTALLED BUT BROKEN (a partial or corrupted install, a missing
# internal submodule, an extension module that will not load, a module-level sys.exit) is a THIRD, and
# it was mishandled in the one shape that stays SILENT: an ImportError raised from INSIDE the package
# was swallowed by the `except`, so this gate DOWNGRADED ITSELF to the weaker regex reader while
# reporting -- through the fallback's own messages -- that the host has no pyyaml. That matters here
# more than almost anywhere: the fallback cannot see a YAML syntax error at all, so a document the
# real parser would REFUSE can yield a SHORT id list, and every criterion missing from that list is
# never checked for coverage. The set this gate enforces shrinks, and nothing says so.
# (The other shape -- an import raising something that is not an ImportError -- has always been
# caught by the excepthook above, which is why only the exit CODE was right there and not the
# diagnosis. Both shapes are now named explicitly.)
#
# Sixth instance of this repo's characteristic defect, and the same discriminator, ordering and
# wording as bin/firm-check-assertions (which is this script's caller, so the two must not disagree
# about whether a host has a usable YAML parser): importlib.util.find_spec("yaml") asks the import
# system whether the module is FINDABLE, without executing it.
#   the probe RAISED    -> INCONCLUSIVE (a broken import hook, a poisoned sys.modules entry, a corrupt
#                          parent package). Checked FIRST, deliberately: an unknown state must not be
#                          mistaken for either of the two known ones. Exit 2 -- guessing "absent"
#                          would silently downgrade the reader on no evidence, which is the very
#                          fail-open being closed here.
#   spec is not None    -> pyyaml IS installed and importing it still failed => BROKEN => exit 2,
#                          naming the real exception type and text.
#   spec is None        -> pyyaml is genuinely NOT INSTALLED. Legitimate degraded path (this repo's
#                          tooling holds itself to a stdlib-only floor); the regex fallback below runs
#                          exactly as it always has, shape check included.
# The import is wrapped in `except BaseException` deliberately -- `except Exception` still lets a
# module-level SystemExit set this process's exit code to something a caller reads as a coverage
# verdict, 0 included, and SystemExit does not pass through sys.excepthook.
# ---------------------------------------------------------------------------------------------
yaml = None
yaml_exc = None
try:
    import yaml
except BaseException as e:            # NOT just ImportError -- see the note above
    yaml_exc = e

if yaml is None:
    yaml_spec, probe_exc = None, None
    try:
        yaml_spec = importlib.util.find_spec("yaml")
    except BaseException as e:
        probe_exc = e
    if probe_exc is not None:
        emit("TRACEABILITY: CANNOT VERIFY -- cannot tell whether pyyaml is absent or broken: "
             f"`import yaml` raised {type(yaml_exc).__name__}: {_one_line_ascii(yaml_exc)}, and "
             "probing for it with importlib.util.find_spec('yaml') itself raised "
             f"{type(probe_exc).__name__}: {_one_line_ascii(probe_exc)}. Refusing to assume 'not "
             "installed' and downgrade to the regex reader on a guess -- an unexplained parser "
             "downgrade is exactly the silent fail-open this gate exists to prevent. Repair the "
             "python environment and re-run.")
        sys.exit(EXIT_CANNOT_EVALUATE)
    if yaml_spec is not None:
        emit("TRACEABILITY: CANNOT VERIFY -- pyyaml IS installed "
             f"({getattr(yaml_spec, 'origin', None) or 'origin unknown'}) but `import yaml` FAILED: "
             f"{type(yaml_exc).__name__}: {_one_line_ascii(yaml_exc)}. That is a BROKEN install, not "
             "a missing one -- so this is NOT the legitimate degraded path and it is NOT quietly "
             "retried with the weaker regex reader, which would report a parser you do not have and "
             "could hand this gate a SHORTER id list than the criteria file declares. Repair or "
             "reinstall pyyaml (pip install --force-reinstall pyyaml), or remove it if you mean to "
             "run on the fallback.")
        sys.exit(EXIT_CANNOT_EVALUATE)
    # spec is None: pyyaml really is not installed. Fall through to the documented fallback.

if yaml is not None:
    try:
        doc = yaml.safe_load(text)
    except Exception as e:
        emit(f"TRACEABILITY: CANNOT VERIFY -- {ac_path} is not valid YAML: {e}")
        sys.exit(EXIT_CANNOT_EVALUATE)
    if doc is None:
        doc = {}
    if not isinstance(doc, dict):
        emit(f"TRACEABILITY: CANNOT VERIFY -- {ac_path} top level is {type(doc).__name__}, "
             f"expected a mapping with a `criteria:` list")
        sys.exit(EXIT_CANNOT_EVALUATE)
    ac_ids = [c.get("id") for c in (doc.get("criteria") or []) if isinstance(c, dict) and c.get("id")]
else:
    # Degraded path. It can find only what it can match, and cannot detect a syntax error at all --
    # hence the fail-closed guards here and below when nothing (or nothing trustworthy) parses.
    ac_ids = re.findall(r'(?:^|[\s\-{,])id:\s*["\']?([A-Za-z0-9_-]+)', text, re.M)
    ac_ids = [a for a in ac_ids if a]
    # SEC-R13. That findall harvests `id:` out of ANY text -- including document SHAPES the real
    # parser REFUSES. The plainest case is a top-level LIST (`- id: AC-001`, no `criteria:` key at
    # all): pyyaml loads it as a list and the branch above rejects it as "not a mapping", while the
    # regex cheerfully returns two ids and the run PASSES. Same file, opposite verdicts, decided by
    # whether the host happens to have pyyaml -- and it diverges in the dangerous direction, the
    # looser reader being the one that says yes. So the shape is checked on this path too.
    #
    # Only when ids were actually found: with none, the zero-ids guard below already fails closed and
    # says something more useful about why.
    #
    # This does not make the two paths identical -- a syntax error is still invisible here, and ids
    # sitting outside the `criteria:` block are still harvested (which over-collects, i.e. errs
    # toward FAIL). What it removes is the shape divergence that pointed the wrong way.
    if ac_ids and not top_level_criteria_key(text):
        emit(f"TRACEABILITY: CANNOT VERIFY -- {ac_path} has `id:` entries but no top-level "
             f"`criteria:` key, so its top level is not the mapping this gate reads; a YAML parser "
             f"would refuse this document. Fix the file, or install pyyaml for an exact parse.")
        sys.exit(EXIT_CANNOT_EVALUATE)
ac_ids = [a for a in ac_ids if a]

# Fail-closed: no ids means there is nothing to trace, which is NOT the same as full coverage -- do
# not pass vacuously (matches the firm's "BLOCK on uncertainty" stance). Covers both "the file
# declares criteria but we couldn't extract any ids" and "the file declares none at all"; a zero-
# criterion run reaching this gate is itself a defect worth surfacing, not a clean bill of health.
if not ac_ids:
    if re.search(r'^\s*criteria\s*:', text, re.M):
        emit("TRACEABILITY: CANNOT VERIFY -- 'criteria:' present but no ids parsed (install pyyaml or fix the file format)")
    else:
        emit(f"TRACEABILITY: CANNOT VERIFY -- no acceptance criteria ids found in {ac_path}; nothing to trace is not coverage")
    sys.exit(EXIT_CANNOT_EVALUATE)

try:
    verdict = json.loads(read_text(v_path))
except LedgerReadError as e:          # before the bare `Exception`: this is not a JSON problem
    emit(f"TRACEABILITY: CANNOT VERIFY -- {e}")
    sys.exit(EXIT_CANNOT_EVALUATE)
except Exception as e:
    emit(f"TRACEABILITY: CANNOT VERIFY -- {v_path} is not valid JSON: {e}")
    sys.exit(EXIT_CANNOT_EVALUATE)
if not isinstance(verdict, dict):
    emit(f"TRACEABILITY: CANNOT VERIFY -- {v_path} is not a JSON object")
    sys.exit(EXIT_CANNOT_EVALUATE)

raw_cov = verdict.get("acceptance_criteria_coverage")
if raw_cov is None:
    raw_cov = []
if not isinstance(raw_cov, list):
    emit("TRACEABILITY: CANNOT VERIFY -- acceptance_criteria_coverage is not a list")
    sys.exit(EXIT_CANNOT_EVALUATE)

# THREE buckets, not one -- this is the exit-code contract at the criterion level.
#
#   problems      the gate LOOKED and the answer is no: a criterion absent from the verdict, or
#                 `no`/`partial` asserted with no justification. Exit 1.
#   unverifiable  the gate could not look: a coverage entry or `covered` value it cannot interpret.
#                 Exit 2. This is NOT a coverage gap and must never be reported as one -- a caller
#                 asserting "this run should fail traceability" would otherwise be satisfied by a
#                 verdict file the checker could not read a single coverage value out of.
#   phantom       the gate cannot trust that it is looking at the right verdict: a coverage entry
#                 naming an id declared by no criterion. Exit 2, same precedence and same reasoning as
#                 `unverifiable`; the long argument is in the both-directions note in the shell header.
#
# `unverifiable` and `phantom` take PRECEDENCE over `problems`: if any part of the coverage could not
# be interpreted, or the verdict is not about this criteria set, the whole run has no verdict -- the
# uninterpretable or mismatched part could have changed it. `problems` is still reported alongside, so
# nothing the gate did manage to find is thrown away; it just does not set the exit code.
#
# Malformed coverage entries are COUNTED, never quietly dropped: a dropped entry for an id that is
# in the criteria would resurface as "NOT in verdict coverage", but one for any other id would just
# vanish, and the summary would then over-report how much QA actually looked at.
problems = []
unverifiable = []
cov = {}
dup_ids = []
for i, c in enumerate(raw_cov):
    if not isinstance(c, dict) or not str(c.get("id") or "").strip():
        unverifiable.append(f"coverage entry #{i} is malformed (needs an object with a non-empty id): {c!r}")
        continue
    cid = str(c["id"]).strip()
    if cid in cov and cid not in dup_ids:
        # PRE-EXISTING behaviour, deliberately unchanged here (it is not this fix's subject): a repeated
        # id overwrites, so the LAST entry for an id decides that criterion and the earlier ones are
        # discarded. Two entries that DISAGREE (`no` then `yes`) therefore resolve to whichever came
        # last, which is a latent hazard of its own -- it is now at least VISIBLE (a note below) instead
        # of being the unexplained gap between the raw entry count and the count this gate reports.
        dup_ids.append(cid)
    cov[cid] = c

# --- the reciprocal direction: coverage -> criteria ---------------------------------------------
# Compared against the criteria ids under the SAME normalisation the coverage keys got (str + strip),
# never against the raw values: a criteria file with `id: 001` yields the int 1 from pyyaml, and
# flagging a coverage entry "1" as phantom because the two sides differ in TYPE would be a false
# accusation. That asymmetry still leaves the per-criterion lookup below failing on such a file --
# unchanged, pre-existing, and exit 1 either way -- but the new guard must not manufacture a
# provenance failure out of it.
declared = {str(a).strip() for a in ac_ids}
phantom = [
    f"coverage entry names id {cid!r} (covered={cov[cid].get('covered')!r}) -- NO criterion declares "
    f"this id"
    for cid in cov if cid not in declared
]
# Named separately from `problems` so the reconciliation line below can state BOTH directions.
uncovered_ids = [a for a in ac_ids if cov.get(a) is None]

VALID_COVERED = ("yes", "no", "partial")   # mirrors agent-firm/schemas/qa-verdict.schema.json
n_yes = n_partial = n_waived = 0
gaps = []    # justified, non-blocking -- but NOT full coverage, so they must be visible
notes = []   # neither blocking nor a coverage gap; still worth saying out loud

if dup_ids:
    # Informational only -- it changes no count and no exit code. It exists because the reported entry
    # count is of DISTINCT ids, so without this the line below silently disagrees with the number of
    # entries in the file.
    notes.append(f"{len(dup_ids)} coverage id(s) appear MORE THAN ONCE and the LAST entry for each one "
                 f"decides that criterion (earlier ones are discarded): {', '.join(sorted(dup_ids))}")

for ac in ac_ids:
    c = cov.get(ac)
    if c is None:
        problems.append(f"{ac}: NOT in verdict coverage")
        continue
    covered  = str(c.get("covered") if c.get("covered") is not None else "").strip().lower()
    evidence = str(c.get("evidence") if c.get("evidence") is not None else "").strip()
    if not covered:
        # "cannot be verified", said in the message all along -- so it is an unverifiable, not a
        # coverage gap. An absent value tells us nothing about whether the criterion is covered.
        unverifiable.append(f"{ac}: no `covered` value -- coverage cannot be verified")
    elif covered not in VALID_COVERED:
        unverifiable.append(f"{ac}: covered={c.get('covered')!r} is not one of yes/no/partial -- cannot be verified")
    elif covered == "yes":
        n_yes += 1
        if not evidence:
            # Not a downgrade of `yes` (still counted as covered, still exit 0) -- but an unsourced
            # claim of coverage is worth naming rather than printing as indistinguishable from a
            # cited one.
            notes.append(f"{ac}: covered=yes but cites NO evidence")
    elif covered == "partial":
        if not evidence:
            problems.append(f"{ac}: covered=partial with no justification")
        else:
            n_partial += 1
            gaps.append(f"{ac}: PARTIAL -- {evidence}")
    else:  # covered == "no"
        if not evidence:
            problems.append(f"{ac}: covered=no with no justification")
        else:
            n_waived += 1
            gaps.append(f"{ac}: NOT COVERED (waived) -- {evidence}")

# The two counts used to be printed side by side and acted on by NOTHING -- which is how a 2-vs-4
# mismatch sat, unremarked, in the output of a PASSING run. Every way the two numbers can now differ is
# accounted for somewhere in this output:
#   * a criterion with no coverage entry   -> itemised BY NAME in the report below (always was)
#   * a coverage entry naming no criterion -> the clause on this line, plus the block below, plus a
#                                             non-zero exit. This is the direction that was ignored.
#   * duplicate ids collapsing             -> the note above (the reported count is of DISTINCT ids)
# The clause is added only for the reciprocal direction, and that is a MEASURED constraint, not
# indifference: bin/firm-check-assertions collapses this whole output into a 240-character detail, and
# an exit-1 run's detail is 202 characters at its longest pinned fixture. Any unconditional clause
# (the shortest sensible one is 27 characters) pushes the uncovered criterion's NAME past the cut, so
# restating a fact already itemised below would buy a tidier line at the cost of the operator no longer
# being told WHICH criterion is uncovered -- a diagnostic regression tests/test-check-assertions.sh
# pins. The one direction that has nowhere else to be reported is the one that gets the bytes.
_recon = (f"  -- MISMATCH: {len(phantom)} of these entries name NO criterion" if phantom else "")
emit(f"acceptance criteria: {len(ac_ids)}  verdict coverage entries: {len(cov)}{_recon}")
emit(f"coverage: {n_yes} full (yes) | {n_partial} partial | {n_waived} waived (no + justification) "
     f"| {len(problems)} problem(s) | {len(unverifiable)} unverifiable | {len(phantom)} phantom")
for n in notes: emit(f"  note: {n}")

if phantom or unverifiable:
    # Precedence over `problems`: an uninterpretable coverage value could have gone either way, and a
    # verdict written against some other criteria set says nothing reliable about this one, so the run
    # has NO traceability verdict -- not a passing one, and not a failing one either.
    emit("TRACEABILITY: CANNOT VERIFY -- coverage could not be evaluated, so this run has no "
         "traceability verdict in either direction:")
    if phantom:
        emit("  this verdict does not describe THIS run's acceptance criteria:")
        for p in phantom: emit(f"  - {p}")
        emit("    A coverage entry for an id this run does not declare means the verdict was written "
             "against a DIFFERENT criteria set (renumbered, stale, or another run's). The entries whose "
             "ids DO match are then untrustworthy too -- an id is only a label, and the same label names "
             "a different criterion in a different revision -- so NO criterion here has a coverage "
             "verdict. Not a coverage FAILURE (exit 1): a coverage question this gate cannot answer.")
        if uncovered_ids:
            # The same mismatch from the other side. Stated here rather than on the counts line
            # because the exit-2 report has no byte budget to protect (see the note there), and
            # because "no id in common" is the crispest possible statement of "not my verdict".
            emit(f"    seen from the other side: {len(uncovered_ids)} of this run's {len(ac_ids)} "
                 "criteria have no coverage entry at all"
                 + (" -- the two id sets do not overlap AT ALL."
                    if len(uncovered_ids) == len(ac_ids) else "."))
        _decl = sorted(declared)
        # Bounded: a real ledger can declare dozens of criteria, and this gate's caller collapses the
        # child's output to 240 characters -- an unbounded id dump would push the ids that are actually
        # the problem out of the report the operator sees.
        emit(f"    the {len(_decl)} id(s) {ac_path} declares: " + ", ".join(_decl[:12])
             + (" ..." if len(_decl) > 12 else ""))
        emit(f"    reconcile {v_path} against it and re-run.")
    for p in unverifiable: emit(f"  - {p}")
    if problems:
        emit("  ...and these criterion-level coverage failures were found as well:")
        for p in problems: emit(f"  - {p}")
    sys.exit(EXIT_CANNOT_EVALUATE)

if problems:
    emit("TRACEABILITY: FAIL")
    for p in problems: emit(f"  - {p}")
    sys.exit(EXIT_COVERAGE_FAIL)

if gaps:
    # Headline deliberately avoids the substring "TRACEABILITY: PASS": anything grepping for that
    # (a human, a log scan, a future script) must not read a partially-covered run as a clean one.
    emit("GAPS -- these criteria are NOT fully covered (each carries a justification):")
    for g in gaps: emit(f"  - {g}")
    emit(f"TRACEABILITY: INCOMPLETE -- {n_yes}/{len(ac_ids)} criteria fully covered, "
         f"{len(gaps)} justified gap(s) above. Exit 0 because every gap is justified, but this is "
         f"NOT full coverage -- carry these gaps into the Final gate.")
    sys.exit(EXIT_OK)

emit(f"TRACEABILITY: PASS -- all {len(ac_ids)} criteria marked fully covered (covered=yes).")
sys.exit(EXIT_OK)
PY
