#!/usr/bin/env bash
# qa-checkout [branch]
# Materializes a FRESH, clean checkout at the integration branch HEAD so QA runs from a known-clean
# state (the firm rule: QA installs from lockfile and runs the same command CI uses, read-only).
set -euo pipefail
__src="${BASH_SOURCE[0]}"   # resolve symlinks so ~/.local/bin/firm-* finds the repo
while [ -L "$__src" ]; do __d="$(cd -P "$(dirname "$__src")" && pwd)"; __src="$(readlink "$__src")"; case $__src in /*) ;; *) __src="$__d/$__src";; esac; done
SELF="$(cd -P "$(dirname "$__src")" && pwd)"   # resolve sibling scripts by location

run_dir=""; [[ -f .agent-firm/CURRENT_RUN ]] && run_dir="$(cat .agent-firm/CURRENT_RUN)"
run_id="$(basename "${run_dir:-none}")"
branch="${1:-integration/${run_id}}"

if ! git show-ref --verify --quiet "refs/heads/${branch}"; then
  echo "branch '${branch}' not found — run bin/integrate first (or pass a branch)" >&2; exit 1
fi

qa_dir=".agent-firm/qa-checkout/${run_id}"
git worktree remove --force "$qa_dir" 2>/dev/null || rm -rf "$qa_dir"
mkdir -p "$(dirname "$qa_dir")"
git worktree add --force "$qa_dir" "$branch" >/dev/null

sha="$(git -C "$qa_dir" rev-parse --short HEAD)"
[[ -x "$SELF/firm-ledger-log" ]] && "$SELF/firm-ledger-log" qa_checkout dir="$qa_dir" branch="$branch" sha="$sha" || true
echo "clean QA checkout: $qa_dir  (at ${branch} @ ${sha})"
echo "QA: cd into it, install from the lockfile, run the exact CI command, capture evidence. Do NOT edit source."
