#!/usr/bin/env bash
# firm-merge-guard — refuse an AI-initiated merge/push unless the operator's identity is allow-listed.
#
# ============================================================================================
# WHAT THIS IS NOT (read first — this disclosure is a deliverable, not a caveat)
#   This is a CLIENT-SIDE control. It is BYPASSABLE by anyone with repo write access, four
#   different ways: edit this script, delete the hook entry from .claude/settings.json (or
#   hooks/hooks.json), set `git config user.email` to a listed value, or run git in a terminal
#   outside the AI tool. It is therefore:
#     · NOT a security boundary,
#     · NOT branch protection,
#     · and it CANNOT provide a "required PR review" — only GitHub can (see
#       docs/BRANCH-PROTECTION-RUNBOOK.md for the exact calls, and the GitHub Pro requirement).
#   Its actual scope is narrower and is the whole of the ask it satisfies: preventing an AI agent
#   from performing an unauthorised merge or push through the tool surface. It stops an agent; it
#   does not stop a determined human. Rated at its honest tier in docs/ENFORCEMENT.md.
# ============================================================================================
#
# IDENTITY SOURCES (the only two; AC-017)
#   1. `gh api user --jq .login`  -> matched against `gh_login`  in the allowlist
#   2. `git config user.email`    -> matched against `git_emails` in the allowlist
#   BOTH must resolve AND both must be allow-listed. `user.name` is NOT read (equally spoofable,
#   pure false-block surface). The allowlist lives in exactly ONE file:
#       agent-firm/policy/merge-authority.yaml
#   Nothing here duplicates its contents — the messages below print what was READ from it.
#
# FAILS CLOSED, ALWAYS. Anything that cannot be evaluated is a BLOCK, never a pass: no network,
# `gh` absent, `gh` unauthenticated, empty/malformed/non-login `gh` output, `git` absent,
# `user.email` unset or empty, allowlist missing/unreadable/unparseable/empty/unknown-key, no
# usable YAML parser, no python3, an unlexable command string, an unrecognised hook payload.
#
# EXIT CONTRACT (check modes — the firm's three-way gate contract; AC-016)
#   0  identity resolved AND allow-listed                     -> permitted
#   1  identity resolved and NOT allow-listed                  -> refused
#   2  CANNOT EVALUATE (any indeterminate path above)          -> refused
#   Callers MUST treat anything other than 0 as a block. `--hook` does exactly that, and it does
#   not distinguish 1 from 2 in the block decision (only in the message it prints).
#
# WHY --hook ALWAYS EXITS 2 ON A BLOCK, NEVER 1
#   Measured against Claude Code 2.1.220, not assumed: a PreToolUse hook exiting **2** blocks the
#   tool call and feeds stderr back to the agent (it registers as a real permission denial). A hook
#   exiting **1** is a NON-blocking error — the probe command RAN. So `--hook` collapses every
#   non-zero check result to exit 2. Returning the raw 1 would be a silent fail-open.
#
# USAGE
#   firm-merge-guard --hook                 # PreToolUse(Bash) adapter; payload JSON on stdin
#   firm-merge-guard --command '<cmdline>'  # check one command line; three-way exit
#   firm-merge-guard --surface              # print the covered command surface + known gaps
#   firm-merge-guard --help
#
# PERFORMANCE (AC-022) — the hook fires on EVERY Bash call, so identity resolution (a network
# round-trip to `gh`) happens ONLY after the command has matched the gated surface. A command with
# none of the trigger substrings is decided in bash, with zero subprocesses. Measured on the
# machine this was written on: 9.8 ms per benign Bash call (no gh, no git, no python3 spawned —
# tests/test-merge-guard.sh proves that with stubs that fail loudly if executed), and ~500 ms for a
# gated command, which is one real `gh` round trip.
#
# ON DOUBLE-FIRING, DELIBERATELY NOT CACHED. This repo is simultaneously the plugin source and the
# project, so BOTH hook registrations resolve and every PreToolUse hook here runs TWICE per Bash
# call (measurable in run.jsonl: ~50% of the existing ledger lines are exact duplicates — a
# pre-existing registration defect, not this guard's). Both registrations are load-bearing: a
# consumer project installing the plugin only sees hooks/hooks.json, a project-scope install only
# sees .claude/settings.json, so dropping either would silently disable the gate in that mode.
# The consequence here is two `gh` round trips (~1 s total) and two ledger events on a GATED
# command; benign commands still cost 2 x 9.8 ms and zero network. That is NOT memoised on
# purpose: a cache of a PERMIT decision is a fail-open surface (a stale entry, or a writable cache
# file, becomes an authorisation) on a control whose entire value is that it fails closed, and the
# cost it would save falls only on merge/push attempts, which are rare and already network-bound.
# Blocking twice is still blocking; the check is idempotent.
set -uo pipefail

# Resolve symlinks so ~/.local/bin/firm-merge-guard still finds the repo (firm-link installs it).
__src="${BASH_SOURCE[0]}"
while [ -L "$__src" ]; do
  __d="$(cd -P "$(dirname "$__src")" && pwd)"; __src="$(readlink "$__src")"
  case $__src in /*) ;; *) __src="$__d/$__src";; esac
done
SELF="$(cd -P "$(dirname "$__src")" && pwd)"
ROOT="$(cd "$SELF/.." && pwd)"
POLICY="$ROOT/agent-firm/policy/merge-authority.yaml"

MODE=""
CMD=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --hook)    MODE="hook" ;;
    --command) MODE="command"; CMD="${2:-}"; shift ;;
    --surface) MODE="surface" ;;
    -h|--help)
      sed -n '2,60p' "$__src" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *)
      printf 'firm-merge-guard: unknown argument: %s (try --help)\n' "$1" >&2
      exit 2 ;;   # an argument we do not understand is not a licence to permit
  esac
  shift
done
[ -n "$MODE" ] || { printf 'firm-merge-guard: one of --hook / --command / --surface is required\n' >&2; exit 2; }

# ---------------------------------------------------------------------------------------------
# The embedded checker. One python3 program, one process: payload parse, command classification,
# allowlist load, identity resolution, message, ledger append. Data arrives via the environment
# (NOT argv) so a command line containing a secret is not exposed in `ps` output.
# ---------------------------------------------------------------------------------------------
_mg_py() {
  python3 - <<'PYEOF'
import json, os, re, subprocess, sys

MODE    = os.environ.get("FIRM_MG_MODE", "")
POLICY  = os.environ.get("FIRM_MG_POLICY", "")
PAYLOAD = os.environ.get("FIRM_MG_PAYLOAD", "")
COMMAND = os.environ.get("FIRM_MG_COMMAND", "")

PERMIT, REFUSE, CANNOT = 0, 1, 2
GH_TIMEOUT, GIT_TIMEOUT = 12, 8

def err(*a):
    sys.stderr.write(" ".join(str(x) for x in a) + "\n")

# ---- the gated command surface -------------------------------------------------------------
# Matching is on the command STRING, because that is all a PreToolUse hook is given. Everything
# below is structural (tokenise, then look at the actual command word and subcommand) rather than
# substring matching, because substring matching would block `git merge-base`, `git merge-file`
# and `git commit -m "...merge..."` — false positives that would make the firm unusable.

TRIGGER = re.compile(r"push|merge|pull|gh", re.I)     # cheap prefilter; a strict superset
SHELLS   = ("bash", "sh", "zsh", "dash", "ksh", "mksh")
WRAPPERS = ("sudo", "doas", "env", "command", "builtin", "exec", "nohup",
            "time", "nice", "ionice", "stdbuf", "setsid", "caffeinate")
GIT_OPT_WITH_VALUE = ("-C", "-c", "--git-dir", "--work-tree", "--namespace",
                      "--exec-path", "--config-env", "--super-prefix")
WRITE_METHODS = ("POST", "PUT", "PATCH", "DELETE")
# `gh api` switches to POST automatically when any field is supplied, so a field flag is a write
# even with no -X. Each of these takes a value.
GH_API_WRITE_FLAGS = ("-f", "--field", "-F", "--raw-field", "--input")
GH_API_VALUE_FLAGS = ("-H", "--header", "-q", "--jq", "-t", "--template",
                      "--hostname", "--cache", "-p", "--preview", "--slurp")
GH_LOGIN_RE = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$")

SURFACE_COVERED = [
    "git push (every form: --force, -f, --force-with-lease, --tags, --mirror, --delete, an",
    "  explicit refspec, any remote name, `git -C <path> push`, `git -c k=v push`)",
    "git merge (any target, including while the default branch is checked out)",
    "git pull (it merges)",
    "git subtree push",
    "gh pr merge",
    "gh api with a write method (-X/--method POST|PUT|PATCH|DELETE) — covers",
    "  `gh api -X PUT /repos/*/git/refs/heads/<default>` and `gh api -X POST /repos/*/merges`",
    "gh api with a field/input flag (-f/-F/--field/--raw-field/--input): gh makes that a POST",
    "gh api on a path containing /merges, /git/refs, or /pulls/<n>/merge (any method)",
    "gh release create|delete|edit|upload (creates or moves a remote tag ref)",
    "gh repo sync (moves a branch ref)",
    "the above behind: `&&`, `||`, `;`, `|`, newlines, `(...)`, backslash continuations,",
    "  leading VAR=VAL assignments, wrappers (sudo/env/command/exec/time/nohup/nice/xargs-free),",
    "  an absolute path (/opt/homebrew/bin/gh), `bash -c '<cmd>'`, `$(...)`/backtick substitution,",
    "  and a shell heredoc body fed to bash/sh/zsh",
]
SURFACE_GAPS = [
    "A git ALIAS: `git ps` where ps=push, or a shell alias/function `gp`. The alias definition is",
    "  not visible in the command string, so the guard cannot see the push. Not closable here.",
    "Any string-level obfuscation: `g=git; $g push`, `eval \"$(printf 'git push')\"`, base64,",
    "  a push inside a script FILE the agent wrote and then executed. A determined bypass is out",
    "  of scope by construction — see the CLIENT-SIDE disclosure in this file's header.",
    "Non-shell surfaces: a push from Python/Node (subprocess, dulwich, isomorphic-git), or any",
    "  MCP/tool that talks to the GitHub API directly. A PreToolUse(Bash) hook never sees them.",
    "`hub` and `glab`, and `git svn dcommit`.",
    "`gh workflow run` / `gh workflow enable`: can trigger a workflow that itself pushes. One",
    "  indirection past what the guard reads.",
    "Local-ref moves that are not merges and not pushes: `git branch -f main <sha>`,",
    "  `git update-ref refs/heads/main`, `git reset --hard` on main. They cannot reach the remote",
    "  without a `git push`, which IS covered.",
    "Read-only `gh api` (a GET with no fields) is deliberately not matched.",
    "A wrapper script that merges internally is not matched by name: `firm-integrate` is the",
    "  firm's own case, and it is safe by its own positive allowlist (integration/* only), not by",
    "  this guard. A FUTURE wrapper could launder a merge past both.",
    "A heredoc body fed to a NON-shell (python3 <<'PY' ... PY) is skipped, so a `git push` line",
    "  inside a python/text heredoc is neither matched nor a false positive. Deliberate: this",
    "  repo's own docs and tests are full of the literal string `git push`.",
]

class Cannot(Exception):
    """Something the checker could not evaluate. Always a BLOCK."""

def base(tok):
    return tok.rsplit("/", 1)[-1] if "/" in tok else tok

def substitutions(text):
    """Yield the inside of every $(...) and `...` span, so `out=$(git push)` is still seen."""
    out, i, n = [], 0, len(text)
    while i < n:
        if text[i] == "$" and i + 1 < n and text[i + 1] == "(":
            depth, j = 1, i + 2
            while j < n and depth:
                if text[j] == "(":
                    depth += 1
                elif text[j] == ")":
                    depth -= 1
                j += 1
            out.append(text[i + 2:j - 1 if depth == 0 else n])
            i = j
            continue
        if text[i] == "`":
            j = text.find("`", i + 1)
            if j < 0:
                break
            out.append(text[i + 1:j])
            i = j + 1
            continue
        i += 1
    return out

HEREDOC_RE = re.compile(r"<<-?\s*(['\"]?)([A-Za-z_][A-Za-z0-9_]*)\1")

def logical_lines(text):
    """Split into lines, dropping heredoc bodies UNLESS the heredoc feeds a shell."""
    lines = text.replace("\\\n", " ").split("\n")
    out, i, n = [], 0, len(lines)
    while i < n:
        line = lines[i]
        out.append(line)
        m = HEREDOC_RE.search(line)
        if m:
            word = m.group(2)
            head = line.strip().split()
            keep = bool(head) and base(head[0].strip("\"'")) in SHELLS
            i += 1
            while i < n and lines[i].strip() != word:
                if keep:
                    out.append(lines[i])
                i += 1
            i += 1          # skip the terminator line itself
            continue
        i += 1
    return out

def segments(line):
    """Tokenise one line and split it on shell operators, OUTSIDE quotes.

    shlex(posix=True, punctuation_chars=True) is the tool for this: it yields `&&`, `||`, `;`, `|`
    as their own tokens and — critically — does NOT split on an operator inside a quoted string.
    A naive split would turn `git commit -m "gate; git push is refused"` into a false positive.
    """
    import shlex
    lex = shlex.shlex(line, posix=True, punctuation_chars=True)
    lex.whitespace_split = True
    try:
        toks = list(lex)
    except ValueError as e:
        # Unbalanced quote: a real shell would fail too, but we must not guess. Fail closed.
        raise Cannot("could not tokenise the command line (%s)" % e)
    segs, cur = [], []
    for t in toks:
        if t and all(ch in "();<>|&" for ch in t):
            if cur:
                segs.append(cur)
                cur = []
        else:
            cur.append(t)
    if cur:
        segs.append(cur)
    return segs

def classify_git(args):
    i = 0
    while i < len(args):
        a = args[i]
        if a in GIT_OPT_WITH_VALUE:
            i += 2
            continue
        if a.startswith("-"):
            i += 1
            continue
        break
    if i >= len(args):
        return None
    sub, rest = args[i], args[i + 1:]
    if sub == "push":
        return "git push"
    if sub == "merge":                 # exact: `merge-base`/`merge-file`/`merge-tree` are NOT this
        return "git merge"
    if sub == "pull":
        return "git pull"
    if sub == "subtree" and rest and rest[0] == "push":
        return "git subtree push"
    return None

def classify_gh_api(rest):
    method, path, write_flag = None, None, False
    j = 0
    while j < len(rest):
        a = rest[j]
        if a in ("-X", "--method"):
            method = rest[j + 1] if j + 1 < len(rest) else ""
            j += 2
            continue
        if a.startswith("--method="):
            method = a.split("=", 1)[1]
            j += 1
            continue
        if a in GH_API_WRITE_FLAGS:
            write_flag = True
            j += 2
            continue
        if any(a.startswith(f + "=") for f in ("--field", "--raw-field", "--input")):
            write_flag = True
            j += 1
            continue
        if a in GH_API_VALUE_FLAGS:
            j += 2
            continue
        if a.startswith("-"):
            j += 1
            continue
        if path is None:
            path = a
        j += 1
    m = (method or "").upper()
    if m in WRITE_METHODS:
        return "gh api -X %s (remote write)" % m
    if write_flag:
        return "gh api with fields (gh sends POST)"
    p = path or ""
    if "/merges" in p:
        return "gh api .../merges"
    if "/git/refs" in p:
        return "gh api .../git/refs"
    if re.search(r"/pulls/\d+/merge", p):
        return "gh api .../pulls/N/merge"
    return None

def classify_gh(args):
    i = 0
    while i < len(args) and args[i].startswith("-"):
        i += 1
    if i >= len(args):
        return None
    grp, rest = args[i], args[i + 1:]
    sub = rest[0] if rest else ""
    if grp == "pr":
        return "gh pr merge" if sub == "merge" else None
    if grp == "api":
        return classify_gh_api(rest)
    if grp == "release":
        return "gh release " + sub if sub in ("create", "delete", "edit", "upload") else None
    if grp == "repo":
        return "gh repo sync" if sub == "sync" else None
    return None

def classify_segment(seg, depth):
    i = 0
    while i < len(seg):
        t = seg[i]
        if re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", t):     # leading VAR=VAL
            i += 1
            continue
        if base(t) in WRAPPERS:
            i += 1
            continue
        break
    if i >= len(seg):
        return None
    argv = seg[i:]
    prog = base(argv[0].strip("\"'"))
    if prog in SHELLS:
        for j in range(1, len(argv) - 1):
            if argv[j] in ("-c", "-lc", "-ic", "-cl"):
                return classify(argv[j + 1], depth + 1)
        return None
    if prog == "git":
        return classify_git(argv[1:])
    if prog == "gh":
        return classify_gh(argv[1:])
    return None

def classify(text, depth=0):
    """Return a label for the gated surface this command line touches, or None."""
    if depth > 3 or not text:
        return None
    if not TRIGGER.search(text):
        return None
    for line in logical_lines(text):
        if not line.strip():
            continue
        for seg in segments(line):
            hit = classify_segment(seg, depth)
            if hit:
                return hit
        for inner in substitutions(line):
            hit = classify(inner, depth + 1)
            if hit:
                return hit
    return None

# ---- the allowlist -------------------------------------------------------------------------
TOP_KEYS   = ("schema_version", "allowed")
ENTRY_KEYS = ("gh_login", "git_emails", "note")

def load_allowlist():
    """-> (logins, emails, entries). Raises Cannot on anything it cannot fully account for."""
    if not POLICY:
        raise Cannot("no allowlist path was resolved")
    if not os.path.isfile(POLICY):
        raise Cannot("allowlist file is missing: %s" % POLICY)
    import importlib.util
    try:
        spec = importlib.util.find_spec("yaml")
    except Exception as e:
        raise Cannot("cannot even probe for a YAML parser (%s)" % e)
    if spec is None:
        # No regex fallback on purpose. A looser reader could mis-read an allowlist, and the only
        # safe direction for THIS file is to refuse. Install pyyaml (see docs/INSTALL.md).
        raise Cannot("pyyaml is not installed, so the allowlist cannot be parsed exactly")
    try:
        import yaml
    except Exception as e:
        raise Cannot("pyyaml is installed but unimportable (%s) — a broken install, not an absent one" % e)
    try:
        with open(POLICY) as fh:
            data = yaml.safe_load(fh)
    except Exception as e:
        raise Cannot("allowlist is not parseable YAML: %s" % e)
    if not isinstance(data, dict):
        raise Cannot("allowlist top level is %s, expected a mapping" % type(data).__name__)
    for k in data:
        if k not in TOP_KEYS:
            raise Cannot("allowlist has an unknown top-level key %r (expected %s)"
                         % (k, ", ".join(TOP_KEYS)))
    entries = data.get("allowed")
    if not isinstance(entries, list) or not entries:
        raise Cannot("allowlist `allowed:` is empty or not a list — never a vacuous pass")
    logins, emails = [], []
    for n, e in enumerate(entries, 1):
        if not isinstance(e, dict):
            raise Cannot("allowlist entry %d is not a mapping" % n)
        for k in e:
            if k not in ENTRY_KEYS:
                raise Cannot("allowlist entry %d has an unknown key %r — this file must not "
                             "describe an identity source the code does not read" % (n, k))
        lg = e.get("gh_login")
        if not isinstance(lg, str) or not lg.strip() or "*" in lg or "?" in lg:
            raise Cannot("allowlist entry %d has a missing/blank/wildcard gh_login" % n)
        ems = e.get("git_emails")
        if not isinstance(ems, list) or not ems:
            raise Cannot("allowlist entry %d has no git_emails" % n)
        for em in ems:
            if not isinstance(em, str) or not em.strip() or "*" in em or "?" in em or "@" not in em:
                raise Cannot("allowlist entry %d has an invalid git_emails value %r" % (n, em))
            emails.append(em.strip().lower())
        logins.append(lg.strip().lower())
    return logins, emails, entries

# ---- identity resolution -------------------------------------------------------------------
def run(argv, timeout):
    """-> (rc, stdout, stderr, failure) where failure is '', 'absent' or 'timeout'."""
    try:
        p = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError:
        return 127, "", "", "absent"
    try:
        out, errout = p.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            p.kill()
            p.communicate(timeout=2)
        except Exception:
            pass
        return 124, "", "", "timeout"
    dec = lambda b: (b or b"").decode("utf-8", "replace")
    return p.returncode, dec(out).strip(), dec(errout).strip(), ""

def resolve_gh():
    """-> (login, status, detail). status 'ok' only for a syntactically valid GitHub login."""
    rc, out, errout, failure = run(["gh", "api", "user", "--jq", ".login"], GH_TIMEOUT)
    if failure == "absent":
        return "", "gh-absent", "the `gh` binary is not on PATH"
    if failure == "timeout":
        return "", "gh-timeout", "`gh api user` did not answer within %ds (offline?)" % GH_TIMEOUT
    first = (errout.splitlines() or [""])[0][:200]
    if rc != 0:
        return "", "gh-failed", "`gh api user` exited %d: %s" % (rc, first or "(no stderr)")
    if not out:
        return "", "gh-empty", "`gh api user --jq .login` printed nothing"
    line = out.splitlines()[0].strip().strip('"')
    if not GH_LOGIN_RE.match(line):
        return "", "gh-malformed", "output is not a GitHub login: %r" % line[:120]
    return line, "ok", ""

def resolve_git_email():
    rc, out, errout, failure = run(["git", "config", "user.email"], GIT_TIMEOUT)
    if failure == "absent":
        return "", "git-absent", "the `git` binary is not on PATH"
    if failure == "timeout":
        return "", "git-timeout", "`git config user.email` did not answer"
    if rc != 0 or not out.strip():
        return "", "git-unset", "`git config user.email` is unset or empty in this working tree"
    val = out.splitlines()[0].strip()
    if "@" not in val:
        return "", "git-malformed", "user.email is not an address: %r" % val[:120]
    return val, "ok", ""

# ---- ledger (AC-021) -----------------------------------------------------------------------
def ledger(event, fields):
    """Append one event to the active run's run.jsonl. Best-effort: never changes the decision."""
    try:
        p = os.path.join(".agent-firm", "CURRENT_RUN")
        if not os.path.isfile(p):
            return
        with open(p) as fh:
            run_dir = fh.read().strip()
        if not run_dir or not os.path.isdir(run_dir):
            return
        import datetime
        rec = {"ts": datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ"), "event": event}
        rec.update(fields)
        with open(os.path.join(run_dir, "run.jsonl"), "a") as fh:
            fh.write(json.dumps(rec, sort_keys=True) + "\n")
    except Exception:
        pass

# ---- the command under test ----------------------------------------------------------------
def command_from_payload():
    """Extract .tool_input.command from the PreToolUse payload.

    Distinguishes three cases on purpose:
      · not a Bash tool call            -> nothing to gate (permit)
      · a Bash call with no command KEY -> schema drift; we can no longer see what would run, and
                                           a gate that cannot see its input must not pass (block)
      · a command that is the empty str -> nothing to run (permit)
    """
    if not PAYLOAD.strip():
        raise Cannot("the hook received an empty stdin payload, so the command is unknown")
    try:
        d = json.loads(PAYLOAD)
    except Exception as e:
        raise Cannot("the hook payload is not JSON (%s)" % e)
    if not isinstance(d, dict):
        raise Cannot("the hook payload is not a JSON object")
    tool = d.get("tool_name")
    if isinstance(tool, str) and tool and tool != "Bash":
        return None                      # a different tool: not this guard's surface
    ti = d.get("tool_input")
    if not isinstance(ti, dict):
        raise Cannot("the hook payload has no tool_input object")
    if "command" not in ti:
        raise Cannot("the hook payload's tool_input has no `command` key — the payload shape "
                     "changed and the command string can no longer be read")
    cmd = ti.get("command")
    if cmd is None or cmd == "":
        return None
    if not isinstance(cmd, str):
        raise Cannot("the hook payload's command is %s, not a string" % type(cmd).__name__)
    return cmd

# ---- main ----------------------------------------------------------------------------------
def surface():
    print("firm-merge-guard — gated command surface")
    print("\nCOVERED (each has its own test assertion in tests/test-merge-guard.sh):")
    for s in SURFACE_COVERED:
        print("  " + s if not s.startswith("  ") else "  " + s)
    print("\nKNOWN GAPS (honestly enumerated; not closable client-side):")
    for s in SURFACE_GAPS:
        print("  " + s if not s.startswith("  ") else "  " + s)
    print("\nNOT MATCHED, deliberately (false positives would make the firm unusable):")
    print("  git merge-base / merge-file / merge-tree / merge-index, git commit -m '...merge...',")
    print("  git log/diff/status/fetch/show, firm-integrate, firm-qa-checkout, bash tests/run-tests.sh")
    return 0

def main():
    if MODE == "surface":
        return surface()

    try:
        cmd = command_from_payload() if MODE == "hook" else COMMAND
    except Cannot as e:
        err("firm-merge-guard: CANNOT EVALUATE — %s" % e)
        err("  Blocking, because a check that cannot read its input must never report success.")
        ledger("merge_guard_block", {"decision": "cannot_evaluate", "reason": str(e), "cmd": ""})
        return CANNOT
    if cmd is None:
        return PERMIT

    try:
        hit = classify(cmd)
    except Cannot as e:
        err("firm-merge-guard: CANNOT EVALUATE — %s" % e)
        err("  command: %s" % cmd[:400])
        err("  Blocking: the command contains a merge/push trigger word but could not be parsed.")
        ledger("merge_guard_block", {"decision": "cannot_evaluate", "reason": str(e),
                                     "cmd": cmd[:2000]})
        return CANNOT
    if not hit:
        return PERMIT        # not the gated surface: no allowlist read, no gh, no network

    # --- from here on the command IS gated, so identity must be established -----------------
    try:
        logins, emails, entries = load_allowlist()
    except Cannot as e:
        err("firm-merge-guard: BLOCKED (cannot evaluate) — %s" % e)
        err("  refused command : %s" % cmd[:400])
        err("  matched surface : %s" % hit)
        err("  allowlist       : %s" % POLICY)
        err("  Fix the allowlist file; an unreadable allowlist is never treated as empty or as")
        err("  allow-everything. See agent-firm/policy/merge-authority.yaml.")
        ledger("merge_guard_block", {"decision": "cannot_evaluate", "reason": str(e),
                                     "cmd": cmd[:2000], "matched": hit})
        return CANNOT

    gh_login, gh_status, gh_detail = resolve_gh()
    git_email, git_status, git_detail = resolve_git_email()

    gh_ok  = gh_status == "ok" and gh_login.lower() in logins
    git_ok = git_status == "ok" and git_email.lower() in emails
    indeterminate = gh_status != "ok" or git_status != "ok"

    def fmt(value, status, allowed, detail):
        if status != "ok":
            return "UNRESOLVED (%s: %s)" % (status, detail)
        return "%s -> %s" % (value, "allow-listed" if allowed else "NOT allow-listed")

    if not indeterminate and gh_ok and git_ok:
        err("firm-merge-guard: permitted — %s by %s / %s (allow-listed in %s)"
            % (hit, gh_login, git_email, os.path.basename(POLICY)))
        ledger("merge_guard_permit", {"decision": "permitted", "cmd": cmd[:2000], "matched": hit,
                                      "gh_login": gh_login, "git_email": git_email})
        return PERMIT

    # Blocked. Say exactly which axis failed and how to proceed legitimately.
    code = CANNOT if indeterminate else REFUSE
    label = "CANNOT EVALUATE identity" if indeterminate else "identity NOT authorised"
    err("firm-merge-guard: BLOCKED — %s." % label)
    err("")
    err("  refused command : %s" % cmd[:400])
    err("  matched surface : %s" % hit)
    err("  gh login        : %s" % fmt(gh_login, gh_status, gh_ok, gh_detail))
    err("  git user.email  : %s" % fmt(git_email, git_status, git_ok, git_detail))
    err("  policy          : BOTH sources must resolve and BOTH must be allow-listed.")
    err("  allowlist       : %s" % POLICY)
    err("  allow-listed    : logins %s ; emails %s" % (", ".join(logins), ", ".join(emails)))
    err("")
    if git_status == "ok" and not git_ok:
        suggest = ""
        for e in entries:
            if str(e.get("gh_login", "")).lower() == gh_login.lower():
                ems = e.get("git_emails") or []
                if ems:
                    suggest = str(ems[0])
                break
        if not suggest and emails:
            suggest = emails[0]
        err("  Your git identity is not one of the authorised ones. A stale global identity left")
        err("  behind by CI (`git config --global user.*` in .github/workflows/ci.yml) is the")
        err("  usual cause on this machine. If you are an authorised operator, set your own:")
        err("")
        err('      git config --global user.email %s' % suggest)
        err("")
    if git_status not in ("ok", ):
        err("  Set a git identity before merging: git config --global user.email <your address>")
    if gh_status == "gh-absent":
        err("  Install and authenticate the GitHub CLI: `gh auth login`.")
    elif gh_status in ("gh-failed", "gh-timeout"):
        err("  Re-authenticate (`gh auth status`, then `gh auth login`) or restore network access.")
    elif gh_status == "ok" and not gh_ok:
        err("  The authenticated GitHub account is not authorised to merge or push here.")
    err("  To authorise an identity, add it to %s (a one-file edit)." % POLICY)
    err("  To proceed without an authorised identity: ask the human operator to run the command")
    err("  themselves in a terminal. Do NOT edit or remove this guard to get past it.")
    err("")
    err("  NOTE: this control is CLIENT-SIDE and bypassable by anyone with repo write access. It")
    err("  is not a security boundary and is not branch protection — see docs/ENFORCEMENT.md.")
    ledger("merge_guard_block", {
        "decision": "refused" if code == REFUSE else "cannot_evaluate",
        "cmd": cmd[:2000], "matched": hit,
        "gh_login": gh_login or "", "gh_status": gh_status,
        "git_email": git_email or "", "git_status": git_status,
        "exit": code})
    return code

try:
    sys.exit(main())
except Cannot as e:                      # anything unclassified above still fails closed
    err("firm-merge-guard: CANNOT EVALUATE — %s" % e)
    sys.exit(2)
except Exception as e:                   # an internal error is not a permit
    err("firm-merge-guard: internal error (%s: %s) — blocking, not permitting."
        % (type(e).__name__, e))
    sys.exit(2)
PYEOF
}

# ---------------------------------------------------------------------------------------------
# Cheap bash prefilter (AC-022). A command line with none of these substrings cannot match any
# entry in SURFACE_COVERED — every covered form literally contains push, merge, pull, or "gh ".
# Returning 1 here costs ZERO subprocesses: no python3, no gh, no git, no network.
# ---------------------------------------------------------------------------------------------
_mg_may_match() {
  case "$1" in
    *push*|*Push*|*PUSH*|*merge*|*Merge*|*MERGE*|*pull*|*Pull*|*PULL*) return 0 ;;
    *"gh "*|*"gh	"*|*'gh"'*|*"gh'"*)                                  return 0 ;;
  esac
  return 1
}

if [ "$MODE" = "surface" ]; then
  FIRM_MG_MODE=surface FIRM_MG_POLICY="$POLICY" FIRM_MG_PAYLOAD="" FIRM_MG_COMMAND="" _mg_py
  exit $?
fi

if [ "$MODE" = "command" ]; then
  _mg_may_match "$CMD" || exit 0
  if ! command -v python3 >/dev/null 2>&1; then
    printf 'firm-merge-guard: CANNOT EVALUATE — python3 is required to inspect this command.\n' >&2
    exit 2
  fi
  FIRM_MG_MODE=command FIRM_MG_POLICY="$POLICY" FIRM_MG_PAYLOAD="" FIRM_MG_COMMAND="$CMD" _mg_py
  rc=$?
  # The contract is exactly three-way, so an exit code from OUTSIDE it (python3 itself failing, a
  # SIGKILL, an exec error) must be reported as cannot-evaluate — not passed through raw. It is
  # still non-zero either way, but a caller told "99" cannot tell that from a decision.
  case "$rc" in 0|1|2) exit "$rc" ;; *)
    printf 'firm-merge-guard: CANNOT EVALUATE — the checker itself exited %s.\n' "$rc" >&2
    exit 2 ;;
  esac
fi

# ---- hook mode ------------------------------------------------------------------------------
payload="$(cat 2>/dev/null || true)"

# Fast negative filter. jq is used ONLY to prove a NEGATIVE (a real string command with no trigger
# word); anything it cannot answer with certainty falls through to python3, which is authoritative.
# A jq that is missing, old, or wrong can therefore only cost a few milliseconds — never a pass.
if command -v jq >/dev/null 2>&1; then
  verdict="$(printf '%s' "$payload" | jq -r '
    if (.tool_input | type) != "object" then "CHECK"
    elif (.tool_input | has("command")) != true then "CHECK"
    elif (.tool_input.command | type) != "string" then "CHECK"
    elif (.tool_input.command | test("push|merge|pull|gh"; "i")) then "CHECK"
    else "SKIP" end' 2>/dev/null || printf 'CHECK')"
  [ "$verdict" = "SKIP" ] && exit 0
else
  # No jq: the whole payload is the haystack. It is a superset of the command, so a negative here
  # is still a safe negative.
  _mg_may_match "$payload" || exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
  printf 'firm-merge-guard: BLOCKED (cannot evaluate) — python3 is not installed, so this command\n' >&2
  printf '  cannot be checked against the merge-authority allowlist. Install python3 (a declared\n' >&2
  printf '  firm prerequisite, see docs/INSTALL.md) or remove the firm-merge-guard PreToolUse hook.\n' >&2
  exit 2
fi

FIRM_MG_MODE=hook FIRM_MG_POLICY="$POLICY" FIRM_MG_PAYLOAD="$payload" FIRM_MG_COMMAND="" _mg_py
rc=$?
# THE CALLER CONTRACT (AC-016): anything other than 0 is a block, and a PreToolUse hook only
# actually blocks on exit 2 in this Claude Code version (measured — exit 1 lets the command run).
# So 1 and 2 are deliberately NOT distinguished here.
[ "$rc" -eq 0 ] || exit 2
exit 0
