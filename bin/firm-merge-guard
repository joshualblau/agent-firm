#!/usr/bin/env bash
# firm-merge-guard — refuse an AI-initiated merge/push unless the operator's identity is allow-listed.
#
# ============================================================================================
# WHAT THIS IS NOT (read first — this disclosure is a deliverable, not a caveat)
#   This is a CLIENT-SIDE control. It is BYPASSABLE by anyone with repo write access, four
#   different ways: edit this script, delete the hook entry from .claude/settings.json (or
#   hooks/hooks.json), rewrite the git identity as a FILE (`.git/config`, `~/.gitconfig` — the
#   `git config` COMMAND is on the gated surface, the FILE is not), or run git in a terminal
#   outside the AI tool. It is therefore:
#     · NOT a security boundary,
#     · NOT branch protection,
#     · and it CANNOT provide a "required PR review" — only GitHub can (see
#       docs/BRANCH-PROTECTION-RUNBOOK.md for the exact calls, and the GitHub Pro requirement).
#   Its actual scope is narrower and is the whole of the ask it satisfies: preventing an AI agent
#   from performing an unauthorised merge or push through the tool surface. It stops an agent; it
#   does not stop a determined human. Rated at its honest tier in docs/ENFORCEMENT.md.
#   DO NOT trust this paragraph for SCOPE. `firm-merge-guard --surface` prints what is COVERED and
#   what is a known GAP, and every line of BOTH lists has its own assertion in
#   tests/test-merge-guard.sh — a covered line has a test that it BLOCKS, a gap line has a test
#   that it does NOT. That is the only claim of scope worth reading.
# ============================================================================================
#
# IDENTITY SOURCES (the only two; AC-017)
#   1. `gh api user --jq .login`  -> matched against `gh_login`  in the allowlist
#   2. `git config user.email`    -> matched against `git_emails` in the allowlist
#   BOTH must resolve AND both must be allow-listed. `user.name` is NOT read for the decision
#   (equally spoofable, pure false-block surface). Both are read in the HOOK'S WORKING DIRECTORY —
#   NOT in the repository named by a `-C` / `--git-dir` in the command being checked. This is a
#   consistency check on the operator's own configuration, not a property of the target repo.
#   The allowlist lives in exactly ONE file:
#       agent-firm/policy/merge-authority.yaml
#   Nothing here duplicates its contents — the messages below print what was READ from it.
#   Because that second axis is a plain string the restrained actor can write, `git config` WRITES
#   to user.email / user.name are themselves on the gated surface. Reads are not.
#
# FAILS CLOSED, ALWAYS. Anything that cannot be evaluated is a BLOCK, never a pass: no network,
# `gh` absent, `gh` unauthenticated, empty/malformed/non-login `gh` output, `git` absent,
# `user.email` unset or empty, allowlist missing/unreadable/unparseable/empty/unknown-key, no
# usable YAML parser, no python3, an unlexable command string, an unrecognised hook payload,
# `--command` with no value, and any exit code from the embedded checker outside its own contract.
#
# EXIT CONTRACT (check modes — the firm's three-way gate contract; AC-016)
#   0  identity resolved AND allow-listed                     -> permitted
#   1  identity resolved and NOT allow-listed                  -> refused
#   2  CANNOT EVALUATE (any indeterminate path above)          -> refused
#   Callers MUST treat anything other than 0 as a block. `--hook` does exactly that, and it does
#   not distinguish 1 from 2 in the block decision (only in the message it prints).
#   The embedded python checker deliberately exits 3 (not 1) for a refusal, so that a bare 1 —
#   which is what a python3 that dies of a syntax error, a bad interpreter or a failed exec
#   returns — can never be MISREAD as the decision "identity resolved and not allow-listed". The
#   bash wrapper maps 3 -> 1 and maps everything outside {0,2,3} to 2 with a message.
#   AND the code alone is not trusted: the checker prints a PROOF-OF-EXECUTION sentinel line on
#   stdout naming its decision, and the wrapper honours 0 (permit) or 3 (refuse) ONLY if the
#   sentinel agrees. An exit status is a number any `python3` on PATH can return without running a
#   line of the checker — a stub exiting 3 was reported as a refusal, and a stub exiting 0 was
#   reported as a PERMIT, which is a fail-open. Both are now cannot-evaluate. stderr is never
#   captured, so the human-readable block message still reaches the caller verbatim.
#
# WHY --hook ALWAYS EXITS 2 ON A BLOCK, NEVER 1
#   Measured against Claude Code 2.1.220, not assumed: a PreToolUse hook exiting **2** blocks the
#   tool call and feeds stderr back to the agent (it registers as a real permission denial). A hook
#   exiting **1** is a NON-blocking error — the probe command RAN. So `--hook` collapses every
#   non-zero check result to exit 2. Returning the raw 1 would be a silent fail-open.
#
# USAGE
#   firm-merge-guard --hook                 # PreToolUse(Bash) adapter; payload JSON on stdin
#   firm-merge-guard --command '<cmdline>'  # check one command line; three-way exit
#   firm-merge-guard --surface              # print the covered command surface + known gaps
#   firm-merge-guard --help
#
# PERFORMANCE (AC-022) — the hook fires on EVERY Bash call, so identity resolution (a network
# round-trip to `gh`) happens ONLY after the command has matched the gated surface. A command with
# none of the trigger substrings is decided in bash, with zero subprocesses. Measured on the
# machine this was written on, 200 iterations under /bin/bash 3.2.57: 11.0 ms per benign Bash call
# through the hook adapter (jq included), 6.3 ms via --command. No gh, git, python3 or jq is spawned
# on that path (tests/test-merge-guard.sh proves it with stubs that fail loudly if executed,
# including for QUOTED benign commands). A gated command costs ~500 ms, which is one real `gh`
# round trip. The prefilter deletes backslashes, quotes, the `$` of a `$'…'`/`$"…"` quote introducer
# and a backslash-newline continuation PAIR, all with bash parameter expansion — still zero
# subprocesses — so shell quoting cannot smuggle a trigger word past it, which it previously could.
# See the comment above _mg_may_match.
#   RE-MEASURED after that last addition (SEC-18), same method, 200 iterations: 5.5 ms via --command
#   and 9.7 ms through the hook for a benign call, i.e. unchanged within run-to-run noise — the extra
#   parameter expansions and the extra `case` cost nothing measurable. `grep 'TODO$' README.md` — a
#   `$` immediately before a quote, the everyday end-of-line regex anchor — stays on the
#   zero-subprocess path at 5.6 ms, and `sed $'s/x/y/' f` (an ANSI-C span with no escape in it) at
#   5.5 ms. What DOES now reach python3 is a `$'…'` span containing a backslash, because hex/octal/\u
#   escapes cannot be decoded in bash without a subprocess; that is a deliberate trade of ~30 ms on a
#   rare spelling against a whole bypass class.
#   MEASURED, same runs, for the `git`-then-`config` clause once it was ORDERED: a command with both
#   words in the WRONG order — `grep -rn config .github/` is the everyday one — went from 34.3 ms to
#   6.3 ms via --command and 38.7 ms to 11.5 ms through the hook, i.e. back onto the zero-subprocess
#   path. And what did NOT improve, stated because a performance claim is a claim: `cat .git/config`
#   and `ls ~/.gitconfig` still cost ~34 ms, because `git` genuinely does precede `config` there and
#   no substring test can tell them from a real `git ... config` write without parsing.
#   `cat docs/config.md` and `python3 -c "import configparser"` were never on the CHECK path at all
#   — neither contains `git` — so the ordering did not change them either.
#
# HOW THE WORST CASE STAYS UNDER THE REGISTERED HOOK TIMEOUT
#   Both hook registrations set "timeout": 30. The script's own bounded waits are GH_TIMEOUT +
#   GIT_TIMEOUT + 2 * KILL_GRACE (8 + 4 + 2 = 14 s worst case, both sources hung), leaving room for
#   python start-up, the allowlist read and the ledger append. tests/test-merge-guard.sh parses
#   these constants out of THIS file and out of BOTH hook registrations and fails if the inequality
#   stops holding, because a hook that exceeds its framework timeout is not a block.
#
# ON DOUBLE-FIRING, DELIBERATELY NOT CACHED. This repo is simultaneously the plugin source and the
# project, so BOTH hook registrations resolve and every PreToolUse hook here runs TWICE per Bash
# call (measurable in run.jsonl: ~50% of the existing ledger lines are exact duplicates — a
# pre-existing registration defect, not this guard's). Both registrations are load-bearing: a
# consumer project installing the plugin only sees hooks/hooks.json, a project-scope install only
# sees .claude/settings.json, so dropping either would silently disable the gate in that mode.
# The consequence here is two `gh` round trips (~1 s total) and two ledger events on a GATED
# command; benign commands still cost 2 x 11.08 ms and zero network. That is NOT memoised on
# purpose: a cache of a PERMIT decision is a fail-open surface (a stale entry, or a writable cache
# file, becomes an authorisation) on a control whose entire value is that it fails closed, and the
# cost it would save falls only on merge/push attempts, which are rare and already network-bound.
# Blocking twice is still blocking; the check is idempotent.
set -uo pipefail

# Resolve symlinks so ~/.local/bin/firm-merge-guard still finds the repo (firm-link installs it).
__src="${BASH_SOURCE[0]}"
while [ -L "$__src" ]; do
  __d="$(cd -P "$(dirname "$__src")" && pwd)"; __src="$(readlink "$__src")"
  case $__src in /*) ;; *) __src="$__d/$__src";; esac
done
SELF="$(cd -P "$(dirname "$__src")" && pwd)"
ROOT="$(cd "$SELF/.." && pwd)"
POLICY="$ROOT/agent-firm/policy/merge-authority.yaml"

MODE=""
CMD=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --hook)    MODE="hook" ;;
    --command)
      # A flag with no value is caller misuse, not an authorisation. `--command "$UNSET_VAR"`
      # must not resolve to "nothing gated here, permit" — every other unreadable input in this
      # script exits 2 and so does this one.
      if [ "$#" -lt 2 ] || [ -z "${2:-}" ]; then
        printf 'firm-merge-guard: CANNOT EVALUATE — --command was given no command string.\n' >&2
        printf '  Blocking: a gate asked to check nothing must not answer "permitted".\n' >&2
        exit 2
      fi
      MODE="command"; CMD="$2"; shift ;;
    --surface) MODE="surface" ;;
    -h|--help)
      sed -n '2,118p' "$__src" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *)
      printf 'firm-merge-guard: unknown argument: %s (try --help)\n' "$1" >&2
      exit 2 ;;   # an argument we do not understand is not a licence to permit
  esac
  shift
done
[ -n "$MODE" ] || { printf 'firm-merge-guard: one of --hook / --command / --surface is required\n' >&2; exit 2; }

# ---------------------------------------------------------------------------------------------
# The embedded checker. One python3 program, one process: payload parse, command classification,
# allowlist load, identity resolution, message, ledger append. Data arrives via the environment
# (NOT argv) so a command line containing a secret is not exposed in `ps` output.
# ---------------------------------------------------------------------------------------------
_mg_py() {
  python3 - <<'PYEOF'
import json, os, re, subprocess, sys

MODE    = os.environ.get("FIRM_MG_MODE", "")
POLICY  = os.environ.get("FIRM_MG_POLICY", "")
PAYLOAD = os.environ.get("FIRM_MG_PAYLOAD", "")
COMMAND = os.environ.get("FIRM_MG_COMMAND", "")

# The DECISION codes (what the ledger records and what the bash wrapper reports as the contract).
PERMIT, REFUSE, CANNOT = 0, 1, 2
# What THIS process exits with. REFUSE leaves as 3 so that a bare 1 from a broken interpreter can
# never be mistaken for a decision; the bash wrapper maps 3 -> 1. (SEC-07)
PROCESS_EXIT = {PERMIT: 0, REFUSE: 3, CANNOT: 2}
# PROOF OF EXECUTION. An exit code alone cannot prove this program ran, and the wrapper reads that
# code AS the decision, so a `python3` that never executed a line of it could still author one:
#   · a python3 exiting 3 was read as "identity resolved and NOT allow-listed" (SEC-17), and
#   · a python3 exiting 0 was read as PERMIT — the same defect pointing the wrong way, and a
#     fail-OPEN. `python3` shims, wrappers and a stub that ignores stdin all exit 0.
# So every decision also writes this sentinel to STDOUT (stderr is left strictly alone: it carries
# the human-readable block message and must reach the agent verbatim). The wrapper honours 0 and 3
# ONLY when the sentinel names the same decision, and reports anything else as cannot-evaluate.
SENTINEL = {PERMIT: "FIRM_MG_DECISION=permit",
            REFUSE: "FIRM_MG_DECISION=refuse",
            CANNOT: "FIRM_MG_DECISION=cannot"}

# Bounded waits. tests/test-merge-guard.sh parses this exact line and asserts
# GH_TIMEOUT + GIT_TIMEOUT + 2*KILL_GRACE + HOOK_BUDGET_MARGIN <= the registered hook timeout in
# BOTH .claude/settings.json and hooks/hooks.json. Do not raise these without re-running that test.
GH_TIMEOUT, GIT_TIMEOUT, KILL_GRACE = 8, 4, 1
# Headroom for python start-up, the allowlist read and the ledger append.
HOOK_BUDGET_MARGIN = 10

def err(*a):
    sys.stderr.write(" ".join(str(x) for x in a) + "\n")

# ---- the gated command surface -------------------------------------------------------------
# Matching is STRUCTURAL: tokenise with shlex, split on shell operators, resolve the launcher
# prefix, then look at the actual command word and subcommand. It is deliberately NOT substring
# matching, because substring matching would block `git merge-base`, `git merge-file` and
# `git commit -m "...merge..."` — false positives that would make the firm unusable. There is a
# cheap substring PREFILTER in bash (see _mg_may_match) but it only ever proves a NEGATIVE.

# Names that ARE a shell: argv[1:] are the shell's OWN flags, so `-c <string>` is an inline command.
# `busybox` and `toybox` are deliberately NOT here even though `busybox sh` is a shell: they are
# multi-call DISPATCHERS whose first operand is an applet NAME, not a flag. Listing one here made
# shell_inline read the applet name `sh` as a script FILE and return None, so `busybox sh -c
# '<cmd>'` was permitted — being in SHELLS was strictly worse than being absent. They belong in
# WRAPPERS, which skips the applet name and resolves the real shell. (SEC-14)
# tests/test-merge-guard.sh asserts SHELLS and WRAPPERS stay disjoint, and asserts every
# dispatcher name is on the WRAPPERS side, so this cannot silently regress.
SHELLS   = ("bash", "sh", "zsh", "dash", "ksh", "mksh", "ash")
MULTICALL = ("busybox", "toybox")
# Launcher words: a program whose job is to run ANOTHER program. Recognising one means "keep
# looking for the real command word", including past the launcher's OWN flags and flag values.
# `su`/`runuser`/`setpriv`/`unshare`/`systemd-run`/`nsenter`/`chroot` sit here beside `sudo` and
# `doas` because they are the same kind of word (SEC-16); the ones that take a POSITIONAL operand
# before the command (`chroot <dir> cmd`, `nsenter -t <pid> cmd`) are still limited by declared
# gap #2, which names them.
WRAPPERS = ("sudo", "doas", "su", "runuser", "setpriv", "unshare", "systemd-run",
            "nsenter", "chroot",
            "env", "command", "builtin", "exec", "nohup",
            "time", "nice", "ionice", "stdbuf", "setsid", "caffeinate",
            "timeout", "gtimeout", "xargs", "flock", "watch", "parallel",
            "taskset", "chrt", "unbuffer", "script", "proxychains", "proxychains4",
            "eatmydata", "retry", "chronic", "ts", "arch", "setarch") + MULTICALL
# Shell keywords that can precede a command word inside one operator-delimited segment
# (`if git diff --quiet; then git push; fi`, `for f in x; do git push; done`).
KEYWORDS = ("if", "then", "elif", "else", "while", "until", "do", "for", "case", "esac",
            "fi", "done", "in", "coproc")
GIT_OPT_WITH_VALUE = ("-C", "-c", "--git-dir", "--work-tree", "--namespace",
                      "--exec-path", "--config-env", "--super-prefix")
WRITE_METHODS = ("POST", "PUT", "PATCH", "DELETE")
# `gh api` switches to POST automatically when any field is supplied, so a field flag is a write
# even with no -X. Each of these takes a value.
GH_API_WRITE_FLAGS = ("-f", "--field", "-F", "--raw-field", "--input")
GH_API_VALUE_FLAGS = ("-H", "--header", "-q", "--jq", "-t", "--template",
                      "--hostname", "--cache", "-p", "--preview", "--slurp")
GH_GROUPS = ("pr", "api", "release", "repo")
GH_LOGIN_RE = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$")

# The identity keys whose WRITE is gated (SEC-04): the guard's own second axis, plus user.name,
# which is not read for the decision but is the same class of self-authorship.
GIT_IDENTITY_KEYS = ("user.email", "user.name")
GIT_CONFIG_VALUE_FLAGS = ("-f", "--file", "--blob", "--type", "-t", "--default",
                          "--fixed-value", "--comment")
GIT_CONFIG_READ_FLAGS  = ("--get", "--get-all", "--get-regexp", "--get-urlmatch", "--list",
                          "-l", "--get-color", "--get-colorbool", "--name-only")
GIT_CONFIG_READ_VERBS  = ("get", "list")
GIT_CONFIG_WRITE_FLAGS = ("--add", "--replace-all", "--unset", "--unset-all",
                          "--rename-section", "--remove-section")

SURFACE_COVERED = [
    "git push — every flag form (--force, -f, --force-with-lease, --tags, --mirror, --delete), an",
    "  explicit or forced refspec, any remote name or URL, `git -C <path> push`, `git -c k=v push`,",
    "  `git --git-dir=<d> push`, `git --no-pager push`, and an absolute path to git",
    "git merge (any target, including while the default branch is checked out)",
    "git pull (it merges)",
    "git subtree push",
    "git config WRITES to user.email / user.name — `git config [--global|--local|--system|-f F]",
    "  user.email <v>`, `--add`/`--replace-all`/`--unset`/`--unset-all`, and the newer",
    "  `git config set|unset user.email <v>` verb form. This is the guard's own identity axis, so a",
    "  blocked agent cannot re-author itself into the allowlist. READS are NOT matched (`git config",
    "  user.email`, `--get`, `--get-all`, `--get-regexp`, `--list`, `-l`, `git config get ...`),",
    "  and neither is a non-identity key (`git config --global core.editor vim`).",
    "gh pr merge",
    "gh api with a write method: `-X POST|PUT|PATCH|DELETE`, `--method X`, `--method=X`, and the",
    "  ATTACHED short form `-XPUT` / `-XPOST` / `-XPATCH` / `-XDELETE` (any case)",
    "gh api with a field/input flag (-f/-F/--field/--raw-field/--input): gh makes that a POST",
    "gh api on a path containing /merges, /git/refs, or /pulls/<n>/merge (any method)",
    "gh release create|delete|edit|upload (creates or moves a remote tag ref)",
    "gh repo sync (moves a branch ref)",
    "any of the above behind ALL of these, in any combination:",
    "  · operators and grouping: `&&`, `||`, `;`, `|`, `&`, newlines, backslash continuations,",
    "    `(...)` subshells, `{ ...; }` brace groups, `!` negation, `$(...)` and backtick capture",
    "  · shell keywords: `if ...; then git push; fi`, `for f in x; do git push; done`",
    "  · leading VAR=VAL assignments",
    "  · redirections anywhere, INCLUDING leading and fd-prefixed ones: `>/dev/null git push`,",
    "    `2>/tmp/e git merge main`, `git push >log 2>&1`",
    "  · a launcher word AND ITS OWN FLAGS AND FLAG VALUES. The launcher set is printed below;",
    "    `sudo -u josh`, `sudo --`, `nice -n 10`, `nice -n19`, `env -i`, `env -u FOO`,",
    "    `command -p`, `stdbuf -o0`, `timeout 60`, `timeout -s KILL 60`, `xargs -n1` all resolve",
    "    to the command they launch",
    "  · a launcher flag VALUE that is itself spelled like a command word, in EITHER reading:",
    "    `sudo -u git git push` (`git` is the -u value; `git` is the conventional service-account",
    "    name) is matched, and so is `env -i git push` / `command -p git push` / `sudo -n git push`",
    "    (where the flag takes NO value, so the same token IS the command word). There is no",
    "    per-launcher table of which flags take a value, so BOTH readings are classified and either",
    "    one matching is a block. Ambiguity resolves toward blocking.",
    "  · a shell with an inline command string: any short-option cluster containing `c` (`-c`,",
    "    `-ec`, `-xc`, `-lc`, `-cl`, `-exc`) and value-taking shell flags before it",
    "    (`bash -o pipefail -c '<cmd>'`, `bash --rcfile f -c '<cmd>'`)",
    "  · a multi-call shell dispatcher in front of the shell: `busybox sh -c '<cmd>'`,",
    "    `busybox ash -c '<cmd>'`, `toybox sh -c '<cmd>'` (the applet NAME is skipped, not read as",
    "    a script file)",
    "  · a shell HERE-STRING, whether the shell owns it or a LATER segment does: `bash <<< '<cmd>'`",
    "    and `cat <<< '<cmd>' | bash` are both scanned, by the same any-segment-is-a-shell rule the",
    "    heredoc uses",
    "  · a heredoc body when ANY segment of the introducing line is a shell — so both",
    "    `bash <<'EOF' ... EOF` and `cat <<'EOF' | bash` are scanned",
    "  · a PROCESS SUBSTITUTION whose inside is the gated command: `cat <(git push origin main)`,",
    "    `diff <(git log) <(git push origin main)` (`<(`/`>(` is a command boundary, not a",
    "    redirection). NOTE the reverse shape, `bash <(echo 'git push')`, is a declared GAP below:",
    "    there the gated text is the OUTPUT of the inside, not the inside.",
    "  · a command string passed as a whitespace-containing flag VALUE to a launcher",
    "    (`flock -c 'git push'`, `watch 'git push'`, `xargs -I{} 'git push'`, `su -c 'git push'`)",
    "  · shell QUOTING or ESCAPING of the command word, the subcommand or a flag, AT ANY POSITION",
    "    IN THE TOKEN — not only at its start: `git pus\\h`, `git 'pu'sh`, `git pu\"sh\"`, `g\\h api`,",
    "    `$'git' push`, `git $'push'`, `gh $'pr' merge`, `git $'config' user.email <v>`, AND the",
    "    MID-TOKEN forms `git pu$'s'h`, `git pus$'h'`, `g$'i't push`, `g$'h' pr merge`,",
    "    `git co$'n'fig --global user.email <v>`, `git pu$\"s\"h`. `$'...'` and `$\"...\"` are quote",
    "    INTRODUCERS: bash collapses them into the surrounding word, so the prefilter deletes the",
    "    `$` together with the quote it introduces and the classifier models the same rule on the",
    "    RAW line, before shlex. Nothing here can affect `$VAR` — a `$` is only special when a QUOTE",
    "    is the very next character, which is bash's own rule.",
    "  · the ESCAPE SEQUENCES inside `$'...'`, DECODED the way bash decodes them, so a trigger word",
    "    spelled in hex, octal or \\u is still matched: `$'\\x67it' push`, `git $'\\x70ush'`,",
    "    `git $'\\160ush'`, `git co$'\\x6e'fig --global user.email <v>`, `$'\\x67h' pr merge`. These",
    "    are real commands, not theory (`to$'\\x75'ch f` creates `f` under /bin/bash 3.2.57), and no",
    "    substring test can see them, so the prefilters send any `$'` span containing a backslash to",
    "    the classifier instead of guessing.",
    "  · a LINE CONTINUATION inside a word — bash deletes the backslash-newline PAIR, so the halves",
    "    join: `git pu\\<newline>sh origin main`, `gi\\<newline>t co\\<newline>nfig --global",
    "    user.email <v>` (and an ordinary `git push \\<newline>origin main` still matches too)",
    "  · all of the above nested one shell deeper, INCLUDING where bash drops a backslash that shlex",
    "    keeps: `bash -c \"git pu\\$'s'h origin main\"` and `bash -ec \"git co\\$'n'fig --global",
    "    user.email <v>\"` are matched. The cost of reading `\\$'` both ways is that a TOP-LEVEL",
    "    `git pu\\$'s'h` — which bash reads as the literal `pu$sh` — is over-blocked. Ambiguity",
    "    resolves toward blocking.",
]

def _wrap_words(words, width=92, indent="    "):
    lines, cur = [], indent
    for w in words:
        if len(cur) + len(w) > width and cur.strip():
            lines.append(cur.rstrip())
            cur = indent
        cur += w + " "
    if cur.strip():
        lines.append(cur.rstrip())
    return lines

# Printed, and then driven name-by-name by tests/test-merge-guard.sh, so the set the doc CLAIMS
# and the set the code USES cannot come apart. An unlisted launcher is a declared GAP, below.
SURFACE_COVERED += ["the launcher set, in full (a NAME LIST, not a rule):"] + _wrap_words(WRAPPERS)
SURFACE_GAPS = [
    "A launcher NOT in the set printed above — a custom wrapper script, `proot`, a new coreutils",
    "  launcher: `mywrap git push origin main` is NOT matched. The set is a name list and a name",
    "  list is never complete; the FLAG handling inside it is generic, the names are not.",
    "A launcher whose command operand follows a non-flag POSITIONAL operand it consumes:",
    "  `flock /tmp/lock git push` and `chroot /newroot git push` are NOT matched (`flock -c 'git",
    "  push'` and `su -c 'git push'` ARE). Skipping a bare positional word would mean treating the",
    "  next word as a command, which over-blocks. Both names are in the launcher set for their flag",
    "  forms. NOTE the neighbouring launchers whose operands are FLAGS are covered, not gapped:",
    "  `nsenter -t 1 -m /usr/bin/git push`, `systemd-run --unit=x /usr/bin/git push`,",
    "  `setpriv --reuid=1000 git push` and `runuser -u git -- git push` all match.",
    "Container / VM / remote launchers, deliberately out of scope: `docker run ... git push`,",
    "  `podman run`, `ssh host 'git push'`, `kubectl exec`. The command runs in a different",
    "  filesystem and identity context, so the identity THIS guard resolves (the gh login and",
    "  user.email in the hook's own working directory) is not the identity that would push. Gating",
    "  on a check that does not describe the actor would be worse than declaring the gap.",
    "A git ALIAS: `git ps` where ps=push, or a shell alias/function `gp`. The alias definition is",
    "  not visible in the command string, so the guard cannot see the push. Not closable here.",
    "Any string-level obfuscation: `g=git; $g push`, `eval \"$(printf 'git push')\"`, base64,",
    "  or a command string assembled at run time (`echo 'git push' | xargs -I{} bash -c '{}'`,",
    "  `curl ... | bash`, `bash <(echo 'git push')`, `bash <(curl ...)`). In all of these the gated",
    "  text is the OUTPUT of something the guard would have to RUN to see, not text on the command",
    "  line. A determined bypass is out of scope by construction — see the CLIENT-SIDE disclosure",
    "  in this file's header. NOT in this category, and NOT a gap: an ANSI-C escape such as",
    "  `$'\\x67it' push` or `git $'\\160ush'`. That is text on the command line, and it is decoded",
    "  and MATCHED (see COVERED above) — a shell quoting construct is not run-time assembly.",
    "A push inside a script FILE: `bash deploy.sh`, `. deploy.sh`, `bash -s < deploy.sh`. The",
    "  guard reads the command line, never a file the command line names.",
    "More than 3 levels of shell nesting (`bash -c \"bash -c 'bash -c ...'\"`) — the recursion is",
    "  bounded at depth 3 so a pathological string cannot hang the hook.",
    "Non-shell surfaces: a push from Python/Node (subprocess, dulwich, isomorphic-git), or any",
    "  MCP/tool that talks to the GitHub API directly. A PreToolUse(Bash) hook never sees them.",
    "`hub` and `glab`, and `git svn dcommit`. Also the DASHED builtin form (`git-push origin main`,",
    "  `git-merge x`, `git-config --global user.email <v>`) and third-party `git-*` porcelain",
    "  (`git-lfs push`, `git-town sync`): the command word is `git-push`, not `git`, so the",
    "  subcommand classifier never runs. Modern git ships the dashed forms in libexec and NOT on",
    "  PATH, so `git-push` is normally 'command not found'; matching the prefix by name would also",
    "  catch unrelated `git-*` tools, so this is left as a named gap rather than a guess.",
    "`gh workflow run` / `gh workflow enable`: can trigger a workflow that itself pushes. One",
    "  indirection past what the guard reads.",
    "Local-ref moves that are not merges and not pushes: `git branch -f main <sha>`,",
    "  `git update-ref refs/heads/main`, `git reset --hard` on main. They cannot reach the remote",
    "  without a `git push`, which IS covered.",
    "Read-only `gh api` (a GET with no fields) is deliberately not matched.",
    "An identity change made as a FILE WRITE rather than as a `git config` command: appending to",
    "  `.git/config` or `~/.gitconfig` (`printf ... >> .git/config`, `sed -i`, `git config --edit`,",
    "  or the Edit/Write tools, which this Bash hook never sees). The `git config` COMMAND is now",
    "  gated; the FILE is not, and cannot be from here. This is the honest residual of SEC-04 and",
    "  it is why the header still lists 'rewrite the git identity as a file' as a bypass route.",
    "A wrapper script that merges internally is not matched by name: `firm-integrate` is the",
    "  firm's own case, and it is safe by its own positive allowlist (integration/* only), not by",
    "  this guard. A FUTURE wrapper could launder a merge past both.",
    "A heredoc body fed to a NON-shell (python3 <<'PY' ... PY) is skipped, so a `git push` line",
    "  inside a python/text heredoc is neither matched nor a false positive. Deliberate: this",
    "  repo's own docs and tests are full of the literal string `git push`.",
]

class Cannot(Exception):
    """Something the checker could not evaluate. Always a BLOCK."""

def base(tok):
    return tok.rsplit("/", 1)[-1] if "/" in tok else tok

# A token as the shell would resolve it, minus the decoration shell quoting leaves behind after
# shlex: `$'push'` lexes to `$push`, `"push"` to `push`, `` `push` `` keeps its backtick,
# `${push}` to `{push}`.
#
# THIS IS APPLIED TO SUBCOMMANDS AND FLAGS, NOT ONLY TO THE PROGRAM WORD. It used to live inside
# prog_name only, so `$'git' push` blocked (the PROGRAM was normalised) while `git $'push'` and
# `gh $'pr' merge` were PERMITTED — and SURFACE_COVERED claims "shell QUOTING or ESCAPING of the
# command word OR THE SUBCOMMAND". A COVERED claim the code does not provide is the defect the
# blocker was raised for, so the normalisation now runs wherever a token is compared against a
# fixed name (subcommand, git/gh global flag, git-config key, gh group, gh api path).
def unquote(tok):
    t = tok.strip("\"'`")
    while t[:1] in ("$", "{"):
        t = t[1:]
    return t.rstrip("}")

def prog_name(tok):
    return base(unquote(tok))

ASSIGN_RE  = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
NUMBERISH  = re.compile(r"^[-+]?\d+(?:\.\d+)?[a-zA-Z]?$")
FD_RE      = re.compile(r"^\d$")
SEP_WORDS  = ("{", "}", "!")
SHELL_CFLAG_RE   = re.compile(r"^[-+][A-Za-z]*c[A-Za-z]*$")
SHELL_VALUE_FLAGS = ("-o", "+o", "-O", "+O", "--rcfile", "--init-file", "--wordexp")
WS_RE = re.compile(r"\s")
# See launcher_argvs. A cap on AMBIGUITY, not on coverage: it exists so a pathological string
# cannot make the classifier quadratic, and exceeding it raises Cannot (a BLOCK) rather than
# discarding a reading, because a discarded reading is a fail-open. No real command line has more
# than one flag value spelled `git`/`gh`/`sh`/`bash`.
MAX_LAUNCHER_READINGS = 16

def substitutions(text):
    """Yield the inside of every $(...) and `...` span, so `out=$(git push)` is still seen."""
    out, i, n = [], 0, len(text)
    while i < n:
        if text[i] == "$" and i + 1 < n and text[i + 1] == "(":
            depth, j = 1, i + 2
            while j < n and depth:
                if text[j] == "(":
                    depth += 1
                elif text[j] == ")":
                    depth -= 1
                j += 1
            out.append(text[i + 2:j - 1 if depth == 0 else n])
            i = j
            continue
        if text[i] == "`":
            j = text.find("`", i + 1)
            if j < 0:
                break
            out.append(text[i + 1:j])
            i = j + 1
            continue
        i += 1
    return out

# ---- bash's own quote INTRODUCERS, modelled on the RAW line, before shlex (SEC-18) -------------
# `$'...'` (ANSI-C quoting) and `$"..."` (locale quoting) are QUOTE INTRODUCERS, not expansions, so
# bash collapses them into the surrounding word exactly the way it collapses `'...'`: `pu$'s'h` IS
# `push`. shlex does not know that — it lexes `pu$'s'h` to the token `pu$sh` — and unquote() only
# ever stripped a `$` at POSITION 0 of a token, so every mid-token spelling was PERMITTED while
# SURFACE_COVERED claimed the whole class "shell QUOTING or ESCAPING of the command word or the
# subcommand":  git pu$'s'h · git pus$'h' · g$'i't push · g$'h' pr merge · git co$'n'fig user.email.
# Repairing tokens AFTER shlex cannot fix that (the damage is that the word was split at all), so the
# modelling happens here, on the raw line:
#   · $'...'  ->  its DECODED content, re-emitted as ONE POSIX single-quoted literal, so shlex
#                 rebuilds precisely the word bash would build. Re-quoting is load-bearing:
#                 `git $'push origin main'` is ONE argument to bash and must stay one token, not
#                 become a push. Decoding is what closes the escape spellings — `$'\x67it' push`,
#                 `git $'\x70ush'`, `git $'\160ush'` really do run git (verified with a non-git
#                 marker, `to$'\x75'ch f`, under /bin/bash 3.2.57), and no substring or token test
#                 can see a trigger word spelled in hex, octal or \u.
#   · $"..."  ->  the same span with the `$` dropped. bash does not decode escapes there, so
#                 neither does this.
# This CANNOT touch `$VAR`: a `$` is special here only when a QUOTE is the very next character,
# which is bash's own rule. `$HOME`, `$PWD`, `"$v"` and `${push}` are passed through untouched.
# And it is never the ONLY reading of a line — classify() drives the raw line as well — so the
# normalisation can only ever ADD a candidate, never remove one.
BS = chr(92)          # a literal backslash, spelled once so that nothing below has to escape it
ANSI_C_SIMPLE = {"a": chr(7), "b": chr(8), "e": chr(27), "E": chr(27), "f": chr(12),
                 "n": chr(10), "r": chr(13), "t": chr(9), "v": chr(11),
                 BS: BS, "'": "'", '"': '"', "?": "?"}
HEXDIGITS, OCTDIGITS = "0123456789abcdefABCDEF", "01234567"

def _ansi_c_decode(body):
    """Decode the inside of one ANSI-C span the way bash does; unknown escapes are kept verbatim."""
    out, i, n = [], 0, len(body)
    while i < n:
        if body[i] != BS:
            out.append(body[i]); i += 1; continue
        i += 1
        if i >= n:
            out.append(BS); break
        c = body[i]
        if c in ANSI_C_SIMPLE:
            out.append(ANSI_C_SIMPLE[c]); i += 1; continue
        if c in ("x", "u", "U"):                       # \xHH, \uHHHH, \UHHHHHHHH
            width = {"x": 2, "u": 4, "U": 8}[c]
            j = i + 1
            while j < min(i + 1 + width, n) and body[j] in HEXDIGITS:
                j += 1
            if j > i + 1:
                # \u / \U are bash >= 4.2. Decoding them on a bash that would NOT is over-blocking,
                # which is the safe direction; the reverse would be a hole.
                try:
                    out.append(chr(int(body[i + 1:j], 16)))
                except (ValueError, OverflowError):
                    pass
                i = j
                continue
            out.append(c); i += 1; continue
        if c in OCTDIGITS:                             # \nnn, up to three octal digits
            j = i
            while j < min(i + 3, n) and body[j] in OCTDIGITS:
                j += 1
            out.append(chr(int(body[i:j], 8) & 0xFF)); i = j; continue
        if c == "c" and i + 1 < n:                     # \cX -> a control character, never a letter
            out.append(chr(ord(body[i + 1].upper()) ^ 0x40)); i += 2; continue
        out.append(BS); out.append(c); i += 1          # not an escape bash knows: keep both chars
    return "".join(out)

def _single_quoted(s):
    """<s> as one POSIX single-quoted word, so shlex hands back exactly these characters."""
    return "'" + s.replace("'", "'" + BS + "'" + "'") + "'"

def _dq_span_end(line, i):
    """Index just past the closing double quote of a span whose BODY starts at i."""
    n = len(line)
    while i < n and line[i] != '"':
        i += 2 if line[i] == BS else 1
    return min(i + 1, n)

def _sq_span(line, i):
    """(raw body, index just past the closing single quote) for a span whose BODY starts at i."""
    body, n = [], len(line)
    while i < n and line[i] != "'":
        if line[i] == BS and i + 1 < n:
            body.append(line[i:i + 2]); i += 2; continue
        body.append(line[i]); i += 1
    return "".join(body), min(i + 1, n)

def resolve_quote_introducers(line):
    """-> the line with every $'...' / $"..." resolved the way bash resolves it.

    Quote CONTEXT is tracked, because a `$'` inside an ordinary quoted span is not an introducer.
    Imprecision here can only add a reading, never remove one, so this errs toward normalising.
    """
    out, i, n = [], 0, len(line)
    while i < n:
        ch = line[i]
        if ch == BS and i + 1 < n:                     # an escaped character: copy both, verbatim
            out.append(line[i:i + 2]); i += 2; continue
        if ch == "'":                                  # a plain single-quoted span is verbatim
            j = line.find("'", i + 1)
            if j < 0:
                out.append(line[i:]); break
            out.append(line[i:j + 1]); i = j + 1; continue
        if ch == '"':                                  # ...and so is a double-quoted one
            j = _dq_span_end(line, i + 1)
            out.append(line[i:j]); i = j; continue
        if ch == "$" and line[i + 1:i + 2] == '"':      # $"..."  ->  "..."
            j = _dq_span_end(line, i + 2)
            out.append(line[i + 1:j]); i = j; continue
        if ch == "$" and line[i + 1:i + 2] == "'":      # $'...'  ->  '<decoded>'
            body, j = _sq_span(line, i + 2)
            out.append(_single_quoted(_ansi_c_decode(body))); i = j; continue
        out.append(ch); i += 1
    return "".join(out)

def line_readings(line):
    """Every defensible reading of one logical line. classify() drives ALL of them; any hit gates.

    Same rule as the ambiguous launcher prefix (see launcher_argvs): when a string has more than one
    defensible reading, classify all of them rather than picking one. Ambiguity resolves toward
    blocking. A line with no quote introducer in it yields exactly one reading and costs nothing.

    The second candidate exists because SHLEX IS NOT BASH INSIDE DOUBLE QUOTES: bash drops the
    backslash of `\\$`, shlex keeps it. So the inner string of `bash -c "git pu\\$'s'h origin main"`
    — which bash hands the inner shell as `git pu$'s'h`, i.e. a real push (verified with a non-git
    marker, `bash -c "to\\$'u'ch f"`, which creates f) — arrives here as `git pu\\$'s'h` and resolves
    to nothing. A shlex token no longer knows whether it was double-quoted, so both readings are
    taken. ONLY the two-character sequences `\\$'` and `\\$"` are affected, so `\\$HOME` and `\\$1`
    are untouched; the cost is deliberate over-blocking of a TOP-LEVEL `\\$'x'`, which bash reads as
    the literal `$x`. That is an evasion-shaped string and this is the fail-closed direction.
    """
    out = []
    for cand in (line, line.replace(BS + "$'", "$'").replace(BS + '$"', '$"')):
        for reading in (cand, resolve_quote_introducers(cand)):
            if reading not in out:
                out.append(reading)
    return out

# `<<EOF`, `<<-EOF`, `<<'EOF'`, `<<"EOF"`, `<<\EOF`
HEREDOC_RE = re.compile(r"<<-?\s*\\?(['\"]?)([A-Za-z_][A-Za-z0-9_]*)\1")

def logical_lines(text):
    """Split into lines, dropping heredoc bodies UNLESS the heredoc feeds a shell.

    "Feeds a shell" is decided from EVERY command in the introducing line, not just its first word:
    `cat <<'EOF' | bash` feeds a shell even though the first word is `cat`. (SEC-01d)

    A LINE CONTINUATION IS REMOVED, NOT REPLACED WITH A SPACE. bash deletes the backslash-newline
    pair outright, so `gi\<newline>t push` is `git push` and `gi\<newline>t co\<newline>nfig --global
    user.email <v>` is an identity write. Substituting a space instead produced `gi t push` and
    permitted both, which is the same class of defect as a mid-token `$'...'` — a quoting construct
    that splits a trigger word without changing what runs. (SEC-18) Removal is also right for the
    ordinary use: `git push \<newline>origin main` keeps the space that was already before the
    backslash, so the words do not run together.
    """
    lines = text.replace("\\\n", "").split("\n")
    out, i, n = [], 0, len(lines)
    while i < n:
        line = lines[i]
        out.append(line)
        m = HEREDOC_RE.search(line)
        if m:
            word = m.group(2)
            keep = line_feeds_shell(line)
            i += 1
            while i < n and lines[i].strip() != word:
                if keep:
                    out.append(lines[i])
                i += 1
            i += 1          # skip the terminator line itself
            continue
        i += 1
    return out

def segs_feed_shell(segs):
    """Does ANY command on this line run a shell? (Every candidate reading of every segment.)"""
    for toks, _here in segs:
        argvs, _cmdlike = launcher_argvs(toks)
        for argv in argvs:
            if prog_name(argv[0]) in SHELLS:
                return True
    return False

def line_feeds_shell(line):
    # EVERY reading of the line, so that `ba$'s'h <<'EOF'` is recognised as a shell and its heredoc
    # body is scanned. Without this the SEC-18 normalisation would close the introducing COMMAND but
    # not the heredoc-keep decision that runs before classify() ever sees the body.
    for reading in line_readings(line):
        try:
            segs = segments(reading)
        except Cannot:
            head = reading.strip().split()
            if head and prog_name(head[0]) in SHELLS:
                return True
            continue
        if segs_feed_shell(segs):
            return True
    return False

def is_punct(t):
    return bool(t) and all(ch in "();<>|&" for ch in t)

def segments(line):
    """Tokenise one line and split it into commands, OUTSIDE quotes.

    shlex(posix=True, punctuation_chars=True) is the tool for this: it yields `&&`, `||`, `;`, `|`
    as their own tokens and — critically — does NOT split on an operator inside a quoted string.
    A naive split would turn `git commit -m "gate; git push is refused"` into a false positive.

    Returns [(tokens, herestrings)]. Two things are handled here rather than in the classifier:
      · A REDIRECTION does not start a new command. Its operator, its operand (always a filename,
        never a command word) and any single-digit fd shlex split off the front of `2>` are all
        dropped, so `>/dev/null git push` and `2>/tmp/e git merge` keep `git` as the command word.
      · A PROCESS SUBSTITUTION is not a redirection, even though shlex lexes `<(` as one
        punctuation run containing `<`. What follows `<(` / `>(` is a COMMAND, not a filename, so
        the run is a BOUNDARY. Reading it as a redirection made `cat <(git push origin main)` drop
        the `git` as the "filename" and leave `push origin main` as the segment, which permitted a
        real push with the command text fully inline. (SEC-15)
      · A HERE-STRING operand (`bash <<< 'git push'`) is a command STRING, so it is kept and handed
        back for recursion instead of being mistaken for a program name.
    """
    import shlex
    lex = shlex.shlex(line, posix=True, punctuation_chars=True)
    lex.whitespace_split = True
    try:
        toks = list(lex)
    except ValueError as e:
        # Unbalanced quote: a real shell would fail too, but we must not guess. Fail closed.
        raise Cannot("could not tokenise the command line (%s)" % e)
    segs, cur, here = [], [], []
    i, n = 0, len(toks)
    while i < n:
        t = toks[i]
        if t in SEP_WORDS:                       # `{`, `}`, `!` are command boundaries too
            if cur or here:
                segs.append((cur, here)); cur, here = [], []
            i += 1
            continue
        if is_punct(t):
            if ("(" in t) or (")" in t):
                # `(`, `)`, and the process-substitution runs `<(` / `>(` / `<()` are BOUNDARIES.
                # This test comes FIRST so that `<(` is never mistaken for a redirection. (SEC-15)
                if cur or here:
                    segs.append((cur, here)); cur, here = [], []
                i += 1
                continue
            if ("<" in t) or (">" in t):
                if cur and FD_RE.match(cur[-1]):
                    cur.pop()
                nxt = toks[i + 1] if i + 1 < n else None
                if nxt is not None and not is_punct(nxt):
                    if t == "<<<":
                        here.append(nxt)
                    i += 2
                    continue
                i += 1
                continue
            if cur or here:
                segs.append((cur, here)); cur, here = [], []
            i += 1
            continue
        cur.append(t)
        i += 1
    if cur or here:
        segs.append((cur, here))
    return segs

def launcher_argvs(seg):
    """Resolve a launcher prefix. -> ([candidate argvs of the launched command], [cmd strings]).

    The prefix may contain, in any order: leading VAR=VAL assignments, launcher words, shell
    keywords, and — the whole point of this function — each launcher's OWN flags and flag VALUES.
    The old version broke on the first flag, which made `sudo -u josh git push`, `nice -n 10 git
    push`, `env -u FOO git push`, `command -p git push` and `timeout 60 git push` invisible. The
    handling here is generic (a flag, then optionally one value that is not itself a program we
    care about), not a per-launcher argument table.

    WHY THIS RETURNS A LIST, NOT ONE argv (SEC-13). Without a per-launcher table of which flags
    take a value, one token can be BOTH readings at once, and the two readings disagree:

        sudo -u git git push origin main     `git` is the VALUE of -u; the command word is the next
                                             `git`.  (`git` is the conventional service-account
                                             name: gitolite, gitea, forgejo, git-daemon.)
        env -i git push origin main          `-i` takes NO value, so `git` IS the command word.
        command -p git push / sudo -n git push / nice -19 git push   likewise.

    Testing the command word first (the old code) permits the whole `sudo -u git ...` family —
    argv became ["git","git","push"], so `sub` read as "git" and nothing matched. Testing the
    flag value first would permit the `env -i` family instead. There is no ordering that gets both
    right, so ORDERING IS THE WRONG TOOL: when a token is a command-word candidate AND a flag is
    pending, BOTH readings are emitted and the caller gates if EITHER of them classifies.
    Ambiguity resolves toward blocking. The cost is one extra classify call on a rare shape.

    The readings are collected in a single left-to-right pass — reading A terminates the walk,
    reading B continues it — so the count is LINEAR in the prefix length, not exponential.

    Second return value: any whitespace-containing token consumed inside the prefix. Those are
    candidate command STRINGS (`flock -c 'git push'`, `watch 'git push'`, `su -c '<cmd>'`) and get
    classified recursively — structurally, so `sudo -p "prompt about git push"` resolves to nothing.
    """
    i, after_flag, saw_launcher = 0, False, False
    cmdlike, argvs = [], []

    def reading(idx):
        # A cap only so a pathological string cannot make this quadratic. It must never DROP a
        # reading — a dropped reading is a fail-open — so exceeding it blocks instead.
        if len(argvs) >= MAX_LAUNCHER_READINGS:
            raise Cannot("the launcher prefix is ambiguous in more than %d places, so the command "
                         "word cannot be resolved" % MAX_LAUNCHER_READINGS)
        argvs.append(seg[idx:])

    while i < len(seg):
        t = seg[i]
        if ASSIGN_RE.match(t):
            i += 1; after_flag = False; continue
        p = prog_name(t)
        if p in WRAPPERS or p in KEYWORDS:
            i += 1; after_flag = False; saw_launcher = True; continue
        if not saw_launcher:
            reading(i)                  # position 0 decides: nothing to skip past
            break
        if t == "--":
            i += 1; after_flag = False; continue
        if t[:1] in ("-", "+"):
            i += 1; after_flag = True; continue
        if p in SHELLS or p in ("git", "gh"):
            reading(i)                  # reading A: this IS the command word
            if not after_flag:
                break
            i += 1; after_flag = False; continue    # reading B: it was the pending flag's value
        if WS_RE.search(t):
            cmdlike.append(t)           # a command string, wherever it sits in the prefix
            if not after_flag:
                break
            i += 1; after_flag = False; continue
        if NUMBERISH.match(t):
            i += 1; after_flag = False; continue    # `timeout 60`, `nice 10`
        if after_flag:
            i += 1; after_flag = False; continue    # this flag's value: `sudo -u josh`
        break                           # a different program is being launched
    return argvs, cmdlike

def shell_inline(argv, depth):
    """`bash -c '<cmd>'` and every equivalent spelling of it.

    The `-c` is matched as a PATTERN — any single-dash short-option cluster containing a lowercase
    `c` — not against a fixed list, because `bash -ec`, `bash -xc`, `sh -ec` and `bash -exc` are
    all `-c` and the fixed list ("-c","-lc","-ic","-cl") missed them. Lowercase `c` is the only
    bash short option spelled `c`, so a cluster containing it always means -c; `-C` (noclobber)
    does not match.
    """
    j = 1
    while j < len(argv):
        t = argv[j]
        if t in SHELL_VALUE_FLAGS:
            j += 2
            continue
        if SHELL_CFLAG_RE.match(t):
            return classify(argv[j + 1], depth + 1) if j + 1 < len(argv) else None
        if t[:1] in ("-", "+"):
            j += 1
            continue
        return None            # a script FILE operand; its contents are a declared gap
    return None

def classify_git_config(rest):
    """Gate a WRITE to the guard's own identity axis; never a read. (SEC-04)"""
    pos, flags = [], []
    j = 0
    while j < len(rest):
        a = unquote(rest[j])
        if a in GIT_CONFIG_VALUE_FLAGS:
            j += 2
            continue
        if a.startswith("-"):
            flags.append(a.split("=", 1)[0])
            j += 1
            continue
        pos.append(a)
        j += 1
    if any(f in GIT_CONFIG_READ_FLAGS for f in flags):
        return None
    if pos and pos[0] in GIT_CONFIG_READ_VERBS:
        return None
    key, write = None, False
    if pos and pos[0] in ("set", "unset"):                  # git >= 2.46 verb form
        key, write = (pos[1] if len(pos) > 1 else ""), True
    elif any(f in GIT_CONFIG_WRITE_FLAGS for f in flags) and pos:
        key, write = pos[0], True
    elif len(pos) >= 2:                                     # `git config user.email <value>`
        key, write = pos[0], True
    if write and key and key.lower() in GIT_IDENTITY_KEYS:
        return "git config (writes %s)" % key.lower()
    return None

def classify_git(args):
    i = 0
    while i < len(args):
        a = unquote(args[i])
        if a in GIT_OPT_WITH_VALUE:
            i += 2
            continue
        if a.startswith("-"):
            i += 1
            continue
        break
    if i >= len(args):
        return None
    sub, rest = unquote(args[i]), args[i + 1:]
    if sub == "push":
        return "git push"
    if sub == "merge":                 # exact: `merge-base`/`merge-file`/`merge-tree` are NOT this
        return "git merge"
    if sub == "pull":
        return "git pull"
    if sub == "subtree" and rest and unquote(rest[0]) == "push":
        return "git subtree push"
    if sub == "config":
        return classify_git_config(rest)
    return None

def classify_gh_api(rest):
    method, path, write_flag = None, None, False
    j = 0
    while j < len(rest):
        a = unquote(rest[j])
        if a in ("-X", "--method"):
            method = unquote(rest[j + 1]) if j + 1 < len(rest) else ""
            j += 2
            continue
        if a.startswith("--method="):
            method = a.split("=", 1)[1]
            j += 1
            continue
        m = re.match(r"^-X(.+)$", a)                 # attached short form: -XPUT (SEC-05)
        if m:
            method = m.group(1)
            j += 1
            continue
        if a in GH_API_WRITE_FLAGS:
            write_flag = True
            j += 2
            continue
        if any(a.startswith(f + "=") for f in ("--field", "--raw-field", "--input")):
            write_flag = True
            j += 1
            continue
        if a in GH_API_VALUE_FLAGS:
            j += 2
            continue
        if a.startswith("-"):
            j += 1
            continue
        if path is None:
            path = a
        j += 1
    m = (method or "").upper()
    if m in WRITE_METHODS:
        return "gh api -X %s (remote write)" % m
    if write_flag:
        return "gh api with fields (gh sends POST)"
    p = path or ""
    if "/merges" in p:
        return "gh api .../merges"
    if "/git/refs" in p:
        return "gh api .../git/refs"
    if re.search(r"/pulls/\d+/merge", p):
        return "gh api .../pulls/N/merge"
    return None

def classify_gh(args):
    """Find the gh command GROUP, skipping global flags AND their values.

    The old loop skipped bare leading flags and then took whatever followed as the group, so a
    value-taking global flag would have consumed the group word and silently un-gated the whole
    gh surface. Same generic flag/flag-value handling as launcher_argv.
    """
    i, after_flag = 0, False
    while i < len(args):
        a = unquote(args[i])
        if a == "--":
            i += 1; after_flag = False; continue
        if a.startswith("-"):
            i += 1; after_flag = True; continue
        if a in GH_GROUPS:
            break
        if after_flag:
            i += 1; after_flag = False; continue
        return None
    if i >= len(args):
        return None
    grp, rest = unquote(args[i]), args[i + 1:]
    sub = unquote(rest[0]) if rest else ""
    if grp == "pr":
        return "gh pr merge" if sub == "merge" else None
    if grp == "api":
        return classify_gh_api(rest)
    if grp == "release":
        return "gh release " + sub if sub in ("create", "delete", "edit", "upload") else None
    if grp == "repo":
        return "gh repo sync" if sub == "sync" else None
    return None

def classify_segment(seg, here, depth):
    argvs, cmdlike = launcher_argvs(seg)
    # EVERY candidate reading of the launcher prefix is classified, and the FIRST one that hits
    # gates the segment. See launcher_argvs: readings are ambiguous by construction, so "any hit
    # is a hit" is the only fail-closed way to combine them. (SEC-13)
    for argv in argvs:
        prog = prog_name(argv[0])
        if prog in SHELLS:
            hit = shell_inline(argv, depth)
            if hit:
                return hit
            for hs in here:                     # `bash <<< 'git push'`
                hit = classify(hs, depth + 1)
                if hit:
                    return hit
        elif prog == "git":
            hit = classify_git(argv[1:])
            if hit:
                return hit
        elif prog == "gh":
            hit = classify_gh(argv[1:])
            if hit:
                return hit
    for c in cmdlike:
        hit = classify(c, depth + 1)
        if hit:
            return hit
    return None

def classify_line(line, depth):
    """One reading of one logical line: its segments, its here-strings, its substitutions."""
    segs = segments(line)
    for toks, here in segs:
        hit = classify_segment(toks, here, depth)
        if hit:
            return hit
    # A HERE-STRING belongs to the LINE, not to the segment that spells it: in
    # `cat <<< '<cmd>' | bash` the text is a command string even though the segment that owns
    # the `<<<` runs `cat`. That is the same rule logical_lines already applies to a heredoc
    # body (`cat <<'EOF' | bash` is scanned), and the asymmetry between the two — heredoc
    # scanned, here-string not — was a bypass. (SEC-15)
    heres = [h for _toks, here in segs for h in here]
    if heres and segs_feed_shell(segs):
        for h in heres:
            hit = classify(h, depth + 1)
            if hit:
                return hit
    for inner in substitutions(line):
        hit = classify(inner, depth + 1)
        if hit:
            return hit
    return None

def classify(text, depth=0):
    """Return a label for the gated surface this command line touches, or None.

    NOTE there is deliberately no raw-substring trigger test here any more. There used to be one
    (`re.compile("push|merge|pull|gh")` against the RAW string) and it threw away work the shlex
    classifier would have done correctly: `git pus\\h`, `git 'pu'sh`, `git pu"sh"` and `g\\h api`
    all lex to the right tokens but do not contain the raw substring in the right place. The cheap
    negative filter lives in bash (_mg_may_match), operates on a quote/escape-NORMALISED copy of
    the string, and is the only place a substring test is allowed. (SEC-03)

    EVERY READING of each line is classified (see line_readings): the line as written, and — when
    the line uses a `$'...'` / `$"..."` quote introducer — the line with that introducer resolved
    the way bash resolves it. shlex cannot do that itself, and mid-token introducers were a bypass
    of the whole quoting/escaping class. (SEC-18)
    """
    if depth > 3 or not text:
        return None
    for line in logical_lines(text):
        if not line.strip():
            continue
        for reading in line_readings(line):
            hit = classify_line(reading, depth)
            if hit:
                return hit
    return None

# ---- the allowlist -------------------------------------------------------------------------
TOP_KEYS   = ("schema_version", "allowed")
ENTRY_KEYS = ("gh_login", "git_emails", "note")

def load_allowlist():
    """-> (logins, emails, entries). Raises Cannot on anything it cannot fully account for."""
    if not POLICY:
        raise Cannot("no allowlist path was resolved")
    if not os.path.isfile(POLICY):
        raise Cannot("allowlist file is missing: %s" % POLICY)
    import importlib.util
    try:
        spec = importlib.util.find_spec("yaml")
    except Exception as e:
        raise Cannot("cannot even probe for a YAML parser (%s)" % e)
    if spec is None:
        # No regex fallback on purpose. A looser reader could mis-read an allowlist, and the only
        # safe direction for THIS file is to refuse. Install pyyaml (see docs/INSTALL.md).
        raise Cannot("pyyaml is not installed, so the allowlist cannot be parsed exactly")
    try:
        import yaml
    except Exception as e:
        raise Cannot("pyyaml is installed but unimportable (%s) — a broken install, not an absent one" % e)
    try:
        with open(POLICY) as fh:
            data = yaml.safe_load(fh)
    except Exception as e:
        raise Cannot("allowlist is not parseable YAML: %s" % e)
    if not isinstance(data, dict):
        raise Cannot("allowlist top level is %s, expected a mapping" % type(data).__name__)
    for k in data:
        if k not in TOP_KEYS:
            raise Cannot("allowlist has an unknown top-level key %r (expected %s)"
                         % (k, ", ".join(TOP_KEYS)))
    entries = data.get("allowed")
    if not isinstance(entries, list) or not entries:
        raise Cannot("allowlist `allowed:` is empty or not a list — never a vacuous pass")
    logins, emails = [], []
    for n, e in enumerate(entries, 1):
        if not isinstance(e, dict):
            raise Cannot("allowlist entry %d is not a mapping" % n)
        for k in e:
            if k not in ENTRY_KEYS:
                raise Cannot("allowlist entry %d has an unknown key %r — this file must not "
                             "describe an identity source the code does not read" % (n, k))
        lg = e.get("gh_login")
        if not isinstance(lg, str) or not lg.strip() or "*" in lg or "?" in lg:
            raise Cannot("allowlist entry %d has a missing/blank/wildcard gh_login" % n)
        ems = e.get("git_emails")
        if not isinstance(ems, list) or not ems:
            raise Cannot("allowlist entry %d has no git_emails" % n)
        for em in ems:
            if not isinstance(em, str) or not em.strip() or "*" in em or "?" in em or "@" not in em:
                raise Cannot("allowlist entry %d has an invalid git_emails value %r" % (n, em))
            emails.append(em.strip().lower())
        logins.append(lg.strip().lower())
    return logins, emails, entries

# ---- identity resolution -------------------------------------------------------------------
def run(argv, timeout):
    """-> (rc, stdout, stderr, failure) where failure is '', 'absent' or 'timeout'."""
    try:
        p = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError:
        return 127, "", "", "absent"
    try:
        out, errout = p.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            p.kill()
            p.communicate(timeout=KILL_GRACE)
        except Exception:
            pass
        return 124, "", "", "timeout"
    dec = lambda b: (b or b"").decode("utf-8", "replace")
    return p.returncode, dec(out).strip(), dec(errout).strip(), ""

def resolve_gh():
    """-> (login, status, detail). status 'ok' only for a syntactically valid GitHub login."""
    rc, out, errout, failure = run(["gh", "api", "user", "--jq", ".login"], GH_TIMEOUT)
    if failure == "absent":
        return "", "gh-absent", "the `gh` binary is not on PATH"
    if failure == "timeout":
        return "", "gh-timeout", "`gh api user` did not answer within %ds (offline?)" % GH_TIMEOUT
    first = (errout.splitlines() or [""])[0][:200]
    if rc != 0:
        return "", "gh-failed", "`gh api user` exited %d: %s" % (rc, first or "(no stderr)")
    if not out:
        return "", "gh-empty", "`gh api user --jq .login` printed nothing"
    line = out.splitlines()[0].strip().strip('"')
    if not GH_LOGIN_RE.match(line):
        return "", "gh-malformed", "output is not a GitHub login: %r" % line[:120]
    return line, "ok", ""

def resolve_git_email():
    rc, out, errout, failure = run(["git", "config", "user.email"], GIT_TIMEOUT)
    if failure == "absent":
        return "", "git-absent", "the `git` binary is not on PATH"
    if failure == "timeout":
        return "", "git-timeout", "`git config user.email` did not answer"
    if rc != 0 or not out.strip():
        return "", "git-unset", "`git config user.email` is unset or empty in this working tree"
    val = out.splitlines()[0].strip()
    if "@" not in val:
        return "", "git-malformed", "user.email is not an address: %r" % val[:120]
    return val, "ok", ""

# ---- ledger (AC-021) -----------------------------------------------------------------------
def ledger(event, fields):
    """Append one event to the active run's run.jsonl. Best-effort: never changes the decision."""
    try:
        p = os.path.join(".agent-firm", "CURRENT_RUN")
        if not os.path.isfile(p):
            return
        with open(p) as fh:
            run_dir = fh.read().strip()
        if not run_dir or not os.path.isdir(run_dir):
            return
        # CURRENT_RUN is DATA, not an instruction: whatever can write it must not be able to steer
        # these appends outside the project the hook is running in. (SEC-11)
        here = os.path.realpath(os.getcwd())
        target = os.path.realpath(run_dir)
        if target != here and not target.startswith(here + os.sep):
            return
        import datetime
        rec = {"ts": datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ"), "event": event}
        rec.update(fields)
        with open(os.path.join(target, "run.jsonl"), "a") as fh:
            fh.write(json.dumps(rec, sort_keys=True) + "\n")
    except Exception:
        pass

# ---- the command under test ----------------------------------------------------------------
def command_from_payload():
    """Extract .tool_input.command from the PreToolUse payload.

    Distinguishes three cases on purpose:
      · not a Bash tool call            -> nothing to gate (permit)
      · a Bash call with no command KEY -> schema drift; we can no longer see what would run, and
                                           a gate that cannot see its input must not pass (block)
      · a command that is the empty str -> nothing to run (permit)
    """
    if not PAYLOAD.strip():
        raise Cannot("the hook received an empty stdin payload, so the command is unknown")
    try:
        d = json.loads(PAYLOAD)
    except Exception as e:
        raise Cannot("the hook payload is not JSON (%s)" % e)
    if not isinstance(d, dict):
        raise Cannot("the hook payload is not a JSON object")
    tool = d.get("tool_name")
    if isinstance(tool, str) and tool and tool != "Bash":
        return None                      # a different tool: not this guard's surface
    ti = d.get("tool_input")
    if not isinstance(ti, dict):
        raise Cannot("the hook payload has no tool_input object")
    if "command" not in ti:
        raise Cannot("the hook payload's tool_input has no `command` key — the payload shape "
                     "changed and the command string can no longer be read")
    cmd = ti.get("command")
    if cmd is None or cmd == "":
        return None
    if not isinstance(cmd, str):
        raise Cannot("the hook payload's command is %s, not a string" % type(cmd).__name__)
    return cmd

# ---- main ----------------------------------------------------------------------------------
def surface():
    print("firm-merge-guard — gated command surface")
    print("\nCOVERED (each line has its own BLOCK assertion in tests/test-merge-guard.sh):")
    for s in SURFACE_COVERED:
        print("  " + s if not s.startswith("  ") else "  " + s)
    print("\nKNOWN GAPS (each line has its own PERMIT assertion, so this list cannot drift):")
    for s in SURFACE_GAPS:
        print("  " + s if not s.startswith("  ") else "  " + s)
    print("\nNOT MATCHED, deliberately (false positives would make the firm unusable):")
    print("  git merge-base / merge-file / merge-tree / merge-index, git commit -m '...merge...',")
    print("  git log/diff/status/fetch/show, git config READS, git -c user.email=... <subcommand>,")
    print("  firm-integrate, firm-qa-checkout, bash tests/run-tests.sh, and — because a decoded")
    print("  ANSI-C span is re-quoted as ONE word, exactly as bash builds it — `git $'push origin")
    print("  main'`, which is a single argument to git and cannot push.")
    return 0

def main():
    if MODE == "surface":
        return surface()

    try:
        cmd = command_from_payload() if MODE == "hook" else COMMAND
    except Cannot as e:
        err("firm-merge-guard: CANNOT EVALUATE — %s" % e)
        err("  Blocking, because a check that cannot read its input must never report success.")
        ledger("merge_guard_block", {"decision": "cannot_evaluate", "reason": str(e), "cmd": ""})
        return CANNOT
    if cmd is None:
        return PERMIT

    try:
        hit = classify(cmd)
    except Cannot as e:
        err("firm-merge-guard: CANNOT EVALUATE — %s" % e)
        err("  command: %s" % cmd[:400])
        err("  Blocking: the command contains a merge/push trigger word but could not be parsed.")
        ledger("merge_guard_block", {"decision": "cannot_evaluate", "reason": str(e),
                                     "cmd": cmd[:2000]})
        return CANNOT
    if not hit:
        return PERMIT        # not the gated surface: no allowlist read, no gh, no network

    # --- from here on the command IS gated, so identity must be established -----------------
    try:
        logins, emails, entries = load_allowlist()
    except Cannot as e:
        err("firm-merge-guard: BLOCKED (cannot evaluate) — %s" % e)
        err("  refused command : %s" % cmd[:400])
        err("  matched surface : %s" % hit)
        err("  allowlist       : %s" % POLICY)
        err("  Fix the allowlist file; an unreadable allowlist is never treated as empty or as")
        err("  allow-everything. See agent-firm/policy/merge-authority.yaml.")
        ledger("merge_guard_block", {"decision": "cannot_evaluate", "reason": str(e),
                                     "cmd": cmd[:2000], "matched": hit})
        return CANNOT

    gh_login, gh_status, gh_detail = resolve_gh()
    git_email, git_status, git_detail = resolve_git_email()

    gh_ok  = gh_status == "ok" and gh_login.lower() in logins
    git_ok = git_status == "ok" and git_email.lower() in emails
    indeterminate = gh_status != "ok" or git_status != "ok"

    def fmt(value, status, allowed, detail):
        if status != "ok":
            return "UNRESOLVED (%s: %s)" % (status, detail)
        return "%s -> %s" % (value, "allow-listed" if allowed else "NOT allow-listed")

    if not indeterminate and gh_ok and git_ok:
        err("firm-merge-guard: permitted — %s by %s / %s (allow-listed in %s)"
            % (hit, gh_login, git_email, os.path.basename(POLICY)))
        ledger("merge_guard_permit", {"decision": "permitted", "cmd": cmd[:2000], "matched": hit,
                                      "gh_login": gh_login, "git_email": git_email})
        return PERMIT

    # Blocked. Say exactly which axis failed and how to proceed legitimately.
    #
    # WHAT THIS MESSAGE DELIBERATELY DOES NOT DO (SEC-04): it does not print a `git config
    # user.email <value>` command. The previous version did, and that made the guard dictate its
    # own bypass — a single un-gated Bash call, printed by the control, to the exact actor the
    # control exists to restrain. The diagnostic (which axis failed, what the allowlist contains,
    # where it lives) is kept, because the allowlist file path is printed and that file is readable
    # anyway; redacting its contents would be theatre. What is removed is the IMPERATIVE. The
    # actionable route for a legitimately mis-configured operator is the human running the repair
    # themselves — and that write is now gated too, so an agent cannot do it "helpfully".
    code = CANNOT if indeterminate else REFUSE
    label = "CANNOT EVALUATE identity" if indeterminate else "identity NOT authorised"
    err("firm-merge-guard: BLOCKED — %s." % label)
    err("")
    err("  refused command : %s" % cmd[:400])
    err("  matched surface : %s" % hit)
    err("  gh login        : %s" % fmt(gh_login, gh_status, gh_ok, gh_detail))
    err("  git user.email  : %s" % fmt(git_email, git_status, git_ok, git_detail))
    err("  policy          : BOTH sources must resolve and BOTH must be allow-listed.")
    err("  allowlist       : %s" % POLICY)
    err("  allow-listed    : logins %s ; emails %s" % (", ".join(logins), ", ".join(emails)))
    err("")
    if git_status == "ok" and not git_ok:
        err("  The git identity configured in this working tree is not an authorised one. A stale")
        err("  global identity left behind by CI (`git config --global user.*` in")
        err("  .github/workflows/ci.yml) is the usual cause on this machine.")
        err("")
        err("  DO NOT re-author your own identity to get past this block. Writing user.email or")
        err("  user.name is ITSELF on this guard's gated surface, deliberately: a check whose only")
        err("  input is a value the caller may rewrite is not a check. If the configuration on")
        err("  this machine is genuinely wrong, that repair belongs to the human operator, in a")
        err("  terminal, under their own identity — not to the blocked agent.")
        err("")
    if git_status not in ("ok", ):
        err("  No usable git identity was found in this working tree. Setting one is itself gated,")
        err("  so the human operator has to do it — this guard will not authorise an agent to")
        err("  choose its own identity.")
    if gh_status == "gh-absent":
        err("  Install and authenticate the GitHub CLI: `gh auth login`.")
    elif gh_status in ("gh-failed", "gh-timeout"):
        err("  Re-authenticate (`gh auth status`, then `gh auth login`) or restore network access.")
    elif gh_status == "ok" and not gh_ok:
        err("  The authenticated GitHub account is not authorised to merge or push here.")
    err("  To authorise an identity, add it to %s (a one-file edit)." % POLICY)
    err("  To proceed without an authorised identity: ask the human operator to run the command")
    err("  themselves in a terminal. Do NOT edit or remove this guard to get past it.")
    err("")
    err("  NOTE: this control is CLIENT-SIDE and bypassable by anyone with repo write access. It")
    err("  is not a security boundary and is not branch protection — see docs/ENFORCEMENT.md.")
    ledger("merge_guard_block", {
        "decision": "refused" if code == REFUSE else "cannot_evaluate",
        "cmd": cmd[:2000], "matched": hit,
        "gh_login": gh_login or "", "gh_status": gh_status,
        "git_email": git_email or "", "git_status": git_status,
        "exit": code})
    return code

def finish(code):
    """-> the process exit status, after emitting the proof-of-execution sentinel."""
    if MODE == "surface":
        return code                      # --surface writes its report on stdout; no sentinel there
    try:
        sys.stdout.write(SENTINEL[code] + "\n")
        sys.stdout.flush()
    except Exception:
        # We ran, but cannot prove it. The wrapper must not read this exit AS a decision.
        return PROCESS_EXIT[CANNOT]
    return PROCESS_EXIT[code]

try:
    sys.exit(finish(main()))
except Cannot as e:                      # anything unclassified above still fails closed
    err("firm-merge-guard: CANNOT EVALUATE — %s" % e)
    sys.exit(finish(CANNOT))
except Exception as e:                   # an internal error is not a permit
    err("firm-merge-guard: internal error (%s: %s) — blocking, not permitting."
        % (type(e).__name__, e))
    sys.exit(finish(CANNOT))
PYEOF
}

# ---------------------------------------------------------------------------------------------
# Cheap bash prefilter (AC-022). This is a HEURISTIC NEGATIVE FILTER, not a superset of
# SURFACE_COVERED — do not re-add the claim that it is one. It used to say "a command line with
# none of these substrings cannot match any entry in SURFACE_COVERED", and that was FALSE: shell
# quoting splits a trigger word without changing what runs, so `git pus\h`, `git 'pu'sh`,
# `git pu"sh"` and `g\h api` all reached this filter with no matching substring and were permitted
# before the real classifier ever saw them. (SEC-03)
#
# So the string is NORMALISED first — every backslash, single quote and double quote is deleted
# with bash parameter expansion, which costs ZERO subprocesses — and the substring test runs
# against the normalised copy. Deleting quotes can only ADD candidates (a false positive here
# costs one python3 start and is then resolved structurally); it can never remove one.
#
# THE `$` OF A QUOTE INTRODUCER IS DELETED WITH THE QUOTE (SEC-18). `$'…'` (ANSI-C) and `$"…"`
# (locale) are QUOTE INTRODUCERS, so bash collapses them into the surrounding word exactly the way
# it collapses `'…'`: `pu$'s'h` IS `push`. Deleting only the quotes left `pu$sh`, which contains no
# trigger word, so `git pu$'s'h`, `git pus$'h'` and — worst — `git co$'n'fig --global user.email`
# were SKIPped here, before python3 ever started. A `$` is only deleted when a quote character
# comes IMMEDIATELY after it, which is precisely bash's own rule and is why this cannot touch
# `$VAR`: `$HOME`, `$PWD`, `"$var"` and `${push}` have no quote in that position and are untouched.
# Deleting characters can only ever ADD candidates (no trigger word contains `$` or a quote), so
# this direction is safe by construction.
#
# AND THE ESCAPE SEQUENCES INSIDE `$'…'` CANNOT BE SEEN BY ANY SUBSTRING TEST. `$'\x67it' push` and
# `git $'\x70ush'` really do run git (verified with a non-git marker: `to$'\x75'ch f` creates `f`
# under /bin/bash 3.2.57), but after normalisation they read `git x70ush` — decoding hex, octal and
# \u escapes in bash would cost a subprocess, which is the one thing this filter exists to avoid.
# So the PRESENCE of `$'` followed anywhere by a backslash is itself a CHECK: the classifier decodes
# the span exactly. That is tested on the RAW string, before the backslash deletion below (which
# would otherwise remove the very evidence). `grep 'TODO$' README.md` — a `$` before a quote with no
# backslash after it — stays on the zero-subprocess path.
#
# A LINE CONTINUATION IS DELETED AS A PAIR, for the same reason. Deleting only the backslash left the
# NEWLINE between the halves of the split word, so `git pu\<newline>sh origin main` — which bash runs
# as `git push` — normalised to `git pu<newline>sh` and SKIPped here. Same construct class as the
# mid-token `$'...'`, same fix shape, and the classifier's logical_lines() removes the pair too.
#
# The `git`-then-`config` clause is its own condition because a `git config user.email <v>` write —
# which IS gated (SEC-04) — contains none of push/merge/pull/gh.
#
# THE PAIR IS ORDERED, AND THE ORDER IS THE WHOLE POINT. It used to be "`config` anywhere AND `git`
# anywhere", which fired on every string containing both words in either order — `grep -rn config
# .github/`, `ls docs/config.md` next to a `.git` path — and each one cost a python3 start
# (measured 40.5 ms versus 6.8 ms on the zero-subprocess path, doubled by the two hook
# registrations). Requiring `git` BEFORE `config` returns those to the zero-subprocess path while
# keeping every gated spelling: the `config` SUBCOMMAND always follows the `git` command word, and
# quote/escape normalisation runs first, so `git 'con'fig`, `git conf\ig` and `/usr/bin/git -C /p
# config` all still match. (Strings like `cat .git/config` do still match — narrowing further, e.g.
# by requiring whitespace before `config`, would drop `git $'config' user.email`, which IS gated.
# The clause errs toward CHECK, which costs milliseconds; erring the other way costs the gate.)
#
# DO NOT DELETE THIS CLAUSE. An uncommitted attempt to do so removed it from HERE only and left the
# jq program's copy intact — and this function is exactly what hook mode falls back to when jq is
# ABSENT (a supported configuration; see below). That would have deleted the whole SEC-04 identity
# gate from the ENFORCEMENT surface on any jq-less host: a fail-open, not a perf tweak. The diff is
# kept as 09-test-evidence/wo-c-discarded-wip-config-prefilter-revert.diff. The two prefilters are
# now pinned to each other by a test that runs a fixed corpus through BOTH and requires them to
# agree (tests/test-merge-guard.sh, "the bash and jq prefilters agree"), so this class of
# divergence fails the suite instead of shipping.
#
# Returning 1 here costs ZERO subprocesses: no python3, no gh, no git, no network.
# ---------------------------------------------------------------------------------------------
_mg_may_match() {
  local s
  # An ANSI-C quoted span carrying a BACKSLASH ESCAPE is decoded only by the classifier (SEC-18).
  # Tested on the RAW argument: the normalisation below deletes backslashes.
  case "$1" in *"\$'"*"\\"*) return 0 ;; esac
  # A line continuation is a PAIR: bash deletes the backslash AND the newline, so the halves of a
  # split word join up (`git pu\<newline>sh` is `git push`).
  s="${1//\\$'\n'/}"
  s="${s//\\/}"
  # `$'` and `$"` are quote INTRODUCERS: delete the `$` along with the quote it introduces (the two
  # lines below would delete that quote anyway), so `pu$'s'h` normalises to `push`. Only a `$`
  # IMMEDIATELY followed by a quote is touched, so `$VAR` / `${VAR}` / `"$v"` are untouched.
  s="${s//\$\'/}"
  s="${s//\$\"/}"
  s="${s//\'/}"
  s="${s//\"/}"
  case "$s" in
    *push*|*Push*|*PUSH*|*merge*|*Merge*|*MERGE*|*pull*|*Pull*|*PULL*) return 0 ;;
    *"gh "*|*"gh	"*)                                                  return 0 ;;
    *git*config*)                                                      return 0 ;;
  esac
  return 1
}

if [ "$MODE" = "surface" ]; then
  FIRM_MG_MODE=surface FIRM_MG_POLICY="$POLICY" FIRM_MG_PAYLOAD="" FIRM_MG_COMMAND="" _mg_py
  exit $?
fi

# _mg_report_rc <rc> <checker-stdout> <refuse-code> — map the checker's process exit onto the
# caller contract. 0 permit, 3 refuse, 2 cannot-evaluate; ANYTHING else came from outside the
# checker's contract (python3 dying of a syntax error or a failed exec both exit 1) and is reported
# as cannot-evaluate rather than passed through as a decision. (SEC-07)
#
# AND THE CODE ALONE IS NOT ENOUGH. An exit status is a number any `python3` on PATH can return
# without running a line of the checker, and this function reads that number AS a decision. So 0
# and 3 are honoured only when the checker's own stdout sentinel names the SAME decision. Without
# it, a python3 stub exiting 3 was reported as "identity resolved and not allow-listed" (SEC-17)
# and — far worse — a python3 stub exiting 0 was reported as PERMITTED, which is a fail-open on a
# control whose entire value is that it fails closed. 2 needs no sentinel: it blocks either way.
_mg_report_rc() {
  case "$1" in
    0) if [ "$2" = "FIRM_MG_DECISION=permit" ]; then exit 0; fi
       _mg_unproven "$1" "permit" ;;
    3) if [ "$2" = "FIRM_MG_DECISION=refuse" ]; then exit "$3"; fi
       _mg_unproven "$1" "refuse" ;;
    2) exit 2 ;;
    *) printf 'firm-merge-guard: CANNOT EVALUATE — the checker itself exited %s (no decision was\n' "$1" >&2
       printf '  reached, so nothing was recorded in the ledger). Blocking.\n' >&2
       exit 2 ;;
  esac
}

_mg_unproven() {
  printf 'firm-merge-guard: CANNOT EVALUATE — the checker exited %s (which would mean "%s") but\n' "$1" "$2" >&2
  printf '  did not emit its proof-of-execution sentinel, so that exit status cannot be read as a\n' >&2
  printf '  decision. A `python3` on PATH that is a stub, a shim, or the wrong interpreter can\n' >&2
  printf '  return any status without running the check. Blocking, and nothing was recorded in the\n' >&2
  printf '  ledger. Verify python3 (a declared firm prerequisite, see docs/INSTALL.md).\n' >&2
  exit 2
}

if [ "$MODE" = "command" ]; then
  _mg_may_match "$CMD" || exit 0
  if ! command -v python3 >/dev/null 2>&1; then
    printf 'firm-merge-guard: CANNOT EVALUATE — python3 is required to inspect this command.\n' >&2
    exit 2
  fi
  # stdout is captured because it carries the decision SENTINEL and nothing else; stderr is NOT
  # captured, so the human-readable block message still reaches the caller verbatim.
  _mg_out="$(FIRM_MG_MODE=command FIRM_MG_POLICY="$POLICY" FIRM_MG_PAYLOAD="" \
             FIRM_MG_COMMAND="$CMD" _mg_py)"
  _mg_report_rc "$?" "$_mg_out" 1
fi

# ---- hook mode ------------------------------------------------------------------------------
payload="$(cat 2>/dev/null || true)"

# Fast negative filter. jq is used ONLY to prove a NEGATIVE (a real string command with no trigger
# word); anything it cannot answer with certainty falls through to python3, which is authoritative.
# A jq that is missing, old, or wrong can therefore only cost a few milliseconds — never a pass.
# The same quote/escape normalisation as _mg_may_match is applied before the substring test, for
# the same reason (SEC-03) — INCLUDING the `$` of a `$'…'` / `$"…"` quote introducer, and the
# RAW-string test for a backslash escape inside an ANSI-C span, which must run BEFORE the backslash
# deletion that would remove its evidence (SEC-18). Whatever changes in one of these two prefilters
# has to change in the other: tests/test-merge-guard.sh drives BOTH over one corpus and fails if
# they disagree — and the jq side is the one that runs whenever jq exists.
# The single quote is spelled with jq's own escape so that this whole jq program can stay inside a
# single-quoted shell string.
if command -v jq >/dev/null 2>&1; then
  verdict="$(printf '%s' "$payload" | jq -r '
    if (.tool_input | type) != "object" then "CHECK"
    elif (.tool_input | has("command")) != true then "CHECK"
    elif (.tool_input.command | type) != "string" then "CHECK"
    elif (.tool_input.command | test("\\$\u0027[\\s\\S]*\\\\")) then "CHECK"
    else (.tool_input.command | gsub("\\\\\n"; "") | gsub("\\\\"; "") | gsub("\\$\u0027"; "") | gsub("\\$\""; "")
          | gsub("\u0027"; "") | gsub("\""; "")) as $c
      | if ($c | test("push|merge|pull|gh"; "i")) then "CHECK"
        elif ($c | test("git[\\s\\S]*config")) then "CHECK"
        else "SKIP" end
    end' 2>/dev/null || printf 'CHECK')"
  [ "$verdict" = "SKIP" ] && exit 0
else
  # No jq: the whole payload is the haystack. It is a superset of the command, so a negative here
  # is still a safe negative.
  _mg_may_match "$payload" || exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
  printf 'firm-merge-guard: BLOCKED (cannot evaluate) — python3 is not installed, so this command\n' >&2
  printf '  cannot be checked against the merge-authority allowlist. Install python3 (a declared\n' >&2
  printf '  firm prerequisite, see docs/INSTALL.md) or remove the firm-merge-guard PreToolUse hook.\n' >&2
  exit 2
fi

_mg_out="$(FIRM_MG_MODE=hook FIRM_MG_POLICY="$POLICY" FIRM_MG_PAYLOAD="$payload" \
           FIRM_MG_COMMAND="" _mg_py)"
# THE CALLER CONTRACT (AC-016): anything other than 0 is a block, and a PreToolUse hook only
# actually blocks on exit 2 in this Claude Code version (measured — exit 1 lets the command run).
# So a refusal (3) and a cannot-evaluate (2) both become 2 here; they are deliberately NOT
# distinguished, and neither is an out-of-contract code.
_mg_report_rc "$?" "$_mg_out" 2
