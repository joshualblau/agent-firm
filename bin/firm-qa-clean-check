#!/usr/bin/env bash
# Lead-owned verification of the persisted QA candidate checkout. --run is the authoritative
# interface; the zero-argument form preserves the assertion runner and converts CURRENT_RUN into the
# same fully validated target before any candidate or ledger operation.
# Exit 0 clean, 1 dirty/identity mismatch, 2 cannot verify.
set -euo pipefail
__src="${BASH_SOURCE[0]}"
while [ -L "$__src" ]; do __d="$(cd -P "$(dirname "$__src")" && pwd)"; __src="$(readlink "$__src")"; case $__src in /*) ;; *) __src="$__d/$__src";; esac; done
SELF="$(cd -P "$(dirname "$__src")" && pwd)"

if [[ $# -eq 0 ]]; then
  current_file=".agent-firm/CURRENT_RUN"
  if [[ ! -f "$current_file" || -L "$current_file" ]] || ! run_dir="$(cat "$current_file" 2>/dev/null)" || [[ -z "$run_dir" ]]; then
    echo "usage: firm-qa-clean-check [--run <run-dir> [qa-checkout]]" >&2
    exit 2
  fi
  qa_arg=""
elif [[ "${1:-}" == "--run" && -n "${2:-}" && $# -le 3 ]]; then
  run_dir="$2"
  qa_arg="${3:-}"
else
  echo "usage: firm-qa-clean-check [--run <run-dir> [qa-checkout]]" >&2
  exit 2
fi

exec python3 - "$SELF" "$run_dir" "$qa_arg" <<'PY'
import json, os, re, stat, subprocess, sys

self_dir, raw_run, qa_arg = sys.argv[1:]

def emit(status, code, message, reason, run=None, candidate=None):
    print(f"firm-qa-clean-check: {status.upper()} -- {message}", file=sys.stderr if code else sys.stdout)
    if run is not None and candidate is not None:
        command = [os.path.join(self_dir, "firm-ledger-log"), "--run", run, "--strict", "qa_clean_check",
                   f"status={status}", f"reason={reason}", f"dir={candidate.get('checkout_path','')}",
                   f"sha={candidate.get('candidate_sha','')}", f"generation={candidate.get('generation','')}"]
        done = subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        if done.returncode != 0:
            print(f"firm-qa-clean-check: target-ledger write failed: {done.stderr.strip()}", file=sys.stderr)
            raise SystemExit(2)
    raise SystemExit(code)

if not raw_run or any(ord(ch) < 32 or ord(ch) == 127 for ch in raw_run) or ".." in raw_run.replace("\\", "/").split("/"):
    emit("cannot_verify", 2, "unsafe explicit run path", "unsafe_run")
run = os.path.abspath(raw_run)
run_id = os.path.basename(run)
repo = os.path.dirname(os.path.dirname(os.path.dirname(run)))
if (not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", run_id)
        or os.path.basename(os.path.dirname(run)) != "runs"
        or os.path.basename(os.path.dirname(os.path.dirname(run))) != ".agent-firm"):
    emit("cannot_verify", 2, "run is not <repo>/.agent-firm/runs/<safe-id>", "unsafe_run")
try:
    for component in (repo, os.path.join(repo, ".agent-firm"), os.path.dirname(run), run):
        info = os.lstat(component)
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
            raise ValueError(f"unsafe run component {component}")
    top = subprocess.check_output(["git", "-C", repo, "rev-parse", "--show-toplevel"], stderr=subprocess.DEVNULL, text=True).strip()
    if os.path.realpath(top) != os.path.realpath(repo):
        raise ValueError("repository root mismatch")
except Exception as exc:
    emit("cannot_verify", 2, f"explicit run cannot be validated: {exc}", "unsafe_run")

candidate_path = os.path.join(run, "09-test-evidence", "qa-candidate.json")
try:
    info = os.lstat(candidate_path)
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        raise ValueError("candidate metadata is not a regular no-follow file")
    with open(candidate_path, encoding="utf-8") as fh:
        candidate = json.load(fh)
except Exception as exc:
    emit("cannot_verify", 2, f"candidate metadata is missing or malformed: {exc}", "candidate_metadata")

sha = candidate.get("candidate_sha")
generation = candidate.get("generation")
checkout = str(candidate.get("checkout_path", ""))
if (candidate.get("schema_version") != 2 or candidate.get("run_id") != run_id
        or not isinstance(sha, str) or not re.fullmatch(r"[0-9a-f]{40}", sha)
        or not isinstance(generation, int) or isinstance(generation, bool) or generation < 1
        or candidate.get("repository_root") != os.path.realpath(repo)):
    emit("cannot_verify", 2, "candidate metadata identity is invalid", "candidate_identity", run, candidate)
try:
    with open(os.path.join(run,"run.jsonl"),encoding="utf-8") as fh:
        events=[json.loads(line) for line in fh if line.strip()]
    matches=[event for event in events if event.get("event")=="qa_checkout"
             and event.get("sha")==sha and str(event.get("generation"))==str(generation)
             and event.get("dir")==checkout and event.get("source_ref")==candidate.get("source_ref")
             and event.get("base_sha")==candidate.get("base_sha")]
except Exception as exc:
    emit("cannot_verify",2,f"target ledger cannot be read: {exc}","ledger",run,candidate)
if len(matches)!=1:
    emit("identity_mismatch",1,"candidate has no unique matching qa_checkout target event","candidate_event",run,candidate)
if qa_arg and os.path.realpath(qa_arg) != os.path.realpath(checkout):
    emit("identity_mismatch", 1, "supplied checkout is not the persisted target checkout", "wrong_checkout", run, candidate)
try:
    if os.path.islink(checkout) or not os.path.isdir(checkout):
        raise ValueError("persisted checkout is missing or symlinked")
    head = subprocess.check_output(["git", "-C", checkout, "rev-parse", "HEAD"], stderr=subprocess.DEVNULL, text=True).strip()
    status = subprocess.check_output(["git", "-C", checkout, "status", "--porcelain=v1", "--untracked-files=all"], stderr=subprocess.DEVNULL, text=True)
    checkout_top = subprocess.check_output(["git", "-C", checkout, "rev-parse", "--show-toplevel"], stderr=subprocess.DEVNULL, text=True).strip()
    common = subprocess.check_output(["git", "-C", checkout, "rev-parse", "--git-common-dir"], stderr=subprocess.DEVNULL, text=True).strip()
    if not os.path.isabs(common):
        common = os.path.join(checkout, common)
    source = subprocess.check_output(["git", "-C", repo, "rev-parse", "--verify", candidate["source_ref"] + "^{commit}"], stderr=subprocess.DEVNULL, text=True).strip()
    ancestry = subprocess.run(["git", "-C", repo, "merge-base", "--is-ancestor", candidate["base_sha"], sha], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode
except Exception as exc:
    emit("cannot_verify", 2, f"persisted checkout cannot be inspected: {exc}", "git_status_failed", run, candidate)
if (head != sha or source != sha or os.path.realpath(checkout_top) != os.path.realpath(checkout)
        or os.path.realpath(common) != os.path.realpath(str(candidate.get("git_common_dir", "")))
        or ancestry != 0):
    emit("identity_mismatch", 1, "checkout/ref/common-dir/base ancestry no longer matches the candidate", "identity_mismatch", run, candidate)
if status:
    emit("dirty", 1, "persisted checkout has visible tracked or untracked changes", "dirty", run, candidate)
emit("clean", 0, "exact run/SHA/generation checkout has no visible changes", "clean", run, candidate)
PY
