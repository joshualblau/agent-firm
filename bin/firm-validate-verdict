#!/usr/bin/env bash
# validate-verdict <path-to-qa-verdict.json>
# Validates a QA verdict against qa-verdict.schema.json.
#
# Exit codes:
#   0 = VALID    — schema-validated with `jsonschema`
#   1 = INVALID  — malformed JSON, missing required keys, or a bad verdict value
#   2 = usage error
#   4 = DEGRADED — structurally plausible but NOT schema-validated (`jsonschema` missing)
#
# 4 is deliberately non-zero. This used to exit 0 with a parenthetical, which meant a machine with
# no `jsonschema` silently downgraded the firm's only mechanical evidence check to "has the right
# top-level keys" — and the Final gate cleared on it. A gate that cannot verify its evidence must
# not pass: see policy/gate-matrix.md. `jsonschema` is a declared prerequisite (docs/INSTALL.md,
# `firm-bootstrap --with-python-deps`), and firm-doctor FAILs without it.
set -euo pipefail

verdict="${1:-}"
if [[ -z "$verdict" ]]; then echo "usage: validate-verdict <qa-verdict.json>" >&2; exit 2; fi

__src="${BASH_SOURCE[0]}"   # resolve symlinks so ~/.local/bin/firm-* finds the repo
while [ -L "$__src" ]; do __d="$(cd -P "$(dirname "$__src")" && pwd)"; __src="$(readlink "$__src")"; case $__src in /*) ;; *) __src="$__d/$__src";; esac; done
SCRIPT_DIR="$(cd -P "$(dirname "$__src")" && pwd)"
SCHEMA="$(cd "$SCRIPT_DIR/.." && pwd)/agent-firm/schemas/qa-verdict.schema.json"

python3 - "$verdict" "$SCHEMA" <<'PY'
import json, sys
vpath, spath = sys.argv[1], sys.argv[2]
try:
    data = json.load(open(vpath))
except Exception as e:
    print(f"INVALID: not valid JSON: {e}"); sys.exit(1)
try:
    import jsonschema
    schema = json.load(open(spath))
    jsonschema.validate(data, schema)
    print("VALID (jsonschema): verdict =", data.get("verdict")); sys.exit(0)
except ImportError:
    required = ["verdict","commit_sha","environment","commands_run","unit","integration",
                "e2e","visual","acceptance_criteria_coverage","untested_risks","blockers",
                "warnings","artifacts","summary"]
    missing = [k for k in required if k not in data]
    if missing:
        print("INVALID (structural): missing keys:", ", ".join(missing)); sys.exit(1)
    if data.get("verdict") not in ("APPROVE","BLOCK"):
        print("INVALID (structural): verdict must be APPROVE or BLOCK"); sys.exit(1)
    print("DEGRADED: verdict is structurally plausible but NOT schema-validated —",
          "`jsonschema` is not installed.")
    print("  verdict =", data["verdict"], "(unverified)")
    print("  This does NOT satisfy the Final gate. Install the prerequisite:")
    print("    python3 -m pip install --user jsonschema pyyaml     (or: firm-bootstrap --with-python-deps)")
    sys.exit(4)
except Exception as e:
    print("INVALID (jsonschema):", e); sys.exit(1)
PY
