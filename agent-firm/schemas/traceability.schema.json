{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-firm/schemas/traceability.schema.json",
  "title": "Agent Firm candidate-bound traceability",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_slug", "candidate", "matrix", "two_voice", "two_voice_diff"],
  "properties": {
    "schema_version": {"const": 2},
    "task_slug": {"type": "string", "minLength": 1},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "repository_root", "git_common_dir", "checkout_path", "source_ref", "source_ref_sha", "base_sha", "commit_sha", "generation"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "repository_root": {"type": "string", "minLength": 1},
        "git_common_dir": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "pattern": "^refs/heads/integration/[A-Za-z0-9._/-]+$"},
        "source_ref_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "generation": {"type": "integer", "minimum": 1},
        "checkout_path": {"type": "string", "minLength": 1}
      }
    },
    "matrix": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/matrixRow"}},
    "two_voice": {"$ref": "#/$defs/twoVoice"},
    "two_voice_diff": {"type": "array", "items": {"$ref": "#/$defs/disposition"}}
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "candidate_sha", "sha256", "bytes", "producer"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "producer": {"$ref": "#/$defs/producer"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^evt-[A-Za-z0-9._:-]{1,128}$"},
        "event": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
        "provider": {"enum": ["gpt", "claude"]},
        "generation": {"type": "integer", "minimum": 1},
        "attempt_id": {"type": "string", "minLength": 1}
      }
    },
    "gateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "candidate_sha", "sha256", "bytes", "producer", "decision"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "producer": {"$ref": "#/$defs/producer"},
        "decision": {"enum": ["waive_partial", "waive_uncovered"]}
      }
    },
    "matrixRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "implementation_files", "tests", "manual_verification", "evidence", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^AC-[0-9]{3}$"},
        "implementation_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "tests": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "manual_verification": {"type": "string"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}},
        "status": {"enum": ["covered", "partial", "uncovered"]},
        "gate_record": {"$ref": "#/$defs/gateRef"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "covered"}}},
          "then": {"properties": {"evidence": {"minItems": 1}}, "not": {"required": ["gate_record"]}}
        },
        {
          "if": {"properties": {"status": {"enum": ["partial", "uncovered"]}}},
          "then": {"required": ["gate_record"]}
        }
      ]
    },
    "attemptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "provider", "generation", "attempt_id", "candidate_sha", "sha256", "bytes", "producer"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "provider": {"enum": ["gpt", "claude"]},
        "generation": {"type": "integer", "minimum": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "producer": {"$ref": "#/$defs/producer"}
      }
    },
    "twoVoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secondary_provider", "status", "required"],
      "properties": {
        "secondary_provider": {"enum": ["gpt", "claude"]},
        "status": {"enum": ["available", "unavailable"]},
        "required": {"type": "boolean"},
        "attempt": {"$ref": "#/$defs/attemptRef"},
        "unavailable_waiver": {"$ref": "#/$defs/evidenceRef"}
      },
      "allOf": [{"if": {"properties": {"status": {"const": "unavailable"}}}, "then": {"required": ["attempt"]}}]
    },
    "boundedResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "rounds", "rerun", "evidence"],
      "properties": {
        "attempted": {"type": "boolean"},
        "rounds": {"type": "integer", "minimum": 0, "maximum": 1},
        "rerun": {"enum": ["approve", "block", "not_run", "not_required"]},
        "evidence": {"anyOf": [{"$ref": "#/$defs/evidenceRef"}, {"type": "null"}]}
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secondary_blocker_id", "secondary_blocker", "primary_position", "positive_dissent", "affected_criteria", "affected_paths", "risk", "risk_reasons", "bounded_resolution", "evidence", "disposition"],
      "properties": {
        "secondary_blocker_id": {"type": "string", "pattern": "^obj-[A-Za-z0-9._:-]{1,128}$"},
        "secondary_blocker": {"type": "string", "minLength": 1},
        "primary_position": {"type": "string", "minLength": 1},
        "positive_dissent": {"type": "boolean"},
        "affected_criteria": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^AC-[0-9]{3}$"}},
        "affected_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "risk": {"enum": ["low", "high"]},
        "risk_reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "bounded_resolution": {"$ref": "#/$defs/boundedResolution"},
        "evidence": {"$ref": "#/$defs/evidenceRef"},
        "disposition": {"enum": ["unresolved", "fixed", "secondary_withdrew", "human_decision", "proceed_with_primary"]},
        "record": {"$ref": "#/$defs/evidenceRef"},
        "fresh_secondary_verdict": {"$ref": "#/$defs/evidenceRef"},
        "blocked_secondary_verdict": {"$ref": "#/$defs/evidenceRef"}
      }
    },
    "highRiskPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "version", "default_on_ambiguity", "categories"],
      "properties": {
        "schema_version": {"const": 1},
        "version": {"const": 1},
        "default_on_ambiguity": {"const": "required"},
        "categories": {
          "type": "object",
          "additionalProperties": false,
          "required": ["auth_permissions_crypto_pii", "hooks_and_policy", "reviewer_wrappers", "traceability_and_final_gate"],
          "properties": {
            "auth_permissions_crypto_pii": {"$ref": "#/$defs/authRiskPatterns"},
            "hooks_and_policy": {"$ref": "#/$defs/hookRiskPatterns"},
            "reviewer_wrappers": {"$ref": "#/$defs/reviewerRiskPatterns"},
            "traceability_and_final_gate": {"$ref": "#/$defs/traceRiskPatterns"}
          }
        }
      }
    },
    "pathPatterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^[^\\x00-\\x1f\\x7f]+$"}
    },
    "authRiskPatterns": {
      "allOf": [
        {"$ref": "#/$defs/pathPatterns"},
        {"minItems": 11, "maxItems": 11, "items": {"enum": ["**/auth/**", "**/*auth*", "**/permissions/**", "**/*permission*", "**/crypto/**", "**/*crypto*", "**/pii/**", "**/*pii*", "**/*credential*", "**/*secret*", ".claude/settings.json"]}}
      ]
    },
    "hookRiskPatterns": {
      "allOf": [
        {"$ref": "#/$defs/pathPatterns"},
        {"minItems": 4, "maxItems": 4, "items": {"enum": ["hooks/**", "**/hooks/**", "agent-firm/policy/**", "**/*allowlist*"]}}
      ]
    },
    "reviewerRiskPatterns": {
      "allOf": [
        {"$ref": "#/$defs/pathPatterns"},
        {"minItems": 5, "maxItems": 5, "items": {"enum": ["bin/firm-gpt-qa", "bin/firm-claude-qa", "bin/firm-reviewer-common", "bin/firm-bounded-exec", "agent-firm/contracts/qa-judge.md"]}}
      ]
    },
    "traceRiskPatterns": {
      "allOf": [
        {"$ref": "#/$defs/pathPatterns"},
        {"minItems": 6, "maxItems": 6, "items": {"enum": ["bin/firm-qa-checkout", "bin/firm-traceability-check", "bin/firm-final-qa-check", "agent-firm/schemas/traceability.schema.json", "agent-firm/schemas/qa-verdict.schema.json", "agent-firm/templates/traceability.yaml"]}}
      ]
    }
  }
}
