{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-firm/schemas/command-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "argv", "cwd", "started_at", "finished_at", "duration_ms", "exit_code", "result", "inputs", "outputs", "stdout", "stderr"],
  "properties": {
    "schema_version": {"const": 1},
    "argv": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "cwd": {"type": "string", "minLength": 1, "maxLength": 4096},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "exit_code": {"type": "integer"},
    "result": {"enum": ["pass", "fail", "timeout", "signal"]},
    "inputs": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/artifact"}},
    "outputs": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/artifact"}},
    "stdout": {"$ref": "#/$defs/stream"},
    "stderr": {"$ref": "#/$defs/stream"}
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "mode", "sanitizer"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mode": {"enum": ["0400", "0600", "0644"]},
        "sanitizer": {"enum": ["identity", "redacted_utf8_v2"]}
      }
    },
    "stream": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "reason"], "properties": {"kind": {"const": "not_applicable"}, "reason": {"const": "stream_not_emitted"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "path", "bytes", "sha256", "mode", "sanitizer"], "properties": {"kind": {"const": "retained"}, "path": {"type": "string", "minLength": 1, "maxLength": 512}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "mode": {"enum": ["0400", "0600", "0644"]}, "sanitizer": {"enum": ["identity", "redacted_utf8_v2"]}}}
      ]
    }
  }
}
